		lootTier = 3,
		icon = "key",
	}),
	recorder = item({
		id = "recorder",
		name = "Portable Recorder",
		category = "story",
		description = "Still has tape in it. Plays what somebody recorded here before the line went quiet.",
		promptVerb = "Play recording",
		weight = 0.6,
		stackSize = 1,
		essential = false,
		quickUsable = true,
		useSeconds = 1.0,
		model = { shape = "box", size = Vector3.new(0.5, 0.16, 0.34), colour = C(72, 70, 68), material = Enum.Material.SmoothPlastic, accent = C(160, 156, 150) },
		effect = { collectible = "recording", playsAudio = true },
		lootWeight = 4,
		lootTier = 3,
		icon = "recorder",
	}),
}

--------------------------------------------------------------------------
-- Indexes
--------------------------------------------------------------------------

local ItemRegistry = {}

ItemRegistry.Items = TableUtil.deepFreeze(ITEMS) :: { [string]: ItemDef }

function ItemRegistry.get(id: string): ItemDef?
	return ITEMS[id]
end

--- Never returns nil. Used in display paths where a missing item must not
--- crash a panel; the caller gets an obviously-wrong placeholder instead.
function ItemRegistry.getOrFallback(id: string): ItemDef
	local def = ITEMS[id]
	if def then
		return def
	end
	return {
		id = id,
		name = "Unknown Item",
		category = "consumable",
		description = "This item is not in the registry. That is a bug; please report the item id.",
		promptVerb = "Take",
		weight = 0.1,
		stackSize = 1,
		essential = false,
		quickUsable = false,
		model = { shape = "box", size = Vector3.new(0.5, 0.5, 0.5), colour = C(200, 60, 200), material = Enum.Material.Neon },
		lootWeight = 0,
		lootTier = 1,
	}
end

function ItemRegistry.exists(id: string): boolean
	return ITEMS[id] ~= nil
end

function ItemRegistry.byCategory(category: ItemCategory): { ItemDef }
	local out: { ItemDef } = {}
	for _, def in ITEMS do
		if def.category == category then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

--- Items eligible for a random loot roll at the given tier.
function ItemRegistry.lootPool(tier: number): { ItemDef }
	local out: { ItemDef } = {}
	for _, def in ITEMS do
		if def.lootTier == tier and def.lootWeight > 0 then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

--- Rolls one item id from a tier, or nil when the pool is empty.
function ItemRegistry.rollLoot(tier: number, rng: Random?): string?
	local pool = ItemRegistry.lootPool(tier)
	local picked = TableUtil.weightedPick(pool, function(def)
		return (def :: ItemDef).lootWeight
	end, rng)
	return if picked then (picked :: ItemDef).id else nil
end

return ItemRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">QuestRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	QuestRegistry
	-------------
	Daily and weekly quests, plus the chapter milestones.

	Design rule: every quest rewards doing something varied or cooperative, and
	none of them reward repetition of the cheapest possible action. There is no
	"complete 20 expeditions" quest, because that is a request to grind rather
	than a reason to play differently tonight.

	Quests are selected deterministically from a daily seed so every player on
	every server sees the same daily set. That matters for social play: crews
	can work on the same objectives together.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

export type QuestPeriod = "daily" | "weekly" | "milestone"

export type QuestDef = {
	id: string,
	period: QuestPeriod,
	name: string,
	description: string,
	-- Counter the progression system increments. Must match a stat key that
	-- something actually reports; ProgressionService asserts this at boot.
	stat: string,
	target: number,
	credits: number,
	xp: number,
	-- Optional cosmetic or item reward.
	reward: { kind: string, id: string, quantity: number? }?,
	-- Difficulty weighting used when picking the daily set: the picker takes a
	-- spread rather than three hard ones or three trivial ones.
	weight: number,
	tier: number, -- 1 light, 2 moderate, 3 demanding
	-- Quests that require other people. Solo players still get a viable set
	-- because the picker guarantees at most one co-op quest per day.
	cooperative: boolean?,
}

local function quest(def: QuestDef): QuestDef
	return def
end

--------------------------------------------------------------------------
-- Daily pool
--------------------------------------------------------------------------

local DAILY: { QuestDef } = {
	quest({
		id = "d_stations",
		period = "daily",
		name = "Make the stops",
		description = "Clear three stations on any difficulty.",
		stat = "stations_cleared",
		target = 3,
		credits = 220,
		xp = 160,
		weight = 10,
		tier = 1,
	}),
	quest({
		id = "d_optional",
		period = "daily",
		name = "Take the long way",
		description = "Complete four optional objectives.",
		stat = "optional_objectives",
		target = 4,
		credits = 260,
		xp = 190,
		weight = 9,
		tier = 2,
	}),
	quest({
		id = "d_records",
		period = "daily",
		name = "Read the room",
		description = "Recover five dispatch logs or recordings.",
		stat = "records_found",
		target = 5,
		credits = 200,
		xp = 150,
		weight = 8,
		tier = 1,
	}),
	quest({
		id = "d_rescue",
