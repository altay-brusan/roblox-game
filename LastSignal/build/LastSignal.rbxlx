        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Format
	------
	Display formatting shared by every interface, so the same number never
	appears two different ways in two different panels.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B" }

--- Compact number for HUD and shop chips: 1240 -> "1.2K".
function Format.compactNumber(value: number): string
	local n = math.floor(value + 0.5)
	local negative = n < 0
	n = math.abs(n)
	local tier = 1
	while n >= 1000 and tier < #SUFFIXES do
		n /= 1000
		tier += 1
	end
	local text: string
	if tier == 1 then
		text = tostring(math.floor(n))
	elseif n < 10 then
		text = string.format("%.1f", n)
	else
		text = string.format("%d", math.floor(n))
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[tier]
end

--- Grouped number for detail panels: 1240 -> "1,240".
function Format.groupedNumber(value: number): string
	local n = math.floor(math.abs(value) + 0.5)
	local text = tostring(n)
	local grouped = ""
	local count = 0
	for index = #text, 1, -1 do
		grouped = string.sub(text, index, index) .. grouped
		count += 1
		if count % 3 == 0 and index > 1 then
			grouped = "," .. grouped
		end
	end
	return (if value < 0 then "-" else "") .. grouped
end

--- Clock for timers: 95 -> "1:35". Negative input clamps to zero so an expired
--- timer never renders as a negative duration.
function Format.clock(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local minutes = math.floor(total / 60)
	local remainder = total % 60
	if minutes >= 60 then
		local hours = math.floor(minutes / 60)
		return string.format("%d:%02d:%02d", hours, minutes % 60, remainder)
	end
	return string.format("%d:%02d", minutes, remainder)
end

--- Coarse duration for "resets in" labels: 7500 -> "2h 5m".
function Format.duration(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	if total < 60 then
		return string.format("%ds", total)
	end
	local minutes = math.floor(total / 60)
	if minutes < 60 then
		return string.format("%dm", minutes)
	end
	local hours = math.floor(minutes / 60)
	if hours < 24 then
		local rest = minutes % 60
		return if rest > 0 then string.format("%dh %dm", hours, rest) else string.format("%dh", hours)
	end
	local days = math.floor(hours / 24)
	local restHours = hours % 24
	return if restHours > 0 then string.format("%dd %dh", days, restHours) else string.format("%dd", days)
end

--- In-world clock used by the story. The expedition starts at 02:17.
function Format.storyClock(minutesSinceStart: number): string
	local base = 2 * 60 + 17
	local total = (base + math.floor(minutesSinceStart)) % (24 * 60)
	return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

--- Speed shown on the cab gauge. The project uses studs/second internally and
--- presents km/h, using the common Roblox convention of 1 stud = 0.28 metres.
function Format.speedKph(studsPerSecond: number): string
	local metresPerSecond = studsPerSecond * 0.28
	return string.format("%d", math.floor(metresPerSecond * 3.6 + 0.5))
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.clamp(math.floor(fraction * 100 + 0.5), 0, 100))
end

--- Robux price label. Zero means "not configured" everywhere in this project,
--- and must never render as a free or purchasable item.
function Format.price(robux: number?): string
	if not robux or robux <= 0 then
		return "Unavailable"
	end
	return Format.groupedNumber(robux) .. " R$"
end

--- Title-cases an identifier for fallback display: "fuel_can" -> "Fuel Can".
function Format.titleFromId(id: string): string
	local spaced = string.gsub(id, "[_%-]", " ")
	-- Luau types the gsub replacement callback as single-capture; this cast
	-- keeps the two-capture form that the runtime supports.
	local capitalise = (function(first: string, rest: string): string
		return string.upper(first) .. string.lower(rest)
	end :: any) :: (string) -> string
	local titled = string.gsub(spaced, "(%a)([%w]*)", capitalise)
	return titled
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Guard
	-----
	Payload validators for everything crossing the network boundary.

	Remote arguments arrive as arbitrary client data: the type annotations on a
	handler are compile-time only and enforce nothing at runtime. Every server
	handler in this project validates its arguments through Guard before the
	values reach any service.

	Validators return the coerced value on success and nil on failure, so the
	usual call shape is:

		local amount = Guard.integer(rawAmount, 1, 99)
		if not amount then return end
]]

local Guard = {}

--- Numbers only, rejecting NaN and infinity. Clients can send either.
function Guard.number(value: any, min: number?, max: number?): number?
	if type(value) ~= "number" then
		return nil
	end
	if value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	if min and value < min then
		return nil
	end
	if max and value > max then
		return nil
	end
	return value
end

function Guard.integer(value: any, min: number?, max: number?): number?
	local n = Guard.number(value, min, max)
	if not n or n % 1 ~= 0 then
		return nil
	end
	return n
end

--- Strings with a byte-length cap. The cap matters: an unbounded string from a
--- client can be megabytes and will be echoed into logs or other clients.
function Guard.string(value: any, maxLength: number?): string?
	if type(value) ~= "string" then
		return nil
	end
	if #value > (maxLength or 128) then
		return nil
	end
	return value
end

--- An identifier used as a registry key. Restricted character set so it can
--- never be used to reach outside a table or be injected into UI text.
function Guard.id(value: any): string?
	local str = Guard.string(value, 64)
	if not str or str == "" then
		return nil
	end
	if not string.match(str, "^[%w_%-%.]+$") then
		return nil
	end
	return str
end

function Guard.boolean(value: any): boolean?
	if type(value) ~= "boolean" then
		return nil
	end
	return value
end

--- Membership test against a fixed set of allowed literals.
function Guard.enum(value: any, allowed: { [string]: any } | { string }): string?
	local str = Guard.string(value, 64)
	if not str then
		return nil
	end
	-- Accept both array-of-strings and set-style tables.
	if (allowed :: any)[str] ~= nil then
		return str
	end
	for _, candidate in allowed :: { string } do
		if candidate == str then
			return str
		end
	end
	return nil
end

function Guard.vector3(value: any, maxMagnitude: number?): Vector3?
	if typeof(value) ~= "Vector3" then
		return nil
	end
	local v = value :: Vector3
	local x, y, z = v.X, v.Y, v.Z
	if x ~= x or y ~= y or z ~= z then
		return nil
	end
	if math.abs(x) == math.huge or math.abs(y) == math.huge or math.abs(z) == math.huge then
		return nil
	end
	if maxMagnitude and v.Magnitude > maxMagnitude then
		return nil
	end
	return v
end

--- A unit-ish direction. Clients frequently send slightly denormalised vectors,
--- so this normalises rather than rejecting, but rejects zero and garbage.
function Guard.direction(value: any): Vector3?
	local v = Guard.vector3(value, 1e6)
	if not v or v.Magnitude < 1e-4 then
		return nil
	end
	return v.Unit
end

--- An Instance of an expected class that is still parented to the world. The
--- parent check stops clients passing references to destroyed or client-only
--- objects that the server would otherwise happily act on.
function Guard.instance(value: any, className: string, ancestor: Instance?): Instance?
	if typeof(value) ~= "Instance" then
		return nil
	end
	local inst = value :: Instance
	if not inst:IsA(className) then
		return nil
	end
	if not inst.Parent then
		return nil
	end
	if ancestor and not inst:IsDescendantOf(ancestor) then
		return nil
	end
	return inst
end

--- A plain table with a bounded number of entries, rejecting anything with a
--- metatable. Used for structured commands such as shop or crew payloads.
function Guard.table(value: any, maxEntries: number?): { [any]: any }?
	if type(value) ~= "table" then
		return nil
	end
	if getmetatable(value :: any) ~= nil then
		return nil
	end
	local limit = maxEntries or 32
	local count = 0
	for _ in value do
		count += 1
		if count > limit then
			return nil
		end
	end
	return value
end

--- An array of validated elements. Fails whole if any element fails, which is
--- the safe default: partial acceptance hides malformed payloads.
function Guard.array(value: any, validator: (any) -> any?, maxLength: number?): { any }?
	local t = Guard.table(value, (maxLength or 32) + 1)
	if not t then
		return nil
	end
	local out = {}
	local expected = 0
	for key, element in t do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
			return nil
		end
		expected += 1
		local checked = validator(element)
		if checked == nil then
			return nil
		end
		out[key] = checked
	end
	if #out ~= expected then
		return nil -- sparse array
	end
	if maxLength and #out > maxLength then
		return nil
	end
	return out
end

--- Distance check used by every proximity-gated interaction. Returns false when
--- either position is missing so a caller cannot accidentally allow the action.
function Guard.withinDistance(a: Vector3?, b: Vector3?, maxDistance: number): boolean
	if not a or not b then
		return false
	end
	return (a - b).Magnitude <= maxDistance
end

--- Convenience for server handlers: resolves a live, alive character root.
function Guard.aliveRoot(player: Player): BasePart?
	local character = player.Character
	if not character or not character.Parent then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	return root
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Logger
	------
	Prefixed, level-filtered logging. Every service creates its own scope so
	output reads "[LAST SIGNAL][DataService] ..." and can be filtered in the
	Studio output window or in live server logs.
]]

local RunService = game:GetService("RunService")

local Logger = {}

export type Level = "debug" | "info" | "warn" | "error"

local LEVEL_ORDER: { [string]: number } = {
	debug = 10,
	info = 20,
	warn = 30,
	error = 40,
}

-- Studio shows debug output; live servers stay at info so logs stay readable.
local minimumLevel: number = if RunService:IsStudio() then LEVEL_ORDER.debug else LEVEL_ORDER.info

function Logger.setMinimumLevel(level: Level)
	minimumLevel = LEVEL_ORDER[level] or LEVEL_ORDER.info
end

export type Scope = {
	debug: (...any) -> (),
	info: (...any) -> (),
	warn: (...any) -> (),
	error: (...any) -> (),
	scope: (string) -> Scope,
}

local function format(prefix: string, ...: any): string
	local count = select("#", ...)
	local parts = table.create(count)
	for index = 1, count do
		local value = select(index, ...)
		if type(value) == "table" then
			parts[index] = "<table>"
		else
			parts[index] = tostring(value)
		end
	end
	return prefix .. " " .. table.concat(parts, " ")
end

function Logger.new(name: string): Scope
	local prefix = string.format("[LAST SIGNAL][%s]", name)
	local scope: Scope = {
		debug = function(...)
			if minimumLevel <= LEVEL_ORDER.debug then
				print(format(prefix, ...))
			end
		end,
		info = function(...)
			if minimumLevel <= LEVEL_ORDER.info then
				print(format(prefix, ...))
			end
		end,
		warn = function(...)
			if minimumLevel <= LEVEL_ORDER.warn then
				warn(format(prefix, ...))
			end
		end,
		error = function(...)
			-- Never raises: logging must not be able to abort its caller.
			warn(format(prefix .. "[ERROR]", ...))
		end,
		scope = function(child: string): Scope
			return Logger.new(name .. "/" .. child)
		end,
	}
	return scope
end

return Logger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Maid
	----
	Deterministic cleanup container. Anything whose lifetime is shorter than the
	server or client session goes into a Maid, so teardown is a single call and
	nothing leaks across expeditions, respawns or menu open/close cycles.

	Accepts Instances, RBXScriptConnections, internal Signal connections,
	functions, threads, and tables exposing Destroy or Disconnect.
]]

local Protect = require(script.Parent.Protect)

local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable(
	{} :: { _tasks: { [any]: any }, _destroyed: boolean, _id: number },
	Maid
))

function Maid.new(): Maid
	return setmetatable({ _tasks = {}, _destroyed = false, _id = 0 }, Maid)
end

local function cleanupTask(item: any)
	local kind = typeof(item)
	if kind == "function" then
		item()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "thread" then
		-- Cancelling the running thread would abort our own teardown.
		if coroutine.running() ~= item and coroutine.status(item) ~= "dead" then
			pcall(task.cancel, item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

--- Adds a task and returns it, so `local part = maid:Give(Instance.new("Part"))`
--- reads naturally at the call site.
function Maid.Give(self: Maid, item: any): any
	if self._destroyed then
		-- Late additions to a destroyed maid are cleaned immediately rather than
		-- leaking; this happens when async work lands after teardown.
		cleanupTask(item)
		return item
	end
	self._id += 1
	self._tasks[self._id] = item
	return item
end

--- Adds a task under a stable key. Re-using a key cleans the previous occupant,
--- which is how single-instance state such as an active beam is managed.
function Maid.GiveKeyed(self: Maid, key: any, item: any): any
	if self._destroyed then
		cleanupTask(item)
		return item
	end
	local existing = self._tasks[key]
	if existing ~= nil and existing ~= item then
		cleanupTask(existing)
	end
	self._tasks[key] = item
	return item
end

function Maid.Remove(self: Maid, key: any)
	local existing = self._tasks[key]
	if existing ~= nil then
		self._tasks[key] = nil
		cleanupTask(existing)
	end
end

--- Runs every task and empties the maid. The maid remains usable afterwards.
function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for _, item in tasks do
		local ok, err = Protect.call(cleanupTask, item)
		if not ok then
			warn("[Maid] cleanup error: " .. tostring(err))
		end
	end
end

function Maid.Destroy(self: Maid)
	self:Clean()
	self._destroyed = true
end

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Net
	---
	The single networking boundary for LAST SIGNAL.

	Rules this module enforces, because they are the ones that get broken:

	1. Every remote is declared up front in RemoteManifest. A typo is a hard
	   error at boot rather than a silent no-op in production.
	2. The server creates the remote folder; the client only ever waits for it.
	   Clients cannot introduce new remotes.
	3. Every server-bound handler is wrapped with a token-bucket rate limit and
	   a pcall, so a malicious or buggy client cannot spam or crash a service.
	4. There are no server-to-client RemoteFunction invocations anywhere in the
	   project. A client that never returns would hang the server thread.

	Argument validation is the caller's responsibility and is expected on every
	server handler; see Guard for the shared validators.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Logger = require(script.Parent.Logger)
local RateLimiter = require(script.Parent.RateLimiter)

local log = Logger.new("Net")
local IS_SERVER = RunService:IsServer()

local Protect = require(script.Parent.Protect)

local Net = {}

--[[
	Remote manifest.

	kind:  "event"    -> RemoteEvent, both directions
	       "function" -> RemoteFunction, client -> server only
	rate:  { capacity, refillPerSecond } applied per player to inbound traffic.
	       Omitted for server -> client only events.
]]
export type RemoteKind = "event" | "function"
export type RemoteSpec = { kind: RemoteKind, rate: { number }? }

local MANIFEST: { [string]: RemoteSpec } = {
	-- Session and profile ------------------------------------------------
	ProfileSnapshot = { kind = "event" }, -- server -> client, full profile push
	ProfileDelta = { kind = "event" }, -- server -> client, incremental update
	RequestProfile = { kind = "function", rate = { 4, 0.5 } },
	SetSetting = { kind = "event", rate = { 12, 3 } },

	-- Lobby, crew and expedition ------------------------------------------
	CrewState = { kind = "event" }, -- server -> client
	CrewCommand = { kind = "function", rate = { 10, 2 } },
	ExpeditionState = { kind = "event" }, -- server -> client
	ExpeditionCommand = { kind = "function", rate = { 10, 2 } },
	Cinematic = { kind = "event" }, -- server -> client
	CinematicSkip = { kind = "event", rate = { 4, 1 } },

	-- World interaction ----------------------------------------------------
	Interact = { kind = "event", rate = { 12, 4 } },
	InteractResult = { kind = "event" }, -- server -> client
	Inventory = { kind = "event" }, -- server -> client
	InventoryCommand = { kind = "function", rate = { 20, 6 } },
	Ping = { kind = "event", rate = { 6, 1 } },
	PingBroadcast = { kind = "event" }, -- server -> client

	-- Train ----------------------------------------------------------------
	TrainState = { kind = "event" }, -- server -> client
	TrainControl = { kind = "event", rate = { 24, 10 } },
	TrainCommand = { kind = "function", rate = { 8, 2 } },

	-- Combat ---------------------------------------------------------------
	WeaponFire = { kind = "event", rate = { 16, 8 } },
	WeaponReload = { kind = "event", rate = { 6, 2 } },
	WeaponEffect = { kind = "event" }, -- server -> client
	MeleeSwing = { kind = "event", rate = { 10, 3 } },

	-- Survival, downed state ------------------------------------------------
	VitalsState = { kind = "event" }, -- server -> client
	DownedState = { kind = "event" }, -- server -> client
	ReviveCommand = { kind = "function", rate = { 6, 1 } },
	SpectateCommand = { kind = "event", rate = { 10, 2 } },

	-- Horror direction -------------------------------------------------------
	HorrorCue = { kind = "event" }, -- server -> client
	RadioMessage = { kind = "event" }, -- server -> client

	-- Progression, quests, rewards -------------------------------------------
	QuestState = { kind = "event" }, -- server -> client
	RewardCommand = { kind = "function", rate = { 8, 1 } },
	RewardGranted = { kind = "event" }, -- server -> client
	LeaderboardData = { kind = "function", rate = { 3, 0.2 } },

	-- Shop and monetization ---------------------------------------------------
	ShopState = { kind = "event" }, -- server -> client
	ShopCommand = { kind = "function", rate = { 10, 1.5 } },
	PurchaseResult = { kind = "event" }, -- server -> client

	-- Live events --------------------------------------------------------------
	EventState = { kind = "event" }, -- server -> client
	EventCommand = { kind = "function", rate = { 8, 1 } },

	-- Presentation, notifications, admin ----------------------------------------
	Notify = { kind = "event" }, -- server -> client
	Subtitle = { kind = "event" }, -- server -> client
	AdminCommand = { kind = "function", rate = { 12, 2 } },
	AdminState = { kind = "event" }, -- server -> client
	Analytics = { kind = "event", rate = { 20, 4 } }, -- client funnel markers
}

Net.Manifest = MANIFEST

local REMOTE_FOLDER_NAME = "Remotes"

local remotes: { [string]: Instance } = {}
local limiters: { [string]: RateLimiter.RateLimiter } = {}
local folder: Folder? = nil

local function assertDeclared(name: string): RemoteSpec
	local spec = MANIFEST[name]
	if not spec then
		error(string.format("Net: remote '%s' is not declared in the manifest", name), 3)
	end
	return spec
end

--- Server-only. Creates every declared remote. Called once during boot.
function Net.initServer()
	assert(IS_SERVER, "Net.initServer may only run on the server")
	if folder then
		return
	end
	local root = ReplicatedStorage:FindFirstChild("LastSignal")
	assert(root, "Net.initServer: ReplicatedStorage.LastSignal is missing")

	local created = Instance.new("Folder")
	created.Name = REMOTE_FOLDER_NAME
	for name, spec in MANIFEST do
		local remote: Instance
		if spec.kind == "event" then
			remote = Instance.new("RemoteEvent")
		else
			remote = Instance.new("RemoteFunction")
		end
		remote.Name = name
		remote.Parent = created
		remotes[name] = remote
		if spec.rate then
			limiters[name] = RateLimiter.new(spec.rate[1], spec.rate[2])
		end
	end
	created.Parent = root
	folder = created

	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter:reset(player)
		end
	end)

	log.info(string.format("initialised %d remotes", (function()
		local n = 0
		for _ in MANIFEST do
			n += 1
		end
		return n
	end)()))
end

local function getRemote(name: string): Instance
	assertDeclared(name)
	local cached = remotes[name]
	if cached then
		return cached
	end
	assert(not IS_SERVER, "Net: server remote missing after init: " .. name)
	local root = ReplicatedStorage:WaitForChild("LastSignal", 30) :: Instance
	local remoteFolder = root:WaitForChild(REMOTE_FOLDER_NAME, 30) :: Instance
	local remote = remoteFolder:WaitForChild(name, 30)
	assert(remote, "Net: remote never replicated: " .. name)
	remotes[name] = remote :: Instance
	return remote :: Instance
end

Net.get = getRemote

-- Server API ---------------------------------------------------------------

export type HandlerOptions = {
	--- Skip the automatic rate limit. Only for server-authored internal calls.
	unlimited: boolean?,
}

--- Connects a server handler to a client-fired RemoteEvent.
--- The handler is rate limited per player and wrapped in pcall.
function Net.onServerEvent(name: string, handler: (Player, ...any) -> (), options: HandlerOptions?): RBXScriptConnection
	assert(IS_SERVER, "Net.onServerEvent is server only")
	local spec = assertDeclared(name)
	assert(spec.kind == "event", "Net.onServerEvent: " .. name .. " is not an event")
	local remote = getRemote(name) :: RemoteEvent
	local limiter = limiters[name]
	local skipLimit = options and options.unlimited

	return remote.OnServerEvent:Connect(function(player, ...)
		if limiter and not skipLimit and not limiter:check(player) then
			-- Dropping silently is intentional: telling a spammer that they are
			-- rate limited only helps them tune the spam.
			return
		end
		local ok, err = Protect.call(handler, player, ...)
		if not ok then
			log.error(string.format("handler '%s' for %s failed: %s", name, player.Name, tostring(err)))
		end
	end)
end

--- Connects a server handler to a client RemoteFunction invocation.
--- Returning nil is the convention for "rejected"; callers must handle it.
function Net.onServerInvoke(name: string, handler: (Player, ...any) -> ...any, options: HandlerOptions?)
	assert(IS_SERVER, "Net.onServerInvoke is server only")
	local spec = assertDeclared(name)
	assert(spec.kind == "function", "Net.onServerInvoke: " .. name .. " is not a function")
	local remote = getRemote(name) :: RemoteFunction
	local limiter = limiters[name]
	local skipLimit = options and options.unlimited

	remote.OnServerInvoke = function(player, ...)
		if limiter and not skipLimit and not limiter:check(player) then
			return { ok = false, error = "RATE_LIMITED" }
		end
		local results = table.pack(pcall(handler, player, ...))
		if not results[1] then
			log.error(string.format("invoke '%s' for %s failed: %s", name, player.Name, tostring(results[2])))
			return { ok = false, error = "INTERNAL" }
		end
		return table.unpack(results, 2, results.n)
	end
end

function Net.fireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER, "Net.fireClient is server only")
	local remote = getRemote(name) :: RemoteEvent
	remote:FireClient(player, ...)
end

function Net.fireAllClients(name: string, ...: any)
	assert(IS_SERVER, "Net.fireAllClients is server only")
	local remote = getRemote(name) :: RemoteEvent
	remote:FireAllClients(...)
end

--- Fires to a specific set of players. Used for crew-scoped traffic so an
--- expedition never leaks state to players in the lobby.
function Net.fireClients(name: string, players: { Player }, ...: any)
	assert(IS_SERVER, "Net.fireClients is server only")
	local remote = getRemote(name) :: RemoteEvent
	for _, player in players do
		if player.Parent then
			remote:FireClient(player, ...)
		end
	end
end

-- Client API ---------------------------------------------------------------

function Net.fireServer(name: string, ...: any)
	assert(not IS_SERVER, "Net.fireServer is client only")
	local remote = getRemote(name) :: RemoteEvent
	remote:FireServer(...)
end

--- Client-to-server invoke. Wrapped in pcall because a server shutdown mid
--- call raises on the client, and no UI should break because of that.
function Net.invokeServer(name: string, ...: any): any
	assert(not IS_SERVER, "Net.invokeServer is client only")
	local remote = getRemote(name) :: RemoteFunction
	local ok, result = pcall(function(...)
		return remote:InvokeServer(...)
	end, ...)
	if not ok then
		log.warn(string.format("invoke '%s' failed: %s", name, tostring(result)))
		return { ok = false, error = "UNAVAILABLE" }
	end
	return result
end

function Net.onClientEvent(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "Net.onClientEvent is client only")
	local remote = getRemote(name) :: RemoteEvent
	return remote.OnClientEvent:Connect(function(...)
		local ok, err = Protect.call(handler, ...)
		if not ok then
			log.error(string.format("client handler '%s' failed: %s", name, tostring(err)))
		end
	end)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Protect</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Protect
	-------
	A typed pcall.

	Luau types pcall as returning only the success flag when the callee is
	declared to return nothing, which discards the error message. Every service
	in this project wants the (ok, err) pair, so the cast lives here once
	instead of being repeated in every file that needs it.

	Behaviour is exactly pcall's; this is a typing convenience, not a wrapper
	with its own semantics.
]]

local Protect = {}

Protect.call = (pcall :: any) :: (fn: (...any) -> ...any, ...any) -> (boolean, any)

--- Runs `fn` and logs a failure through `onError` instead of propagating it.
--- Used where a failure must never abort a loop, such as per-player ticks.
function Protect.tryOr(fn: (...any) -> ...any, onError: (string) -> (), ...: any): boolean
	local ok, err = Protect.call(fn, ...)
	if not ok then
		onError(tostring(err))
	end
	return ok
end

return Protect
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter
	-----------
	Token-bucket limiter guarding every server-bound remote. One bucket exists
	per (owner, limiter) pair and is discarded when the player leaves.

	Bursts are allowed up to `capacity`; sustained rate is `refillPerSecond`.
	That shape suits gameplay input: a player may legitimately fire three shots
	in a moment, but not three hundred in a minute.
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

type Bucket = { tokens: number, updated: number }

export type RateLimiter = typeof(setmetatable(
	{} :: {
		_capacity: number,
		_refill: number,
		_buckets: { [any]: Bucket },
	},
	RateLimiter
))

function RateLimiter.new(capacity: number, refillPerSecond: number): RateLimiter
	assert(capacity > 0, "capacity must be positive")
	assert(refillPerSecond > 0, "refillPerSecond must be positive")
	return setmetatable({
		_capacity = capacity,
		_refill = refillPerSecond,
		_buckets = {},
	}, RateLimiter)
end

--- Returns true when the caller may proceed, consuming one token.
function RateLimiter.check(self: RateLimiter, owner: any): boolean
	local now = os.clock()
	local bucket = self._buckets[owner]
	if not bucket then
		bucket = { tokens = self._capacity, updated = now }
		self._buckets[owner] = bucket
	else
		local elapsed = now - bucket.updated
		bucket.updated = now
		bucket.tokens = math.min(self._capacity, bucket.tokens + elapsed * self._refill)
	end
	local resolved = bucket :: Bucket
	if resolved.tokens >= 1 then
		resolved.tokens -= 1
		return true
	end
	return false
end

--- Whole tokens remaining. Used by admin tooling to inspect suspected abuse.
function RateLimiter.remaining(self: RateLimiter, owner: any): number
	local bucket = self._buckets[owner]
	if not bucket then
		return self._capacity
	end
	local elapsed = os.clock() - bucket.updated
	return math.floor(math.min(self._capacity, bucket.tokens + elapsed * self._refill))
end

function RateLimiter.reset(self: RateLimiter, owner: any)
	self._buckets[owner] = nil
end

function RateLimiter.clear(self: RateLimiter)
	table.clear(self._buckets)
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Signal
	------
	Lightweight event implementation used across LAST SIGNAL.

	Why not BindableEvent: BindableEvents serialise their arguments, which breaks
	table identity and drops metatables. Every internal event in this project
	passes real Lua values, so a pure-Lua signal is both faster and safer.

	Handlers run on pooled coroutines (matching RBXScriptSignal semantics) so a
	single throwing listener can never prevent the others from running.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Wait: (self: Signal<T...>) -> T...,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
	Destroy: (self: Signal<T...>) -> (),
}

local Connection = {}
Connection.__index = Connection

local Signal = {}
Signal.__index = Signal

-- Pool of parked coroutines. Reusing them avoids one coroutine allocation per
-- fire, which matters for high-frequency signals such as the world tick.
local freeThread: thread? = nil

local function runHandler(fn, ...)
	local thread = freeThread
	freeThread = nil
	fn(...)
	freeThread = thread
end

local function threadLoop()
	while true do
		runHandler(coroutine.yield())
	end
end

local function spawnHandler(fn, ...)
	if not freeThread then
		local created = coroutine.create(threadLoop)
		freeThread = created
		task.spawn(created)
	end
	task.spawn(freeThread :: thread, fn, ...)
end

function Connection.new(signal: any, fn: any): any
	return setmetatable({
		Connected = true,
		_signal = signal,
		_fn = fn,
		_next = nil,
	}, Connection)
end

function Connection.Disconnect(self: any)
	if not self.Connected then
		return
	end
	self.Connected = false

	local signal = self._signal
	if signal then
		if signal._head == self then
			signal._head = self._next
		else
			local prev = signal._head
			while prev and prev._next ~= self do
				prev = prev._next
			end
			if prev then
				prev._next = self._next
			end
		end
	end
	self._signal = nil
	self._fn = nil
end

function Signal.Connect(self: any, fn)
	assert(type(fn) == "function", "Signal:Connect expects a function")
	local connection = Connection.new(self, fn)
	connection._next = self._head
	self._head = connection
	return connection
end

function Signal.Once(self: any, fn)
	assert(type(fn) == "function", "Signal:Once expects a function")
	local connection
	connection = self:Connect(function(...)
		if connection.Connected then
			connection:Disconnect()
		end
		fn(...)
	end)
	return connection
end

function Signal.Wait(self: any)
	local waiting = coroutine.running()
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		task.spawn(waiting, ...)
	end)
	return coroutine.yield()
end

function Signal.Fire(self: any, ...)
	local node = self._head
	while node do
		-- Cache the next node first: a handler may disconnect itself.
		local nextNode = node._next
		if node.Connected then
			spawnHandler(node._fn, ...)
		end
		node = nextNode
	end
end

function Signal.DisconnectAll(self: any)
	local node = self._head
	while node do
		local nextNode = node._next
		node.Connected = false
		node._signal = nil
		node._fn = nil
		node = nextNode
	end
	self._head = nil
end

function Signal.Destroy(self: any)
	self:DisconnectAll()
end

local function newSignal<T...>(): Signal<T...>
	return (setmetatable({ _head = nil }, Signal) :: any) :: Signal<T...>
end

return {
	new = newSignal,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Spring
	------
	Critically-damped-ish spring used for camera sway, weapon recoil recovery,
	HUD meter motion and the cab needle gauges.

	Framerate independent: step() integrates with the real delta time, so a
	120 fps client and a 30 fps phone settle at the same rate. This matters
	because the same spring drives recoil, which affects aim.
]]

local Spring = {}
Spring.__index = Spring

export type Spring = typeof(setmetatable(
	{} :: {
		position: number,
		velocity: number,
		target: number,
		stiffness: number,
		damping: number,
	},
	Spring
))

function Spring.new(initial: number, stiffness: number?, damping: number?): Spring
	return setmetatable({
		position = initial,
		velocity = 0,
		target = initial,
		stiffness = stiffness or 90,
		damping = damping or 16,
	}, Spring)
end

function Spring.setTarget(self: Spring, target: number)
	self.target = target
end

--- Adds an instantaneous velocity change, used for recoil kicks and impacts.
function Spring.impulse(self: Spring, amount: number)
	self.velocity += amount
end

function Spring.step(self: Spring, deltaTime: number): number
	-- Sub-stepping keeps a stiff spring stable when a frame hitches. Without
	-- this, a 200 ms stall makes recoil springs explode.
	local remaining = math.min(deltaTime, 0.25)
	local maxStep = 1 / 120
	while remaining > 0 do
		local step = math.min(remaining, maxStep)
		remaining -= step
		local displacement = self.position - self.target
		local acceleration = -self.stiffness * displacement - self.damping * self.velocity
		self.velocity += acceleration * step
		self.position += self.velocity * step
	end
	return self.position
end

function Spring.reset(self: Spring, value: number)
	self.position = value
	self.velocity = 0
	self.target = value
end

--- Three-axis spring for camera and weapon offsets.
local Vector3Spring = {}
Vector3Spring.__index = Vector3Spring

export type Vector3Spring = typeof(setmetatable(
	{} :: { x: Spring, y: Spring, z: Spring },
	Vector3Spring
))

function Spring.vector3(initial: Vector3, stiffness: number?, damping: number?): Vector3Spring
	return setmetatable({
		x = Spring.new(initial.X, stiffness, damping),
		y = Spring.new(initial.Y, stiffness, damping),
		z = Spring.new(initial.Z, stiffness, damping),
	}, Vector3Spring)
end

function Vector3Spring.setTarget(self: Vector3Spring, target: Vector3)
	self.x:setTarget(target.X)
	self.y:setTarget(target.Y)
	self.z:setTarget(target.Z)
end

function Vector3Spring.impulse(self: Vector3Spring, amount: Vector3)
	self.x:impulse(amount.X)
	self.y:impulse(amount.Y)
	self.z:impulse(amount.Z)
end

function Vector3Spring.step(self: Vector3Spring, deltaTime: number): Vector3
	return Vector3.new(self.x:step(deltaTime), self.y:step(deltaTime), self.z:step(deltaTime))
end

function Vector3Spring.reset(self: Vector3Spring, value: Vector3)
	self.x:reset(value.X)
	self.y:reset(value.Y)
	self.z:reset(value.Z)
end

--- Exponential smoothing helper for values that do not need spring overshoot,
--- such as fog density and audio gain. Also framerate independent.
function Spring.damp(current: number, target: number, smoothing: number, deltaTime: number): number
	local alpha = 1 - math.exp(-deltaTime / math.max(1e-4, smoothing))
	return current + (target - current) * alpha
end

return Spring
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TableUtil
	---------
	Table helpers used by the data layer, registries and UI. Deliberately small:
	every function here is used by production code in this project.
]]

local TableUtil = {}

--- Deep copy. Cycles are preserved via a seen-map so copying a profile that
--- references shared sub-tables cannot loop forever.
function TableUtil.deepCopy(source: any, _seen: { [any]: any }?): any
	if type(source) ~= "table" then
		return source
	end
	local seen = _seen or {}
	if seen[source] then
		return seen[source]
	end
	local copy = {}
	seen[source] = copy
	for key, value in source do
		copy[TableUtil.deepCopy(key, seen)] = TableUtil.deepCopy(value, seen)
	end
	return copy
end

--- Fills in missing keys from `template` without touching values the player
--- already has. This is how new save fields reach existing players without a
--- migration step, and it never clobbers real progress.
function TableUtil.reconcile(target: { [any]: any }, template: { [any]: any }): { [any]: any }
	local result: { [any]: any } = {}
	for key, templateValue in template do
		local targetValue = target[key]
		if targetValue == nil then
			result[key] = TableUtil.deepCopy(templateValue)
		elseif type(templateValue) == "table" and type(targetValue) == "table" then
			-- Arrays are owned wholesale by the save file; only maps merge.
			if #templateValue > 0 then
				result[key] = targetValue
			else
				result[key] = TableUtil.reconcile(targetValue, templateValue)
			end
		else
			result[key] = targetValue
		end
	end
	-- Preserve keys the template no longer knows about, so a rolled-back build
	-- cannot destroy data written by a newer one.
	for key, value in target do
		if result[key] == nil then
			result[key] = value
		end
	end
	return result
end

function TableUtil.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

function TableUtil.keys(t: { [any]: any }): { any }
	local out = {}
	for key in t do
		table.insert(out, key)
	end
	return out
end

function TableUtil.values(t: { [any]: any }): { any }
	local out = {}
	for _, value in t do
		table.insert(out, value)
	end
	return out
end

function TableUtil.find(list: { any }, predicate: (any, number) -> boolean): (any?, number?)
	for index, value in list do
		if predicate(value, index) then
			return value, index
		end
	end
	return nil, nil
end

function TableUtil.filter(list: { any }, predicate: (any, number) -> boolean): { any }
	local out = {}
	for index, value in list do
		if predicate(value, index) then
			table.insert(out, value)
		end
	end
	return out
end

function TableUtil.map(list: { any }, transform: (any, number) -> any): { any }
	local out = table.create(#list)
	for index, value in list do
		out[index] = transform(value, index)
	end
	return out
end

function TableUtil.shuffle(list: { any }, rng: Random?): { any }
	local random = rng or Random.new()
	local out = table.clone(list)
	for i = #out, 2, -1 do
		local j = random:NextInteger(1, i)
		out[i], out[j] = out[j], out[i]
	end
	return out
end

--- Weighted pick. `weightOf` must return a non-negative number.
function TableUtil.weightedPick(list: { any }, weightOf: (any) -> number, rng: Random?): any?
	local total = 0
	for _, item in list do
		total += math.max(0, weightOf(item))
	end
	if total <= 0 then
		return nil
	end
	local roll = (rng or Random.new()):NextNumber() * total
	for _, item in list do
		roll -= math.max(0, weightOf(item))
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

--- Recursively freezes a table. Registries are frozen at load so a bug in one
--- system cannot mutate shared definitions used by every other system.
function TableUtil.deepFreeze(t: any): any
	if type(t) ~= "table" then
		return t
	end
	for _, value in t do
		if type(value) == "table" and not table.isfrozen(value) then
			TableUtil.deepFreeze(value)
		end
	end
	if not table.isfrozen(t) then
		table.freeze(t)
	end
	return t
end

return TableUtil
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Registry</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CosmeticRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CosmeticRegistry
	----------------
	Every appearance item: lamps, outfits, equipment finishes and crew patches.

	Nothing in this file changes a gameplay number. Lamp cosmetics may tint the
	beam, but beam range, angle and battery drain all come from Balance and are
	identical for every lamp, so no purchase makes the dark easier to see in.

	Sources:
	  default  owned by everyone
	  credits  bought with the free currency
	  robux    bought with Robux, keyed to Config.Monetization
	  quest    granted by a milestone or weekly quest
	  event    granted by a live event, and limited to its run
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

local C = Color3.fromRGB

export type CosmeticSlot = "lamp" | "outfit" | "finish" | "patch"
export type CosmeticSource = "default" | "credits" | "robux" | "quest" | "event"

export type CosmeticDef = {
	id: string,
	slot: CosmeticSlot,
	name: string,
	description: string,
	source: CosmeticSource,
	creditCost: number?,
	productKey: string?,
	questId: string?,
	eventId: string?,
	-- Slot-specific appearance data, read by the equipment and character
	-- builders. Colours only; no geometry is gated behind a purchase in a way
	-- that would change a silhouette enough to affect gameplay readability.
	body: Color3?,
	accent: Color3?,
	material: Enum.Material?,
	beamTint: Color3?,
	-- Patches are drawn on the crew jacket and shown beside your name on the
	-- crew panel, which is where most of their value actually sits.
	glyph: string?,
	rarity: number, -- 1 common .. 4 limited
}

local function cosmetic(def: CosmeticDef): CosmeticDef
	return def
end

local COSMETICS: { [string]: CosmeticDef } = {

	--------------------------------------------------------------------
	-- Lamps
	--------------------------------------------------------------------
	lantern_standard = cosmetic({
		id = "lantern_standard",
		slot = "lamp",
		name = "Issue Lamp",
		description = "Standard crew lamp. Scuffed plastic, taped switch.",
		source = "default",
		body = C(64, 66, 70),
		accent = C(180, 182, 186),
		material = Enum.Material.SmoothPlastic,
		beamTint = C(255, 243, 214),
		rarity = 1,
	}),
	lantern_steel = cosmetic({
		id = "lantern_steel",
		slot = "lamp",
		name = "Steel Lamp",
		description = "Heavier, older, and it has survived more than you have.",
		source = "credits",
		creditCost = 1200,
		body = C(96, 100, 106),
		accent = C(140, 144, 150),
		material = Enum.Material.Metal,
		beamTint = C(250, 246, 232),
		rarity = 1,
	}),
	lantern_operator = cosmetic({
		id = "lantern_operator",
		slot = "lamp",
		name = "Operator's Lamp",
		description = "Found at Ward Hill. Somebody kept it working for eleven days.",
		source = "quest",
		questId = "m_archive_full",
		body = C(58, 62, 58),
		accent = C(178, 150, 84),
		material = Enum.Material.Metal,
		beamTint = C(255, 236, 198),
		rarity = 3,
	}),
	lantern_brass = cosmetic({
		id = "lantern_brass",
		slot = "lamp",
		name = "Brass Lamp",
		description = "Polished brass with a fluted lens.",
		source = "robux",
		productKey = "lantern_kit",
		body = C(172, 138, 70),
		accent = C(206, 178, 112),
		material = Enum.Material.Metal,
		beamTint = C(255, 232, 186),
		rarity = 2,
	}),
	lantern_dispatcher = cosmetic({
		id = "lantern_dispatcher",
		slot = "lamp",
		name = "Dispatcher's Lamp",
		description = "Control room issue, with a warm amber lens.",
		source = "robux",
		productKey = "lantern_kit",
		body = C(52, 56, 62),
		accent = C(196, 152, 58),
		material = Enum.Material.Metal,
		beamTint = C(255, 222, 168),
		rarity = 2,
	}),
	lantern_field = cosmetic({
		id = "lantern_field",
		slot = "lamp",
		name = "Field Lamp",
		description = "Canvas-wrapped, rubber bumpered, built to be dropped.",
		source = "robux",
		productKey = "lantern_kit",
		body = C(84, 88, 72),
		accent = C(58, 60, 54),
		material = Enum.Material.Fabric,
		beamTint = C(252, 244, 220),
		rarity = 2,
	}),
	lantern_hooded = cosmetic({
		id = "lantern_hooded",
		slot = "lamp",
		name = "Hooded Lamp",
		description = "A deep hood that throws a tighter, colder pool of light.",
		source = "robux",
		productKey = "lantern_kit",
		body = C(40, 42, 46),
		accent = C(120, 126, 134),
		material = Enum.Material.Metal,
		beamTint = C(230, 240, 255),
		rarity = 2,
	}),
	lantern_signalman = cosmetic({
		id = "lantern_signalman",
		slot = "lamp",
		name = "Signalman's Lamp",
		description = "Three-aspect hand lamp with a red and green shutter.",
		source = "robux",
		productKey = "vip_crew",
		body = C(46, 50, 48),
		accent = C(180, 60, 52),
		material = Enum.Material.Metal,
		beamTint = C(255, 238, 206),
		rarity = 3,
	}),
	lantern_sleeper = cosmetic({
		id = "lantern_sleeper",
		slot = "lamp",
		name = "Sleeper Lamp",
		description = "Maroon enamel, from a service that stopped running long ago.",
		source = "event",
		eventId = "lost_conductor",
		body = C(92, 40, 46),
		accent = C(186, 162, 116),
		material = Enum.Material.Metal,
		beamTint = C(255, 226, 186),
		rarity = 4,
	}),

	--------------------------------------------------------------------
	-- Outfits
	--------------------------------------------------------------------
	outfit_crew = cosmetic({
		id = "outfit_crew",
		slot = "outfit",
		name = "Crew Coveralls",
		description = "What everyone starts in. Oil-stained and warm.",
		source = "default",
		body = C(66, 70, 64),
		accent = C(196, 152, 58),
		material = Enum.Material.Fabric,
		rarity = 1,
	}),
	outfit_yard = cosmetic({
		id = "outfit_yard",
		slot = "outfit",
		name = "Yard Jacket",
		description = "Heavy donkey jacket with reflective shoulders.",
		source = "credits",
		creditCost = 1800,
		body = C(44, 46, 50),
		accent = C(210, 206, 190),
		material = Enum.Material.Fabric,
		rarity = 1,
	}),
	outfit_conductor = cosmetic({
		id = "outfit_conductor",
		slot = "outfit",
		name = "Conductor's Coat",
		description = "Double-breasted, brass-buttoned, entirely impractical out here.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(38, 42, 54),
		accent = C(186, 152, 78),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),
	outfit_engineer = cosmetic({
		id = "outfit_engineer",
		slot = "outfit",
		name = "Long-Haul Engineer",
		description = "Quilted liner, tool loops, and a lamp clip on the chest.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(72, 62, 52),
		accent = C(140, 132, 118),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),
	outfit_surveyor = cosmetic({
		id = "outfit_surveyor",
		slot = "outfit",
		name = "Surveyor",
		description = "Waxed cotton and a map case that still has maps in it.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(86, 80, 58),
		accent = C(120, 104, 74),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),
	outfit_medic = cosmetic({
		id = "outfit_medic",
		slot = "outfit",
		name = "Line Medic",
		description = "White armband, deep pockets, and rather a lot of blood that is not yours.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(58, 62, 66),
		accent = C(218, 214, 206),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),
	outfit_lineman = cosmetic({
		id = "outfit_lineman",
		slot = "outfit",
		name = "Lineman",
		description = "Climbing harness, rubber gauntlets, insulated boots.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(52, 58, 48),
		accent = C(178, 148, 52),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),
	outfit_forester = cosmetic({
		id = "outfit_forester",
		slot = "outfit",
		name = "Forester",
		description = "Oiled wool and a collar you can pull right up.",
		source = "robux",
		productKey = "crew_outfits",
		body = C(48, 58, 46),
		accent = C(96, 74, 52),
		material = Enum.Material.Fabric,
		rarity = 2,
	}),

	--------------------------------------------------------------------
	-- Equipment finishes
	--------------------------------------------------------------------
	finish_standard = cosmetic({
		id = "finish_standard",
		slot = "finish",
		name = "Works Finish",
		description = "Factory paint, mostly worn off.",
		source = "default",
		body = C(96, 100, 106),
		material = Enum.Material.Metal,
		rarity = 1,
	}),
	finish_brass = cosmetic({
		id = "finish_brass",
		slot = "finish",
		name = "Worn Brass",
		description = "Brass fittings, handled until they shine.",
		source = "robux",
		productKey = "tool_finishes",
		body = C(176, 142, 74),
		material = Enum.Material.Metal,
		rarity = 2,
	}),
	finish_gunmetal = cosmetic({
		id = "finish_gunmetal",
		slot = "finish",
		name = "Gunmetal",
		description = "Deep blued steel that eats the light.",
		source = "robux",
		productKey = "tool_finishes",
		body = C(52, 54, 60),
		material = Enum.Material.Metal,
		rarity = 2,
	}),
	finish_enamel = cosmetic({
		id = "finish_enamel",
		slot = "finish",
		name = "Depot Enamel",
		description = "Thick green enamel, chipped down to the primer.",
		source = "robux",
		productKey = "tool_finishes",
		body = C(56, 76, 62),
		material = Enum.Material.SmoothPlastic,
		rarity = 2,
	}),

	--------------------------------------------------------------------
	-- Patches
	--------------------------------------------------------------------
	patch_departure = cosmetic({
		id = "patch_departure",
		slot = "patch",
		name = "0217",
		description = "For completing your first expedition.",
		source = "quest",
		questId = "m_first_run",
		accent = C(196, 152, 58),
		glyph = "numerals",
		rarity = 1,
	}),
	patch_archivist = cosmetic({
		id = "patch_archivist",
		slot = "patch",
		name = "Archivist",
		description = "For recovering twenty records in a week.",
		source = "quest",
		questId = "w_archive",
		accent = C(150, 160, 180),
		glyph = "page",
		rarity = 2,
	}),
	patch_signalman_earned = cosmetic({
		id = "patch_signalman_earned",
		slot = "patch",
		name = "Never Fooled",
		description = "For completing the chapter without following a single false transmission.",
		source = "quest",
		questId = "m_never_fooled",
		accent = C(180, 60, 52),
		glyph = "aspect",
		rarity = 3,
	}),
	patch_signalman = cosmetic({
		id = "patch_signalman",
		slot = "patch",
		name = "Signalman",
		description = "Comes with the Signalman's Pass.",
		source = "robux",
		productKey = "vip_crew",
		accent = C(196, 152, 58),
		glyph = "aspect",
		rarity = 2,
	}),
	patch_conductor = cosmetic({
		id = "patch_conductor",
		slot = "patch",
		name = "Lost Conductor",
		description = "Awarded during the Lost Conductor. Not available afterwards.",
		source = "event",
		eventId = "lost_conductor",
		accent = C(186, 162, 116),
		glyph = "ticket",
		rarity = 4,
	}),
}

--------------------------------------------------------------------------

local CosmeticRegistry = {}

CosmeticRegistry.Cosmetics = TableUtil.deepFreeze(COSMETICS) :: { [string]: CosmeticDef }

CosmeticRegistry.DefaultsBySlot = {
	lamp = "lantern_standard",
	outfit = "outfit_crew",
	finish = "finish_standard",
	patch = "",
}

function CosmeticRegistry.get(id: string): CosmeticDef?
	return COSMETICS[id]
end

function CosmeticRegistry.bySlot(slot: CosmeticSlot): { CosmeticDef }
	local out: { CosmeticDef } = {}
	for _, def in COSMETICS do
		if def.slot == slot then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a, b)
		if a.rarity ~= b.rarity then
			return a.rarity < b.rarity
		end
		return a.id < b.id
	end)
	return out
end

--- Everything purchasable with credits, for the free side of the shop.
function CosmeticRegistry.creditPurchasable(): { CosmeticDef }
	local out: { CosmeticDef } = {}
	for _, def in COSMETICS do
		if def.source == "credits" and (def.creditCost or 0) > 0 then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a, b)
		return (a.creditCost or 0) < (b.creditCost or 0)
	end)
	return out
end

--- All cosmetics granted by a given Robux product, used when a receipt is
--- processed so one purchase reliably grants its whole bundle.
function CosmeticRegistry.grantedByProduct(productKey: string): { string }
	local out: { string } = {}
	for id, def in COSMETICS do
		if def.productKey == productKey then
			table.insert(out, id)
		end
	end
	table.sort(out)
	return out
end

--- Default ownership handed to a brand new profile.
function CosmeticRegistry.defaultOwned(): { [string]: boolean }
	local owned: { [string]: boolean } = {}
	for id, def in COSMETICS do
		if def.source == "default" then
			owned[id] = true
		end
	end
	return owned
end

return CosmeticRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">EventRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EventRegistry
	-------------
	Live events. One complete event ships with the game: The Lost Conductor.

	The point of this file is that a future event is data, not code. An event
	declares its window, its spawns, its collectible, its rewards and its
	encounter; EventService reads that and runs it. Adding the next event means
	adding a table here, not rewriting the expedition.

	Safety properties EventService guarantees for every event defined here:
	  - Claims are idempotent. Reconnecting, or clicking twice, cannot double
	    grant a reward.
	  - Progress earned during an event is never removed when it ends. Only the
	    ability to earn more stops.
	  - An event stopped early by an administrator settles outstanding claims
	    before it closes.
	  - An expired event still lets a player claim rewards they already earned,
	    for a grace period, so ending mid-expedition is not a punishment.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

export type EventReward = {
	threshold: number, -- tokens required
	credits: number?,
	xp: number?,
	cosmetic: string?,
	livery: string?,
	title: string,
	description: string,
}

export type EventDef = {
	id: string,
	name: string,
	tagline: string,
	description: string,

	-- Window. Unix seconds. `startsAt = 0` means "not scheduled": the event is
	-- fully built but dormant, and an administrator turns it on.
	startsAt: number,
	endsAt: number,
	-- After endsAt, players may still claim already-earned rewards for this
	-- long. Nothing earned is lost by an expedition running past the deadline.
	claimGraceSeconds: number,

	-- Token collected during the event.
	tokenItem: string,
	tokenName: string,
	-- How many spawn per station, before crew scaling.
	tokensPerStation: number,
	-- Chance a station also hosts the encounter.
	encounterChance: number,

	-- The encounter this event adds.
	encounter: {
		id: string,
		name: string,
		description: string,
		-- Behaviour key handled by EventService; original to this event.
		behaviour: string,
		params: { [string]: any },
	}?,

	rewards: { EventReward },

	-- Eligibility. Kept deliberately loose: gating a limited cosmetic behind a
	-- level requirement punishes new players for arriving during the event.
	minLevel: number,
}

--------------------------------------------------------------------------

local EVENTS: { [string]: EventDef } = {
	lost_conductor = {
		id = "lost_conductor",
		name = "The Lost Conductor",
		tagline = "A service that never ran is still collecting tickets.",
		description = "Punched tickets have started appearing along the line, for a sleeper service that was cancelled before it ever left the yard. Somebody is still walking the train checking them. Collect the tickets, work out where the service was going, and decide whether to let him finish his round.",

		startsAt = 0, -- dormant until scheduled; see docs/EVENTS.md
		endsAt = 0,
		claimGraceSeconds = 7 * 86400,

		tokenItem = "conductor_ticket",
		tokenName = "Punched Ticket",
		tokensPerStation = 3,
		encounterChance = 0.45,

		encounter = {
			id = "the_conductor",
			name = "The Conductor",
			description = "He walks the length of the train, from the last carriage to the cab, checking tickets. He is not hostile and he cannot be stopped. If he reaches a player who is holding no ticket, that player's lamp goes out and stays out until the next station.",
			behaviour = "patrol_inspector",
			params = {
				-- Walks the consist end to end at a fixed, unhurried pace.
				speed = 6,
				-- Appears at a random point during travel, never during a
				-- station stop and never during the cinematic.
				spawnDuringTravelOnly = true,
				-- Holding a ticket makes the interaction safe and consumes it.
				appeasedByToken = true,
				-- The penalty is inconvenience, not damage. An event encounter
				-- that can kill you turns a limited cosmetic into a tax.
				penalty = "lamp_out_until_station",
				dealsDamage = false,
				-- He can be avoided entirely by being in a different carriage.
				avoidable = true,
				-- One appearance per travel leg, maximum.
				maxPerLeg = 1,
			},
		},

		rewards = {
			{
				threshold = 5,
				credits = 400,
				xp = 300,
				title = "First Punch",
				description = "Five tickets collected.",
			},
			{
				threshold = 15,
				credits = 900,
				xp = 700,
				cosmetic = "patch_conductor",
				title = "Full Round",
				description = "Fifteen tickets. The conductor's patch.",
			},
			{
				threshold = 30,
				credits = 1600,
				xp = 1200,
				cosmetic = "lantern_sleeper",
				title = "Sleeper Service",
				description = "Thirty tickets. The maroon sleeper lamp.",
			},
			{
				threshold = 50,
				credits = 2600,
				xp = 2000,
				livery = "livery_lostconductor",
				title = "The Whole Service",
				description = "Fifty tickets. The Sleeper Maroon livery for any train you own.",
			},
		},

		minLevel = 0,
	},
}

--------------------------------------------------------------------------

local EventRegistry = {}

EventRegistry.Events = TableUtil.deepFreeze(EVENTS) :: { [string]: EventDef }

function EventRegistry.get(id: string): EventDef?
	return EVENTS[id]
end

function EventRegistry.all(): { EventDef }
	local out: { EventDef } = {}
	for _, def in EVENTS do
		table.insert(out, def)
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

--- Is the event accepting new progress right now?
function EventRegistry.isActive(def: EventDef, now: number?): boolean
	local t = now or os.time()
	if def.startsAt <= 0 or def.endsAt <= 0 then
		return false
	end
	return t >= def.startsAt and t < def.endsAt
end

--- Can a player still claim rewards they already earned?
function EventRegistry.isClaimable(def: EventDef, now: number?): boolean
	local t = now or os.time()
	if def.startsAt <= 0 then
		return false
	end
	return t >= def.startsAt and t < def.endsAt + def.claimGraceSeconds
end

--- Rewards a token count has unlocked, in threshold order.
function EventRegistry.unlockedRewards(def: EventDef, tokens: number): { EventReward }
	local out: { EventReward } = {}
	for _, reward in def.rewards do
		if tokens >= reward.threshold then
			table.insert(out, reward)
		end
	end
	table.sort(out, function(a, b)
		return a.threshold < b.threshold
	end)
	return out
end

--- The next reward a player is working towards, for the progress bar.
function EventRegistry.nextReward(def: EventDef, tokens: number): EventReward?
	local best: EventReward? = nil
	for _, reward in def.rewards do
		if tokens < reward.threshold then
			if not best or reward.threshold < (best :: EventReward).threshold then
				best = reward
			end
		end
	end
	return best
end

--- Any event currently live. There is deliberately no support for two events
--- running at once: overlapping token economies confuse players and make the
--- reward panel unreadable.
function EventRegistry.activeEvent(now: number?): EventDef?
	for _, def in EVENTS do
		if EventRegistry.isActive(def, now) then
			return def
		end
	end
	return nil
end

return EventRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ItemRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ItemRegistry
	------------
	Every carryable object in LAST SIGNAL.

	Design rule followed here: a small number of items that each change a
	decision, rather than a long catalogue of near-duplicates. Each entry below
	answers "what would a player give up to carry this?".

	Weight is the real constraint. Slots exist so the grid reads clearly, but
	weight is what forces the interesting choice between a jerry can and a
	medical kit on the walk back.

	`model` describes the procedural build used by the world builders and the
	dropped-item spawner. Items are recognisable by silhouette and material; no
	item in this project relies on a floating name board to be identified.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

export type ItemCategory = "medical" | "power" | "fuel" | "tool" | "component" | "ammo" | "consumable" | "story" | "weapon"

export type ModelSpec = {
	shape: string, -- interpreted by BuildKit.buildItemModel
	size: Vector3,
	colour: Color3,
	material: Enum.Material,
	accent: Color3?,
	emissive: number?,
}

export type ItemDef = {
	id: string,
	name: string,
	category: ItemCategory,
	description: string,
	-- Short line shown on the proximity prompt, never a floating label.
	promptVerb: string,
	weight: number,
	stackSize: number,
	-- Items marked essential cannot be destroyed and are returned to the train
	-- supply rack instead of the floor when dropped inside a carriage.
	essential: boolean,
	-- Can be placed in one of the five quick slots.
	quickUsable: boolean,
	useSeconds: number?,
	model: ModelSpec,
	-- Free-form payload consumed by InventoryService and the interaction system.
	effect: { [string]: any }?,
	-- Relative frequency when a loot table asks for a random item of a tier.
	lootWeight: number,
	lootTier: number, -- 1 common, 2 uncommon, 3 rare
	icon: string?, -- vector glyph key drawn by the UI kit, not an image asset
}

local function item(def: ItemDef): ItemDef
	return def
end

local C = Color3.fromRGB

local ITEMS: { [string]: ItemDef } = {

	--------------------------------------------------------------------
	-- Medical
	--------------------------------------------------------------------
	bandage = item({
		id = "bandage",
		name = "Field Dressing",
		category = "medical",
		description = "Stops bleeding and restores a little health. Quick to apply, which matters more than the amount it heals.",
		promptVerb = "Take dressing",
		weight = 0.3,
		stackSize = 6,
		essential = false,
		quickUsable = true,
		useSeconds = 2.2,
		model = { shape = "roll", size = Vector3.new(0.45, 0.3, 0.45), colour = C(226, 220, 205), material = Enum.Material.Fabric },
		effect = { heal = 22, stopBleed = true },
