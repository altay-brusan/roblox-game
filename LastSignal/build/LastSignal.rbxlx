		kind = "firearm",
		description = "Not really a weapon. Puts burning light exactly where you need it, at range, and the Signal-Eater will not walk through it.",
		damage = 8,
		range = 160,
		fireInterval = 1.6,
		ammoType = "flare",
		magazineSize = 1,
		reloadStyle = "single",
		reloadSeconds = 1.9,
