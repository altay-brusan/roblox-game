		quickUsable = true,
		useSeconds = 1.4,
		model = { shape = "vial", size = Vector3.new(0.22, 0.6, 0.22), colour = C(150, 198, 172), material = Enum.Material.Glass, emissive = 0.15 },
		effect = { stamina = 100, staminaBoostSeconds = 25, crashSeconds = 12 },
