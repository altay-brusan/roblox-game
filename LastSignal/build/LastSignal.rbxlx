--------------------------------------------------------------------------
-- Travel events between stations
--------------------------------------------------------------------------

-- These are not stops. They happen while the train is moving, at a distance
-- along the track, and they exist so the travel legs are not dead time.
export type TravelEventDef = {
	id: string,
	distance: number,
	name: string,
	description: string,
	kind: string,
	params: { [string]: any },
}

local TRAVEL_EVENTS: { TravelEventDef } = {
	{
		id = "deer_crossing",
		distance = 2900,
		name = "Something on the line",
		description = "Shapes crossing the track ahead. Braking is optional; hitting them costs condition.",
		kind = "obstacle",
		params = { conditionCost = 6, brakingWindow = 7, harmless = true },
	},
	{
		id = "service_tunnel",
		distance = 5600,
		name = "Ashcombe Tunnel",
		description = "Nine hundred studs of unlit tunnel. Interior lighting only, radio cuts out, and the carriage doors must be closed.",
		kind = "tunnel",
		params = { length = 900, radioBlackout = true, requiresDoorsClosed = true, conditionCostIfOpen = 8 },
	},
	{
		id = "overheat",
		distance = 8600,
		name = "The long grade",
		description = "A sustained climb. The engine runs hot unless coolant is applied or the throttle is eased.",
		kind = "mechanical",
		params = { gradeLength = 1400, overheatRate = 0.9, mitigations = { "coolant", "throttle_below" }, throttleBelowNotch = 5 },
	},
	{
		id = "passenger",
		distance = 11800,
		name = "Something in the last carriage",
		description = "A door that was closed is open, and the carriage is heavier than it was.",
		kind = "intruder",
		params = { carriage = -1, revealSeconds = 45 },
	},
}

--------------------------------------------------------------------------

local StationRegistry = {}

StationRegistry.Stations = TableUtil.deepFreeze(STATIONS) :: { StationDef }
StationRegistry.TravelEvents = TableUtil.deepFreeze(TRAVEL_EVENTS) :: { TravelEventDef }

function StationRegistry.count(): number
	return #STATIONS
end

function StationRegistry.byIndex(index: number): StationDef?
	return STATIONS[index]
end

function StationRegistry.byId(id: string): StationDef?
	for _, def in STATIONS do
		if def.id == id then
			return def
		end
	end
	return nil
end

--- World position of a station's origin along the track.
function StationRegistry.originFor(def: StationDef, expeditionOrigin: Vector3): Vector3
	return expeditionOrigin + Vector3.new(0, 0, -def.distance)
end

--- Travel events that fall between two track distances, in order.
function StationRegistry.travelEventsBetween(fromDistance: number, toDistance: number): { TravelEventDef }
	local out: { TravelEventDef } = {}
	for _, event in TRAVEL_EVENTS do
		if event.distance > fromDistance and event.distance <= toDistance then
			table.insert(out, event)
		end
	end
	table.sort(out, function(a, b)
		return a.distance < b.distance
	end)
	return out
end

--- Total required objectives across the chapter, used by the results screen.
function StationRegistry.totalRequiredObjectives(): number
	local total = 0
	for _, def in STATIONS do
		for _, objective in def.objectives do
			if not objective.optional then
				total += 1
			end
		end
	end
	return total
end

return StationRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TrainRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainRegistry
	-------------
	The four trains, and the liveries and interior kits that dress them.

	A variant is not a recolour. Each entry carries a `build` block that changes
	the locomotive's proportions, nose profile, bogie count, carriage count and
	carriage layout, so the trains read differently at a glance and handle
	differently in the cab. Liveries are the recolours, and they are separate.

	Handling numbers are multipliers applied on top of Balance.Train, so a
	global re-tune of train physics still affects every variant consistently.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

local C = Color3.fromRGB

export type CarriageKind = "passenger" | "supply" | "workshop" | "flat" | "guard"

export type CarriageSpec = {
	kind: CarriageKind,
	length: number,
	-- Interior fitting density; drives how much seating and storage is built.
	seats: number,
	racks: number,
	crates: number,
	-- Carriages with this flag get a working roof hatch, used for optional
	-- risky routes and for one of the station puzzles.
	roofHatch: boolean?,
}

export type TrainBuild = {
	-- Locomotive -------------------------------------------------------
	locoLength: number,
	locoWidth: number,
	locoHeight: number,
	nose: "blunt" | "raked" | "bonnet" | "armoured",
	bogies: number, -- per locomotive
	axlesPerBogie: number,
	wheelRadius: number,
	cabPosition: "front" | "centre",
	exhaustStacks: number,
	-- Exterior detail density. Higher values add more grilles, pipes,
	-- handrails and rivet strips during the procedural build.
	detailLevel: number,
	carriages: { CarriageSpec },
}

export type TrainHandling = {
	maxSpeedMultiplier: number,
	accelerationMultiplier: number,
	brakingMultiplier: number,
	fuelUseMultiplier: number,
	conditionDriftMultiplier: number,
	damageResistance: number, -- 1.0 is baseline; higher takes less condition damage
	inventoryBonusSlots: number,
	headlightRangeMultiplier: number,
}

export type TrainDef = {
	id: string,
	name: string,
	class: string,
	tagline: string,
	description: string,
	build: TrainBuild,
	handling: TrainHandling,
	defaultLivery: string,
	unlockLevel: number,
	creditCost: number,
	-- The starter must always be enough to finish the chapter. Enforced by a
	-- check in ExpeditionService, not just by intent.
	isStarter: boolean,
}

local function train(def: TrainDef): TrainDef
	return def
end

