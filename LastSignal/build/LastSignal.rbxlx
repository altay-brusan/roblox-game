		wall = C(102, 72, 48),
		floor = C(58, 42, 32),
		seat = C(96, 46, 44),
		seatMaterial = Enum.Material.Fabric,
		trim = C(186, 148, 76),
		lampColour = C(255, 214, 150),
		lampBrightness = 0.95,
		source = "robux",
		productKey = "workshop_access",
	},
	interior_surveyor = {
		id = "interior_surveyor",
		name = "Surveyor's Office",
		description = "Map tables, drafting lamps and pinned line diagrams.",
		wall = C(150, 146, 128),
		floor = C(72, 64, 54),
		seat = C(86, 74, 56),
		seatMaterial = Enum.Material.Fabric,
		trim = C(118, 104, 78),
		lampColour = C(255, 240, 206),
		lampBrightness = 1.15,
		source = "robux",
		productKey = "workshop_access",
	},
	interior_ashwood = {
		id = "interior_ashwood",
		name = "Ashwood",
		description = "Pale ash panelling and dark leather. Quiet, and slightly too clean for this line.",
		wall = C(186, 174, 152),
		floor = C(66, 58, 50),
		seat = C(48, 42, 40),
		seatMaterial = Enum.Material.Fabric,
		trim = C(148, 132, 108),
		lampColour = C(255, 236, 202),
		lampBrightness = 1.05,
		source = "robux",
		productKey = "workshop_access",
	},
} :: { [string]: InteriorDef }

--------------------------------------------------------------------------

local TrainRegistry = {}

TrainRegistry.Trains = TableUtil.deepFreeze(TRAINS) :: { [string]: TrainDef }
TrainRegistry.Liveries = TableUtil.deepFreeze(LIVERIES) :: { [string]: LiveryDef }
TrainRegistry.Interiors = TableUtil.deepFreeze(INTERIORS) :: { [string]: InteriorDef }

TrainRegistry.StarterTrainId = "warden"

function TrainRegistry.get(id: string): TrainDef?
	return TRAINS[id]
end

function TrainRegistry.getOrStarter(id: string?): TrainDef
	local def = if id then TRAINS[id] else nil
	return def or (TRAINS[TrainRegistry.StarterTrainId] :: TrainDef)
end

function TrainRegistry.getLivery(id: string?): LiveryDef
	local def = if id then LIVERIES[id] else nil
	return def or (LIVERIES.livery_depot :: LiveryDef)
end

function TrainRegistry.getInterior(id: string?): InteriorDef
	local def = if id then INTERIORS[id] else nil
	return def or (INTERIORS.interior_standard :: InteriorDef)
end

function TrainRegistry.allTrains(): { TrainDef }
	local out: { TrainDef } = {}
	for _, def in TRAINS do
		table.insert(out, def)
	end
	table.sort(out, function(a, b)
		return a.unlockLevel < b.unlockLevel
	end)
	return out
end

function TrainRegistry.allLiveries(): { LiveryDef }
	local out: { LiveryDef } = {}
	for _, def in LIVERIES do
		table.insert(out, def)
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function TrainRegistry.allInteriors(): { InteriorDef }
	local out: { InteriorDef } = {}
	for _, def in INTERIORS do
		table.insert(out, def)
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

--- Total length of a consist, used to lay out the yard and the platforms so a
--- train always fits the space built for it.
function TrainRegistry.consistLength(def: TrainDef): number
	local total = def.build.locoLength
	for _, carriage in def.build.carriages do
		total += carriage.length + 4 -- coupler gap
	end
	return total
end

return TrainRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">WeaponRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WeaponRegistry
	--------------
	Melee and firearm definitions.

	Combat in LAST SIGNAL is a pressure valve, not the main verb. Weapons exist
	so that a bad situation can be survived, not so that the forest can be
	cleared. That shows up in the numbers:

	  - Nothing here kills the Signal-Eater. Damage fills its drive-off meter.
	  - Ammunition is scarce and every firearm is loud, which raises threat.
	  - Reload times are mechanism-accurate and long enough to be a commitment.
	  - Melee costs stamina, so it competes with running away.

	Every field marked "server" is validated server-side on each shot. The
	client never decides whether a hit landed, only where it aimed.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

export type WeaponKind = "melee" | "firearm"
export type ReloadStyle = "cylinder" | "shell" | "clip" | "single" | "none"

export type WeaponDef = {
	id: string,
	name: string,
	kind: WeaponKind,
	description: string,

	damage: number, -- server authoritative
	range: number, -- server authoritative, studs
	-- Seconds between shots or swings. Server enforces with a small grace.
	fireInterval: number,

	-- Firearm only -------------------------------------------------------
	ammoType: string?,
	magazineSize: number?,
	reloadStyle: ReloadStyle,
	reloadSeconds: number?, -- whole-magazine styles
	reloadPerRoundSeconds: number?, -- shell-at-a-time styles
	pellets: number?, -- shotgun spread
	spreadDegrees: number?,
	recoilVertical: number?,
	recoilHorizontal: number?,
	aimSpreadMultiplier: number?,
	noiseRadius: number,

	-- Melee only ---------------------------------------------------------
	swingArcDegrees: number?,
	staminaCost: number?,
	-- Melee can hit more than one target in the arc; firearms cannot.
	maxTargets: number?,

	-- Handling -------------------------------------------------------------
	weight: number,
	moveSpeedMultiplier: number,
	equipSeconds: number,

	-- Presentation ---------------------------------------------------------
	model: { [string]: any },
	fireCue: string,
	dryCue: string?,
	reloadCue: string?,
	impactCue: string,
	-- Viewmodel motion, consumed by the first-person weapon controller.
	viewmodel: {
		restOffset: Vector3,
		aimOffset: Vector3,
		swayScale: number,
		bobScale: number,
		recoilKick: Vector3,
		recoilRecovery: number,
	},

	-- Availability ---------------------------------------------------------
	startingLoadout: boolean, -- selectable in the lobby loadout screen
	unlockLevel: number,
	creditCost: number,
}

local C = Color3.fromRGB

local function weapon(def: WeaponDef): WeaponDef
	return def
end

local WEAPONS: { [string]: WeaponDef } = {

	--------------------------------------------------------------------
	-- Melee
	--------------------------------------------------------------------
	wrench = weapon({
		id = "wrench",
		name = "Pipe Wrench",
		kind = "melee",
		description = "Depot issue. Slow, heavy, and it lands hard enough to buy you the two seconds you need.",
		damage = 34,
		range = 8.5,
		fireInterval = 0.95,
		reloadStyle = "none",
		noiseRadius = 55,
		swingArcDegrees = 70,
		staminaCost = 9,
		maxTargets = 1,
		weight = 3.0,
		moveSpeedMultiplier = 0.96,
		equipSeconds = 0.45,
		model = {
			shape = "wrench",
			length = 2.4,
			colour = C(96, 100, 106),
			gripColour = C(52, 44, 38),
			material = Enum.Material.Metal,
		},
		fireCue = "melee_swing",
		impactCue = "melee_hit_flesh",
		viewmodel = {
			restOffset = Vector3.new(0.85, -0.75, -1.15),
			aimOffset = Vector3.new(0.55, -0.55, -0.9),
			swayScale = 1.0,
			bobScale = 1.0,
			recoilKick = Vector3.new(-0.12, 0.05, -0.3),
			recoilRecovery = 10,
		},
		startingLoadout = true,
		unlockLevel = 0,
		creditCost = 0,
	}),
	crowbar = weapon({
		id = "crowbar",
		name = "Crowbar",
		kind = "melee",
		description = "Faster than the wrench and it opens seized doors. Less damage, more uses.",
		damage = 26,
		range = 9.0,
		fireInterval = 0.7,
		reloadStyle = "none",
		noiseRadius = 50,
		swingArcDegrees = 60,
		staminaCost = 7,
		maxTargets = 1,
		weight = 2.6,
		moveSpeedMultiplier = 0.98,
		equipSeconds = 0.35,
		model = {
			shape = "crowbar",
			length = 2.6,
			colour = C(120, 74, 56),
			gripColour = C(60, 40, 32),
			material = Enum.Material.Metal,
		},
		fireCue = "melee_swing",
		impactCue = "melee_hit_flesh",
		viewmodel = {
			restOffset = Vector3.new(0.8, -0.72, -1.1),
			aimOffset = Vector3.new(0.5, -0.52, -0.85),
			swayScale = 0.95,
			bobScale = 0.95,
			recoilKick = Vector3.new(-0.1, 0.04, -0.25),
			recoilRecovery = 12,
		},
		startingLoadout = true,
		unlockLevel = 0,
		creditCost = 0,
	}),
	axe = weapon({
		id = "axe",
		name = "Felling Axe",
		kind = "melee",
		description = "From the logging camp. Enormous damage, enormous commitment; miss and you are still swinging when it reaches you.",
		damage = 58,
		range = 9.5,
		fireInterval = 1.5,
		reloadStyle = "none",
		noiseRadius = 65,
		swingArcDegrees = 85,
		staminaCost = 16,
		maxTargets = 2,
		weight = 4.6,
		moveSpeedMultiplier = 0.9,
		equipSeconds = 0.7,
		model = {
			shape = "axe",
			length = 3.0,
			colour = C(128, 104, 72),
			headColour = C(112, 116, 120),
			material = Enum.Material.Wood,
		},
		fireCue = "melee_swing",
		impactCue = "melee_hit_flesh",
		viewmodel = {
			restOffset = Vector3.new(0.9, -0.8, -1.25),
			aimOffset = Vector3.new(0.6, -0.6, -1.0),
