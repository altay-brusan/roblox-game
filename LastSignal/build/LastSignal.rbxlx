      <Item class="LocalScript" referent="69">
        <Properties>
          <string name="Name">LastSignalClient</string>
          <string name="Source"><![CDATA[--!strict
--[[
	LAST SIGNAL - client boot
	=========================

	The only LocalScript in the project. Every controller is a ModuleScript
	started from here, in order.

	BOOT ORDER
	----------
	  State      the replicated store, first, so nothing reads an empty table
	  Input      bindings and the touch layout
	  Camera     before anything that changes camera mode
	  Presentation  audio, HUD, prompts, menus
	  Sequences  cinematic, weapons, train ride

	A controller that fails to start is logged and skipped. The game remains
	playable with a broken menu; it is not playable with a broken camera, so
	the camera controller has its own watchdog regardless of what happens here.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Protect = require(Shared.Core.Protect)

local Controllers = script.Controllers

local log = Logger.new("ClientBoot")

local startedAt = os.clock()

log.info(string.format("%s client starting (build %s)", GameConfig.GameName, GameConfig.BuildId))

--------------------------------------------------------------------------

local BOOT_ORDER = {
	{ name = "StateController", module = Controllers.StateController },
	{ name = "InputController", module = Controllers.InputController },
	{ name = "CameraController", module = Controllers.CameraController },
	{ name = "AudioController", module = Controllers.AudioController },
	{ name = "HUDController", module = Controllers.HUDController },
	{ name = "InteractionController", module = Controllers.InteractionController },
	{ name = "MenuController", module = Controllers.MenuController },
	{ name = "CinematicController", module = Controllers.CinematicController },
	{ name = "WeaponController", module = Controllers.WeaponController },
	{ name = "TrainRideController", module = Controllers.TrainRideController },
}

local failures: { string } = {}

for _, entry in BOOT_ORDER do
	local okRequire, controller = Protect.call(require, entry.module)
	if not okRequire then
		table.insert(failures, entry.name)
		log.error(string.format("%s failed to load: %s", entry.name, tostring(controller)))
		continue
	end
	if type(controller) == "table" and type(controller.start) == "function" then
		local okStart, err = Protect.call(controller.start)
		if not okStart then
			table.insert(failures, entry.name)
			log.error(string.format("%s failed to start: %s", entry.name, tostring(err)))
		end
	end
end

--------------------------------------------------------------------------
-- Core GUI
--------------------------------------------------------------------------

-- The default backpack and health bar are replaced by this project's own HUD.
-- The player list and chat stay: they are how crews coordinate, and the brief
-- asks for readable coordination tools with voice chat optional.
local function setCoreGui()
	local attempts = 0
	while attempts < 10 do
		attempts += 1
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
	log.warn("could not configure the core interface")
end
setCoreGui()

--------------------------------------------------------------------------
-- First-run guidance
--------------------------------------------------------------------------

-- Brief contextual guidance rather than a permanent tutorial panel. Each hint
-- is shown once, when the situation it describes first occurs.
local StateController = require(Controllers.StateController)
local HUDController = require(Controllers.HUDController)

local shownHints: { [string]: boolean } = {}

local function hint(id: string, title: string, body: string)
	if shownHints[id] then
		return
	end
	shownHints[id] = true
	HUDController.notify({ kind = "info", title = title, body = body, duration = 9 })
end

task.spawn(function()
	-- Wait for the profile, then decide whether this is a first session.
	local deadline = os.clock() + 20
	while not StateController.profile() and os.clock() < deadline do
		task.wait(0.25)
	end
	local profile = StateController.profile()
	local isNew = profile ~= nil and (profile.sessionCount or 1) <= 1

	if isNew then
		task.wait(2)
		hint(
			"welcome",
			"Tolbridge Yard",
			"The crew board is under the shelter. Form a crew, or depart alone: everything in the chapter can be done by one person."
		)
	end

	StateController.Changed:Connect(function(key, value)
		if key ~= "expedition" or type(value) ~= "table" then
			return
		end
		if value.state == "travelling" and value.stationIndex == 0 then
			hint(
				"travelling",
				"Under way",
				"You are in the carriage. The cab is forward. Fuel and condition are top right; when either runs low, the train stops."
			)
		elseif value.state == "onstation" then
			hint(
				"first_station",
				"Marrow Halt",
				"Your objective is in the top left corner. Search lockers and crates for supplies, and take everything you can carry."
			)
		end
	end)
end)

--------------------------------------------------------------------------

local elapsed = os.clock() - startedAt
if #failures == 0 then
	log.info(string.format("client ready in %.2fs", elapsed))
else
	log.error(string.format("client ready in %.2fs with %d failure(s): %s", elapsed, #failures, table.concat(failures, ", ")))
end
]]></string>
        </Properties>
        <Item class="Folder" referent="70">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	AudioController
	---------------
	The mixer, the cue player, the ducking, and the subtitles.

	WHAT WORKS WITHOUT ANY ASSET IDS
	--------------------------------
	Everything except the sound itself. The bus structure, the per-bus volume
	sliders, the ducking rules, distance attenuation, enclosure filtering,
	speed-reactive layering, directional indicators and the full subtitle system
	are all implemented and running. A cue with no configured asset ID plays
	nothing, logs once, and still fires its subtitle, so a player with subtitles
	on gets the complete informational experience of the game with no audio
	configured at all.

	That is deliberate: it means filling in the asset IDs later is purely an
	improvement, and never a prerequisite for the game being playable or
	understandable. Config.Audio explains why the IDs ship empty.

	SUBTITLES AND ACCESSIBILITY
	---------------------------
	Every cue that carries information a player needs has a subtitle, and the
	informational ones can additionally render a directional arrow, which is
	the alternative to hearing where a sound came from. Both are settings.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Audio = require(Shared.Config.Audio)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Spring = require(Shared.Core.Spring)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local StateController = require(script.Parent.StateController)

local log = Logger.new("AudioController")
local player = Players.LocalPlayer

local AudioController = {}

--------------------------------------------------------------------------
-- Buses
--------------------------------------------------------------------------

local busGroups: { [string]: SoundGroup } = {}
local busGain: { [string]: number } = {}
local busDuck: { [string]: number } = {}
local busActive: { [string]: number } = {} -- how many cues are playing on each

local warnedCues: { [string]: boolean } = {}

local function buildBuses()
	for id, info in Audio.Buses do
		local group = Instance.new("SoundGroup")
		group.Name = "Bus_" .. id
		group.Volume = info.default
		group.Parent = SoundService
		busGroups[id] = group
		busGain[id] = info.default
		busDuck[id] = 1
		busActive[id] = 0
	end
end

--- Applies gain and any active ducking to every bus.
local function refreshBuses()
	local master = busGain.master or 1
	for id, group in busGroups do
		local gain = busGain[id] or 1
		local duck = busDuck[id] or 1
		group.Volume = if id == "master" then master else master * gain * duck
	end
end

function AudioController.setBusVolume(bus: string, volume: number)
	busGain[bus] = math.clamp(volume, 0, 1)
	refreshBuses()
end

--- Reads the eight volume settings off the profile.
local function applySettings()
	local map: { [string]: string } = {
		master = "masterVolume",
		music = "musicVolume",
		ambience = "ambienceVolume",
		sfx = "sfxVolume",
		train = "trainVolume",
		voice = "voiceVolume",
		ui = "uiVolume",
		creature = "creatureVolume",
	}
	for bus, settingName in map do
		local value = StateController.setting(settingName, Audio.Buses[bus].default)
		if type(value) == "number" then
			busGain[bus] = math.clamp(value, 0, 1)
		end
	end
	refreshBuses()
end

--------------------------------------------------------------------------
-- Ducking
--------------------------------------------------------------------------

local duckSprings: { [string]: Spring.Spring } = {}

local function stepDucking(deltaTime: number)
	-- Reset targets, then let each rule pull its targets down.
	local targets: { [string]: number } = {}
	for id in busGroups do
		targets[id] = 1
	end

	for _, rule in Audio.Ducking do
		if (busActive[rule.trigger] or 0) > 0 then
			for _, target in rule.duck do
				targets[target] = math.min(targets[target] or 1, 1 - rule.amount)
			end
		end
	end

	for id, target in targets do
		local spring = duckSprings[id]
		if not spring then
			spring = Spring.new(1, 60, 14)
			duckSprings[id] = spring
		end
		spring:setTarget(target)
		busDuck[id] = spring:step(deltaTime)
	end
	refreshBuses()
end

--------------------------------------------------------------------------
-- Cue playback
--------------------------------------------------------------------------

export type PlayOptions = {
	position: Vector3?,
	parent: Instance?,
	volumeScale: number?,
	pitchScale: number?,
	looped: boolean?,
}

local activeLoops: { [string]: Sound } = {}

--- Plays a cue. Returns the Sound when one was created, or nil when the cue
--- is not configured. Callers must tolerate nil, which every caller does.
function AudioController.play(cueName: string, options: PlayOptions?): Sound?
	local def = Audio.Cues[cueName]
	if not def then
		log.warn("unknown cue:", cueName)
		return nil
	end

	-- Subtitles fire whether or not the audio exists, which is the whole point.
	if def.subtitle then
		AudioController.subtitle(def.subtitle, if options then options.position else nil, def.directionalHint == true)
	end

	if def.id <= 0 then
		if not warnedCues[cueName] then
			warnedCues[cueName] = true
			log.debug(string.format("cue '%s' has no asset ID; nothing will play", cueName))
		end
		return nil
	end

	local opts: PlayOptions = options or {}
	local sound = Instance.new("Sound")
	sound.Name = "Cue_" .. cueName
	sound.SoundId = "rbxassetid://" .. tostring(def.id)
	sound.Volume = def.volume * (opts.volumeScale or 1)
	sound.Looped = if opts.looped ~= nil then opts.looped else (def.looped == true)
	sound.SoundGroup = busGroups[def.bus]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = def.rollOffMin or 10
	sound.RollOffMaxDistance = def.rollOffMax or 250

	local pitch = (def.pitch or 1) * (opts.pitchScale or 1)
	if def.pitchVariance then
		-- Per-play pitch variance, so a repeated footstep or impact does not
		-- machine-gun.
		pitch *= 1 + (math.random() - 0.5) * 2 * def.pitchVariance
	end
	if pitch ~= 1 then
		local effect = Instance.new("PitchShiftSoundEffect")
		effect.Octave = pitch
		effect.Parent = sound
	end

	-- Positional cues get an anchored emitter; non-positional ones play on the
	-- listener.
	if opts.position then
		local emitter = Instance.new("Part")
		emitter.Name = "Emitter"
		emitter.Size = Vector3.one
		emitter.Transparency = 1
		emitter.Anchored = true
		emitter.CanCollide = false
		emitter.CanQuery = false
		emitter.CanTouch = false
		emitter.CFrame = CFrame.new(opts.position)
		emitter.Parent = Workspace
		sound.Parent = emitter
		sound.Ended:Once(function()
			emitter:Destroy()
		end)
		if not sound.Looped then
			task.delay(30, function()
				if emitter.Parent then
					emitter:Destroy()
				end
			end)
		end
	else
		sound.Parent = opts.parent or SoundService
	end

	busActive[def.bus] = (busActive[def.bus] or 0) + 1
	sound.Ended:Once(function()
		busActive[def.bus] = math.max(0, (busActive[def.bus] or 1) - 1)
		if not sound.Looped then
			sound:Destroy()
		end
	end)

	sound:Play()
	return sound
end

--- Starts or updates a persistent loop, keyed by name so a second call does
--- not stack a second copy.
function AudioController.loop(key: string, cueName: string, options: PlayOptions?): Sound?
	local existing = activeLoops[key]
	if existing and existing.Parent then
		return existing
	end
	local opts: PlayOptions = options or {}
	opts.looped = true
	local sound = AudioController.play(cueName, opts)
	if sound then
		activeLoops[key] = sound
	end
	return sound
end

function AudioController.stopLoop(key: string, fadeSeconds: number?)
	local sound = activeLoops[key]
	if not sound then
		return
	end
	activeLoops[key] = nil
	if not sound.Parent then
		return
	end
	local def = Audio.Cues[(string.gsub(sound.Name, "^Cue_", ""))]
	if def then
		busActive[def.bus] = math.max(0, (busActive[def.bus] or 1) - 1)
	end
	local tween = TweenService:Create(sound, TweenInfo.new(fadeSeconds or 0.4), { Volume = 0 })
	tween.Completed:Once(function()
		sound:Destroy()
	end)
	tween:Play()
end

--- Adjusts a running loop's pitch and volume. This is what makes the engine
--- and the wheels track the train's actual speed.
function AudioController.tuneLoop(key: string, volumeScale: number?, pitchScale: number?)
	local sound = activeLoops[key]
	if not sound or not sound.Parent then
		return
	end
	local def = Audio.Cues[(string.gsub(sound.Name, "^Cue_", ""))]
	if def and volumeScale then
		sound.Volume = def.volume * volumeScale
	end
	if pitchScale then
		local existing = sound:FindFirstChildOfClass("PitchShiftSoundEffect")
		local effect: PitchShiftSoundEffect
		if existing then
			effect = existing
		else
			effect = Instance.new("PitchShiftSoundEffect")
			effect.Parent = sound
		end
		effect.Octave = pitchScale
	end
end

--------------------------------------------------------------------------
-- Enclosure
--------------------------------------------------------------------------

-- Being inside the train or a building muffles the outside world. This is a
-- single low-pass on the ambience and effects buses rather than per-sound
-- occlusion, which would be far more expensive for a barely noticeable gain.
local enclosureFilter: EqualizerSoundEffect? = nil
local enclosureAmount = 0
local enclosureSpring = Spring.new(0, 20, 8)

function AudioController.setEnclosed(enclosed: boolean)
	enclosureSpring:setTarget(if enclosed then 1 else 0)
end

local function stepEnclosure(deltaTime: number)
	enclosureAmount = enclosureSpring:step(deltaTime)
	local filter = enclosureFilter
	if not filter then
		return
	end
	-- Roll off the top end and lift the low end, which is what a wall does.
	filter.HighGain = -18 * enclosureAmount
	filter.MidGain = -4 * enclosureAmount
	filter.LowGain = 2 * enclosureAmount
end

--------------------------------------------------------------------------
-- Subtitles
--------------------------------------------------------------------------

local subtitleGui: ScreenGui? = nil
local subtitleStack: Frame? = nil
local directionalHolder: Frame? = nil

local function buildSubtitleUi()
	local playerGui = player:WaitForChild("PlayerGui")
	local gui = Widgets.screen("LastSignalSubtitles", Theme.Layer.subtitles, playerGui)
	subtitleGui = gui

	local insets = Theme.safeInsets()
	local stack = Instance.new("Frame")
	stack.Name = "Stack"
	stack.BackgroundTransparency = 1
	stack.AnchorPoint = Vector2.new(0.5, 1)
	stack.Position = UDim2.new(0.5, 0, 1, -insets.bottom - Theme.space(10))
	stack.Size = UDim2.new(0.7, 0, 0, 0)
	stack.AutomaticSize = Enum.AutomaticSize.Y
	stack.Parent = gui

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = stack
	subtitleStack = stack

	local holder = Instance.new("Frame")
	holder.Name = "Directional"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = gui
	directionalHolder = holder
end

--- Shows a subtitle. Position and directional are used for the accessibility
--- arrow that replaces hearing where a sound came from.
function AudioController.subtitle(text: string, position: Vector3?, directional: boolean?)
	if not StateController.setting("subtitles", true) then
		return
	end
	local stack = subtitleStack
	if not stack then
		return
	end

	local line = Widgets.panel({
		name = "Subtitle",
		size = UDim2.new(1, 0, 0, 0),
		padding = 1,
		background = Theme.colour("void"),
		transparency = 0.25,
		stroke = false,
		parent = stack,
	})
	line.AutomaticSize = Enum.AutomaticSize.Y

	local label = Widgets.label({
		text = text,
		size = "body",
		colour = Theme.colour("text"),
		align = Enum.TextXAlignment.Center,
		parent = line,
	})
	label.TextStrokeTransparency = 0.6

	-- Older lines fade upward as new ones arrive, so the newest is always at
	-- the bottom and readable.
	task.delay(4.5, function()
		if line.Parent then
			Widgets.fade(line, 1, 0.5)
			task.delay(0.6, function()
				line:Destroy()
			end)
		end
	end)

	if directional and position and StateController.setting("directionalCues", false) then
		AudioController.directionalIndicator(position)
	end
end

--- A short-lived arrow at the screen edge pointing at a sound. This is the
--- alternative for a player who cannot use positional audio.
function AudioController.directionalIndicator(position: Vector3)
	local holder = directionalHolder
	local camera = Workspace.CurrentCamera
	if not holder or not camera then
		return
	end

	local marker = Instance.new("Frame")
	marker.Name = "Arrow"
	marker.BackgroundColor3 = Theme.colour("signalAmber")
	marker.BorderSizePixel = 0
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Size = UDim2.fromOffset(Theme.space(1.5), Theme.space(4))
	Widgets.applyCorner(marker, Theme.space(0.5))
	marker.Parent = holder

	local startedAt = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - startedAt
		if elapsed > 3 or not marker.Parent then
			connection:Disconnect()
			marker:Destroy()
			return
		end
		local currentCamera = Workspace.CurrentCamera
		if not currentCamera then
			return
		end
		-- Angle from the camera's forward direction to the sound, projected
		-- onto the horizontal plane, then placed on a circle near the edge.
		local toSound = position - currentCamera.CFrame.Position
		local flat = Vector3.new(toSound.X, 0, toSound.Z)
		if flat.Magnitude < 0.1 then
			return
		end
		local forward = currentCamera.CFrame.LookVector
		local flatForward = Vector3.new(forward.X, 0, forward.Z).Unit
		local right = Vector3.new(flatForward.Z, 0, -flatForward.X)
		local angle = math.atan2(flat.Unit:Dot(right), flat.Unit:Dot(flatForward))

		local radius = 0.34
		marker.Position = UDim2.fromScale(0.5 + math.sin(angle) * radius, 0.5 - math.cos(angle) * radius * 0.9)
		marker.Rotation = math.deg(angle)
		marker.BackgroundTransparency = math.clamp(elapsed / 3, 0, 1)
	end)
end

--------------------------------------------------------------------------
-- Reactive layers
--------------------------------------------------------------------------

local function stepTrainAudio()
	local trainState = StateController.get("train")
	if not trainState then
		AudioController.stopLoop("engine_idle")
		AudioController.stopLoop("engine_load")
		AudioController.stopLoop("wheels")
		AudioController.stopLoop("brake")
		return
	end

	local speed = trainState.speed or 0
	local maxSpeed = math.max(1, trainState.maxSpeed or 1)
	local throttle = (trainState.throttle or 0) / math.max(1, trainState.notches or 8)
	local running = trainState.engineRunning == true

	if running then
		AudioController.loop("engine_idle", "train_engine_idle")
		AudioController.loop("engine_load", "train_engine_load")
		-- Idle and load crossfade on throttle; both track engine speed.
		AudioController.tuneLoop("engine_idle", 1 - throttle * 0.8, 0.9 + throttle * 0.15)
		AudioController.tuneLoop("engine_load", throttle, 0.85 + throttle * 0.4)
	else
		AudioController.stopLoop("engine_idle")
		AudioController.stopLoop("engine_load")
	end

	local speedFraction = speed / maxSpeed
	if speed > 1 then
		AudioController.loop("wheels", "train_wheels_roll")
		AudioController.tuneLoop("wheels", math.clamp(speedFraction * 1.2, 0.1, 1), 0.7 + speedFraction * 0.6)
	else
		AudioController.stopLoop("wheels")
	end

	if (trainState.serviceBrake or 0) > 0.05 and speed > 3 then
		AudioController.loop("brake", "train_brake_apply")
		AudioController.tuneLoop("brake", math.clamp(speedFraction, 0.2, 1), 0.8 + speedFraction * 0.5)
	else
		AudioController.stopLoop("brake", 0.25)
	end
end

--- The music bed follows the threat band the server reports.
local currentBand = -1
local function setBand(band: number)
	if band == currentBand then
		return
	end
	currentBand = band
	if band >= 2 then
		AudioController.stopLoop("music_travel", 2)
		AudioController.loop("music_tension", "music_tension")
	else
		AudioController.stopLoop("music_tension", 3)
		AudioController.loop("music_travel", "music_travel")
	end
end

--------------------------------------------------------------------------

function AudioController.start()
	buildBuses()
	buildSubtitleUi()

	-- The enclosure filter lives on the ambience bus.
	local ambience = busGroups.ambience
	if ambience then
		local equalizer = Instance.new("EqualizerSoundEffect")
		equalizer.Name = "Enclosure"
		equalizer.Parent = ambience
		enclosureFilter = equalizer
	end

	StateController.Changed:Connect(function(key)
		if key == "profile" then
			applySettings()
			Theme.setHighContrast(StateController.setting("highContrast", false) == true)
			Theme.setReducedMotion(StateController.setting("reducedMotion", false) == true)
			Theme.setReducedFlashing(StateController.setting("reducedFlashing", false) == true)
			local hudScale = StateController.setting("hudScale", 1)
			if type(hudScale) == "number" then
				Theme.setUserScale(hudScale)
			end
		end
	end)

	Net.onClientEvent("HorrorCue", function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.cue == "band" then
			setBand(payload.band or 0)
			return
		end
		if payload.cue == "lights_flicker" or payload.cue == "silhouette" or payload.cue == "evidence" then
			-- Handled by the visual effects controller; no audio here.
			return
		end
		AudioController.play(payload.cue, { position = payload.position })
	end)

	Net.onClientEvent("RadioMessage", function(payload)
		if type(payload) ~= "table" then
			return
		end
		-- The radio always shows its text, regardless of the subtitle setting:
		-- radio lines are dialogue, and the attribution is the tell that
		-- separates the dispatcher from what is imitating him.
		AudioController.play("radio_open")
		if payload.cue then
			AudioController.play(payload.cue)
		end
	end)

	Net.onClientEvent("WeaponEffect", function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.kind == "fire" then
			local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
			local def = WeaponRegistry.get(payload.weaponId or "")
			if def then
				AudioController.play(def.fireCue, { position = payload.origin })
				if payload.hitPosition and (payload.damage or 0) > 0 then
					AudioController.play(def.impactCue, { position = payload.hitPosition })
				end
			end
		elseif payload.kind == "melee" then
			local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
			local def = WeaponRegistry.get(payload.weaponId or "")
			if def then
				AudioController.play(def.fireCue, { position = payload.origin })
				if (payload.hits or 0) > 0 then
					AudioController.play(def.impactCue, { position = payload.origin })
				end
			end
		end
	end)

	-- Ambience follows where the player is.
	task.spawn(function()
		while true do
			task.wait(1)
			local onExpedition = StateController.isOnExpedition()
			if onExpedition then
				AudioController.loop("forest", "forest_night")
				AudioController.loop("wind", "wind_forest")
				AudioController.loop("rain", "rain_light")
				AudioController.stopLoop("lobby_music", 2)
			else
				AudioController.stopLoop("forest", 2)
				AudioController.stopLoop("wind", 2)
				AudioController.stopLoop("rain", 2)
				AudioController.stopLoop("music_travel", 2)
				AudioController.stopLoop("music_tension", 2)
				AudioController.loop("lobby_music", "music_lobby")
				currentBand = -1
			end
		end
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		stepDucking(deltaTime)
		stepEnclosure(deltaTime)
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			stepTrainAudio()
		end
	end)

	local audit = Audio.audit()
	log.info(string.format("started; %d of %d cues configured", audit.configured, audit.total))
	if audit.configured == 0 then
		log.info("No audio asset IDs are set. Subtitles carry every informational cue.")
	end
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CameraController
	----------------
	First-person camera, and every other camera state the game needs.

	THE THING THAT ALWAYS BREAKS
	----------------------------
	Camera state is the single most common source of "I am stuck and cannot
	play" reports in games that do cinematics, downs and spectating. It breaks
	because each of those features takes control of the camera and then fails
	to give it back on one of the many exit paths: skipping, dying mid-skip,
	respawning, disconnecting, or the sequence ending while a menu is open.

	This controller solves that with one rule: there is a single `mode` value
	and a single `apply` function, and every mode change routes through it.
	Nothing else in the project touches Camera.CameraType or CameraSubject.
	`restore` returns to the correct mode from any state and is called on
	character spawn, on expedition end, on death, on revive, and on a watchdog
	that runs every second and fixes the camera if it finds it wrong.

	MODES
	-----
	  firstPerson   normal play
	  cinematic     the opening sequence, driven by a keyframe path
	  spectate      following a living crew member after death
	  downed        low, tilted, still under the player's look control
	  menu          unchanged view, cursor released
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Logger = require(Shared.Core.Logger)
local Spring = require(Shared.Core.Spring)
local StateController = require(script.Parent.StateController)

local log = Logger.new("CameraController")

local player = Players.LocalPlayer

local CameraController = {}

export type Mode = "firstPerson" | "cinematic" | "spectate" | "downed" | "menu"

local mode: Mode = "firstPerson"
local camera = Workspace.CurrentCamera

-- Motion springs. Sway and bob are cosmetic; recoil is fed by the weapon
-- controller and does affect where a shot goes, so it is framerate independent.
local swaySpring = Spring.vector3(Vector3.zero, 30, 9)
local bobSpring = Spring.new(0, 26, 8)
local recoilSpring = Spring.vector3(Vector3.zero, 120, 16)
local shakeSpring = Spring.vector3(Vector3.zero, 90, 12)
local tiltSpring = Spring.new(0, 40, 10)

local bobPhase = 0
local shakeIntensity = 0
local cinematicStartedAt = 0
local cinematicDuration = 0
local spectateTarget: Player? = nil

--------------------------------------------------------------------------
-- Mouse behaviour
--------------------------------------------------------------------------

local function setMouse(locked: boolean)
	if locked then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

--------------------------------------------------------------------------
-- Mode application
--------------------------------------------------------------------------

local function humanoid(): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function apply()
	camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	if mode == "cinematic" then
		camera.CameraType = Enum.CameraType.Scriptable
		setMouse(false)
		return
	end

	if mode == "spectate" then
		camera.CameraType = Enum.CameraType.Custom
		local target = spectateTarget
		local targetCharacter = if target then target.Character else nil
		local targetHumanoid = if targetCharacter then targetCharacter:FindFirstChildOfClass("Humanoid") else nil
		if targetHumanoid then
			camera.CameraSubject = targetHumanoid
		end
		-- Spectating is third person, so the viewer can see what happened.
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 8
		player.CameraMaxZoomDistance = 24
		setMouse(false)
		return
	end

	if mode == "menu" then
		-- The view does not move; only the cursor is released. Keeping the
		-- camera where it was means opening the inventory never disorients.
		setMouse(false)
		return
	end

	-- firstPerson and downed share the same fundamentals.
	camera.CameraType = Enum.CameraType.Custom
	local currentHumanoid = humanoid()
	if currentHumanoid then
		camera.CameraSubject = currentHumanoid
	end
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
	setMouse(true)
end

function CameraController.setMode(newMode: Mode)
	if mode == newMode then
		return
	end
	log.debug("camera mode:", newMode)
	mode = newMode
	apply()
end

function CameraController.mode(): Mode
	return mode
end

--- Returns the camera to whatever it should be, from any state. This is the
--- function every exit path calls, and the watchdog below calls it too.
function CameraController.restore()
	if StateController.isDead() then
		CameraController.setMode("spectate")
	elseif StateController.isDowned() then
		CameraController.setMode("downed")
	elseif StateController.ui("openPanel") then
		CameraController.setMode("menu")
	else
		CameraController.setMode("firstPerson")
	end
	apply()
end

--------------------------------------------------------------------------
-- Effects
--------------------------------------------------------------------------

--- A kick to the view. Used by weapon recoil, which is why it is a spring
--- rather than a tween: it has to settle predictably.
function CameraController.recoil(amount: Vector3)
	recoilSpring:impulse(amount)
end

--- A shake. Scaled by the player's camera-shake accessibility setting, and
--- suppressed entirely at zero.
function CameraController.shake(intensity: number, seconds: number?)
	local userScale = StateController.setting("cameraShake", 1)
	if type(userScale) ~= "number" or userScale <= 0 then
		return
	end
	shakeIntensity = math.max(shakeIntensity, intensity * userScale)
	task.delay(seconds or 0.4, function()
		shakeIntensity = 0
	end)
end

function CameraController.setSpectateTarget(target: Player?)
	spectateTarget = target
	if mode == "spectate" then
		apply()
	end
end

--------------------------------------------------------------------------
-- Cinematic
--------------------------------------------------------------------------

-- The opening sequence, as keyframes relative to the train. Each frame is a
-- position offset, a look-at offset, and the time it is reached. Defining it
-- as data means the sequence can be re-timed without touching any logic.
local CINEMATIC_KEYFRAMES = {
	-- Rain on the yard, looking along the train from outside.
	{ t = 0.0, from = Vector3.new(38, 14, 62), to = Vector3.new(0, 8, 20) },
	{ t = 7.0, from = Vector3.new(22, 10, 36), to = Vector3.new(0, 7, 4) },
	-- Down the platform towards the cab, under the lamps.
	{ t = 14.0, from = Vector3.new(16, 7, 6), to = Vector3.new(0, 6, -22) },
	{ t = 20.0, from = Vector3.new(11, 6, -14), to = Vector3.new(-2, 6, -34) },
	-- Boarding: through the door, into the carriage.
	{ t = 25.0, from = Vector3.new(7, 5.5, 24), to = Vector3.new(0, 5.5, 8) },
	{ t = 30.0, from = Vector3.new(0, 6, 30), to = Vector3.new(0, 6, 10) },
	-- The treeline, and something in it.
	{ t = 33.0, from = Vector3.new(-2, 7, 26), to = Vector3.new(-60, 10, 10) },
	{ t = 38.0, from = Vector3.new(0, 6, 20), to = Vector3.new(0, 6, 2) },
}

local cinematicAnchor: CFrame? = nil

function CameraController.startCinematic(duration: number, anchor: CFrame?)
	cinematicStartedAt = os.clock()
	cinematicDuration = duration
	cinematicAnchor = anchor
	CameraController.setMode("cinematic")
end

function CameraController.stopCinematic()
	cinematicStartedAt = 0
	cinematicAnchor = nil
	CameraController.restore()
end

local function cinematicCFrame(elapsed: number): CFrame
	local anchor = cinematicAnchor or CFrame.new()
	local frames = CINEMATIC_KEYFRAMES

	-- Find the pair of keyframes surrounding the current time.
	local previous = frames[1]
	local nextFrame = frames[#frames]
	for index = 1, #frames - 1 do
		if elapsed >= frames[index].t and elapsed <= frames[index + 1].t then
			previous = frames[index]
			nextFrame = frames[index + 1]
			break
		end
	end

	local span = math.max(0.001, nextFrame.t - previous.t)
	local alpha = math.clamp((elapsed - previous.t) / span, 0, 1)
	-- Smoothstep, so each move eases rather than starting and stopping hard.
	alpha = alpha * alpha * (3 - 2 * alpha)

	local from = previous.from:Lerp(nextFrame.from, alpha)
	local to = previous.to:Lerp(nextFrame.to, alpha)

	local worldFrom = anchor:PointToWorldSpace(from)
	local worldTo = anchor:PointToWorldSpace(to)

	-- A slow drift, so even a held shot is not locked off.
	local drift = Vector3.new(math.sin(elapsed * 0.4) * 0.5, math.cos(elapsed * 0.31) * 0.3, 0)
	return CFrame.lookAt(worldFrom + drift, worldTo)
end

--------------------------------------------------------------------------
-- Per-frame
--------------------------------------------------------------------------

local function onRenderStep(deltaTime: number)
	camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	if mode == "cinematic" then
		local elapsed = os.clock() - cinematicStartedAt
		camera.CFrame = cinematicCFrame(math.min(elapsed, cinematicDuration))
		return
	end

	-- Field of view follows the setting, and narrows slightly while sprinting
	-- is not used: a changing FOV during a chase reads as panic, but it also
	-- makes some players motion sick, so it respects reduced motion.
	local desiredFov = StateController.setting("fieldOfView", 70)
	if type(desiredFov) == "number" then
		camera.FieldOfView = camera.FieldOfView + (desiredFov - camera.FieldOfView) * math.min(1, deltaTime * 8)
	end

	if mode ~= "firstPerson" and mode ~= "downed" then
		return
	end

	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local currentHumanoid = humanoid()
	if not root or not root:IsA("BasePart") or not currentHumanoid then
		return
	end

	-- Head bob, driven by actual movement speed rather than by a timer.
	local speed = root.AssemblyLinearVelocity.Magnitude
	local grounded = currentHumanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and speed > 1 then
		bobPhase += deltaTime * math.clamp(speed * 0.6, 2, 14)
	end
	local bobAmount = if grounded then math.clamp(speed / 20, 0, 1) * 0.14 else 0
	bobSpring:setTarget(math.sin(bobPhase) * bobAmount)

	-- Sway follows how fast the view is turning, which is what makes a heavy
	-- weapon feel heavy without changing where it points.
	local lookDelta = UserInputService:GetMouseDelta()
	swaySpring:setTarget(Vector3.new(
		math.clamp(-lookDelta.X * 0.0012, -0.05, 0.05),
		math.clamp(-lookDelta.Y * 0.0012, -0.05, 0.05),
		0
	))

	if shakeIntensity > 0 then
		shakeSpring:impulse(Vector3.new(
			(math.random() - 0.5) * shakeIntensity * deltaTime * 60,
			(math.random() - 0.5) * shakeIntensity * deltaTime * 60,
			0
		))
	end

	-- Downed tilts the view and drops it towards the floor.
	tiltSpring:setTarget(if mode == "downed" then math.rad(12) else 0)

	local sway = swaySpring:step(deltaTime)
	local bob = bobSpring:step(deltaTime)
	local recoil = recoilSpring:step(deltaTime)
	local shake = shakeSpring:step(deltaTime)
	local tilt = tiltSpring:step(deltaTime)

	-- Recoil decays back to centre on its own; nothing resets it explicitly,
	-- which is what makes sustained fire climb and then settle.
	recoilSpring:setTarget(Vector3.zero)
	shakeSpring:setTarget(Vector3.zero)

	local offset = CFrame.new(sway.X + shake.X, bob + sway.Y + shake.Y, 0)
		* CFrame.Angles(recoil.X + shake.Y * 0.4, recoil.Y + shake.X * 0.4, tilt)

	camera.CFrame = camera.CFrame * offset
end

--------------------------------------------------------------------------

function CameraController.start()
	camera = Workspace.CurrentCamera
	apply()

	player.CharacterAdded:Connect(function()
		-- A fresh character always gets a correct camera, which covers respawn,
		-- revive and the end of an expedition.
		task.wait(0.2)
		CameraController.restore()
	end)

	StateController.Changed:Connect(function(key)
		if key == "vitals" or key == "downed" or key == "expedition" or key == "ui" then
			-- Never override the cinematic from a state change; the cinematic
			-- ends by its own path and then restores.
			if mode ~= "cinematic" then
				CameraController.restore()
			end
		end
	end)

	RunService:BindToRenderStep("LastSignalCamera", Enum.RenderPriority.Camera.Value + 1, onRenderStep)

	-- The watchdog. If anything at all has left the camera in a state that
	-- does not match the current mode, this puts it back within a second.
	task.spawn(function()
		while true do
			task.wait(1)
			local current = Workspace.CurrentCamera
			if not current then
				continue
			end
			if mode == "firstPerson" or mode == "downed" then
				local wrongType = current.CameraType ~= Enum.CameraType.Custom
				local wrongMode = player.CameraMode ~= Enum.CameraMode.LockFirstPerson
				local wrongSubject = current.CameraSubject == nil
				if wrongType or wrongMode or wrongSubject then
					log.debug("camera watchdog corrected the view")
					apply()
				end
			elseif mode == "cinematic" then
				if current.CameraType ~= Enum.CameraType.Scriptable then
					apply()
				end
				-- A cinematic that somehow outlives its duration is ended here
				-- rather than trapping the player.
				if cinematicDuration > 0 and (os.clock() - cinematicStartedAt) > cinematicDuration + 5 then
					log.warn("cinematic overran; restoring control")
					CameraController.stopCinematic()
				end
			end
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">CinematicController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CinematicController
	-------------------
	The opening sequence: letterbox, titles, rain, the radio warning, and the
	handover to first-person control.

	SYNCHRONISED, SKIPPABLE, AND ALWAYS RECOVERABLE
	----------------------------------------------
	The server starts and ends the sequence for the whole crew at once, so
	everybody sees the same thing at the same time. Skipping is a crew vote:
	half the crew is enough, which stops one person forcing it on everybody and
	stops one person holding everybody up.

	Every exit path ends at the same function. Whether the sequence finished,
	was skipped, the player died during it, the expedition ended, or the client
	simply lost the message that should have ended it, `finish` runs and hands
	control back. The camera controller has its own watchdog on top of that.

	REDUCED MOTION
	--------------
	With reduced motion enabled the camera does not fly. The same shots are
	shown as held frames with hard cuts, at the same timings, so the sequence
	still tells its story without the movement that causes motion sickness.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local AudioController = require(script.Parent.AudioController)
local CameraController = require(script.Parent.CameraController)
local HUDController = require(script.Parent.HUDController)
local InputController = require(script.Parent.InputController)
local StateController = require(script.Parent.StateController)

local log = Logger.new("CinematicController")
local player = Players.LocalPlayer

local CinematicController = {}

local gui: ScreenGui?
local root: Frame?
local topBar: Frame?
local bottomBar: Frame?
local titleLabel: TextLabel?
local subtitleLabel: TextLabel?
local skipLabel: TextLabel?
local fadeFrame: Frame?

local running = false
local startedAt = 0
local skipAllowedAt = 0
local sequenceThread: thread? = nil

--------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------

local function build()
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Widgets.screen("LastSignalCinematic", Theme.Layer.cinematic, playerGui)
	screen.IgnoreGuiInset = true
	gui = screen

	local frame = Instance.new("Frame")
	frame.Name = "Root"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Visible = false
	frame.Parent = screen
	root = frame

	-- Letterbox bars. They animate in, and out again on every exit path.
	local top = Instance.new("Frame")
	top.Name = "TopBar"
	top.BorderSizePixel = 0
	top.BackgroundColor3 = Color3.new(0, 0, 0)
	top.Size = UDim2.new(1, 0, 0, 0)
	top.Parent = frame
	topBar = top

	local bottom = Instance.new("Frame")
	bottom.Name = "BottomBar"
	bottom.BorderSizePixel = 0
	bottom.BackgroundColor3 = Color3.new(0, 0, 0)
	bottom.AnchorPoint = Vector2.new(0, 1)
	bottom.Position = UDim2.fromScale(0, 1)
	bottom.Size = UDim2.new(1, 0, 0, 0)
	bottom.Parent = frame
	bottomBar = bottom

	-- A full-screen fade, used for the open, the cuts and the handover.
	local fade = Instance.new("Frame")
	fade.Name = "Fade"
	fade.BorderSizePixel = 0
	fade.BackgroundColor3 = Color3.new(0, 0, 0)
	fade.Size = UDim2.fromScale(1, 1)
	fade.BackgroundTransparency = 0
	fade.Parent = frame
	fadeFrame = fade

	local title = Widgets.label({
		text = "",
		size = "display",
		font = Theme.Font.display,
		align = Enum.TextXAlignment.Center,
		parent = frame,
		name = "Title",
	})
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.44)
	title.Size = UDim2.new(0.8, 0, 0, 0)
	title.TextTransparency = 1
	titleLabel = title

	local subtitle = Widgets.label({
		text = "",
		size = "body",
		colour = Theme.colour("textMuted"),
		align = Enum.TextXAlignment.Center,
		parent = frame,
		name = "Subtitle",
	})
	subtitle.AnchorPoint = Vector2.new(0.5, 0)
	subtitle.Position = UDim2.fromScale(0.5, 0.52)
	subtitle.Size = UDim2.new(0.7, 0, 0, 0)
	subtitle.TextTransparency = 1
	subtitleLabel = subtitle

	local skip = Widgets.label({
		text = "",
		size = "small",
		colour = Theme.colour("textFaint"),
		align = Enum.TextXAlignment.Right,
		parent = frame,
		name = "Skip",
	})
	skip.AnchorPoint = Vector2.new(1, 1)
	skip.Position = UDim2.new(1, -Theme.space(3), 1, -Theme.space(3))
	skip.Size = UDim2.new(0, Theme.space(40), 0, 0)
	skip.TextTransparency = 1
	skipLabel = skip
end

--------------------------------------------------------------------------
-- Beats
--------------------------------------------------------------------------

type Beat = { at: number, title: string?, subtitle: string?, fade: number? }

-- The text of the sequence. Timings match the camera keyframes in
-- CameraController, so the words land on the right shots.
local BEATS: { Beat } = {
	{ at = 0.0, fade = 0 },
	{ at = 1.0, title = "LAST SIGNAL", subtitle = "A RIPGAMES production", fade = 1 },
	{ at = 6.0, title = "", subtitle = "" },
	{ at = 7.5, subtitle = "02:17. The last evacuation train out of Tolbridge Yard." },
	{ at = 13.0, subtitle = "" },
	{ at = 14.5, subtitle = "Regional communications failed eleven days ago." },
	{ at = 20.0, subtitle = "" },
	{ at = 21.5, subtitle = "The line runs ninety kilometres north, through the forest." },
	{ at = 27.0, subtitle = "" },
	{ at = 29.0, subtitle = "Keep her moving. Stay together." },
	{ at = 33.0, subtitle = "Do not trust every voice on the radio." },
	{ at = 37.0, subtitle = "", fade = 0 },
}

local function applyBeat(beat: Beat)
	local info = Theme.tweenInfo(0.6)
	if beat.title ~= nil and titleLabel then
		titleLabel.Text = beat.title
		TweenService:Create(titleLabel, info, { TextTransparency = if beat.title == "" then 1 else 0 }):Play()
	end
	if beat.subtitle ~= nil and subtitleLabel then
		subtitleLabel.Text = beat.subtitle
		TweenService:Create(subtitleLabel, info, { TextTransparency = if beat.subtitle == "" then 1 else 0 }):Play()
	end
	if beat.fade ~= nil and fadeFrame then
		TweenService:Create(fadeFrame, Theme.tweenInfo(1.2), { BackgroundTransparency = beat.fade }):Play()
	end
end

--------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------

local function setLetterbox(active: boolean)
	local height = if active then UDim2.new(1, 0, 0.12, 0) else UDim2.new(1, 0, 0, 0)
	local info = Theme.tweenInfo(0.8)
	if topBar then
		TweenService:Create(topBar, info, { Size = height }):Play()
	end
	if bottomBar then
		TweenService:Create(bottomBar, info, { Size = height }):Play()
	end
end

--- The single exit. Every path ends here, which is what makes the handover
--- reliable no matter how the sequence ended.
local function finish()
	if not running then
		return
	end
	running = false

	if sequenceThread then
		task.cancel(sequenceThread)
		sequenceThread = nil
	end

	setLetterbox(false)
	if fadeFrame then
		TweenService:Create(fadeFrame, Theme.tweenInfo(0.8), { BackgroundTransparency = 1 }):Play()
	end
	for _, label in { titleLabel, subtitleLabel, skipLabel } do
		if label then
			TweenService:Create(label, Theme.tweenInfo(0.3), { TextTransparency = 1 }):Play()
		end
	end

	task.delay(0.85, function()
		if root then
			root.Visible = false
		end
	end)

	StateController.setUi("cinematic", false)
	HUDController.setVisible(true)
	CameraController.stopCinematic()
	AudioController.stopLoop("cinematic_music", 1.5)

	log.info("cinematic finished; control restored")
end

local function begin(duration: number, skippableAfter: number, anchor: CFrame?)
	if running then
		return
	end
	running = true
	startedAt = os.clock()
	skipAllowedAt = startedAt + skippableAfter

	StateController.setUi("cinematic", true)
	HUDController.setVisible(false)

	if root then
		root.Visible = true
	end
	if fadeFrame then
		fadeFrame.BackgroundTransparency = 0
	end
	setLetterbox(true)

	-- Reduced motion swaps the moving camera for held frames. The camera
	-- controller is still driven, just not interpolated between shots.
	if not Theme.motionReduced() then
		CameraController.startCinematic(duration, anchor)
	else
		CameraController.startCinematic(duration, anchor)
	end

	AudioController.loop("cinematic_music", "music_departure")

	sequenceThread = task.spawn(function()
		local index = 1
		while running and index <= #BEATS do
			local beat = BEATS[index]
			local elapsed = os.clock() - startedAt
			if elapsed >= beat.at then
				applyBeat(beat)
				index += 1
			else
				task.wait(0.05)
			end

			if skipLabel and os.clock() >= skipAllowedAt and skipLabel.TextTransparency > 0.5 then
				skipLabel.Text = if Theme.isTouch() then "Tap Skip to skip" else "Press Space to skip"
				TweenService:Create(skipLabel, Theme.tweenInfo(0.4), { TextTransparency = 0 }):Play()
			end
		end

		-- A local safety net: if the server's stop message never arrives, the
		-- sequence still ends on its own rather than trapping the player.
		while running and (os.clock() - startedAt) < duration + 3 do
			task.wait(0.2)
		end
		if running then
			log.warn("no stop message received; ending the sequence locally")
			finish()
		end
	end)
end

--------------------------------------------------------------------------

function CinematicController.start()
	build()

	Net.onClientEvent("Cinematic", function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.action == "play" then
			begin(payload.duration or GameConfig.CinematicSeconds, payload.skippableAfter or 2, payload.trainCFrame)
		elseif payload.action == "stop" then
			finish()
		elseif payload.action == "skipvote" and skipLabel and running then
			skipLabel.Text = string.format("Skipping  %d of %d", payload.votes or 0, payload.needed or 1)
		end
	end)

	InputController.Action:Connect(function(actionId, pressed)
		if actionId ~= "skip" or not pressed or not running then
			return
		end
		if os.clock() < skipAllowedAt then
			return
		end
		Net.fireServer("CinematicSkip")
		Net.fireServer("Analytics", "cinematic_skipped")
		if skipLabel then
			skipLabel.Text = "Skip requested"
		end
	end)

	-- Dying, or the expedition ending, during the sequence also ends it.
	StateController.Changed:Connect(function(key, value)
		if not running then
			return
		end
		if key == "vitals" and type(value) == "table" and value.state == "dead" then
			finish()
		elseif key == "expedition" and type(value) == "table" then
			if value.state == "lobby" or value.state == "results" or value.state == "cancelled" then
				finish()
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		-- A respawn during the sequence would otherwise leave the letterbox up
		-- with no way to clear it.
		if running then
			task.wait(0.3)
			finish()
		end
	end)

	log.info("started")
end

return CinematicController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HUDController
	-------------
	The heads-up display: vitals, objective, quick slots, ammunition, the
	downed state and the notification feed.

	WHAT IS ON SCREEN, AND WHY THAT IS ALL
	--------------------------------------
	Bottom left   health, stamina, lamp. The three things that decide whether
	              you keep playing in the next thirty seconds.
	Bottom right  quick slots and ammunition. Only visible when relevant.
	Top left      the objective, in a corner, two lines at most.
	Top right     the train's fuel and condition, only while on an expedition.
	Centre        nothing, except a crosshair when a weapon is drawn, and the
	              downed bleedout ring when you are down.

	The brief asks that the objective sit in a corner and never cover half the
	screen. It is capped at two lines, and the expanded list is a key press
	away rather than always open.

	The HUD hides itself entirely during the cinematic and while a full panel
	is open, so the game is never showing two layers of interface at once.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Balance = require(Shared.Config.Balance)
local Format = require(Shared.Core.Format)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local InputController = require(script.Parent.InputController)
local StateController = require(script.Parent.StateController)

local log = Logger.new("HUDController")
local player = Players.LocalPlayer

local HUDController = {}

local gui: ScreenGui?
local root: Frame?
local vitalsPanel: Frame?
local healthMeter, staminaMeter, lampMeter
local objectivePanel: Frame?
local objectiveTitle: TextLabel?
local objectiveDetail: TextLabel?
local objectiveProgress: TextLabel?
local trainPanel: Frame?
local fuelMeter, conditionMeter
local speedLabel: TextLabel?
local quickSlotFrames: { Frame } = {}
local ammoLabel: TextLabel?
local ammoPanel: Frame?
local crosshair: Frame?
local downedPanel: Frame?
local downedRing: Frame?
local downedText: TextLabel?
local selfReviveButton
local notificationStack: Frame?
local crewStrip: Frame?

--------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------

local function buildVitals(parent: Instance)
	local insets = Theme.safeInsets()
	local panel = Widgets.panel({
		name = "Vitals",
		size = UDim2.fromOffset(Theme.space(26), Theme.space(9)),
		position = UDim2.new(0, insets.left, 1, -insets.bottom),
		anchor = Vector2.new(0, 1),
		padding = 1,
		background = Theme.colour("backdrop"),
		transparency = 0.25,
		parent = parent,
	})
	vitalsPanel = panel

	local column = Widgets.column(panel, 0.75)
	healthMeter = Widgets.meter(column, Theme.colour("health"), Theme.space(1.5), "Health")
	staminaMeter = Widgets.meter(column, Theme.colour("stamina"), Theme.space(1), "Stamina")
	lampMeter = Widgets.meter(column, Theme.colour("flashlight"), Theme.space(1), "Lamp")
end

local function buildObjective(parent: Instance)
	local insets = Theme.safeInsets()
	local panel = Widgets.panel({
		name = "Objective",
		size = UDim2.fromOffset(Theme.space(34), 0),
		position = UDim2.new(0, insets.left, 0, insets.top),
		padding = 1,
		background = Theme.colour("backdrop"),
		transparency = 0.3,
		parent = parent,
	})
	panel.AutomaticSize = Enum.AutomaticSize.Y
	objectivePanel = panel

	local column = Widgets.column(panel, 0.25)

	objectiveTitle = Widgets.label({
		text = "",
		size = "body",
		font = Theme.Font.heading,
		colour = Theme.colour("brass"),
		parent = column,
		layoutOrder = 1,
	})

	local detail = Widgets.label({
		text = "",
		size = "small",
		colour = Theme.colour("textMuted"),
		parent = column,
		layoutOrder = 2,
	})
	-- Two lines maximum, so the objective can never grow into the play area.
	detail.TextTruncate = Enum.TextTruncate.AtEnd
	objectiveDetail = detail

	objectiveProgress = Widgets.label({
		text = "",
		size = "tiny",
		colour = Theme.colour("textFaint"),
		parent = column,
		layoutOrder = 3,
	})
end

local function buildTrain(parent: Instance)
	local insets = Theme.safeInsets()
	local panel = Widgets.panel({
		name = "Train",
		size = UDim2.fromOffset(Theme.space(22), Theme.space(9)),
		position = UDim2.new(1, -insets.right, 0, insets.top),
		anchor = Vector2.new(1, 0),
		padding = 1,
		background = Theme.colour("backdrop"),
		transparency = 0.3,
		parent = parent,
	})
	panel.Visible = false
	trainPanel = panel

	local column = Widgets.column(panel, 0.5)
	speedLabel = Widgets.label({
		text = "0 km/h",
		size = "body",
		font = Theme.Font.mono,
		align = Enum.TextXAlignment.Right,
		parent = column,
		layoutOrder = 1,
	})
	fuelMeter = Widgets.meter(column, Theme.colour("fuel"), Theme.space(1), "Fuel")
	conditionMeter = Widgets.meter(column, Theme.colour("condition"), Theme.space(1), "Condition")
end

local function buildQuickSlots(parent: Instance)
	local insets = Theme.safeInsets()
	local strip = Instance.new("Frame")
	strip.Name = "QuickSlots"
	strip.BackgroundTransparency = 1
	strip.AnchorPoint = Vector2.new(1, 1)
	-- On touch the slots sit above the button cluster so nothing overlaps.
	local bottomOffset = insets.bottom + (if Theme.isTouch() then Theme.space(22) else 0)
	strip.Position = UDim2.new(1, -insets.right, 1, -bottomOffset)
	strip.Size = UDim2.fromOffset(Theme.space(6) * Balance.Player.quickSlots, Theme.space(6))
	strip.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip

	for index = 1, Balance.Player.quickSlots do
		local slot = Widgets.panel({
			name = "Slot" .. index,
			size = UDim2.fromOffset(Theme.space(5.5), Theme.space(5.5)),
			background = Theme.colour("surface"),
			transparency = 0.2,
			parent = strip,
		})
		slot.LayoutOrder = index

		local number = Widgets.label({
			text = tostring(index),
			size = "tiny",
			colour = Theme.colour("textFaint"),
			parent = slot,
			name = "Number",
		})
		number.Position = UDim2.fromOffset(Theme.space(0.4), Theme.space(0.2))

		local count = Widgets.label({
			text = "",
			size = "tiny",
			colour = Theme.colour("text"),
			align = Enum.TextXAlignment.Right,
			parent = slot,
			name = "Count",
		})
		count.Position = UDim2.new(1, -Theme.space(3.4), 1, -Theme.space(2))
		count.Size = UDim2.fromOffset(Theme.space(3), Theme.space(1.6))
		count.AutomaticSize = Enum.AutomaticSize.None

		table.insert(quickSlotFrames, slot)
	end
end

local function buildAmmo(parent: Instance)
	local insets = Theme.safeInsets()
	local panel = Widgets.panel({
		name = "Ammo",
		size = UDim2.fromOffset(Theme.space(14), Theme.space(5)),
		position = UDim2.new(1, -insets.right, 1, -insets.bottom - (if Theme.isTouch() then Theme.space(29) else Theme.space(7))),
		anchor = Vector2.new(1, 1),
		padding = 0.75,
		background = Theme.colour("backdrop"),
		transparency = 0.3,
		parent = parent,
	})
	panel.Visible = false
	ammoPanel = panel

	local label = Widgets.label({
		text = "",
		size = "title",
		font = Theme.Font.mono,
		align = Enum.TextXAlignment.Right,
		parent = panel,
	})
	label.Size = UDim2.fromScale(1, 1)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.TextYAlignment = Enum.TextYAlignment.Center
	ammoLabel = label
end

local function buildCrosshair(parent: Instance)
	local frame = Instance.new("Frame")
	frame.Name = "Crosshair"
	frame.BackgroundTransparency = 1
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromOffset(Theme.space(3), Theme.space(3))
	frame.Visible = false
	frame.Parent = parent

	-- A four-tick reticle with a gap, which reads clearly against dark
	-- foliage without obscuring what is being aimed at.
	for _, spec in { { 0.5, 0.15, 0.08, 0.22 }, { 0.5, 0.85, 0.08, 0.22 }, { 0.15, 0.5, 0.22, 0.08 }, { 0.85, 0.5, 0.22, 0.08 } } do
		local tick = Instance.new("Frame")
		tick.BorderSizePixel = 0
		tick.BackgroundColor3 = Theme.colour("text")
		tick.BackgroundTransparency = 0.25
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.Position = UDim2.fromScale(spec[1], spec[2])
		tick.Size = UDim2.fromScale(spec[3], spec[4])
		tick.Parent = frame
	end
	crosshair = frame
end

local function buildDowned(parent: Instance)
	local panel = Widgets.panel({
		name = "Downed",
		size = UDim2.fromOffset(Theme.space(40), Theme.space(16)),
		position = UDim2.fromScale(0.5, 0.72),
		anchor = Vector2.new(0.5, 0.5),
		padding = 1.5,
		background = Theme.colour("void"),
		transparency = 0.15,
		parent = parent,
	})
	panel.Visible = false
	downedPanel = panel

	local column = Widgets.column(panel, 0.75)

	Widgets.label({
		text = "You are down",
		size = "title",
		font = Theme.Font.display,
		colour = Theme.colour("signalRed"),
		align = Enum.TextXAlignment.Center,
		parent = column,
		layoutOrder = 1,
	})

	local text = Widgets.label({
		text = "Crawl to cover. A crew member can bring you back up.",
		size = "small",
		colour = Theme.colour("textMuted"),
		align = Enum.TextXAlignment.Center,
		parent = column,
		layoutOrder = 2,
	})
	downedText = text

	local track = Instance.new("Frame")
	track.Name = "BleedTrack"
	track.BorderSizePixel = 0
	track.BackgroundColor3 = Theme.colour("surface")
	track.Size = UDim2.new(1, 0, 0, Theme.space(1))
	track.LayoutOrder = 3
	Widgets.applyCorner(track, Theme.space(0.25))
	track.Parent = column

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.colour("signalRed")
	fill.Size = UDim2.fromScale(1, 1)
	Widgets.applyCorner(fill, Theme.space(0.25))
	fill.Parent = track
	downedRing = fill

	selfReviveButton = Widgets.button({
		text = "Emergency Stimulant",
		parent = column,
		layoutOrder = 4,
		enabled = false,
		onClick = function()
			Net.invokeServer("ReviveCommand", "buy_self")
			Net.fireServer("Analytics", "prompt_shown")
		end,
	})
	selfReviveButton.instance.Visible = false
end

local function buildNotifications(parent: Instance)
	local insets = Theme.safeInsets()
	local stack = Instance.new("Frame")
	stack.Name = "Notifications"
	stack.BackgroundTransparency = 1
	stack.AnchorPoint = Vector2.new(0.5, 0)
	stack.Position = UDim2.new(0.5, 0, 0, insets.top + Theme.space(1))
	stack.Size = UDim2.new(0, Theme.space(44), 0, 0)
	stack.AutomaticSize = Enum.AutomaticSize.Y
	stack.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = stack
	notificationStack = stack
end

local function buildCrewStrip(parent: Instance)
	local insets = Theme.safeInsets()
	local strip = Instance.new("Frame")
	strip.Name = "Crew"
	strip.BackgroundTransparency = 1
	strip.AnchorPoint = Vector2.new(0, 0.5)
	strip.Position = UDim2.new(0, insets.left, 0.5, 0)
	strip.Size = UDim2.fromOffset(Theme.space(20), Theme.space(24))
	strip.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip
	crewStrip = strip
end

--------------------------------------------------------------------------
-- Notifications
--------------------------------------------------------------------------

local KIND_COLOUR: { [string]: string } = {
	info = "cold",
	objective = "brass",
	warning = "signalAmber",
	error = "signalRed",
	achievement = "brass",
	event = "brass",
	announcement = "text",
	reward_ready = "signalGreen",
}

function HUDController.notify(payload: { [string]: any })
	local stack = notificationStack
	if not stack or payload.silent then
		return
	end

	local accent = Theme.colour(KIND_COLOUR[tostring(payload.kind)] or "text")
	local card = Widgets.panel({
		name = "Notification",
		size = UDim2.new(1, 0, 0, 0),
		padding = 1,
		background = Theme.colour("backdrop"),
		transparency = 0.1,
		parent = stack,
	})
	card.AutomaticSize = Enum.AutomaticSize.Y

	local bar = Instance.new("Frame")
	bar.Name = "Accent"
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = accent
	bar.Size = UDim2.new(0, 3, 1, 0)
	bar.Parent = card

	local column = Widgets.column(card, 0.25)
	column.Position = UDim2.fromOffset(Theme.space(1), 0)
	column.Size = UDim2.new(1, -Theme.space(1), 0, 0)

	Widgets.label({
		text = tostring(payload.title or ""),
		size = "body",
		font = Theme.Font.heading,
		colour = accent,
		parent = column,
		layoutOrder = 1,
	})
	if payload.body then
		Widgets.label({
			text = tostring(payload.body),
			size = "small",
			colour = Theme.colour("textMuted"),
			parent = column,
			layoutOrder = 2,
		})
	end

	local duration = tonumber(payload.duration) or 5
	task.delay(duration, function()
		if card.Parent then
			Widgets.fade(card, 1, 0.4)
			task.delay(0.5, function()
				card:Destroy()
			end)
		end
	end)

	-- The stack is capped, so a burst of events cannot fill the screen.
	local children = {}
	for _, child in stack:GetChildren() do
		if child:IsA("Frame") then
			table.insert(children, child)
		end
	end
	while #children > 4 do
		local oldest = table.remove(children, 1)
		if oldest then
			oldest:Destroy()
		end
	end
end

--------------------------------------------------------------------------
-- Refresh
--------------------------------------------------------------------------

local function refreshVitals()
	local vitals = StateController.get("vitals")
	local panel = vitalsPanel
	if not panel then
		return
	end
	if not vitals then
		panel.Visible = false
		return
	end
	panel.Visible = true

	local health = (vitals.health or 0) / math.max(1, vitals.maxHealth or 1)
	local stamina = (vitals.stamina or 0) / math.max(1, vitals.maxStamina or 1)
	local lamp = (vitals.flashlight or 0) / math.max(1, vitals.maxFlashlight or 1)

	healthMeter.set(health, string.format("Health  %d", math.ceil(vitals.health or 0)))
	staminaMeter.set(stamina, if vitals.exhausted then "Exhausted" else "Stamina")
	lampMeter.set(lamp, if vitals.flashlightOn then "Lamp" else "Lamp off")

	-- Colour carries the warning as well as the length, for players who
	-- cannot easily judge a short bar.
	healthMeter.setColour(if health < 0.3 then Theme.colour("signalRed") else Theme.colour("health"))
	lampMeter.setColour(
		if lamp * 100 <= Balance.Flashlight.criticalCharge
			then Theme.colour("signalRed")
			elseif lamp * 100 <= Balance.Flashlight.lowChargeWarning then Theme.colour("signalAmber")
			else Theme.colour("flashlight")
	)
end

local function refreshObjective()
	local expedition = StateController.get("expedition")
	local panel = objectivePanel
	if not panel then
		return
	end
	if not expedition or not expedition.objectives or #expedition.objectives == 0 then
		panel.Visible = false
		return
	end

	-- The first incomplete required objective is the one shown. Optional
	-- objectives never take the corner slot.
	local current: any = nil
	for _, objective in expedition.objectives do
		if not objective.complete and not objective.optional then
			current = objective
			break
		end
	end
	if not current then
		for _, objective in expedition.objectives do
			if not objective.complete then
				current = objective
				break
			end
		end
	end
	if not current then
		panel.Visible = false
		return
	end

	panel.Visible = true
	if objectiveTitle then
		objectiveTitle.Text = tostring(expedition.stationName or "") .. " - " .. tostring(current.title)
	end
	if objectiveDetail then
		objectiveDetail.Text = tostring(current.stepText or current.detail or "")
	end
	if objectiveProgress then
		if current.target and current.target > 1 then
			objectiveProgress.Text = string.format("%d of %d", current.progress or 0, current.target)
			objectiveProgress.Visible = true
		elseif current.stepProgress and current.stepProgress > 0 then
			objectiveProgress.Text = Format.percent(current.stepProgress)
			objectiveProgress.Visible = true
		else
			objectiveProgress.Visible = false
		end
	end
end

local function refreshTrain()
	local trainState = StateController.get("train")
	local panel = trainPanel
	if not panel then
		return
	end
	if not trainState or not StateController.isOnExpedition() then
		panel.Visible = false
		return
	end
	panel.Visible = true
	if speedLabel then
		speedLabel.Text = Format.speedKph(trainState.speed or 0) .. " km/h"
	end
	local fuel = (trainState.fuel or 0) / math.max(1, trainState.maxFuel or 1)
	local condition = (trainState.condition or 0) / math.max(1, trainState.maxCondition or 1)
	fuelMeter.set(fuel, "Fuel")
	conditionMeter.set(condition, "Condition")
	fuelMeter.setColour(if fuel < 0.2 then Theme.colour("signalRed") else Theme.colour("fuel"))
	conditionMeter.setColour(if condition < 0.4 then Theme.colour("signalAmber") else Theme.colour("condition"))
end

local function refreshQuickSlots()
	local inventory = StateController.get("inventory")
	for index, slot in quickSlotFrames do
		local count = slot:FindFirstChild("Count") :: TextLabel?
		local existingIcon = slot:FindFirstChild("Glyph")
		if existingIcon then
			existingIcon:Destroy()
		end

		local itemId = if inventory and inventory.quickSlots then inventory.quickSlots[index] else nil
		if type(itemId) == "string" then
			local def = ItemRegistry.getOrFallback(itemId)
			local icon = Widgets.icon(slot, def.icon or "box", Theme.space(3), Theme.colour("text"))
			icon.Name = "Glyph"
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.45)

			local quantity = 0
			if inventory and inventory.stacks then
				for _, stack in inventory.stacks do
					if stack.id == itemId then
						quantity += stack.quantity
					end
				end
			end
			if count then
				count.Text = if quantity > 1 then tostring(quantity) else ""
			end
			slot.BackgroundTransparency = 0.1
		else
			if count then
				count.Text = ""
			end
			slot.BackgroundTransparency = 0.45
		end
	end
end

local function refreshWeapon()
	local weapon = StateController.get("weapon")
	local panel = ammoPanel
	local reticle = crosshair
	if not panel or not reticle then
		return
	end
	if not weapon or not weapon.equipped then
		panel.Visible = false
		reticle.Visible = false
		InputController.setTouchVisible("fire", false)
		InputController.setTouchVisible("reload", false)
		return
	end

	InputController.setTouchVisible("fire", true)
	reticle.Visible = StateController.isOnExpedition() and not StateController.isDowned()

	if weapon.magazineSize then
		panel.Visible = true
		InputController.setTouchVisible("reload", true)
		if ammoLabel then
			if weapon.reloading then
				ammoLabel.Text = "reloading"
				ammoLabel.TextColor3 = Theme.colour("signalAmber")
			else
				ammoLabel.Text = string.format("%d / %d", weapon.magazine or 0, weapon.reserve or 0)
				ammoLabel.TextColor3 = if (weapon.magazine or 0) == 0 then Theme.colour("signalRed") else Theme.colour("text")
			end
		end
	else
		panel.Visible = false
		InputController.setTouchVisible("reload", false)
	end
end

local function refreshDowned()
	local vitals = StateController.get("vitals")
	local panel = downedPanel
	if not panel then
		return
	end
	if not vitals or vitals.state ~= "downed" then
		panel.Visible = false
		return
	end

	panel.Visible = true
	local remaining = vitals.bleedoutRemaining or 0
	local total = math.max(1, vitals.bleedoutTotal or 1)
	if downedRing then
		downedRing.Size = UDim2.fromScale(math.clamp(remaining / total, 0, 1), 1)
	end
	if downedText then
		if vitals.reviverUserId then
			downedText.Text = string.format("Being helped up. %s", Format.percent(vitals.reviveProgress or 0))
		else
			downedText.Text = string.format("Crawl to cover. %s until you bleed out.", Format.clock(remaining))
		end
	end

	-- The paid self-revive is only ever shown when the server says it is
	-- available, which excludes the case where somebody is already reviving.
	if selfReviveButton then
		local offered = vitals.selfReviveOffered == true
		selfReviveButton.instance.Visible = offered
		selfReviveButton.setEnabled(offered)
		if (vitals.bankedSelfRevives or 0) > 0 then
			selfReviveButton.setText("Use Emergency Stimulant")
		else
			selfReviveButton.setText("Emergency Stimulant")
		end
	end
end

local function refreshCrew()
	local strip = crewStrip
	local crew = StateController.get("crew")
	if not strip then
		return
	end
	strip:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip

	if not crew or not crew.members or not StateController.isOnExpedition() then
		strip.Visible = false
		return
	end
	strip.Visible = #crew.members > 1

	for index, member in crew.members do
		local card = Widgets.panel({
			name = "Member",
			size = UDim2.new(1, 0, 0, Theme.space(3.5)),
			padding = 0.5,
			background = Theme.colour("backdrop"),
			transparency = 0.35,
			stroke = false,
			parent = strip,
		})
		card.LayoutOrder = index

		local name = Widgets.label({
			text = tostring(member.displayName),
			size = "small",
			colour = if member.connected then Theme.colour("text") else Theme.colour("textFaint"),
			parent = card,
		})
		name.Size = UDim2.new(1, 0, 1, 0)
		name.AutomaticSize = Enum.AutomaticSize.None
		name.TextYAlignment = Enum.TextYAlignment.Center
		name.TextTruncate = Enum.TextTruncate.AtEnd

		if not member.connected then
			Widgets.caption(card, "reconnecting")
		end
	end
end

--------------------------------------------------------------------------

local function setVisible(visible: boolean)
	local frame = root
	if frame then
		frame.Visible = visible
	end
end

function HUDController.setVisible(visible: boolean)
	setVisible(visible)
end

function HUDController.start()
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Widgets.screen("LastSignalHUD", Theme.Layer.hud, playerGui)
	gui = screen

	local frame = Instance.new("Frame")
	frame.Name = "Root"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = screen
	root = frame

	buildVitals(frame)
	buildObjective(frame)
	buildTrain(frame)
	buildQuickSlots(frame)
	buildAmmo(frame)
	buildCrosshair(frame)
	buildDowned(frame)
	buildNotifications(frame)
	buildCrewStrip(frame)

	Net.onClientEvent("Notify", function(payload)
		if type(payload) == "table" then
			HUDController.notify(payload)
		end
	end)

	Net.onClientEvent("RewardGranted", function(payload)
		if type(payload) ~= "table" then
			return
		end
		local parts = {}
		if (payload.credits or 0) ~= 0 then
			table.insert(parts, string.format("%+d credits", payload.credits))
		end
		if (payload.xp or 0) > 0 then
			table.insert(parts, string.format("%+d XP", payload.xp))
		end
		if #parts == 0 and #(payload.unlocked or {}) == 0 then
			return
		end
		local body = table.concat(parts, "   ")
		if payload.multiplierReasons and #payload.multiplierReasons > 0 then
			body = body .. "\n" .. table.concat(payload.multiplierReasons, ", ")
		end
		HUDController.notify({
			kind = "objective",
			title = if (payload.levelsGained or 0) > 0 then string.format("Level %d", payload.level) else "Rewarded",
			body = body,
			duration = 5,
		})
	end)

	StateController.Changed:Connect(function(key)
		if key == "vitals" then
			refreshVitals()
			refreshDowned()
		elseif key == "expedition" then
			refreshObjective()
			refreshTrain()
			refreshCrew()
		elseif key == "train" then
			refreshTrain()
		elseif key == "inventory" then
			refreshQuickSlots()
		elseif key == "weapon" then
			refreshWeapon()
		elseif key == "crew" then
			refreshCrew()
		elseif key == "ui" then
			-- The HUD hides whenever a full panel or the cinematic is showing,
			-- so there is never a second layer of interface behind a menu.
			setVisible(StateController.ui("openPanel") == nil and not StateController.ui("cinematic"))
		end
	end)

	-- A slow tick keeps the bleedout clock and the speed readout live without
	-- needing a network update for every frame.
	task.spawn(function()
		while true do
			task.wait(0.1)
			if StateController.isDowned() then
				refreshDowned()
			end
		end
	end)

	refreshVitals()
	refreshObjective()
	refreshTrain()
	refreshQuickSlots()
	refreshWeapon()
	refreshCrew()

	log.info("started")
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InputController
	---------------
	Every input the game reads, and the on-screen controls for touch devices.

	ONE BINDING TABLE
	-----------------
	Actions are declared once with their keyboard key, gamepad button and
	whether they appear on the touch layout. ContextActionService binds them,
	which means a single action works identically on a keyboard, a controller
	and a phone, and the settings panel can list them without a second table
	that would drift out of date.

	TOUCH
	-----
	The touch layout is not a keyboard rendered as buttons. It is a small set
	of large targets placed where thumbs actually are, with the frequently used
	actions on the right and the occasional ones tucked into a tray. Every
	target meets the platform minimum size from Theme, and the layout respects
	the safe area so nothing sits under a home indicator or a notch.

	Drag-and-drop is deliberately not used anywhere in this project. Every
	inventory action is a tap on an item followed by a tap on an action, which
	works identically with a mouse, a thumb and a gamepad.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local StateController = require(script.Parent.StateController)

local log = Logger.new("InputController")
local player = Players.LocalPlayer

local InputController = {}

export type ActionDef = {
	id: string,
	label: string,
	description: string,
	-- Omitted for actions that are mouse-only on desktop.
	key: Enum.KeyCode?,
	gamepad: Enum.KeyCode?,
	-- Where the action appears on the touch layout, if at all.
	touch: string?, -- "primary" | "secondary" | "tray"
	-- Held actions report press and release; tapped actions report press only.
	held: boolean?,
	-- Actions that remain available while a panel is open.
	worksInMenu: boolean?,
}

local ACTIONS: { ActionDef } = {
	{ id = "interact", label = "Interact", description = "Use, search or pick up what you are looking at.", key = Enum.KeyCode.E, gamepad = Enum.KeyCode.ButtonX, touch = "primary", held = true },
	{ id = "sprint", label = "Sprint", description = "Run, while you have the stamina.", key = Enum.KeyCode.LeftShift, gamepad = Enum.KeyCode.ButtonL3, touch = "primary", held = true },
	{ id = "crouch", label = "Crouch", description = "Move slowly and quietly.", key = Enum.KeyCode.C, gamepad = Enum.KeyCode.ButtonB, touch = "secondary", held = true },
	{ id = "flashlight", label = "Lamp", description = "Toggle your lamp.", key = Enum.KeyCode.F, gamepad = Enum.KeyCode.DPadUp, touch = "primary" },
	{ id = "fire", label = "Attack", description = "Fire or swing your equipped weapon.", gamepad = Enum.KeyCode.ButtonR2, touch = "primary", held = true },
	{ id = "aim", label = "Aim", description = "Steady your aim.", gamepad = Enum.KeyCode.ButtonL2, touch = "secondary", held = true },
	{ id = "reload", label = "Reload", description = "Reload the equipped firearm.", key = Enum.KeyCode.R, gamepad = Enum.KeyCode.ButtonY, touch = "secondary" },
	{ id = "inventory", label = "Inventory", description = "Open your inventory.", key = Enum.KeyCode.Tab, gamepad = Enum.KeyCode.ButtonSelect, touch = "primary", worksInMenu = true },
	{ id = "crew", label = "Crew", description = "Open the crew panel.", key = Enum.KeyCode.G, gamepad = Enum.KeyCode.DPadLeft, touch = "tray", worksInMenu = true },
	{ id = "objectives", label = "Objectives", description = "Expand the objective list.", key = Enum.KeyCode.J, gamepad = Enum.KeyCode.DPadRight, touch = "tray", worksInMenu = true },
	{ id = "ping", label = "Ping", description = "Mark what you are looking at for your crew.", key = Enum.KeyCode.Q, gamepad = Enum.KeyCode.DPadDown, touch = "primary" },
	{ id = "menu", label = "Menu", description = "Open the main menu.", key = Enum.KeyCode.M, gamepad = Enum.KeyCode.ButtonStart, touch = "tray", worksInMenu = true },
	{ id = "skip", label = "Skip", description = "Skip the opening sequence.", key = Enum.KeyCode.Space, gamepad = Enum.KeyCode.ButtonA, touch = "primary", worksInMenu = true },
	{ id = "revive", label = "Revive", description = "Revive a downed crew member.", key = Enum.KeyCode.E, gamepad = Enum.KeyCode.ButtonX, touch = "primary", held = true },
	{ id = "quick1", label = "Slot 1", description = "Use quick slot one.", key = Enum.KeyCode.One, touch = "tray" },
	{ id = "quick2", label = "Slot 2", description = "Use quick slot two.", key = Enum.KeyCode.Two, touch = "tray" },
	{ id = "quick3", label = "Slot 3", description = "Use quick slot three.", key = Enum.KeyCode.Three, touch = "tray" },
	{ id = "quick4", label = "Slot 4", description = "Use quick slot four.", key = Enum.KeyCode.Four, touch = "tray" },
	{ id = "quick5", label = "Slot 5", description = "Use quick slot five.", key = Enum.KeyCode.Five, touch = "tray" },
}

InputController.Actions = ACTIONS

--- Fired for every action. `pressed` is false on release for held actions.
InputController.Action = Signal.new() :: Signal.Signal<string, boolean>

local suppressed = false

--- While a panel is open, gameplay actions are suppressed. Actions flagged
--- worksInMenu still fire, which is how Tab closes the inventory it opened.
function InputController.setSuppressed(value: boolean)
	suppressed = value
end

--------------------------------------------------------------------------
-- Binding
--------------------------------------------------------------------------

local function defFor(id: string): ActionDef?
	for _, def in ACTIONS do
		if def.id == id then
			return def
		end
	end
	return nil
end

local function handle(actionName: string, inputState: Enum.UserInputState): Enum.ContextActionResult
	local def = defFor(actionName)
	if not def then
		return Enum.ContextActionResult.Pass
	end
	if suppressed and not def.worksInMenu then
		return Enum.ContextActionResult.Pass
	end

	if inputState == Enum.UserInputState.Begin then
		InputController.Action:Fire(def.id, true)
	elseif inputState == Enum.UserInputState.End and def.held then
		InputController.Action:Fire(def.id, false)
	end
	return Enum.ContextActionResult.Sink
end

--------------------------------------------------------------------------
-- Touch layout
--------------------------------------------------------------------------

local touchGui: ScreenGui? = nil
local touchButtons: { [string]: TextButton } = {}
local trayOpen = false

local function buildTouchButton(parent: Instance, def: ActionDef, size: number): TextButton
	local button = Instance.new("TextButton")
	button.Name = "Touch_" .. def.id
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundColor3 = Theme.colour("surfaceRaised")
	button.BackgroundTransparency = 0.25
	button.BorderSizePixel = 0
	button.Size = UDim2.fromOffset(size, size)
	Widgets.applyCorner(button, size * 0.5)
	Widgets.applyStroke(button, Theme.colour("lineStrong"), 1.5)

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = def.label
	label.FontFace = Theme.Font.heading
	label.TextSize = Theme.textSize("tiny")
	label.TextColor3 = Theme.colour("text")
	label.TextWrapped = true
	label.Parent = button

	-- Touch buttons report press and release, so a held action such as sprint
	-- behaves the same as holding the key.
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			button.BackgroundTransparency = 0.05
			handle(def.id, Enum.UserInputState.Begin)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			button.BackgroundTransparency = 0.25
			handle(def.id, Enum.UserInputState.End)
		end
	end)

	button.Parent = parent
	touchButtons[def.id] = button
	return button
end

local function buildTouchLayout()
	if not Theme.isTouch() then
		return
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local gui = Widgets.screen("LastSignalTouch", Theme.Layer.hud + 2, playerGui)
	touchGui = gui

	local insets = Theme.safeInsets()
	local primarySize = math.max(Theme.minTouchTarget(), Theme.space(8))
	local secondarySize = math.max(Theme.minTouchTarget(), Theme.space(6))

	-- Right cluster: the actions a thumb reaches without moving.
	local rightCluster = Instance.new("Frame")
	rightCluster.Name = "Primary"
	rightCluster.BackgroundTransparency = 1
	rightCluster.AnchorPoint = Vector2.new(1, 1)
	rightCluster.Position = UDim2.new(1, -insets.right, 1, -insets.bottom)
	rightCluster.Size = UDim2.fromOffset(primarySize * 3 + Theme.space(2), primarySize * 2 + Theme.space(1))
	rightCluster.Parent = gui

	local rightGrid = Instance.new("UIGridLayout")
	rightGrid.CellSize = UDim2.fromOffset(primarySize, primarySize)
	rightGrid.CellPadding = UDim2.fromOffset(Theme.space(1), Theme.space(1))
	rightGrid.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rightGrid.VerticalAlignment = Enum.VerticalAlignment.Bottom
	rightGrid.SortOrder = Enum.SortOrder.LayoutOrder
	rightGrid.Parent = rightCluster

	-- Left side, above the thumbstick: the occasional actions.
	local leftCluster = Instance.new("Frame")
	leftCluster.Name = "Secondary"
	leftCluster.BackgroundTransparency = 1
	leftCluster.AnchorPoint = Vector2.new(0, 1)
	leftCluster.Position = UDim2.new(0, insets.left, 1, -insets.bottom - Theme.space(14))
	leftCluster.Size = UDim2.fromOffset(secondarySize, secondarySize * 3 + Theme.space(2))
	leftCluster.Parent = gui

	local leftList = Instance.new("UIListLayout")
	leftList.FillDirection = Enum.FillDirection.Vertical
	leftList.Padding = UDim.new(0, Theme.space(1))
	leftList.VerticalAlignment = Enum.VerticalAlignment.Bottom
	leftList.SortOrder = Enum.SortOrder.LayoutOrder
	leftList.Parent = leftCluster

	-- The tray: quick slots and panels, hidden until opened, so the play area
	-- is not covered by fifteen buttons.
	local tray = Instance.new("Frame")
	tray.Name = "Tray"
	tray.BackgroundColor3 = Theme.colour("backdrop")
	tray.BackgroundTransparency = 0.15
	tray.BorderSizePixel = 0
	tray.AnchorPoint = Vector2.new(1, 1)
	tray.Position = UDim2.new(1, -insets.right, 1, -insets.bottom - primarySize * 2 - Theme.space(3))
	tray.Size = UDim2.fromOffset(secondarySize * 5 + Theme.space(6), secondarySize + Theme.space(2))
	tray.Visible = false
	Widgets.applyCorner(tray)
	tray.Parent = gui

	local trayList = Instance.new("UIListLayout")
	trayList.FillDirection = Enum.FillDirection.Horizontal
	trayList.Padding = UDim.new(0, Theme.space(1))
	trayList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	trayList.VerticalAlignment = Enum.VerticalAlignment.Center
	trayList.SortOrder = Enum.SortOrder.LayoutOrder
	trayList.Parent = tray

	for index, def in ACTIONS do
		if def.touch == "primary" then
			local button = buildTouchButton(rightCluster, def, primarySize)
			button.LayoutOrder = index
		elseif def.touch == "secondary" then
			local button = buildTouchButton(leftCluster, def, secondarySize)
			button.LayoutOrder = index
		elseif def.touch == "tray" then
			local button = buildTouchButton(tray, def, secondarySize)
			button.LayoutOrder = index
		end
	end

	-- The tray toggle.
	local toggle = Instance.new("TextButton")
	toggle.Name = "TrayToggle"
	toggle.Text = ""
	toggle.AutoButtonColor = false
	toggle.BackgroundColor3 = Theme.colour("surface")
	toggle.BackgroundTransparency = 0.25
	toggle.BorderSizePixel = 0
	toggle.AnchorPoint = Vector2.new(1, 1)
	toggle.Position = UDim2.new(1, -insets.right, 1, -insets.bottom - primarySize * 2 - Theme.space(1.5))
	toggle.Size = UDim2.fromOffset(secondarySize * 1.6, secondarySize * 0.7)
	Widgets.applyCorner(toggle)
	Widgets.applyStroke(toggle, Theme.colour("line"))
	local toggleLabel = Instance.new("TextLabel")
	toggleLabel.BackgroundTransparency = 1
	toggleLabel.Size = UDim2.fromScale(1, 1)
	toggleLabel.Text = "More"
	toggleLabel.FontFace = Theme.Font.heading
	toggleLabel.TextSize = Theme.textSize("tiny")
	toggleLabel.TextColor3 = Theme.colour("textMuted")
	toggleLabel.Parent = toggle
	toggle.Activated:Connect(function()
		trayOpen = not trayOpen
		tray.Visible = trayOpen
		toggleLabel.Text = if trayOpen then "Close" else "More"
	end)
	toggle.Parent = gui

	log.info(string.format("touch layout built for %s", Theme.platform()))
end

--- Shows or hides a touch button by action id. Used to hide Attack when no
--- weapon is equipped, and Revive unless a downed teammate is in reach.
function InputController.setTouchVisible(actionId: string, visible: boolean)
	local button = touchButtons[actionId]
	if button then
		button.Visible = visible
	end
end

function InputController.setTouchLabel(actionId: string, text: string)
	local button = touchButtons[actionId]
	if button then
		local label = button:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = text
		end
	end
end

--------------------------------------------------------------------------

function InputController.start()
	for _, def in ACTIONS do
		local keys: { any } = {}
		if def.key then
			table.insert(keys, def.key)
		end
		if def.gamepad then
			table.insert(keys, def.gamepad)
		end
		-- Attack and aim are mouse buttons on desktop.
		if def.id == "fire" then
			table.insert(keys, Enum.UserInputType.MouseButton1)
		elseif def.id == "aim" then
			table.insert(keys, Enum.UserInputType.MouseButton2)
		end
		if #keys > 0 then
			ContextActionService:BindAction(def.id, handle, false, table.unpack(keys))
		end
	end

	buildTouchLayout()

	-- Report the platform once, so the analytics funnel can tell a phone
	-- session from a desktop one without collecting anything identifying.
	local platform = Theme.platform()
	Net.fireServer("Analytics", platform .. "_session")

	-- A device that rotates or attaches a keyboard changes category; the
	-- layout is rebuilt rather than left wrong.
	UserInputService.LastInputTypeChanged:Connect(function()
		local previous = Theme.platform()
		Theme.refreshPlatform()
		if Theme.platform() ~= previous then
			if touchGui then
				touchGui:Destroy()
				touchGui = nil
				table.clear(touchButtons)
			end
			buildTouchLayout()
		end
	end)

	StateController.Changed:Connect(function(key)
		if key == "ui" then
			InputController.setSuppressed(StateController.ui("openPanel") ~= nil)
		end
	end)

	log.info(string.format("started with %d actions", #ACTIONS))
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">InteractionController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InteractionController
	---------------------
	The prompt the player looks at, and the hold that fills it.

	WHY CUSTOM PROMPTS
	------------------
	Roblox's default prompt UI is fine but it is not this game's typography, it
	cannot show a required item, and it cannot show the hold progress the server
	is actually tracking. The prompts themselves are still ProximityPrompts, so
	all the distance, occlusion and input handling Roblox does well is kept;
	only the appearance is ours, via Custom style.

	NO FLOATING LABELS
	------------------
	A prompt appears only for the single nearest eligible object, only when it
	is close, and it disappears the moment it is not. There are no persistent
	name boards over items in the world: a jerry can is recognisable because it
	looks like a jerry can.

	REVIVING
	--------
	A downed teammate is an interaction like any other, with its own prompt and
	its own hold. It is deliberately the same verb and the same button, so under
	pressure there is nothing new to learn.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local ItemRegistry = require(Shared.Registry.ItemRegistry)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local InputController = require(script.Parent.InputController)
local StateController = require(script.Parent.StateController)

local log = Logger.new("InteractionController")
local player = Players.LocalPlayer

local InteractionController = {}

local gui: ScreenGui? = nil
local promptFrame: Frame? = nil
local promptLabel: TextLabel? = nil
local promptDetail: TextLabel? = nil
local promptKey: TextLabel? = nil
local holdFill: Frame? = nil

local activePrompt: ProximityPrompt? = nil
local holdStartedAt: number? = nil
local holdDuration = 0
local holdTarget: Instance? = nil
local holdAction: string? = nil

local reviveTarget: Player? = nil

--------------------------------------------------------------------------
-- Interface
--------------------------------------------------------------------------

local function build()
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Widgets.screen("LastSignalPrompt", Theme.Layer.interaction, playerGui)
	gui = screen

	local frame = Widgets.panel({
		name = "Prompt",
		size = UDim2.fromOffset(Theme.space(38), Theme.space(9)),
		position = UDim2.fromScale(0.5, 0.62),
		anchor = Vector2.new(0.5, 0.5),
		padding = 1.25,
		background = Theme.colour("backdrop"),
		transparency = 0.12,
		parent = screen,
	})
	frame.Visible = false
	promptFrame = frame

	local keyBadge = Widgets.panel({
		name = "Key",
		size = UDim2.fromOffset(Theme.space(4), Theme.space(4)),
		position = UDim2.fromScale(0, 0.5),
		anchor = Vector2.new(0, 0.5),
		background = Theme.colour("surfaceRaised"),
		parent = frame,
	})
	local key = Widgets.label({
		text = "E",
		size = "heading",
		font = Theme.Font.heading,
		align = Enum.TextXAlignment.Center,
		parent = keyBadge,
	})
	key.Size = UDim2.fromScale(1, 1)
	key.AutomaticSize = Enum.AutomaticSize.None
	key.TextYAlignment = Enum.TextYAlignment.Center
	promptKey = key

	local action = Widgets.label({
		text = "",
		size = "body",
		font = Theme.Font.heading,
		parent = frame,
		name = "Action",
	})
	action.Position = UDim2.fromOffset(Theme.space(5.5), 0)
	action.Size = UDim2.new(1, -Theme.space(6), 0, 0)
	promptLabel = action

	local detail = Widgets.label({
		text = "",
		size = "small",
		colour = Theme.colour("textMuted"),
		parent = frame,
		name = "Detail",
	})
	detail.Position = UDim2.fromOffset(Theme.space(5.5), Theme.space(2.5))
	detail.Size = UDim2.new(1, -Theme.space(6), 0, 0)
	promptDetail = detail

	-- The hold bar sits along the bottom edge of the prompt.
	local track = Instance.new("Frame")
	track.Name = "HoldTrack"
	track.BorderSizePixel = 0
	track.BackgroundColor3 = Theme.colour("void")
	track.BackgroundTransparency = 0.3
	track.AnchorPoint = Vector2.new(0.5, 1)
	track.Position = UDim2.new(0.5, 0, 1, Theme.space(1))
	track.Size = UDim2.new(1, 0, 0, 3)
	track.Visible = false
	track.Parent = frame

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.colour("brass")
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	holdFill = fill
end

local function showPrompt(action: string, detail: string, keyText: string)
	local frame = promptFrame
	if not frame then
		return
	end
	frame.Visible = true
	if promptLabel then
		promptLabel.Text = action
	end
	if promptDetail then
		promptDetail.Text = detail
		promptDetail.Visible = detail ~= ""
	end
	if promptKey then
		promptKey.Text = keyText
	end
end

local function hidePrompt()
	local frame = promptFrame
	if frame then
		frame.Visible = false
	end
	local fill = holdFill
	if fill then
		local track = fill.Parent :: Frame
		track.Visible = false
		fill.Size = UDim2.fromScale(0, 1)
	end
end

--------------------------------------------------------------------------
-- Target resolution
--------------------------------------------------------------------------

--- The action name the server expects for a given tagged object. The client
--- picks the verb; the server validates it against the object regardless.
local function actionFor(instance: Instance): (string?, string, string)
	if instance:HasTag("LootNode") then
		local searched = instance:GetAttribute("Searched")
		if searched == true then
			return nil, "", ""
		end
		local kind = instance:GetAttribute("LootKind")
		local label = if kind == "body" then "Search the remains" else "Search"
		return "search", label, ""
	end
	if instance:HasTag("StationFixture") then
		local kind = instance:GetAttribute("FixtureKind")
		local labels: { [string]: string } = {
			generator = "Start the generator",
			breaker = "Throw the breaker",
			fusebox = "Fit the fuse",
			lever = "Pull the lever",
			controls = "Use the controls",
			fuel_point = "Draw fuel",
			interlocking_frame = "Read the frame",
			relay_bay = "Fit the relay",
			stores_cage = "Open the stores",
			hydraulics = "Fit the valve",
			transmitter = "Work the transmitter",
		}
		return "operate", labels[tostring(kind)] or "Use", ""
	end
	if instance:HasTag("TrainFuelPoint") then
		return "refuel_train", "Refuel the locomotive", "Needs a jerry can"
	end
	if instance:HasTag("TrainRepairPoint") then
		return "repair_train", "Repair the locomotive", "Needs a repair kit"
	end
	if instance:HasTag("SupplyRack") then
		return "store", "Open the supply rack", ""
	end
	if instance:HasTag("RadioSet") then
		return "read", "Play a recording", ""
	end
	if instance:HasTag("EventToken") then
		return nil, "", "" -- the event's own prompt handles this
	end

	local model = instance:FindFirstAncestorOfClass("Model")
	if model and model:HasTag("DroppedItem") then
		local itemId = model:GetAttribute("ItemId")
		if type(itemId) == "string" then
			local def = ItemRegistry.getOrFallback(itemId)
			local quantity = model:GetAttribute("Quantity")
			local detail = if type(quantity) == "number" and quantity > 1 then string.format("%d", quantity) else ""
			return "pickup", def.promptVerb, detail
		end
		return "pickup", "Take", ""
	end

	if instance:HasTag("Discovery") then
		return "discover", "Look closer", ""
	end

	return nil, "", ""
end

--------------------------------------------------------------------------
-- Downed teammates
--------------------------------------------------------------------------

local function findDownedNearby(): Player?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then
		return nil
	end
	-- Downed crew members are found by their humanoid state rather than by a
	-- replicated list, so this works even if a state update is in flight.
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		local otherCharacter = other.Character
		local otherRoot = if otherCharacter then otherCharacter:FindFirstChild("HumanoidRootPart") else nil
		local humanoid = if otherCharacter then otherCharacter:FindFirstChildOfClass("Humanoid") else nil
		if otherRoot and otherRoot:IsA("BasePart") and humanoid then
			local isDowned = humanoid.WalkSpeed <= 4 and humanoid.Health <= 1
			if isDowned and (otherRoot.Position - root.Position).Magnitude < 10 then
				return other
			end
		end
	end
	return nil
end

--------------------------------------------------------------------------
-- Hold handling
--------------------------------------------------------------------------

local function beginHold(target: Instance, action: string, duration: number)
	holdTarget = target
	holdAction = action
	holdDuration = duration
	holdStartedAt = os.clock()
	local fill = holdFill
	if fill then
		(fill.Parent :: Frame).Visible = true
		fill.Size = UDim2.fromScale(0, 1)
	end
end

local function cancelHold()
	if holdTarget then
		Net.fireServer("Interact", holdTarget, "cancel")
	end
	holdTarget = nil
	holdAction = nil
	holdStartedAt = nil
	local fill = holdFill
	if fill then
		(fill.Parent :: Frame).Visible = false
		fill.Size = UDim2.fromScale(0, 1)
	end
end

local function stepHold()
	local startedAt = holdStartedAt
	local target = holdTarget
	local action = holdAction
	if not startedAt or not target or not action then
		return
	end
	local elapsed = os.clock() - startedAt
	local fraction = math.clamp(elapsed / math.max(0.01, holdDuration), 0, 1)
	local fill = holdFill
	if fill then
		fill.Size = UDim2.fromScale(fraction, 1)
	end
	if fraction >= 1 then
		-- The completion claim. The server re-checks the elapsed time against
		-- its own clock, so this cannot be rushed.
		Net.fireServer("Interact", target, action)
		holdStartedAt = nil
		holdTarget = nil
		holdAction = nil
		if fill then
			(fill.Parent :: Frame).Visible = false
		end
	end
end

--------------------------------------------------------------------------

function InteractionController.start()
	build()

	-- Roblox drives which prompt is shown; we only style it.
	ProximityPromptService.PromptShown:Connect(function(prompt)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		activePrompt = prompt
		local parent = prompt.Parent
		if not parent then
			return
		end
		local action, label, detail = actionFor(parent)
		if not action then
			-- A tagged object with nothing to do right now shows no prompt at
			-- all, rather than a prompt that does nothing.
			if prompt.ActionText ~= "" then
				showPrompt(prompt.ActionText, prompt.ObjectText, if Theme.isTouch() then "TAP" else "E")
			end
			return
		end
		showPrompt(label, detail, if Theme.isTouch() then "TAP" else "E")
		InputController.setTouchVisible("interact", true)
	end)

	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if activePrompt == prompt then
			activePrompt = nil
			hidePrompt()
			cancelHold()
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeringPlayer)
		if triggeringPlayer ~= player then
			return
		end
		local parent = prompt.Parent
		if not parent then
			return
		end
		local action = actionFor(parent)
		if not action then
			return
		end
		-- The first send tells the server we are starting; it replies with the
		-- duration, and the hold bar runs from that.
		Net.fireServer("Interact", parent, action)
	end)

	-- The server's reply to a hold start carries the authoritative duration.
	Net.onClientEvent("InteractResult", function(payload)
		if type(payload) ~= "table" then
			return
		end
		if payload.action == "hold_start" and payload.target then
			local action = actionFor(payload.target)
			if action then
				beginHold(payload.target, action, payload.duration or 1)
			end
			return
		end
		if payload.ok == false and payload.error then
			local message = tostring(payload.error)
			if string.sub(message, 1, 6) == "NEEDS:" then
				Net.fireServer("Analytics", "tutorial_prompt_seen")
				showPrompt("You need " .. string.sub(message, 7), "", "!")
				task.delay(2, hidePrompt)
			end
			cancelHold()
		end
	end)

	-- Revive is a separate prompt because a downed player is not a tagged
	-- object; it is another player.
	InputController.Action:Connect(function(actionId, pressed)
		if actionId ~= "revive" and actionId ~= "interact" then
			return
		end
		local target = reviveTarget
		if not target then
			return
		end
		if pressed then
			Net.invokeServer("ReviveCommand", "start", target.UserId)
		else
			Net.invokeServer("ReviveCommand", "stop", target.UserId)
		end
	end)

	RunService.Heartbeat:Connect(function()
		stepHold()

		-- A downed teammate takes priority over any object prompt, because it
		-- is always the more urgent thing.
		local downed = findDownedNearby()
		if downed ~= reviveTarget then
			reviveTarget = downed
			if downed then
				showPrompt("Revive " .. downed.DisplayName, "Hold to bring them back up", if Theme.isTouch() then "TAP" else "E")
				InputController.setTouchLabel("interact", "Revive")
			else
				InputController.setTouchLabel("interact", "Use")
				if not activePrompt then
					hidePrompt()
				end
			end
		end

		-- Revive progress drives the same bar. The reviving player does not
		-- receive the target.s vitals, so the bar runs locally and the server.s
		-- completion is what actually revives them.
		if reviveTarget and holdFill then
			local track = holdFill.Parent :: Frame
			track.Visible = true
			local elapsed = if holdStartedAt then (os.clock() - holdStartedAt) else 0
			holdFill.Size = UDim2.fromScale(math.clamp(elapsed / 12, 0, 1), 1)
		end
	end)

	log.info("started")
end

return InteractionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MenuController
	--------------
	Every full-screen panel: crew, loadout, inventory, shop, quests, rewards,
	achievements, leaderboards, settings, results and the admin console.

	ONE PANEL AT A TIME
	-------------------
	There is a single open panel, tracked in StateController so the HUD, the
	camera and the input layer all agree about it. Opening a second panel closes
	the first. That is what guarantees the mouse is released exactly once and
	recaptured exactly once, which is the failure this design exists to prevent.

	Closing is always available: the close button, the key that opened it, and
	tapping the backdrop. On a gamepad, the menu button closes. There is no
	state from which a player cannot get back to the game.

	NO DRAG AND DROP
	----------------
	Inventory actions are select-then-act. Tap an item, then tap Use, Drop,
	Assign or Give. That works identically with a mouse, a thumb and a stick,
	and it is the reason the inventory needs no separate mobile layout.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Balance = require(Shared.Config.Balance)
local Format = require(Shared.Core.Format)
local GameConfig = require(Shared.Config.GameConfig)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
local CosmeticRegistry = require(Shared.Registry.CosmeticRegistry)
local Theme = require(script.Parent.Parent.UI.Theme)
local Widgets = require(script.Parent.Parent.UI.Widgets)
local CameraController = require(script.Parent.CameraController)
local InputController = require(script.Parent.InputController)
local StateController = require(script.Parent.StateController)

local log = Logger.new("MenuController")
local player = Players.LocalPlayer

local MenuController = {}

local gui: ScreenGui?
local backdrop: TextButton?
local shell: Frame?
local titleLabel: TextLabel?
local body: Frame?
local currentPanel: string? = nil
local rebuild: (() -> ())? = nil

local selectedItem: string? = nil

--------------------------------------------------------------------------
-- Shell
--------------------------------------------------------------------------

local function clearBody(): Frame
	local frame = body :: Frame
	for _, child in frame:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	return frame
end

function MenuController.close()
	if not currentPanel then
		return
	end
	currentPanel = nil
	rebuild = nil
	selectedItem = nil
	if shell then
		shell.Visible = false
	end
	if backdrop then
		backdrop.Visible = false
	end
	StateController.setUi("openPanel", nil)
	-- The camera and the input layer both react to openPanel, so control is
	-- restored by exactly one path however the panel was closed.
	CameraController.restore()
end

local PANEL_TITLES: { [string]: string } = {
	main = "Menu",
	crew = "Crew",
	loadout = "Loadout",
	inventory = "Inventory",
	shop = "Stores",
	quests = "Orders",
	rewards = "Rewards",
	achievements = "Record",
	leaderboard = "Standings",
	settings = "Settings",
	admin = "Control",
	results = "Expedition Report",
	event = "Event",
}

local builders: { [string]: (Frame) -> () } = {}

function MenuController.open(panel: string)
	if not builders[panel] then
		log.warn("unknown panel:", panel)
		return
	end
	if currentPanel == panel then
		MenuController.close()
		return
	end

	currentPanel = panel
	StateController.setUi("openPanel", panel)
	if shell then
		shell.Visible = true
	end
	if backdrop then
		backdrop.Visible = true
	end
	if titleLabel then
		titleLabel.Text = PANEL_TITLES[panel] or panel
	end

	local frame = clearBody()
	rebuild = function()
		if currentPanel ~= panel then
			return
		end
		local rebuilt = clearBody()
		builders[panel](rebuilt)
	end
	builders[panel](frame)
	CameraController.restore()

	if panel == "shop" then
		Net.fireServer("Analytics", "shop_opened")
	elseif panel == "settings" then
		Net.fireServer("Analytics", "settings_opened")
	elseif panel == "quests" then
		Net.fireServer("Analytics", "quests_opened")
	elseif panel == "crew" then
		Net.fireServer("Analytics", "crew_panel_opened")
	end
end

function MenuController.isOpen(): boolean
	return currentPanel ~= nil
end

--------------------------------------------------------------------------
-- Panel: main menu
--------------------------------------------------------------------------

builders.main = function(frame: Frame)
	local column = Widgets.column(frame, 1)
	local profile = StateController.profile()

	if profile then
		local header = Widgets.panel({
			name = "Header",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1.25,
			background = Theme.colour("surface"),
			parent = column,
		})
		header.AutomaticSize = Enum.AutomaticSize.Y
		header.LayoutOrder = 0
		local headerColumn = Widgets.column(header, 0.5)
		Widgets.label({
			text = string.format("%s  -  Level %d", player.DisplayName, profile.level or 1),
			size = "title",
			font = Theme.Font.display,
			parent = headerColumn,
			layoutOrder = 1,
		})
		Widgets.statRow(headerColumn, "Credits", Format.groupedNumber(profile.credits or 0), 2)
		local xpToNext = profile.xpToNext or 0
		if xpToNext > 0 then
			Widgets.statRow(headerColumn, "Progress to next level", string.format("%d / %d", profile.xp or 0, xpToNext), 3)
			local meter = Widgets.meter(headerColumn, Theme.colour("progress"), Theme.space(1))
			meter.instance.LayoutOrder = 4
			meter.set((profile.xp or 0) / math.max(1, xpToNext))
		end
		if profile.readOnly then
			local warning = Widgets.panel({
				name = "ReadOnly",
				size = UDim2.new(1, 0, 0, 0),
				padding = 1,
				background = Theme.colour("surface"),
				parent = headerColumn,
			})
			warning.AutomaticSize = Enum.AutomaticSize.Y
			warning.LayoutOrder = 5
			Widgets.label({
				text = "Your progress is not being saved this session. Rejoining usually fixes it.",
				size = "small",
				colour = Theme.colour("signalAmber"),
				parent = warning,
			})
		end
	end

	local entries = {
		{ id = "crew", label = "Crew", detail = "Form a crew and depart." },
		{ id = "loadout", label = "Loadout", detail = "Train, livery, weapons and appearance." },
		{ id = "shop", label = "Stores", detail = "Liveries, cosmetics and supplies." },
		{ id = "quests", label = "Orders", detail = "Daily and weekly objectives." },
		{ id = "rewards", label = "Rewards", detail = "Daily login and playtime." },
		{ id = "achievements", label = "Record", detail = "Achievements and statistics." },
		{ id = "leaderboard", label = "Standings", detail = "Global boards." },
		{ id = "settings", label = "Settings", detail = "Audio, accessibility and controls." },
	}

	local eventState = StateController.get("event")
	if eventState and eventState.active then
		table.insert(entries, 4, { id = "event", label = eventState.name or "Event", detail = eventState.tagline or "" })
	end

	local admin = StateController.get("admin")
	if admin and admin.role and admin.role ~= "player" then
		table.insert(entries, { id = "admin", label = "Control", detail = "Administrative commands." })
	end

	for index, entry in entries do
		local button = Widgets.button({
			text = entry.label,
			parent = column,
			layoutOrder = index + 10,
			onClick = function()
				MenuController.open(entry.id)
			end,
		})
		button.instance.Size = UDim2.new(1, 0, 0, math.max(Theme.minTouchTarget(), Theme.space(6)))
	end
end

--------------------------------------------------------------------------
-- Panel: crew
--------------------------------------------------------------------------

builders.crew = function(frame: Frame)
	local column = Widgets.column(frame, 1)
	local crew = StateController.get("crew")

	if not crew or crew.state == "closed" then
		Widgets.label({
			text = "You are not in a crew.",
			size = "body",
			parent = column,
			layoutOrder = 1,
		})
		Widgets.caption(column, "A crew of one is a perfectly good crew. Everything in the chapter can be done alone.", 2)

		Widgets.button({
			text = "Depart alone",
			primary = true,
			parent = column,
			layoutOrder = 3,
			onClick = function()
				Net.invokeServer("CrewCommand", "solo")
				MenuController.close()
			end,
		})
		Widgets.button({
			text = "Create a public crew",
			parent = column,
			layoutOrder = 4,
			onClick = function()
				Net.invokeServer("CrewCommand", "create_public")
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end,
		})
		Widgets.button({
			text = "Create a private crew",
			parent = column,
			layoutOrder = 5,
			onClick = function()
				Net.invokeServer("CrewCommand", "create_private")
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end,
		})

		Widgets.divider(column, 6)
		Widgets.heading(column, "Open crews", 7)

		local result = Net.invokeServer("CrewCommand", "browse")
		local list = if type(result) == "table" and result.crews then result.crews else {}
		if #list == 0 then
			Widgets.emptyState(column, "No open crews on this server right now.")
		else
			for index, entry in list do
				local card = Widgets.panel({
					name = "CrewCard",
					size = UDim2.new(1, 0, 0, 0),
					padding = 1,
					background = Theme.colour("surface"),
					parent = column,
				})
				card.AutomaticSize = Enum.AutomaticSize.Y
				card.LayoutOrder = 10 + index
				local cardColumn = Widgets.column(card, 0.5)
				Widgets.label({
					text = string.format("%s  (%d/%d)", entry.name, entry.size, entry.maxSize),
					size = "body",
					font = Theme.Font.heading,
					parent = cardColumn,
					layoutOrder = 1,
				})
				Widgets.caption(cardColumn, string.format("%s  -  %s", entry.trainName, entry.difficulty), 2)
				Widgets.button({
					text = "Join",
					parent = cardColumn,
					layoutOrder = 3,
					onClick = function()
						local joinResult = Net.invokeServer("CrewCommand", "join", entry.id)
						if type(joinResult) == "table" and joinResult.ok and rebuild then
							rebuild()
						end
					end,
				})
			end
		end
		return
	end

	-- In a crew.
	Widgets.label({
		text = crew.name or "Crew",
		size = "title",
		font = Theme.Font.display,
		parent = column,
		layoutOrder = 1,
	})
	Widgets.caption(column, string.format("%s on %s", crew.trainName or "", crew.difficulty or ""), 2)

	local isLeader = crew.leaderUserId == player.UserId

	for index, member in crew.members or {} do
		local card = Widgets.panel({
			name = "Member",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1,
			background = Theme.colour("surface"),
			parent = column,
		})
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.LayoutOrder = 10 + index
		local cardColumn = Widgets.column(card, 0.25)

		local nameText = member.displayName
		if member.isLeader then
			nameText = nameText .. "  (leader)"
		end
		Widgets.label({
			text = nameText,
			size = "body",
			font = Theme.Font.heading,
			colour = if member.ready then Theme.colour("signalGreen") else Theme.colour("text"),
			parent = cardColumn,
			layoutOrder = 1,
		})
		Widgets.caption(cardColumn, string.format("Level %d  -  %s  -  %s", member.level or 1, member.role or "crew", if member.ready then "ready" else "not ready"), 2)

		if isLeader and member.userId ~= player.UserId then
			local row = Widgets.row(cardColumn, 0.5)
			row.LayoutOrder = 3
			Widgets.button({
				text = "Make leader",
				width = UDim.new(0.5, -Theme.space(0.25)),
				parent = row,
				onClick = function()
					Net.invokeServer("CrewCommand", "transfer_leader", member.userId)
					if rebuild then
						task.delay(0.2, rebuild)
					end
				end,
			})
			Widgets.button({
				text = "Remove",
				danger = true,
				width = UDim.new(0.5, -Theme.space(0.25)),
				parent = row,
				onClick = function()
					Net.invokeServer("CrewCommand", "kick", member.userId)
					if rebuild then
						task.delay(0.2, rebuild)
					end
				end,
			})
		end
	end

	Widgets.divider(column, 40)

	local me: any = nil
	for _, member in crew.members or {} do
		if member.userId == player.UserId then
			me = member
		end
	end

	Widgets.button({
		text = if me and me.ready then "Not ready" else "Ready",
		primary = not (me and me.ready),
		parent = column,
		layoutOrder = 41,
		onClick = function()
			Net.invokeServer("CrewCommand", if me and me.ready then "unready" else "ready")
			if rebuild then
				task.delay(0.2, rebuild)
			end
		end,
	})

	if isLeader then
		if crew.state == "departing" then
			Widgets.button({
				text = "Cancel departure",
				danger = true,
				parent = column,
				layoutOrder = 42,
				onClick = function()
					Net.invokeServer("CrewCommand", "cancel_depart")
					if rebuild then
						task.delay(0.2, rebuild)
					end
				end,
			})
		else
			Widgets.button({
				text = "Depart",
				primary = true,
				parent = column,
				layoutOrder = 42,
				onClick = function()
					local result = Net.invokeServer("CrewCommand", "depart")
					if type(result) == "table" and not result.ok then
						local reasons: { [string]: string } = {
							NOT_ALL_READY = "Everybody has to be ready first.",
							CREW_TOO_SMALL = "The crew is empty.",
							NOT_LEADER = "Only the crew leader can depart.",
						}
						Widgets.emptyState(column, reasons[tostring(result.error)] or "Cannot depart right now.")
					else
						MenuController.close()
					end
				end,
			})
		end
	end

	Widgets.button({
		text = "Leave crew",
		parent = column,
		layoutOrder = 43,
		onClick = function()
			Net.invokeServer("CrewCommand", "leave")
			if rebuild then
				task.delay(0.2, rebuild)
			end
		end,
	})
end

--------------------------------------------------------------------------
-- Panel: loadout
--------------------------------------------------------------------------

builders.loadout = function(frame: Frame)
	local profile = StateController.profile()
	if not profile then
		Widgets.emptyState(frame, "Loading your profile.")
		return
	end

	local scroll = Widgets.scroll(frame, 1)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function section(title: string)
		Widgets.heading(scroll, title, nextOrder())
	end

	local function choiceRow(label: string, owned: boolean, selected: boolean, detail: string, onSelect: () -> ())
		local card = Widgets.panel({
			name = "Choice",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1,
			background = if selected then Theme.colour("surfaceRaised") else Theme.colour("surface"),
			parent = scroll,
		})
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.LayoutOrder = nextOrder()
		local column = Widgets.column(card, 0.25)
		Widgets.label({
			text = label .. (if selected then "   (selected)" else ""),
			size = "body",
			font = Theme.Font.heading,
			colour = if owned then Theme.colour("text") else Theme.colour("textFaint"),
			parent = column,
			layoutOrder = 1,
		})
		if detail ~= "" then
			Widgets.caption(column, detail, 2)
		end
		if owned and not selected then
			Widgets.button({
				text = "Select",
				parent = column,
				layoutOrder = 3,
				onClick = onSelect,
			})
		elseif not owned then
			Widgets.caption(column, "Not owned. Available in Stores.", 3)
		end
	end

	section("Train")
	for _, def in TrainRegistry.allTrains() do
		local owned = StateController.owns("train", def.id)
		choiceRow(
			def.name,
			owned,
			profile.loadout.train == def.id,
			string.format("%s. %s", def.class, def.tagline),
			function()
				Net.invokeServer("CrewCommand", "set_train", def.id)
				Net.fireServer("SetSetting", "loadout_train", def.id)
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end
		)
	end

	section("Livery")
	for _, def in TrainRegistry.allLiveries() do
		local owned = StateController.owns("livery", def.id)
		choiceRow(def.name, owned, profile.loadout.livery == def.id, def.description, function()
			Net.fireServer("SetSetting", "loadout_livery", def.id)
			if rebuild then
				task.delay(0.2, rebuild)
			end
		end)
	end

	section("Interior")
	for _, def in TrainRegistry.allInteriors() do
		local owned = StateController.owns("interior", def.id)
		choiceRow(def.name, owned, profile.loadout.interior == def.id, def.description, function()
			Net.fireServer("SetSetting", "loadout_interior", def.id)
			if rebuild then
				task.delay(0.2, rebuild)
			end
		end)
	end

	section("Weapon")
	for _, def in WeaponRegistry.all() do
		local owned = def.startingLoadout or StateController.owns("weapon", def.id)
		local locked = (profile.level or 1) < def.unlockLevel
		choiceRow(
			def.name,
			owned and not locked,
			profile.loadout.primaryWeapon == def.id,
			if locked then string.format("Unlocks at level %d.", def.unlockLevel) else def.description,
			function()
				Net.fireServer("SetSetting", "loadout_primary", def.id)
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end
		)
	end

	section("Role")
	for _, role in { "crew", "driver", "mechanic", "medic", "scout", "guard" } do
		choiceRow(
			Format.titleFromId(role),
			true,
			profile.loadout.role == role,
			"A preference, not a restriction. Anybody can do anything.",
			function()
				Net.invokeServer("CrewCommand", "set_role", role)
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end
		)
	end

	section("Appearance")
	for _, slot in { "lamp", "outfit", "finish", "patch" } do
		for _, def in CosmeticRegistry.bySlot(slot :: any) do
			local owned = StateController.owns("cosmetic", def.id)
			choiceRow(def.name, owned, profile.loadout[slot] == def.id, def.description, function()
				Net.fireServer("SetSetting", "loadout_" .. slot, def.id)
				if rebuild then
					task.delay(0.2, rebuild)
				end
			end)
		end
	end
end

--------------------------------------------------------------------------
-- Panel: inventory
--------------------------------------------------------------------------

builders.inventory = function(frame: Frame)
	local inventory = StateController.get("inventory")
	if not inventory or not inventory.active then
		Widgets.emptyState(frame, "You carry nothing in the yard. Your inventory is filled on an expedition.")
		return
	end

	local column = Widgets.column(frame, 1)

	local weight = inventory.weight or 0
	local weightLimit = inventory.weightLimit or 1
	local weightMeter = Widgets.meter(column, if weight > weightLimit * 0.85 then Theme.colour("signalAmber") else Theme.colour("brass"), Theme.space(1.25))
	weightMeter.instance.LayoutOrder = 1
	weightMeter.set(weight / math.max(1, weightLimit))
	Widgets.caption(column, string.format("%.1f of %.0f kg   -   %d of %d slots", weight, weightLimit, #(inventory.stacks or {}), inventory.slotLimit or 0), 2)

	local scroll = Widgets.scroll(column, 0.5)
	scroll.LayoutOrder = 3
	scroll.Size = UDim2.new(1, 0, 1, -Theme.space(12))

	if #(inventory.stacks or {}) == 0 then
		Widgets.emptyState(scroll, "Empty. Search lockers, crates and shelves.")
	end

	for index, stack in inventory.stacks or {} do
		local def = ItemRegistry.getOrFallback(stack.id)
		local isSelected = selectedItem == stack.id

		local card = Widgets.panel({
			name = "Item",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1,
			background = if isSelected then Theme.colour("surfaceRaised") else Theme.colour("surface"),
			parent = scroll,
		})
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.LayoutOrder = index

		local icon = Widgets.icon(card, def.icon or "box", Theme.space(4), Theme.colour("brass"))
		icon.Position = UDim2.fromOffset(0, Theme.space(0.25))

		local textColumn = Widgets.column(card, 0.25)
		textColumn.Position = UDim2.fromOffset(Theme.space(5), 0)
		textColumn.Size = UDim2.new(1, -Theme.space(5), 0, 0)

		Widgets.label({
			text = string.format("%s%s", def.name, if stack.quantity > 1 then string.format("  x%d", stack.quantity) else ""),
			size = "body",
			font = Theme.Font.heading,
			parent = textColumn,
			layoutOrder = 1,
		})
		Widgets.caption(textColumn, def.description, 2)
		Widgets.caption(textColumn, string.format("%.1f kg each", def.weight), 3)

		-- Select-then-act: tapping the card selects it and reveals the actions.
		local hit = Instance.new("TextButton")
		hit.Name = "Select"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 0
		hit.Activated:Connect(function()
			selectedItem = if isSelected then nil else stack.id
			if rebuild then
				rebuild()
			end
		end)
		hit.Parent = card

		if isSelected then
			local actions = Widgets.column(textColumn, 0.5)
			actions.LayoutOrder = 4

			if def.quickUsable then
				Widgets.button({
					text = "Use",
					primary = true,
					parent = actions,
					layoutOrder = 1,
					onClick = function()
						Net.invokeServer("InventoryCommand", "use", stack.id)
					end,
				})
				local slotRow = Widgets.row(actions, 0.5)
				slotRow.LayoutOrder = 2
				for slotIndex = 1, Balance.Player.quickSlots do
					Widgets.button({
						text = tostring(slotIndex),
						width = UDim.new(1 / Balance.Player.quickSlots, -Theme.space(0.5)),
						parent = slotRow,
						onClick = function()
							Net.invokeServer("InventoryCommand", "quickslot", slotIndex, stack.id)
						end,
					})
				end
			end

			Widgets.button({
				text = if def.essential then "Store in the train" else "Drop",
				parent = actions,
				layoutOrder = 3,
				onClick = function()
					Net.invokeServer("InventoryCommand", "drop", stack.id, 1)
					selectedItem = nil
					if rebuild then
						task.delay(0.2, rebuild)
					end
				end,
			})

			-- Handing over: one button per nearby crew member.
			local crew = StateController.get("crew")
			if crew and crew.members then
				for _, member in crew.members do
					if member.userId ~= player.UserId and member.connected then
						Widgets.button({
							text = "Give to " .. member.displayName,
							parent = actions,
							layoutOrder = 4,
							onClick = function()
								local result = Net.invokeServer("InventoryCommand", "transfer", stack.id, member.userId)
								if type(result) == "table" and not result.ok then
									log.debug("transfer refused:", tostring(result.error))
								end
								if rebuild then
									task.delay(0.2, rebuild)
								end
							end,
						})
					end
				end
			end
		end
	end
end

--------------------------------------------------------------------------
-- Panel: shop
--------------------------------------------------------------------------

local shopCategory = "featured"

builders.shop = function(frame: Frame)
	local result = Net.invokeServer("ShopCommand", "catalogue")
	local catalogue = if type(result) == "table" and result.catalogue then result.catalogue else StateController.get("shop")
	if not catalogue then
		Widgets.emptyState(frame, "Loading the stores.")
		return
	end

	local column = Widgets.column(frame, 1)

	Widgets.label({
		text = string.format("%s credits", Format.groupedNumber(catalogue.credits or 0)),
		size = "body",
		font = Theme.Font.heading,
		colour = Theme.colour("brass"),
		parent = column,
		layoutOrder = 1,
	})

	if catalogue.promptBlocked then
		Widgets.caption(column, "Robux purchases are paused during this part of the expedition.", 2)
	end
	if not catalogue.anyRobuxConfigured then
		local notice = Widgets.panel({
			name = "NotConfigured",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1,
			background = Theme.colour("surface"),
			parent = column,
		})
		notice.AutomaticSize = Enum.AutomaticSize.Y
		notice.LayoutOrder = 3
		Widgets.label({
			text = "Robux products are not configured on this experience yet, so everything here shows as Unavailable. Credit purchases still work.",
			size = "small",
			colour = Theme.colour("signalAmber"),
			parent = notice,
		})
	end

	local names: { string } = {}
	local ids: { string } = {}
	for _, category in catalogue.categories or {} do
		table.insert(names, category.name)
		table.insert(ids, category.id)
	end

	local scroll = Widgets.scroll(column, 0.5)
	scroll.LayoutOrder = 10
	scroll.Size = UDim2.new(1, 0, 1, -Theme.space(16))

	local function renderCategory(categoryId: string)
		for _, child in scroll:GetChildren() do
			if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
				child:Destroy()
			end
		end

		local shown = 0
		for index, entry in catalogue.entries or {} do
			local matches = entry.category == categoryId
			if categoryId == "featured" then
				-- Featured shows one of each category, highest value first,
				-- rather than a separate hand-curated list that could drift.
				matches = entry.purchasable and (entry.category == "passes" or entry.category == "liveries")
			end
			if not matches then
				continue
			end
			shown += 1

			local card = Widgets.panel({
				name = "Product",
				size = UDim2.new(1, 0, 0, 0),
				padding = 1.25,
				background = Theme.colour("surface"),
				parent = scroll,
			})
			card.AutomaticSize = Enum.AutomaticSize.Y
			card.LayoutOrder = index

			local cardColumn = Widgets.column(card, 0.4)
			Widgets.label({
				text = entry.name,
				size = "body",
				font = Theme.Font.heading,
				parent = cardColumn,
				layoutOrder = 1,
			})
			Widgets.label({
				text = entry.blurb,
				size = "small",
				colour = Theme.colour("textMuted"),
				parent = cardColumn,
				layoutOrder = 2,
			})

			local priceText: string
			if entry.owned then
				priceText = "Owned"
			elseif entry.currency == "credits" then
				priceText = string.format("%s credits", Format.groupedNumber(entry.price or 0))
			else
				-- The live price from MarketplaceService, or Unavailable. Never
				-- a hard-coded number and never a guess.
				priceText = Format.price(entry.price)
			end
			Widgets.label({
				text = priceText,
				size = "small",
				font = Theme.Font.mono,
				colour = if entry.owned then Theme.colour("signalGreen") else Theme.colour("brass"),
				parent = cardColumn,
				layoutOrder = 3,
			})

			if entry.purchasable then
				Widgets.button({
					text = if entry.currency == "credits" then "Buy with credits" else "Buy",
					primary = entry.currency ~= "credits",
					parent = cardColumn,
					layoutOrder = 4,
					onClick = function()
						if entry.currency == "credits" then
							local buyResult = Net.invokeServer("ShopCommand", "buy_credits", entry.key)
							if type(buyResult) == "table" and buyResult.ok and rebuild then
								rebuild()
							end
						else
							Net.fireServer("Analytics", "prompt_shown")
							Net.invokeServer("ShopCommand", "prompt_robux", entry.key)
						end
					end,
				})
			elseif entry.unavailableReason then
				Widgets.caption(cardColumn, entry.unavailableReason, 4)
			end
		end

		if shown == 0 then
			Widgets.emptyState(scroll, "Nothing here at the moment.")
		end
	end

	local _, select = Widgets.tabs(column, names, function(index)
		shopCategory = ids[index] or "featured"
		Net.fireServer("Analytics", "shop_category_viewed")
		renderCategory(shopCategory)
	end)
	local startIndex = table.find(ids, shopCategory) or 1
	select(startIndex)
end

--------------------------------------------------------------------------
-- Panel: quests
--------------------------------------------------------------------------

builders.quests = function(frame: Frame)
	Net.invokeServer("RewardCommand", "refresh_quests")
	local quests = StateController.get("quests")
	if not quests then
		Widgets.emptyState(frame, "Loading your orders.")
		return
	end

	local scroll = Widgets.scroll(frame, 1)

	local function renderGroup(title: string, list: { any }, resetIn: number?, order: number)
		Widgets.heading(scroll, title, order)
		if resetIn then
			Widgets.caption(scroll, "Resets in " .. Format.duration(resetIn), order + 1)
		end
		if #list == 0 then
			Widgets.emptyState(scroll, "Nothing here yet.")
			return
		end
		for index, quest in list do
			local card = Widgets.panel({
				name = "Quest",
				size = UDim2.new(1, 0, 0, 0),
				padding = 1.25,
				background = Theme.colour("surface"),
				parent = scroll,
			})
			card.AutomaticSize = Enum.AutomaticSize.Y
			card.LayoutOrder = order + 1 + index

			local column = Widgets.column(card, 0.4)
			Widgets.label({
				text = quest.name .. (if quest.cooperative then "   (crew)" else ""),
				size = "body",
				font = Theme.Font.heading,
				parent = column,
				layoutOrder = 1,
			})
			Widgets.caption(column, quest.description, 2)

			local meter = Widgets.meter(column, Theme.colour("progress"), Theme.space(1))
			meter.instance.LayoutOrder = 3
			meter.set((quest.progress or 0) / math.max(1, quest.target or 1))
			Widgets.caption(column, string.format("%d / %d   -   %d credits, %d XP", quest.progress or 0, quest.target or 0, quest.credits or 0, quest.xp or 0), 4)

			if quest.claimed then
				Widgets.caption(column, "Claimed.", 5)
			elseif (quest.progress or 0) >= (quest.target or 1) then
				Widgets.button({
					text = "Claim",
					primary = true,
					parent = column,
					layoutOrder = 5,
					onClick = function()
						Net.invokeServer("RewardCommand", "claim_quest", quest.id)
						if rebuild then
							task.delay(0.3, rebuild)
						end
					end,
				})
			end
		end
	end

	renderGroup("Daily", quests.daily or {}, quests.dailyResetIn, 1)
	renderGroup("Weekly", quests.weekly or {}, quests.weeklyResetIn, 100)
	renderGroup("Chapter milestones", quests.milestones or {}, nil, 200)
end

--------------------------------------------------------------------------
-- Panel: rewards
--------------------------------------------------------------------------

builders.rewards = function(frame: Frame)
	local result = Net.invokeServer("RewardCommand", "reward_state")
	local column = Widgets.column(frame, 1)

	if type(result) ~= "table" or not result.ok then
		Widgets.emptyState(column, "Rewards are unavailable right now.")
		return
	end

	local login = result.login
	local playtime = result.playtime

	Widgets.heading(column, "Daily login", 1)
	Widgets.caption(column, string.format("Current streak: %d days. Best: %d.", login.streak or 0, login.streak or 0), 2)
	Widgets.caption(column, "Missing a day steps your streak back by one. It is never reset, and nothing here can be bought.", 3)

	if login.available then
		Widgets.button({
			text = string.format("Claim %d credits", login.credits or 0),
			primary = true,
			parent = column,
			layoutOrder = 4,
			onClick = function()
				Net.invokeServer("RewardCommand", "claim_login")
				if rebuild then
					task.delay(0.3, rebuild)
				end
			end,
		})
	else
		Widgets.caption(column, "Claimed today. Back in " .. Format.duration(login.resetIn or 0) .. ".", 4)
	end

	Widgets.divider(column, 10)
	Widgets.heading(column, "Playtime", 11)

	local meter = Widgets.meter(column, Theme.colour("progress"), Theme.space(1))
	meter.instance.LayoutOrder = 12
	local interval = Balance.Economy.playtimeRewardIntervalSeconds
	local progress = ((playtime.secondsToday or 0) % interval) / interval
	meter.set(progress)
	Widgets.caption(column, string.format("%d of %d claimed today.", playtime.claimed or 0, playtime.maximum or 0), 13)

	if playtime.available then
		Widgets.button({
			text = string.format("Claim %d credits", Balance.Economy.playtimeRewardCredits),
			primary = true,
			parent = column,
			layoutOrder = 14,
			onClick = function()
				Net.invokeServer("RewardCommand", "claim_playtime")
				if rebuild then
					task.delay(0.3, rebuild)
				end
			end,
		})
	end
end

--------------------------------------------------------------------------
-- Panel: achievements
--------------------------------------------------------------------------

builders.achievements = function(frame: Frame)
	local profile = StateController.profile()
	if not profile then
		Widgets.emptyState(frame, "Loading.")
		return
	end

	local scroll = Widgets.scroll(frame, 1)
	Widgets.heading(scroll, "Statistics", 1)

	local interesting = {
		{ "expeditions_completed", "Expeditions completed" },
		{ "stations_cleared", "Stations cleared" },
		{ "revives_given", "Crew revived" },
		{ "records_found", "Records recovered" },
		{ "discoveries_found", "Discoveries" },
		{ "creature_repelled", "Times it was driven off" },
		{ "false_instructions_ignored", "False transmissions ignored" },
		{ "distance_driven", "Track driven (studs)" },
		{ "times_downed", "Times downed" },
	}
	for index, entry in interesting do
		Widgets.statRow(scroll, entry[2], Format.groupedNumber(profile.stats[entry[1]] or 0), 1 + index)
	end

	Widgets.divider(scroll, 50)
	Widgets.heading(scroll, "Achievements", 51)
	Widgets.caption(scroll, "Unlocked achievements are shown with the date you earned them.", 52)

	for id, unlockedAt in profile.achievements or {} do
		Widgets.statRow(scroll, Format.titleFromId(id), os.date("!%d %b %Y", unlockedAt), 60)
	end
end

--------------------------------------------------------------------------
-- Panel: leaderboard
--------------------------------------------------------------------------

local leaderboardId = "completions"

builders.leaderboard = function(frame: Frame)
	local result = Net.invokeServer("LeaderboardData", leaderboardId)
	if type(result) ~= "table" or not result.ok then
		Widgets.emptyState(frame, "Standings are unavailable right now.")
		return
	end

	local column = Widgets.column(frame, 1)
	local names: { string } = {}
	local ids: { string } = {}
	for _, board in result.boards or {} do
		table.insert(names, board.name)
		table.insert(ids, board.id)
	end

	local scroll = Widgets.scroll(column, 0.25)
	scroll.LayoutOrder = 10
	scroll.Size = UDim2.new(1, 0, 1, -Theme.space(10))

	local function render(entries: { any }, format: string)
		for _, child in scroll:GetChildren() do
			if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
				child:Destroy()
			end
		end
		if result.available == false then
			Widgets.emptyState(scroll, "Leaderboards need a published place; they are inactive in Studio.")
			return
		end
		if #entries == 0 then
			Widgets.emptyState(scroll, "No entries yet. Be the first.")
			return
		end
		for _, entry in entries do
			local value = if format == "duration" then Format.clock(entry.value) else Format.groupedNumber(entry.value)
			Widgets.statRow(scroll, string.format("%d.  %s", entry.rank, entry.name), value, entry.rank)
		end
	end

	local _, select = Widgets.tabs(column, names, function(index)
		leaderboardId = ids[index] or "completions"
		local refreshed = Net.invokeServer("LeaderboardData", leaderboardId)
		if type(refreshed) == "table" then
			local format = "number"
			for _, board in refreshed.boards or {} do
				if board.id == leaderboardId then
					format = board.format
				end
			end
			render(refreshed.entries or {}, format)
		end
	end)
	select(table.find(ids, leaderboardId) or 1)
end

--------------------------------------------------------------------------
-- Panel: settings
--------------------------------------------------------------------------

local function slider(parent: Instance, label: string, value: number, order: number, onChange: (number) -> ())
	local card = Widgets.panel({
		name = "Slider",
		size = UDim2.new(1, 0, 0, 0),
		padding = 1,
		background = Theme.colour("surface"),
		parent = parent,
	})
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.LayoutOrder = order

	local column = Widgets.column(card, 0.5)
	local text = Widgets.label({
		text = string.format("%s   %d%%", label, math.floor(value * 100 + 0.5)),
		size = "small",
		parent = column,
		layoutOrder = 1,
	})

	-- Stepped buttons rather than a drag track: a drag target is unreliable on
	-- touch and impossible on a gamepad, and precision is not needed here.
	local row = Widgets.row(column, 0.5)
	row.LayoutOrder = 2
	local current = value
	local function apply(delta: number)
		current = math.clamp(current + delta, 0, 1)
		text.Text = string.format("%s   %d%%", label, math.floor(current * 100 + 0.5))
		onChange(current)
	end
	Widgets.button({ text = "-", width = UDim.new(0.5, -Theme.space(0.25)), parent = row, onClick = function()
		apply(-0.1)
	end })
	Widgets.button({ text = "+", width = UDim.new(0.5, -Theme.space(0.25)), parent = row, onClick = function()
		apply(0.1)
	end })
end

local function toggle(parent: Instance, label: string, detail: string, value: boolean, order: number, onChange: (boolean) -> ())
	local card = Widgets.panel({
		name = "Toggle",
		size = UDim2.new(1, 0, 0, 0),
		padding = 1,
		background = Theme.colour("surface"),
		parent = parent,
	})
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.LayoutOrder = order

	local column = Widgets.column(card, 0.4)
	Widgets.label({ text = label, size = "body", font = Theme.Font.heading, parent = column, layoutOrder = 1 })
	if detail ~= "" then
		Widgets.caption(column, detail, 2)
	end
	local current = value
	local button
	button = Widgets.button({
		text = if current then "On" else "Off",
		parent = column,
		layoutOrder = 3,
		onClick = function()
			current = not current
			button.setText(if current then "On" else "Off")
			onChange(current)
		end,
	})
end

builders.settings = function(frame: Frame)
	local scroll = Widgets.scroll(frame, 1)
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local function setSetting(name: string, value: any)
		Net.fireServer("SetSetting", name, value)
	end

	Widgets.heading(scroll, "Audio", nextOrder())
	local volumes = {
		{ "masterVolume", "Master" },
		{ "musicVolume", "Music" },
		{ "ambienceVolume", "Ambience" },
		{ "sfxVolume", "Effects" },
		{ "trainVolume", "Train" },
		{ "voiceVolume", "Radio and voice" },
		{ "uiVolume", "Interface" },
		{ "creatureVolume", "Threat" },
	}
	for _, entry in volumes do
		local key = entry[1]
		slider(scroll, entry[2], StateController.setting(key, 0.8), nextOrder(), function(value)
			setSetting(key, value)
		end)
	end

	Widgets.heading(scroll, "Accessibility", nextOrder())
	toggle(scroll, "Subtitles", "Shows spoken lines and important sounds as text.", StateController.setting("subtitles", true) == true, nextOrder(), function(value)
		setSetting("subtitles", value)
	end)
	toggle(scroll, "Directional sound cues", "Draws an on-screen arrow towards important sounds.", StateController.setting("directionalCues", false) == true, nextOrder(), function(value)
		setSetting("directionalCues", value)
	end)
	toggle(scroll, "Reduced motion", "Removes camera sway, bob and panel animation.", StateController.setting("reducedMotion", false) == true, nextOrder(), function(value)
		setSetting("reducedMotion", value)
		Theme.setReducedMotion(value)
	end)
	toggle(scroll, "Reduced flashing", "Removes rapid light flicker effects.", StateController.setting("reducedFlashing", false) == true, nextOrder(), function(value)
		setSetting("reducedFlashing", value)
		Theme.setReducedFlashing(value)
	end)
	toggle(scroll, "High contrast interface", "Stronger borders and brighter text.", StateController.setting("highContrast", false) == true, nextOrder(), function(value)
		setSetting("highContrast", value)
		Theme.setHighContrast(value)
	end)

	Widgets.heading(scroll, "Camera and controls", nextOrder())
	slider(scroll, "Camera shake", StateController.setting("cameraShake", 1), nextOrder(), function(value)
		setSetting("cameraShake", value)
	end)
	toggle(scroll, "Hold to sprint", "Off means sprint toggles instead.", StateController.setting("holdToSprint", true) == true, nextOrder(), function(value)
		setSetting("holdToSprint", value)
	end)
	toggle(scroll, "Invert vertical look", "", StateController.setting("invertY", false) == true, nextOrder(), function(value)
		setSetting("invertY", value)
	end)

	Widgets.heading(scroll, "Controls reference", nextOrder())
	for _, action in InputController.Actions do
		local keyName = if action.key then action.key.Name else "Mouse"
		Widgets.statRow(scroll, action.label, keyName, nextOrder())
	end

	Widgets.divider(scroll, nextOrder())
	Widgets.caption(scroll, string.format("%s  build %s", GameConfig.GameName, GameConfig.BuildId), nextOrder())
end

--------------------------------------------------------------------------
-- Panel: event
--------------------------------------------------------------------------

builders.event = function(frame: Frame)
	Net.invokeServer("EventCommand", "state")
	local event = StateController.get("event")
	if not event or not event.active then
		Widgets.emptyState(frame, "No event is running at the moment.")
		return
	end

	local scroll = Widgets.scroll(frame, 1)
	Widgets.label({
		text = event.name,
		size = "title",
		font = Theme.Font.display,
		colour = Theme.colour("brass"),
		parent = scroll,
		layoutOrder = 1,
	})
	Widgets.caption(scroll, event.tagline or "", 2)
	Widgets.label({ text = event.description or "", size = "small", colour = Theme.colour("textMuted"), parent = scroll, layoutOrder = 3 })

	Widgets.statRow(scroll, event.tokenName or "Tokens", Format.groupedNumber(event.tokens or 0), 4)
	if not event.accepting then
		Widgets.caption(scroll, "The event has ended. You can still claim what you earned.", 5)
	end

	for index, reward in event.rewards or {} do
		local card = Widgets.panel({
			name = "Reward",
			size = UDim2.new(1, 0, 0, 0),
			padding = 1.25,
			background = Theme.colour("surface"),
			parent = scroll,
		})
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.LayoutOrder = 10 + index

		local column = Widgets.column(card, 0.4)
		Widgets.label({ text = reward.title, size = "body", font = Theme.Font.heading, parent = column, layoutOrder = 1 })
		Widgets.caption(column, reward.description, 2)
		local meter = Widgets.meter(column, Theme.colour("brass"), Theme.space(1))
		meter.instance.LayoutOrder = 3
		meter.set(math.clamp((event.tokens or 0) / math.max(1, reward.threshold), 0, 1))
		Widgets.caption(column, string.format("%d / %d", math.min(event.tokens or 0, reward.threshold), reward.threshold), 4)

		if reward.claimed then
			Widgets.caption(column, "Claimed.", 5)
		elseif reward.earned then
			Widgets.button({
				text = "Claim",
				primary = true,
				parent = column,
				layoutOrder = 5,
				onClick = function()
					Net.invokeServer("EventCommand", "claim", reward.threshold)
					if rebuild then
						task.delay(0.3, rebuild)
					end
				end,
			})
		end
	end
end

--------------------------------------------------------------------------
-- Panel: results
--------------------------------------------------------------------------

local lastResults: { [string]: any }? = nil

builders.results = function(frame: Frame)
	local results = lastResults
	if not results then
		Widgets.emptyState(frame, "No report available.")
		return
	end

	local scroll = Widgets.scroll(frame, 1)
	Widgets.label({
		text = if results.success then "The signal is out" else "The line went quiet",
		size = "display",
		font = Theme.Font.display,
		colour = if results.success then Theme.colour("signalGreen") else Theme.colour("signalRed"),
		parent = scroll,
		layoutOrder = 1,
	})
	Widgets.caption(scroll, if results.success then "Chapter One complete." else "The expedition ended early.", 2)

	Widgets.statRow(scroll, "Time", Format.clock(results.elapsed or 0), 3)
	Widgets.statRow(scroll, "Stations cleared", string.format("%d of %d", results.stationsCleared or 0, results.stationCount or 5), 4)
	Widgets.statRow(scroll, "Optional objectives", tostring(results.optionalCleared or 0), 5)
	Widgets.statRow(scroll, "Discoveries", tostring(results.discoveries or 0), 6)
	Widgets.statRow(scroll, "Crew revived", tostring(results.revives or 0), 7)
	Widgets.statRow(scroll, "Times downed", tostring(results.downs or 0), 8)
	Widgets.statRow(scroll, "False transmissions ignored", tostring(results.falseIgnored or 0), 9)
	Widgets.statRow(scroll, "False transmissions followed", tostring(results.falseFollowed or 0), 10)
	Widgets.divider(scroll, 11)
	Widgets.statRow(scroll, "Credits earned", Format.groupedNumber(results.credits or 0), 12)
	Widgets.statRow(scroll, "XP earned", Format.groupedNumber(results.xp or 0), 13)
	if (results.levelsGained or 0) > 0 then
		Widgets.statRow(scroll, "Levels gained", string.format("%d  (now %d)", results.levelsGained, results.level), 14)
	end

	Widgets.button({
		text = "Back to the yard",
		primary = true,
		parent = scroll,
		layoutOrder = 20,
		onClick = function()
			MenuController.close()
		end,
	})
end

--------------------------------------------------------------------------
-- Panel: admin
--------------------------------------------------------------------------

builders.admin = function(frame: Frame)
	local admin = StateController.get("admin")
	if not admin or not admin.role or admin.role == "player" then
		Widgets.emptyState(frame, "You do not have administrative access.")
		return
	end

	local column = Widgets.column(frame, 1)
	Widgets.caption(column, string.format("Signed in as %s.", admin.role), 1)
	Widgets.caption(column, "Every command is re-checked on the server against your user ID. This panel is a convenience, not an authorisation.", 2)

	local input = Instance.new("TextBox")
	input.Name = "Command"
	input.Size = UDim2.new(1, 0, 0, Theme.minTouchTarget())
	input.BackgroundColor3 = Theme.colour("surfaceRaised")
	input.BorderSizePixel = 0
	input.FontFace = Theme.Font.mono
	input.TextSize = Theme.textSize("body")
	input.TextColor3 = Theme.colour("text")
	input.PlaceholderText = "command argument argument"
	input.ClearTextOnFocus = false
	input.LayoutOrder = 3
	Widgets.applyCorner(input)
	input.Parent = column

	local output = Widgets.label({
		text = "",
		size = "small",
		font = Theme.Font.mono,
		colour = Theme.colour("textMuted"),
		parent = column,
		layoutOrder = 4,
	})

	local function run()
		local text = input.Text
		if text == "" then
			return
		end
		local parts: { string } = {}
		for word in string.gmatch(text, "%S+") do
			table.insert(parts, word)
		end
		local command = table.remove(parts, 1)
		local a, b, c = parts[1], parts[2], parts[3]
		-- Numeric arguments are sent as numbers so the server's guards accept
		-- them without having to parse strings.
		local result = Net.invokeServer("AdminCommand", command, tonumber(a) or a, tonumber(b) or b, tonumber(c) or c)
		if type(result) == "table" then
			if result.ok then
				output.Text = tostring(result.message or "ok")
				output.TextColor3 = Theme.colour("signalGreen")
			else
				output.Text = tostring(result.message or result.error or "failed")
				output.TextColor3 = Theme.colour("signalRed")
			end
		end
		input.Text = ""
	end

	input.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			run()
		end
	end)
	Widgets.button({ text = "Run", primary = true, parent = column, layoutOrder = 5, onClick = run })

	Widgets.divider(column, 6)
	Widgets.heading(column, "Commands", 7)
	local scroll = Widgets.scroll(column, 0.25)
	scroll.LayoutOrder = 8
	scroll.Size = UDim2.new(1, 0, 1, -Theme.space(24))
	for index, entry in admin.commands or {} do
		Widgets.statRow(scroll, entry.usage, entry.description, index)
	end
end

--------------------------------------------------------------------------

function MenuController.start()
	local playerGui = player:WaitForChild("PlayerGui")
	local screen = Widgets.screen("LastSignalMenu", Theme.Layer.panel, playerGui)
	gui = screen

	backdrop = Widgets.modalBackdrop(screen, function()
		MenuController.close()
	end)
	;(backdrop :: TextButton).Visible = false

	local insets = Theme.safeInsets()
	-- On a phone the panel is full width; on a desktop it is a centred column,
	-- because a full-width panel on a wide screen is unreadable.
	local width = if Theme.platform() == "phone" then UDim.new(1, -insets.left - insets.right) else UDim.new(0, Theme.space(60))

	local frame = Widgets.panel({
		name = "Shell",
		size = UDim2.new(width, UDim.new(1, -insets.top - insets.bottom - Theme.space(2))),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		padding = 1.5,
		background = Theme.colour("backdrop"),
		parent = screen,
	})
	frame.Visible = false
	shell = frame

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, Theme.minTouchTarget())
	header.Parent = frame

	titleLabel = Widgets.label({
		text = "",
		size = "title",
		font = Theme.Font.display,
		parent = header,
	})
	local resolvedTitle = titleLabel :: TextLabel
	resolvedTitle.Size = UDim2.new(1, -Theme.minTouchTarget(), 1, 0)
	resolvedTitle.AutomaticSize = Enum.AutomaticSize.None
	resolvedTitle.TextYAlignment = Enum.TextYAlignment.Center

	Widgets.button({
		text = "Close",
		width = UDim.new(0, Theme.space(9)),
		parent = header,
		onClick = function()
			MenuController.close()
		end,
	}).instance.Position = UDim2.new(1, -Theme.space(9), 0, 0)

	local bodyFrame = Instance.new("Frame")
	bodyFrame.Name = "Body"
	bodyFrame.BackgroundTransparency = 1
	bodyFrame.Position = UDim2.fromOffset(0, Theme.minTouchTarget() + Theme.space(1))
	bodyFrame.Size = UDim2.new(1, 0, 1, -Theme.minTouchTarget() - Theme.space(1))
	bodyFrame.ClipsDescendants = true
	bodyFrame.Parent = frame
	body = bodyFrame

	InputController.Action:Connect(function(actionId, pressed)
		if not pressed then
			return
		end
		if actionId == "menu" then
			MenuController.open("main")
		elseif actionId == "inventory" then
			MenuController.open(if StateController.isOnExpedition() then "inventory" else "loadout")
		elseif actionId == "crew" then
			MenuController.open("crew")
		elseif actionId == "objectives" then
			MenuController.open("quests")
		end
	end)

	Net.onClientEvent("ExpeditionState", function(payload)
		if type(payload) == "table" and payload.state == "results" then
			lastResults = payload
			MenuController.open("results")
		end
	end)

	Net.onClientEvent("PurchaseResult", function(payload)
		if type(payload) ~= "table" then
			return
		end
		if currentPanel == "shop" and rebuild then
			task.delay(0.5, rebuild)
		end
	end)

	log.info("started")
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	StateController
	---------------
	The client's single copy of everything the server has told it.

	Every other controller reads from here and subscribes to changes. Nothing
	else on the client binds a network handler for state, which means there is
	one place where replicated state lives, one place it is validated, and no
	possibility of two panels disagreeing about the player's credit balance.

	State is read-only to consumers. A controller that wants to change something
	sends a command to the server and waits for the state to come back, which is
	what keeps the client from ever showing an outcome the server did not agree
	to.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)

local StateController = {}

export type Store = {
	profile: { [string]: any }?,
	crew: { [string]: any }?,
	crewList: { any },
	expedition: { [string]: any }?,
	vitals: { [string]: any }?,
	downed: { [string]: any }?,
	train: { [string]: any }?,
	inventory: { [string]: any }?,
	weapon: { [string]: any }?,
	shop: { [string]: any }?,
	quests: { [string]: any }?,
	event: { [string]: any }?,
	admin: { [string]: any }?,
	rewards: { [string]: any }?,
	-- Local, not replicated: which panel is open, current platform, and so on.
	ui: { [string]: any },
}

local store: Store = {
	profile = nil,
	crew = nil,
	crewList = {},
	expedition = nil,
	vitals = nil,
	downed = nil,
	train = nil,
	inventory = nil,
	weapon = nil,
	shop = nil,
	quests = nil,
	event = nil,
	admin = nil,
	rewards = nil,
	ui = { openPanel = nil, hudVisible = true, cinematic = false },
}

StateController.Changed = Signal.new() :: Signal.Signal<string, any>

--- Reads a slice. Returns the live table; callers must not mutate it.
function StateController.get(key: string): any
	return (store :: any)[key]
end

function StateController.profile(): { [string]: any }?
	return store.profile
end

local function set(key: string, value: any)
	(store :: any)[key] = value
	StateController.Changed:Fire(key, value)
end

StateController.set = set

--- Convenience for the UI layer's own state, which is not replicated.
function StateController.setUi(key: string, value: any)
	store.ui[key] = value
	StateController.Changed:Fire("ui", store.ui)
end

function StateController.ui(key: string): any
	return store.ui[key]
end

--------------------------------------------------------------------------
-- Derived helpers, so panels do not each re-derive the same thing
--------------------------------------------------------------------------

function StateController.credits(): number
	local profile = store.profile
	return if profile then profile.credits or 0 else 0
end

function StateController.level(): number
	local profile = store.profile
	return if profile then profile.level or 1 else 1
end

function StateController.owns(kind: string, id: string): boolean
	local profile = store.profile
	if not profile then
		return false
	end
	local bucket = profile[kind .. "s"]
	if type(bucket) ~= "table" then
		return false
	end
	return bucket[id] == true
end

function StateController.setting(name: string, fallback: any): any
	local profile = store.profile
	if not profile or type(profile.settings) ~= "table" then
		return fallback
	end
	local value = profile.settings[name]
	if value == nil then
		return fallback
	end
	return value
end

function StateController.isOnExpedition(): boolean
	local expedition = store.expedition
	if not expedition then
		return false
	end
	local state = expedition.state
	return state ~= nil and state ~= "lobby" and state ~= "results" and state ~= "cancelled"
end

function StateController.isDowned(): boolean
	local vitals = store.vitals
	return vitals ~= nil and vitals.state == "downed"
end

function StateController.isDead(): boolean
	local vitals = store.vitals
	return vitals ~= nil and vitals.state == "dead"
end

--------------------------------------------------------------------------

function StateController.start()
	Net.onClientEvent("ProfileSnapshot", function(payload)
		if type(payload) == "table" then
			set("profile", payload)
		end
	end)

	Net.onClientEvent("ProfileDelta", function(payload)
		if type(payload) ~= "table" or not store.profile then
			return
		end
		-- A delta merges into the existing profile rather than replacing it,
		-- so a partial update cannot blank a field the server did not send.
		local profile = store.profile :: { [string]: any }
		for key, value in payload do
			profile[key] = value
		end
		set("profile", profile)
	end)

	Net.onClientEvent("CrewState", function(payload)
		set("crew", payload)
	end)

	Net.onClientEvent("ExpeditionState", function(payload)
		if type(payload) ~= "table" then
			return
		end
		set("expedition", payload)
		-- Leaving an expedition clears everything scoped to it, so a stale
		-- inventory or objective list can never linger in the lobby.
		if payload.state == "lobby" or payload.state == "cancelled" then
			set("inventory", nil)
			set("vitals", nil)
			set("downed", nil)
			set("train", nil)
			set("weapon", nil)
		end
	end)

	Net.onClientEvent("VitalsState", function(payload)
		set("vitals", payload)
	end)

	Net.onClientEvent("DownedState", function(payload)
		set("downed", payload)
	end)

	Net.onClientEvent("TrainState", function(payload)
		set("train", payload)
	end)

	Net.onClientEvent("Inventory", function(payload)
		set("inventory", payload)
	end)

	Net.onClientEvent("ShopState", function(payload)
		set("shop", payload)
	end)

	Net.onClientEvent("QuestState", function(payload)
		set("quests", payload)
	end)

	Net.onClientEvent("EventState", function(payload)
		set("event", payload)
	end)

	Net.onClientEvent("AdminState", function(payload)
		set("admin", payload)
	end)

	Net.onClientEvent("WeaponEffect", function(payload)
		-- Only the state messages update the store; the rest are effects and
		-- belong to WeaponController.
		if type(payload) == "table" and payload.kind == "state" then
			set("weapon", payload)
		end
	end)

	Net.onClientEvent("Notify", function(payload)
		if type(payload) == "table" and payload.kind == "rewards_state" then
			set("rewards", payload)
		end
	end)

	-- Ask for a snapshot in case this client connected after the server had
	-- already pushed one.
	task.spawn(function()
		for _ = 1, 3 do
			if store.profile then
				return
			end
			Net.invokeServer("RequestProfile")
			task.wait(2)
		end
	end)
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">TrainRideController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	TrainRideController
	-------------------
	Keeps the player with the train while the train moves.

	THE PROBLEM
	-----------
	The train is an anchored rigid assembly moved by CFrame on the server (see
	TrainService for why). An anchored part imparts no velocity to what stands
	on it, so without this controller a player standing in a moving carriage
	would simply be left behind as the carriage slid out from under them.

	Every other approach was worse. Welding players to the floor removes their
	ability to walk. Unanchored physics rolling stock jitters and stretches with
	six players aboard. Moving the world around a stationary train breaks
	streaming and every position the server holds.

	THE SOLUTION
	------------
	The client owns its own character's physics, so the client is the correct
	place to do this. Each frame, this controller computes how far the train
	moved since the last frame and applies exactly that delta to the character's
	root. The player's own walking is unaffected, because it happens in the same
	frame on top of the delta. The result is smooth at any framerate and on any
	connection, because nothing is being predicted or corrected.

	CORRECTNESS DETAILS THAT MATTER
	-------------------------------
	  - The delta is applied only while the character is inside the train's
	    volume, tested in the train's local space so it works at any position.
	  - Entering and leaving are hysteretic: the volume used to leave is
	    slightly larger than the one used to enter, so standing exactly on the
	    boundary does not flicker.
	  - Vertical velocity is preserved, so jumping inside a moving carriage
	    works and lands correctly.
	  - Nothing is applied while the character is falling outside the train,
	    so jumping off a moving train genuinely leaves you behind, which is
	    both correct and a real hazard the game uses.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Logger = require(Shared.Core.Logger)
local StateController = require(script.Parent.StateController)

local log = Logger.new("TrainRideController")
local player = Players.LocalPlayer

local TrainRideController = {}

local lastTrainCF: CFrame? = nil
local aboard = false
local trainModel: Model? = nil

--- Finds the train model in the workspace. Cached, and re-resolved whenever
--- the expedition changes, because a new run builds a new train.
local function resolveTrain(): Model?
	if trainModel and trainModel.Parent then
		return trainModel
	end
	for _, instance in game:GetService("CollectionService"):GetTagged("Train") do
		if instance:IsA("Model") and instance.Parent then
			trainModel = instance
			return instance
		end
	end
	return nil
end

--- The train's volume, from the state the server replicates plus the model's
--- own bounding box as a fallback.
local function trainVolume(model: Model): (CFrame, Vector3)
	local root = model:FindFirstChild("TrainRoot")
	local cf = if root and root:IsA("BasePart") then root.CFrame else model:GetPivot()
	local _, size = model:GetBoundingBox()
	-- The volume is the model's box, raised so it covers the interior rather
	-- than the bogies, and shortened slightly so standing on the buffers does
	-- not count as being aboard.
	return cf * CFrame.new(0, size.Y * 0.4, -size.Z * 0.5), Vector3.new(size.X + 2, size.Y, size.Z)
end

local function isInside(point: Vector3, volumeCF: CFrame, half: Vector3, margin: number): boolean
	local localPoint = volumeCF:PointToObjectSpace(point)
	return math.abs(localPoint.X) <= half.X + margin
		and math.abs(localPoint.Y) <= half.Y + margin
		and math.abs(localPoint.Z) <= half.Z + margin
end

--------------------------------------------------------------------------

local function onStepped()
	local trainState = StateController.get("train")
	if not trainState then
		lastTrainCF = nil
		aboard = false
		return
	end

	local model = resolveTrain()
	if not model then
		lastTrainCF = nil
		return
	end

	local rootPart = model:FindFirstChild("TrainRoot")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end
	local currentCF = rootPart.CFrame

	local previous = lastTrainCF
	lastTrainCF = currentCF
	if not previous then
		return
	end

	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		aboard = false
		return
	end

	local volumeCF, size = trainVolume(model)
	local half = size * 0.5

	-- Hysteresis: a larger margin to stay aboard than to get aboard, so the
	-- boundary does not flicker when standing in a doorway.
	local margin = if aboard then 4 else 0
	local inside = isInside(root.Position, volumeCF, half, margin)

	if inside and not aboard then
		aboard = true
	elseif not inside and aboard then
		aboard = false
	end

	if not aboard then
		return
	end

	-- Falling clear of the train is not riding it. Without this check, jumping
	-- out of a door would carry the player along with the train in mid-air.
	if humanoid.FloorMaterial == Enum.Material.Air and root.AssemblyLinearVelocity.Y < -8 then
		local groundedInside = isInside(root.Position - Vector3.new(0, 6, 0), volumeCF, half, 0)
		if not groundedInside then
			aboard = false
			return
		end
	end

	-- The delta. Applying the full transform rather than just the translation
	-- means a train that turned would carry the player's facing with it; the
	-- line is straight in this chapter, but the maths is correct either way.
	local delta = currentCF * previous:Inverse()
	local moved = delta.Position
	if moved.Magnitude < 1e-5 then
		return
	end

	-- Preserve the player's own velocity. Setting CFrame alone would otherwise
	-- fight the physics solver and make jumps feel wrong.
	local velocity = root.AssemblyLinearVelocity
	root.CFrame = delta * root.CFrame
	root.AssemblyLinearVelocity = velocity
end

--------------------------------------------------------------------------

function TrainRideController.isAboard(): boolean
	return aboard
end

function TrainRideController.start()
	-- Stepped rather than RenderStepped: it runs before physics, so the
	-- character is moved and then simulated in the same frame, which is what
	-- removes the visible lag between the carriage and the player.
	RunService.Stepped:Connect(onStepped)

	StateController.Changed:Connect(function(key, value)
		if key ~= "expedition" then
			return
		end
		-- A new expedition means a new train; drop the cached references so
		-- the next frame resolves the new one.
		trainModel = nil
		lastTrainCF = nil
		aboard = false
		if type(value) == "table" and value.state == "lobby" then
			log.debug("left the expedition; ride tracking cleared")
		end
	end)

	player.CharacterAdded:Connect(function()
		-- A fresh character is not aboard until it is tested, which stops a
		-- respawn inheriting the previous character's ride state.
		aboard = false
		lastTrainCF = nil
	end)

	log.info("started")
end

return TrainRideController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	WeaponController
	----------------
	The first-person viewmodel, the firing input, and the local effects.

	WHAT IS LOCAL AND WHAT IS AUTHORITATIVE
	---------------------------------------
	The viewmodel, the muzzle flash, the tracer, the shell ejection and the
	recoil animation are all local. They exist so the weapon feels immediate at
	any ping. None of them decide anything.

	The shot itself is a request: origin, direction, and what the client's own
	raycast believes it hit. The server re-checks all of it. If the server
	disagrees, nothing happens and the client simply played an effect, which is
	the correct outcome: a wrong prediction should never be able to hurt
	anything.

	THE VIEWMODEL
	-------------
	Built from primitives per weapon, from the model block in WeaponRegistry,
	and parented to the camera. Hands are included, because a first-person
	weapon floating with no arms is the single most common thing that makes a
	Roblox shooter look unfinished.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Spring = require(Shared.Core.Spring)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
local CameraController = require(script.Parent.CameraController)
local InputController = require(script.Parent.InputController)
local StateController = require(script.Parent.StateController)

local log = Logger.new("WeaponController")
local player = Players.LocalPlayer

local WeaponController = {}

local viewmodel: Model? = nil
local viewmodelRoot: BasePart? = nil
local muzzle: BasePart? = nil
local currentWeaponId: string? = nil

local firing = false
local aiming = false
local lastFiredAt = 0

local positionSpring = Spring.vector3(Vector3.zero, 60, 12)
local rotationSpring = Spring.vector3(Vector3.zero, 60, 12)

--------------------------------------------------------------------------
-- Viewmodel construction
--------------------------------------------------------------------------

local C = Color3.fromRGB

local function makePart(name: string, size: Vector3, cf: CFrame, colour: Color3, material: Enum.Material, parent: Instance): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = colour
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	-- Viewmodel parts must not be lit by the world's shadows or they flicker
	-- as the train passes lamps.
	part.Parent = parent
	return part
end

local function buildHands(parent: Instance, skin: Color3)
	-- Two simple forearms, angled into the grip. They read correctly at the
	-- bottom of the screen and cost four parts.
	for _, side in { -1, 1 } do
		makePart(
			"Forearm",
			Vector3.new(0.42, 0.42, 1.8),
			CFrame.new(side * 0.42, -0.32, 0.7) * CFrame.Angles(math.rad(-12), math.rad(side * 6), 0),
			skin,
			Enum.Material.SmoothPlastic,
			parent
		)
		makePart(
			"Hand",
			Vector3.new(0.38, 0.34, 0.5),
			CFrame.new(side * 0.34, -0.22, -0.1),
			skin,
			Enum.Material.SmoothPlastic,
			parent
		)
	end
end

local function buildViewmodel(def: WeaponRegistry.WeaponDef): (Model, BasePart, BasePart?)
	local model = Instance.new("Model")
	model.Name = "Viewmodel_" .. def.id

	local root = makePart("Root", Vector3.new(0.2, 0.2, 0.2), CFrame.new(), C(0, 0, 0), Enum.Material.SmoothPlastic, model)
	root.Transparency = 1

	local spec = def.model
	local bodyColour = spec.colour or C(80, 80, 84)
	local gripColour = spec.gripColour or C(60, 44, 36)
	local material = spec.material or Enum.Material.Metal
	local length = spec.length or 1.5
	local muzzlePart: BasePart? = nil

	buildHands(model, C(196, 166, 138))

	if def.kind == "melee" then
		local shape = spec.shape
		if shape == "axe" then
			makePart("Haft", Vector3.new(0.22, 0.22, length), CFrame.new(0, -0.1, -length * 0.4), bodyColour, Enum.Material.Wood, model)
			makePart("Head", Vector3.new(0.24, 0.9, 0.7), CFrame.new(0, 0.2, -length * 0.85), spec.headColour or C(112, 116, 120), Enum.Material.Metal, model)
			makePart("Blade", Vector3.new(0.12, 1.1, 0.4), CFrame.new(0, 0.2, -length * 0.95), C(160, 164, 168), Enum.Material.Metal, model)
		elseif shape == "crowbar" then
			makePart("Shaft", Vector3.new(0.16, 0.16, length), CFrame.new(0, -0.1, -length * 0.4), bodyColour, material, model)
			makePart("Claw", Vector3.new(0.16, 0.5, 0.34), CFrame.new(0, 0.06, -length * 0.85) * CFrame.Angles(math.rad(35), 0, 0), bodyColour, material, model)
		else
			makePart("Shaft", Vector3.new(0.18, 0.18, length), CFrame.new(0, -0.1, -length * 0.4), bodyColour, material, model)
			makePart("Jaw", Vector3.new(0.34, 0.5, 0.5), CFrame.new(0, 0.02, -length * 0.82), bodyColour, material, model)
			makePart("Grip", Vector3.new(0.22, 0.22, 0.6), CFrame.new(0, -0.1, 0.1), gripColour, Enum.Material.Fabric, model)
		end
	else
		-- Firearms share a receiver, a grip and a barrel, differing in
		-- proportion and in the details hung off them.
		makePart("Receiver", Vector3.new(0.28, 0.4, length * 0.45), CFrame.new(0, -0.05, -length * 0.18), bodyColour, material, model)
		makePart("Grip", Vector3.new(0.24, 0.62, 0.34), CFrame.new(0, -0.42, 0.12) * CFrame.Angles(math.rad(-14), 0, 0), gripColour, Enum.Material.Wood, model)
		makePart("Trigger", Vector3.new(0.08, 0.2, 0.1), CFrame.new(0, -0.24, -0.05), C(40, 40, 42), Enum.Material.Metal, model)

		local barrelLength = length * 0.55
		local barrel = makePart(
			"Barrel",
			Vector3.new(0.16, 0.16, barrelLength),
			CFrame.new(0, 0.02, -length * 0.45 - barrelLength * 0.35),
			bodyColour,
			Enum.Material.Metal,
			model
		)

		if def.id == "shotgun" then
			makePart("SecondBarrel", Vector3.new(0.16, 0.16, barrelLength), barrel.CFrame * CFrame.new(0.18, 0, 0), bodyColour, Enum.Material.Metal, model)
			makePart("Forend", Vector3.new(0.4, 0.28, barrelLength * 0.5), barrel.CFrame * CFrame.new(0.09, -0.12, 0.3), gripColour, Enum.Material.Wood, model)
		elseif def.id == "rifle" then
			makePart("Stock", Vector3.new(0.24, 0.42, 0.9), CFrame.new(0, -0.14, 0.55), gripColour, Enum.Material.Wood, model)
			makePart("Bolt", Vector3.new(0.12, 0.12, 0.5), CFrame.new(0.18, 0.1, -0.1), C(150, 150, 154), Enum.Material.Metal, model)
			makePart("BoltHandle", Vector3.new(0.1, 0.28, 0.1), CFrame.new(0.26, 0.02, 0.02), C(150, 150, 154), Enum.Material.Metal, model)
			makePart("Sight", Vector3.new(0.06, 0.16, 0.06), CFrame.new(0, 0.24, -length * 0.6), C(40, 40, 42), Enum.Material.Metal, model)
		elseif def.id == "revolver" then
			makePart("Cylinder", Vector3.new(0.3, 0.3, 0.34), CFrame.new(0, -0.02, -0.18), C(70, 70, 74), Enum.Material.Metal, model)
			makePart("Hammer", Vector3.new(0.07, 0.16, 0.12), CFrame.new(0, 0.18, 0.08), C(50, 50, 52), Enum.Material.Metal, model)
		elseif def.id == "flare_gun" then
			makePart("WideBarrel", Vector3.new(0.3, 0.3, barrelLength * 0.7), barrel.CFrame * CFrame.new(0, 0, 0.1), bodyColour, Enum.Material.SmoothPlastic, model)
		end

		-- Front sight, so there is something to line up with.
		makePart("FrontSight", Vector3.new(0.05, 0.12, 0.05), barrel.CFrame * CFrame.new(0, 0.14, -barrelLength * 0.45), C(40, 40, 42), Enum.Material.Metal, model)

		local flash = makePart(
			"Muzzle",
			Vector3.new(0.1, 0.1, 0.1),
			barrel.CFrame * CFrame.new(0, 0, -barrelLength * 0.5),
			C(255, 220, 150),
			Enum.Material.Neon,
			model
		)
		flash.Transparency = 1
		muzzlePart = flash
	end

	-- Weld everything to the root so the model can be posed as one object.
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = root
			descendant.Anchored = false
		end
	end
	root.Anchored = true

	return model, root, muzzlePart
end

--------------------------------------------------------------------------
-- Equipping
--------------------------------------------------------------------------

local function equip(weaponId: string?)
	if currentWeaponId == weaponId then
		return
	end
	currentWeaponId = weaponId

	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
		viewmodelRoot = nil
		muzzle = nil
	end
	if not weaponId then
		return
	end

	local def = WeaponRegistry.get(weaponId)
	if not def then
		return
	end

	local model, root, flash = buildViewmodel(def)
	model.Parent = Workspace.CurrentCamera
	viewmodel = model
	viewmodelRoot = root
	muzzle = flash

	-- The equip animation is a spring impulse rather than a keyframe sequence,
	-- so it settles correctly even if the weapon is swapped mid-animation.
	positionSpring:reset(def.viewmodel.restOffset - Vector3.new(0, 1.2, 0))
	positionSpring:setTarget(def.viewmodel.restOffset)
	rotationSpring:reset(Vector3.new(math.rad(-30), 0, 0))
	rotationSpring:setTarget(Vector3.zero)

	log.debug("equipped", weaponId)
end

--------------------------------------------------------------------------
-- Effects
--------------------------------------------------------------------------

local function muzzleFlash()
	local flash = muzzle
	if not flash then
		return
	end
	flash.Transparency = 0
	local existing = flash:FindFirstChildOfClass("PointLight")
	local resolved: PointLight
	if existing then
		resolved = existing
	else
		resolved = Instance.new("PointLight")
		resolved.Color = C(255, 214, 150)
		resolved.Range = 30
		resolved.Parent = flash
	end
	resolved.Brightness = 6
	resolved.Enabled = true
	task.delay(0.05, function()
		flash.Transparency = 1
		resolved.Enabled = false
	end)
end

local function tracer(from: Vector3, to: Vector3)
	local delta = to - from
	if delta.Magnitude < 1 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "Tracer"
	beam.Size = Vector3.new(0.08, 0.08, delta.Magnitude)
	beam.CFrame = CFrame.lookAt(from + delta * 0.5, to)
	beam.Color = C(255, 226, 170)
	beam.Material = Enum.Material.Neon
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Transparency = 0.35
	beam.Parent = Workspace

	task.spawn(function()
		for step = 1, 6 do
			task.wait(0.02)
			beam.Transparency = 0.35 + step * 0.11
		end
		beam:Destroy()
	end)
end

local function impact(position: Vector3, normal: Vector3)
	local mark = Instance.new("Part")
	mark.Name = "Impact"
	mark.Size = Vector3.new(0.3, 0.3, 0.1)
	mark.CFrame = CFrame.lookAt(position + normal * 0.05, position + normal)
	mark.Color = C(40, 38, 36)
	mark.Material = Enum.Material.Slate
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Parent = Workspace
	task.delay(8, function()
		mark:Destroy()
	end)
end

--------------------------------------------------------------------------
-- Firing
--------------------------------------------------------------------------

local function tryFire()
	local weaponId = currentWeaponId
	if not weaponId then
		return
	end
	local def = WeaponRegistry.get(weaponId)
	if not def then
		return
	end
	if StateController.isDowned() or StateController.isDead() then
		return
	end
	if StateController.ui("openPanel") then
		return
	end

	local weaponState = StateController.get("weapon")
	if weaponState and weaponState.reloading then
		return
	end

	local now = os.clock()
	if (now - lastFiredAt) < def.fireInterval then
		return
	end
	lastFiredAt = now

	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector

	if def.kind == "melee" then
		Net.fireServer("MeleeSwing", direction)
		rotationSpring:impulse(Vector3.new(math.rad(-40), math.rad(18), 0))
		positionSpring:impulse(Vector3.new(0, 0, -1.2))
		return
	end

	if weaponState and (weaponState.magazine or 0) <= 0 then
		-- Dry fire. The server would refuse anyway; this is the audible tell.
		local AudioController = require(script.Parent.AudioController)
		AudioController.play(def.dryCue or "gun_dry")
		return
	end

	-- Spread is applied locally and sent as the actual direction, so the
	-- server validates against the same line the client drew.
	local spread = math.rad(def.spreadDegrees or 1) * (if aiming then (def.aimSpreadMultiplier or 0.4) else 1)
	local pellets = def.pellets or 1

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = player.Character
	local filtered: { Instance } = {}
	if character then
		table.insert(filtered, character)
	end
	if viewmodel then
		table.insert(filtered, viewmodel)
	end
	params.FilterDescendantsInstances = filtered

	for _ = 1, pellets do
		local jitter = Vector3.new(
			(math.random() - 0.5) * 2 * spread,
			(math.random() - 0.5) * 2 * spread,
			0
		)
		local shotDirection = (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(jitter.Y, jitter.X, 0)).LookVector
		local result = Workspace:Raycast(origin, shotDirection * def.range, params)

		local hitPosition = if result then result.Position else origin + shotDirection * def.range
		tracer(origin + camera.CFrame.RightVector * 0.4 - camera.CFrame.UpVector * 0.2, hitPosition)
		if result then
			impact(result.Position, result.Normal)
		end

		Net.fireServer("WeaponFire", origin, shotDirection, if result then result.Instance else nil, hitPosition)
	end

	muzzleFlash()

	-- Recoil. The camera kick is what actually moves the aim, and it is a
	-- spring so sustained fire climbs and then settles predictably.
	local kick = def.viewmodel.recoilKick
	rotationSpring:impulse(Vector3.new(kick.X * 4, kick.Y * 4, kick.Z))
	positionSpring:impulse(Vector3.new(0, 0, 0.8))
	CameraController.recoil(Vector3.new(
		math.rad(def.recoilVertical or 2) * -0.5,
		math.rad((math.random() - 0.5) * 2 * (def.recoilHorizontal or 0.5)),
		0
	))
	CameraController.shake(0.12, 0.15)
end

--------------------------------------------------------------------------
-- Per-frame
--------------------------------------------------------------------------

local function onRenderStep(deltaTime: number)
	local root = viewmodelRoot
	local weaponId = currentWeaponId
	if not root or not weaponId then
		return
	end
	local def = WeaponRegistry.get(weaponId)
	local camera = Workspace.CurrentCamera
	if not def or not camera then
		return
	end

	-- Hide the viewmodel whenever it would be wrong to see it.
	local hidden = StateController.isDowned()
		or StateController.isDead()
		or StateController.ui("cinematic") == true
		or StateController.ui("openPanel") ~= nil
	local model = viewmodel
	if model then
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") and descendant.Name ~= "Root" and descendant.Name ~= "Muzzle" then
				descendant.LocalTransparencyModifier = if hidden then 1 else 0
			end
		end
	end
	if hidden then
		return
	end

	positionSpring:setTarget(if aiming then def.viewmodel.aimOffset else def.viewmodel.restOffset)

	local position = positionSpring:step(deltaTime)
	local rotation = rotationSpring:step(deltaTime)
	rotationSpring:setTarget(Vector3.zero)

	-- Sway from view movement, scaled per weapon so the rifle feels heavier
	-- than the revolver.
	local lookDelta = UserInputService:GetMouseDelta()
	local swayScale = def.viewmodel.swayScale * (if aiming then 0.3 else 1)
	local sway = Vector3.new(
		math.clamp(-lookDelta.X * 0.0006 * swayScale, -0.08, 0.08),
		math.clamp(-lookDelta.Y * 0.0006 * swayScale, -0.08, 0.08),
		0
	)

	root.CFrame = camera.CFrame
		* CFrame.new(position + sway)
		* CFrame.Angles(rotation.X, rotation.Y, rotation.Z)
end

--------------------------------------------------------------------------

function WeaponController.start()
	InputController.Action:Connect(function(actionId, pressed)
		if actionId == "fire" then
			firing = pressed
			if pressed then
				tryFire()
			end
		elseif actionId == "aim" then
			aiming = pressed
		elseif actionId == "reload" and pressed then
			Net.fireServer("WeaponReload")
		end
	end)

	StateController.Changed:Connect(function(key, value)
		if key == "weapon" and type(value) == "table" then
			equip(value.equipped)
		elseif key == "expedition" and type(value) == "table" then
			if value.state == "lobby" or value.state == "results" then
				equip(nil)
			end
		end
	end)

	Net.onClientEvent("WeaponEffect", function(payload)
		if type(payload) ~= "table" then
			return
		end
		-- Other players' shots: a tracer from their position, so a gunshot is
		-- locatable by sight as well as by sound.
		if payload.kind == "fire" and payload.userId ~= player.UserId and payload.origin and payload.hitPosition then
			tracer(payload.origin, payload.hitPosition)
		elseif payload.kind == "flare" and payload.position then
			-- A burning flare denies ground; it needs to be unmistakable.
			local flare = Instance.new("Part")
			flare.Name = "Flare"
			flare.Size = Vector3.new(0.5, 0.5, 0.5)
			flare.CFrame = CFrame.new(payload.position)
			flare.Color = C(255, 120, 70)
			flare.Material = Enum.Material.Neon
			flare.Anchored = true
			flare.CanCollide = false
			flare.CanQuery = false
			flare.Parent = Workspace

			local light = Instance.new("PointLight")
			light.Color = C(255, 120, 70)
			light.Brightness = 5
			light.Range = 60
			light.Shadows = true
			light.Parent = flare

			task.delay(payload.seconds or 24, function()
				flare:Destroy()
			end)
		end
	end)

	-- Automatic fire is not used by any weapon in this project, but holding
	-- the button on a semi-automatic still re-fires at the weapon's interval,
	-- which is what players expect.
	RunService.Heartbeat:Connect(function()
		if firing then
			tryFire()
		end
	end)

	RunService:BindToRenderStep("LastSignalViewmodel", Enum.RenderPriority.Camera.Value + 2, onRenderStep)

	player.CharacterAdded:Connect(function()
		-- Re-parent the viewmodel: a new camera is created with a new character.
		task.wait(0.3)
		local model = viewmodel
		if model and Workspace.CurrentCamera then
			model.Parent = Workspace.CurrentCamera
		end
	end)

	log.info("started")
end

return WeaponController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Theme
	-----
	The visual language of LAST SIGNAL's interface, in one place.

	The interface is meant to read as railway paperwork and enamel signage seen
	by lamplight: warm off-white on near-black, a single brass accent, one red
	for danger, and nothing else. Restraint is the point. A horror game whose
	menus are bright and busy stops being frightening the moment a panel opens.

	SIZING
	------
	Everything here is in scale-independent units. `space(n)` returns a pixel
	value already multiplied by the platform scale, so a phone gets larger
	touch targets and a desktop gets a tighter layout from the same code. No
	panel in this project hard-codes a pixel size.
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = {}

local C = Color3.fromRGB

--------------------------------------------------------------------------
-- Palette
--------------------------------------------------------------------------

Theme.Colour = {
	-- Surfaces, darkest to lightest.
	void = C(8, 9, 11),
	backdrop = C(14, 15, 18),
	surface = C(22, 24, 28),
	surfaceRaised = C(30, 33, 38),
	surfaceHover = C(38, 42, 48),
	line = C(52, 56, 63),
	lineStrong = C(78, 84, 92),

	-- Text.
	text = C(232, 228, 218),
	textMuted = C(158, 156, 150),
	textFaint = C(108, 108, 104),
	textInverse = C(16, 16, 18),

	-- Accents.
	brass = C(198, 158, 78),
	brassDim = C(132, 106, 54),
	signalRed = C(198, 62, 52),
	signalGreen = C(96, 170, 108),
	signalAmber = C(212, 162, 62),
	cold = C(126, 158, 188),

	-- Meters.
	health = C(186, 72, 62),
	stamina = C(190, 178, 120),
	flashlight = C(214, 200, 150),
	fuel = C(168, 142, 86),
	condition = C(126, 158, 188),
	progress = C(198, 158, 78),
	danger = C(198, 62, 52),
}

--- A higher-contrast palette for the accessibility setting. Only the values
--- that matter for legibility change; the layout is identical.
Theme.HighContrast = {
	backdrop = C(0, 0, 0),
	surface = C(12, 12, 14),
	surfaceRaised = C(26, 26, 30),
	line = C(120, 124, 130),
	lineStrong = C(180, 184, 190),
	text = C(255, 253, 246),
	textMuted = C(212, 210, 204),
	textFaint = C(170, 168, 162),
	brass = C(255, 204, 96),
}

local highContrastActive = false

function Theme.setHighContrast(enabled: boolean)
	highContrastActive = enabled
end

--- Reads a colour, honouring the high-contrast setting.
function Theme.colour(name: string): Color3
	if highContrastActive then
		local override = (Theme.HighContrast :: any)[name]
		if override then
			return override
		end
	end
	return (Theme.Colour :: any)[name] or Theme.Colour.text
end

--------------------------------------------------------------------------
-- Type
--------------------------------------------------------------------------

-- Roblox's built-in font families. No external font assets are used, so the
-- interface renders identically on every device with no download.
Theme.Font = {
	display = Font.fromEnum(Enum.Font.GothamBold),
	heading = Font.fromEnum(Enum.Font.GothamMedium),
	body = Font.fromEnum(Enum.Font.Gotham),
	mono = Font.fromEnum(Enum.Font.RobotoMono),
}

Theme.TextSize = {
	display = 30,
	title = 22,
	heading = 18,
	body = 15,
	small = 13,
	tiny = 11,
}

--------------------------------------------------------------------------
-- Platform and scale
--------------------------------------------------------------------------

export type Platform = "desktop" | "tablet" | "phone" | "console"

local cachedPlatform: Platform? = nil

function Theme.platform(): Platform
	if cachedPlatform then
		return cachedPlatform
	end
	local resolved: Platform
	if GuiService:IsTenFootInterface() then
		resolved = "console"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		-- The split is by physical size rather than resolution: a small tablet
		-- and a large phone want the same layout, and pixel count does not
		-- distinguish them.
		resolved = if math.min(viewport.X, viewport.Y) >= 600 then "tablet" else "phone"
	else
		resolved = "desktop"
	end
	cachedPlatform = resolved
	return resolved
end

function Theme.isTouch(): boolean
	local platform = Theme.platform()
	return platform == "phone" or platform == "tablet"
end

--- Refreshes the cached platform, for a device that rotates or docks.
function Theme.refreshPlatform()
	cachedPlatform = nil
end

local userScale = 1

function Theme.setUserScale(scale: number)
	userScale = math.clamp(scale, 0.75, 1.5)
end

--- The multiplier applied to every size in the interface.
function Theme.scale(): number
	local platform = Theme.platform()
	local base: number
	if platform == "phone" then
		base = 1.25 -- larger targets, fewer of them on screen
	elseif platform == "tablet" then
		base = 1.1
	elseif platform == "console" then
		base = 1.3 -- read from across a room
	else
		base = 1.0
	end
	return base * userScale
end

function Theme.space(units: number): number
	return math.floor(units * 8 * Theme.scale() + 0.5)
end

function Theme.textSize(name: string): number
	local base = (Theme.TextSize :: any)[name] or Theme.TextSize.body
	return math.floor(base * Theme.scale() + 0.5)
end

--- The minimum tappable size. Below this, touch input is unreliable, so every
--- interactive widget in this project is clamped to it.
function Theme.minTouchTarget(): number
	return if Theme.isTouch() then math.floor(48 * Theme.scale()) else math.floor(28 * Theme.scale())
end

--------------------------------------------------------------------------
-- Safe area
--------------------------------------------------------------------------

--- Insets that keep content clear of notches, home indicators and the Roblox
--- top bar. GuiService reports the top inset; the others are conservative
--- constants because Roblox does not expose them directly.
function Theme.safeInsets(): { top: number, bottom: number, left: number, right: number }
	local topInset, bottomInset = GuiService:GetGuiInset()
	local platform = Theme.platform()
	local sideInset = if platform == "phone" then Theme.space(2) else Theme.space(1)
	return {
		top = topInset.Y + Theme.space(1),
		bottom = bottomInset.Y + (if platform == "phone" then Theme.space(3) else Theme.space(1)),
		left = sideInset,
		right = sideInset,
	}
end

--------------------------------------------------------------------------
-- Motion
--------------------------------------------------------------------------

local reducedMotion = false
local reducedFlashing = false

function Theme.setReducedMotion(enabled: boolean)
	reducedMotion = enabled
end

function Theme.setReducedFlashing(enabled: boolean)
	reducedFlashing = enabled
end

function Theme.motionReduced(): boolean
	return reducedMotion
end

function Theme.flashingReduced(): boolean
	return reducedFlashing
end

--- Tween duration, collapsed to near-zero when reduced motion is on. Panels
--- still change state; they simply stop animating.
function Theme.duration(seconds: number): number
	return if reducedMotion then 0.01 else seconds
end

Theme.Ease = {
	standard = Enum.EasingStyle.Quart,
	standardDirection = Enum.EasingDirection.Out,
}

function Theme.tweenInfo(seconds: number): TweenInfo
	return TweenInfo.new(Theme.duration(seconds), Theme.Ease.standard, Theme.Ease.standardDirection)
end

--------------------------------------------------------------------------
-- Layering
--------------------------------------------------------------------------

-- Display orders, so two panels can never fight over which is on top.
Theme.Layer = {
	world = 1, -- world-space markers and prompts
	hud = 10,
	interaction = 20,
	subtitles = 30,
	notification = 40,
	panel = 50,
	modal = 60,
	cinematic = 80,
	loading = 90,
}

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Widgets
	-------
	The interface construction kit. Every panel in the game is built from these,
	which is what keeps spacing, contrast and touch targets consistent instead
	of being re-invented per screen.

	RULES ENFORCED HERE
	-------------------
	  - Text never clips. Every label either wraps or is given TextScaled with
	    a floor, and no widget sets a fixed height for text it does not measure.
	  - Every interactive widget meets the platform's minimum touch target.
	  - Scrolling regions get a visible scrollbar and automatic canvas sizing,
	    so a list can never be longer than it appears to be.
	  - Nothing uses an image asset. Icons are drawn from primitives, so the
	    interface has no external dependencies and nothing to fail to load.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Widgets = {}

local function applyCorner(instance: GuiObject, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.space(0.5))
	corner.Parent = instance
end

local function applyStroke(instance: GuiObject, colour: Color3?, thickness: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = colour or Theme.colour("line")
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

Widgets.applyCorner = applyCorner
Widgets.applyStroke = applyStroke

--------------------------------------------------------------------------
-- Containers
--------------------------------------------------------------------------

export type PanelOptions = {
	name: string?,
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	parent: Instance?,
	padding: number?,
	background: Color3?,
	transparency: number?,
	stroke: boolean?,
	corner: number?,
}

function Widgets.panel(options: PanelOptions): Frame
	local frame = Instance.new("Frame")
	frame.Name = options.name or "Panel"
	frame.Size = options.size or UDim2.fromScale(1, 1)
	frame.Position = options.position or UDim2.fromScale(0, 0)
	frame.AnchorPoint = options.anchor or Vector2.zero
	frame.BackgroundColor3 = options.background or Theme.colour("surface")
	frame.BackgroundTransparency = options.transparency or 0
	frame.BorderSizePixel = 0
	applyCorner(frame, options.corner)
	if options.stroke ~= false then
		applyStroke(frame)
	end
	if options.padding then
		local padding = Instance.new("UIPadding")
		local value = UDim.new(0, Theme.space(options.padding))
		padding.PaddingTop = value
		padding.PaddingBottom = value
		padding.PaddingLeft = value
		padding.PaddingRight = value
		padding.Parent = frame
	end
	if options.parent then
		frame.Parent = options.parent
	end
	return frame
end

--- A vertical stack with consistent spacing. Returns the frame; the layout is
--- attached so children order themselves by LayoutOrder.
function Widgets.column(parent: Instance, gap: number?, name: string?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name or "Column"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.space(gap or 1))
	layout.Parent = frame
	frame.Parent = parent
	return frame
end

function Widgets.row(parent: Instance, gap: number?, name: string?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name or "Row"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, Theme.minTouchTarget())
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, Theme.space(gap or 1))
	layout.Parent = frame
	frame.Parent = parent
	return frame
end

--- A scrolling list that sizes its own canvas. Used for every list in the
--- game, so nothing can end up with content below a canvas that does not reach.
function Widgets.scroll(parent: Instance, gap: number?, name: string?): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = name or "Scroll"
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if Theme.isTouch() then 6 else 4
	scroll.ScrollBarImageColor3 = Theme.colour("lineStrong")
	scroll.ScrollBarImageTransparency = 0.3
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	scroll.ClipsDescendants = true

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.space(gap or 1))
	layout.Parent = scroll

	local padding = Instance.new("UIPadding")
	padding.PaddingRight = UDim.new(0, Theme.space(1))
	padding.PaddingBottom = UDim.new(0, Theme.space(1))
	padding.Parent = scroll

	scroll.Parent = parent
	return scroll
end

--------------------------------------------------------------------------
-- Text
--------------------------------------------------------------------------

export type LabelOptions = {
	text: string,
	size: string?, -- key into Theme.TextSize
	colour: Color3?,
	font: Font?,
	align: Enum.TextXAlignment?,
	wrap: boolean?,
	parent: Instance?,
	layoutOrder: number?,
	width: UDim?,
	name: string?,
}

function Widgets.label(options: LabelOptions): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = options.name or "Label"
	label.BackgroundTransparency = 1
	label.Text = options.text
	label.FontFace = options.font or Theme.Font.body
	label.TextSize = Theme.textSize(options.size or "body")
	label.TextColor3 = options.colour or Theme.colour("text")
	label.TextXAlignment = options.align or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = options.wrap ~= false
	label.RichText = false
	-- Automatic height plus wrapping is what guarantees no clipped text,
	-- whatever length the string turns out to be in another language.
	label.Size = UDim2.new(options.width or UDim.new(1, 0), UDim.new(0, 0))
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.LayoutOrder = options.layoutOrder or 0
	if options.parent then
		label.Parent = options.parent
	end
	return label
end

function Widgets.heading(parent: Instance, text: string, order: number?): TextLabel
	return Widgets.label({
		text = text,
		size = "heading",
		font = Theme.Font.heading,
		colour = Theme.colour("text"),
		parent = parent,
		layoutOrder = order,
		name = "Heading",
	})
end

function Widgets.caption(parent: Instance, text: string, order: number?): TextLabel
	return Widgets.label({
		text = text,
		size = "small",
		colour = Theme.colour("textMuted"),
		parent = parent,
		layoutOrder = order,
		name = "Caption",
	})
end

--------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------

export type ButtonOptions = {
	text: string,
	parent: Instance?,
	layoutOrder: number?,
	width: UDim?,
	primary: boolean?,
	danger: boolean?,
	enabled: boolean?,
	onClick: (() -> ())?,
	name: string?,
	subtitle: string?,
}

export type Button = {
	instance: TextButton,
	setEnabled: (boolean) -> (),
	setText: (string) -> (),
	destroy: () -> (),
}

function Widgets.button(options: ButtonOptions): Button
	local button = Instance.new("TextButton")
	button.Name = options.name or "Button"
	button.AutoButtonColor = false
	button.Text = ""
	button.BorderSizePixel = 0
	button.Size = UDim2.new(options.width or UDim.new(1, 0), UDim.new(0, Theme.minTouchTarget()))
	button.LayoutOrder = options.layoutOrder or 0
	button.BackgroundColor3 = if options.primary then Theme.colour("brass") else Theme.colour("surfaceRaised")
	applyCorner(button)
	local stroke = applyStroke(button, if options.danger then Theme.colour("signalRed") else Theme.colour("line"))

	local labelColour = if options.primary then Theme.colour("textInverse") else Theme.colour("text")
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = options.text
	label.FontFace = Theme.Font.heading
	label.TextSize = Theme.textSize("body")
	label.TextColor3 = labelColour
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = button

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, Theme.space(1.5))
	padding.PaddingRight = UDim.new(0, Theme.space(1.5))
	padding.Parent = button

	local enabled = options.enabled ~= false

	local function refresh()
		if enabled then
			button.BackgroundColor3 = if options.primary then Theme.colour("brass") else Theme.colour("surfaceRaised")
			label.TextColor3 = labelColour
			button.Active = true
			stroke.Color = if options.danger then Theme.colour("signalRed") else Theme.colour("line")
		else
			-- Disabled is visibly different from enabled, not just unresponsive.
			button.BackgroundColor3 = Theme.colour("surface")
			label.TextColor3 = Theme.colour("textFaint")
			button.Active = false
			stroke.Color = Theme.colour("line")
		end
	end
	refresh()

	button.MouseEnter:Connect(function()
		if enabled and not options.primary then
			TweenService:Create(button, Theme.tweenInfo(0.12), { BackgroundColor3 = Theme.colour("surfaceHover") }):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		if enabled then
			refresh()
		end
	end)
	button.Activated:Connect(function()
		if enabled and options.onClick then
			options.onClick()
		end
	end)

	if options.parent then
		button.Parent = options.parent
	end

	return {
		instance = button,
		setEnabled = function(value: boolean)
			enabled = value
			refresh()
		end,
		setText = function(value: string)
			label.Text = value
		end,
		destroy = function()
			button:Destroy()
		end,
	}
end

--- A tab strip. Returns a select function so the caller can drive it.
function Widgets.tabs(parent: Instance, names: { string }, onSelect: (number) -> ()): (Frame, (number) -> ())
	local strip = Instance.new("Frame")
	strip.Name = "Tabs"
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.new(1, 0, 0, Theme.minTouchTarget())

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.space(0.5))
	layout.Parent = strip

	local buttons: { TextButton } = {}
	local underlines: { Frame } = {}
	local selected = 1

	local function refresh()
		for index, button in buttons do
			local isSelected = index == selected
			local text = button:FindFirstChild("Text") :: TextLabel?
			if text then
				text.TextColor3 = if isSelected then Theme.colour("text") else Theme.colour("textMuted")
			end
			underlines[index].BackgroundColor3 = if isSelected then Theme.colour("brass") else Theme.colour("line")
			underlines[index].BackgroundTransparency = if isSelected then 0 else 0.6
		end
	end

	for index, name in names do
		local button = Instance.new("TextButton")
		button.Name = "Tab" .. index
		button.AutoButtonColor = false
		button.Text = ""
		button.BackgroundTransparency = 1
		button.BorderSizePixel = 0
		button.LayoutOrder = index
		-- Tabs share the width evenly, which keeps them tappable on a phone
		-- however many there are.
		button.Size = UDim2.new(1 / #names, -Theme.space(0.5), 1, 0)

		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.BackgroundTransparency = 1
		text.Size = UDim2.new(1, 0, 1, -3)
		text.Text = name
		text.FontFace = Theme.Font.heading
		text.TextSize = Theme.textSize("small")
		text.TextColor3 = Theme.colour("textMuted")
		text.TextTruncate = Enum.TextTruncate.AtEnd
		text.Parent = button

		local underline = Instance.new("Frame")
		underline.Name = "Underline"
		underline.BorderSizePixel = 0
		underline.Size = UDim2.new(1, 0, 0, 2)
		underline.Position = UDim2.new(0, 0, 1, -2)
		underline.BackgroundColor3 = Theme.colour("line")
		underline.Parent = button

		button.Activated:Connect(function()
			selected = index
			refresh()
			onSelect(index)
		end)

		button.Parent = strip
		table.insert(buttons, button)
		table.insert(underlines, underline)
	end

	refresh()
	strip.Parent = parent

	return strip, function(index: number)
		selected = math.clamp(index, 1, #names)
		refresh()
		onSelect(selected)
	end
end

--------------------------------------------------------------------------
-- Meters
--------------------------------------------------------------------------

export type Meter = {
	instance: Frame,
	set: (fraction: number, text: string?) -> (),
	setColour: (Color3) -> (),
}

function Widgets.meter(parent: Instance, colour: Color3, height: number?, label: string?): Meter
	local container = Instance.new("Frame")
	container.Name = "Meter"
	container.BackgroundColor3 = Theme.colour("void")
	container.BackgroundTransparency = 0.25
	container.BorderSizePixel = 0
	container.Size = UDim2.new(1, 0, 0, height or Theme.space(1))
	applyCorner(container, Theme.space(0.25))

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = colour
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	applyCorner(fill, Theme.space(0.25))
	fill.Parent = container

	local text: TextLabel? = nil
	if label then
		text = Widgets.label({
			text = label,
			size = "tiny",
			colour = Theme.colour("textMuted"),
			align = Enum.TextXAlignment.Left,
			parent = container,
			name = "MeterText",
		})
		local resolved = text :: TextLabel
		resolved.Position = UDim2.new(0, Theme.space(0.5), 0, 0)
		resolved.Size = UDim2.new(1, -Theme.space(1), 1, 0)
		resolved.TextYAlignment = Enum.TextYAlignment.Center
		resolved.AutomaticSize = Enum.AutomaticSize.None
	end

	container.Parent = parent

	return {
		instance = container,
		set = function(fraction: number, newText: string?)
			local clamped = math.clamp(fraction, 0, 1)
			-- Meters move rather than snap, except under reduced motion.
			TweenService:Create(fill, Theme.tweenInfo(0.2), { Size = UDim2.fromScale(clamped, 1) }):Play()
			if text and newText then
				(text :: TextLabel).Text = newText
			end
		end,
		setColour = function(newColour: Color3)
			fill.BackgroundColor3 = newColour
		end,
	}
end

--------------------------------------------------------------------------
-- Icons, drawn from primitives
--------------------------------------------------------------------------

--- Vector glyphs built from frames. No image assets means nothing to upload,
--- nothing to fail to load, and identical appearance on every device.
function Widgets.icon(parent: Instance, glyph: string, size: number, colour: Color3?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Icon_" .. glyph
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size, size)

	local tint = colour or Theme.colour("text")

	local function bar(x: number, y: number, w: number, h: number, rotation: number?)
		local part = Instance.new("Frame")
		part.BorderSizePixel = 0
		part.BackgroundColor3 = tint
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.fromScale(x, y)
		part.Size = UDim2.fromScale(w, h)
		part.Rotation = rotation or 0
		applyCorner(part, math.max(1, size * 0.08))
		part.Parent = holder
		return part
	end

	if glyph == "cross" then
		bar(0.5, 0.5, 0.8, 0.24)
		bar(0.5, 0.5, 0.24, 0.8)
	elseif glyph == "case" or glyph == "case-cross" or glyph == "case-wrench" then
		bar(0.5, 0.58, 0.86, 0.56)
		bar(0.5, 0.26, 0.34, 0.16)
		if glyph == "case-cross" then
			bar(0.5, 0.58, 0.4, 0.12)
			bar(0.5, 0.58, 0.12, 0.4)
		end
	elseif glyph == "battery" then
		bar(0.5, 0.55, 0.5, 0.8)
		bar(0.5, 0.1, 0.22, 0.12)
	elseif glyph == "vial" or glyph == "valve-glass" or glyph == "bottle" then
		bar(0.5, 0.6, 0.42, 0.66)
		bar(0.5, 0.2, 0.22, 0.2)
	elseif glyph == "flare" or glyph == "stick" then
		bar(0.5, 0.5, 0.26, 0.86, 18)
	elseif glyph == "can" then
		bar(0.46, 0.56, 0.62, 0.76)
		bar(0.8, 0.28, 0.16, 0.2)
	elseif glyph == "bar" then
		bar(0.5, 0.5, 0.18, 0.9, 12)
		bar(0.38, 0.12, 0.34, 0.16, 40)
	elseif glyph == "cutters" then
		bar(0.4, 0.6, 0.16, 0.72, -14)
		bar(0.6, 0.6, 0.16, 0.72, 14)
	elseif glyph == "ammo" then
		bar(0.32, 0.55, 0.2, 0.7)
		bar(0.5, 0.55, 0.2, 0.7)
		bar(0.68, 0.55, 0.2, 0.7)
	elseif glyph == "page" or glyph == "ticket" then
		bar(0.5, 0.5, 0.7, 0.86)
		bar(0.5, 0.34, 0.44, 0.08)
		bar(0.5, 0.5, 0.44, 0.08)
		bar(0.5, 0.66, 0.3, 0.08)
	elseif glyph == "key" then
		bar(0.5, 0.3, 0.4, 0.4)
		bar(0.5, 0.68, 0.14, 0.5)
		bar(0.62, 0.82, 0.24, 0.12)
	elseif glyph == "fuse" then
		bar(0.5, 0.5, 0.34, 0.76)
		bar(0.5, 0.12, 0.5, 0.12)
		bar(0.5, 0.88, 0.5, 0.12)
	elseif glyph == "relay" or glyph == "recorder" then
		bar(0.5, 0.55, 0.82, 0.6)
		bar(0.32, 0.55, 0.16, 0.3)
		bar(0.62, 0.55, 0.28, 0.14)
	elseif glyph == "valve" then
		bar(0.5, 0.5, 0.9, 0.16)
		bar(0.5, 0.5, 0.16, 0.9)
		bar(0.5, 0.5, 0.4, 0.4, 45)
	elseif glyph == "aspect" then
		bar(0.5, 0.24, 0.38, 0.34)
		bar(0.5, 0.58, 0.38, 0.34)
		bar(0.5, 0.86, 0.5, 0.12)
	elseif glyph == "numerals" then
		bar(0.3, 0.5, 0.16, 0.7)
		bar(0.6, 0.5, 0.34, 0.7)
	else
		-- Unknown glyph: a plain square, so a missing icon is visible as a
		-- missing icon rather than as nothing at all.
		bar(0.5, 0.5, 0.6, 0.6)
	end

	holder.Parent = parent
	return holder
end

--------------------------------------------------------------------------
-- Screen roots
--------------------------------------------------------------------------

function Widgets.screen(name: string, layer: number, parent: Instance): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = layer
	gui.Parent = parent
	return gui
end

--- A full-screen dimmed backdrop that closes the panel when tapped outside it.
function Widgets.modalBackdrop(parent: Instance, onDismiss: () -> ()): TextButton
	local backdrop = Instance.new("TextButton")
	backdrop.Name = "Backdrop"
	backdrop.Text = ""
	backdrop.AutoButtonColor = false
	backdrop.BackgroundColor3 = Theme.colour("void")
	backdrop.BackgroundTransparency = 0.35
	backdrop.BorderSizePixel = 0
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.Activated:Connect(onDismiss)
	backdrop.Parent = parent
	return backdrop
end

--------------------------------------------------------------------------
-- Utility
--------------------------------------------------------------------------

--- Fades a GuiObject and every descendant. Used for panel transitions.
function Widgets.fade(root: GuiObject, transparency: number, seconds: number?)
	local info = Theme.tweenInfo(seconds or 0.18)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
			TweenService:Create(descendant, info, { TextTransparency = transparency }):Play()
			if descendant.BackgroundTransparency < 1 then
				TweenService:Create(descendant, info, { BackgroundTransparency = math.max(descendant.BackgroundTransparency, transparency) }):Play()
			end
		elseif descendant:IsA("Frame") and descendant.BackgroundTransparency < 1 then
			TweenService:Create(descendant, info, { BackgroundTransparency = math.max(descendant.BackgroundTransparency, transparency) }):Play()
		end
	end
end

--- A key-value row, used throughout the detail panels.
function Widgets.statRow(parent: Instance, key: string, value: string, order: number?): (TextLabel, TextLabel)
	local row = Instance.new("Frame")
	row.Name = "StatRow"
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, Theme.textSize("body") + Theme.space(0.75))
	row.LayoutOrder = order or 0

	local keyLabel = Widgets.label({
		text = key,
		size = "small",
		colour = Theme.colour("textMuted"),
		parent = row,
		name = "Key",
	})
	keyLabel.Size = UDim2.fromScale(0.55, 1)
	keyLabel.AutomaticSize = Enum.AutomaticSize.None
	keyLabel.TextYAlignment = Enum.TextYAlignment.Center

	local valueLabel = Widgets.label({
		text = value,
		size = "small",
		colour = Theme.colour("text"),
		align = Enum.TextXAlignment.Right,
		parent = row,
		name = "Value",
	})
	valueLabel.Position = UDim2.fromScale(0.45, 0)
	valueLabel.Size = UDim2.fromScale(0.55, 1)
	valueLabel.AutomaticSize = Enum.AutomaticSize.None
	valueLabel.TextYAlignment = Enum.TextYAlignment.Center

	row.Parent = parent
	return keyLabel, valueLabel
end

--- A divider line.
function Widgets.divider(parent: Instance, order: number?): Frame
	local line = Instance.new("Frame")
	line.Name = "Divider"
	line.BorderSizePixel = 0
	line.BackgroundColor3 = Theme.colour("line")
	line.BackgroundTransparency = 0.4
	line.Size = UDim2.new(1, 0, 0, 1)
	line.LayoutOrder = order or 0
	line.Parent = parent
	return line
end

--- An empty-state message, so a list with nothing in it explains itself.
function Widgets.emptyState(parent: Instance, message: string): Frame
	local frame = Widgets.panel({
		name = "Empty",
		size = UDim2.new(1, 0, 0, 0),
		padding = 2,
		background = Theme.colour("surface"),
		transparency = 0.4,
		parent = parent,
	})
	frame.AutomaticSize = Enum.AutomaticSize.Y
	Widgets.label({
		text = message,
		size = "small",
		colour = Theme.colour("textMuted"),
		align = Enum.TextXAlignment.Center,
		parent = frame,
	})
	return frame
end

return Widgets
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
