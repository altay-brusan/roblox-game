  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="33">
      <Properties>
        <string name="Name">LastSignalServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	LAST SIGNAL - server boot
	=========================
	A RIPGAMES production.

	This is the only Script on the server. Everything else is a ModuleScript
	started from here, in a fixed order, so there is exactly one place to look
	when something does not come up.

	BOOT ORDER
	----------
	The order below is not arbitrary. Each stage depends on the ones above it:

	  1  Net            remotes must exist before any service binds a handler
	  2  Data           profiles must load before anything reads or writes one
	  3  Economy        progression, quests, rewards, purchases, shop
	  4  World          the lobby and the expedition lanes get built
	  5  Session        crews, expeditions, the train
	  6  Gameplay       interaction, survival, combat, creatures, threat
	  7  Live           events, administration, analytics, leaderboards
	  8  Players        only now are joining players accepted

	Player joins are deliberately last. A player who connects mid-boot would
	otherwise find a world with no ground and services that are not listening.

	If a service fails to start, the failure is logged with its name and boot
	continues. A broken leaderboard must not stop the game from running; a
	broken DataService will already have put every session into read-only mode
	rather than risking player data.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("LastSignal")

local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Monetization = require(Shared.Config.Monetization)
local Audio = require(Shared.Config.Audio)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)

local Services = script.Services

local log = Logger.new("Boot")

--------------------------------------------------------------------------

local startedAt = os.clock()

log.info(string.rep("=", 58))
log.info(string.format("%s - %s", GameConfig.GameName, GameConfig.ChapterName))
log.info(string.format("%s  build %s  place mode %s", GameConfig.StudioName, GameConfig.BuildId, GameConfig.PlaceMode))
log.info(string.rep("=", 58))

-- Remotes first. Every service below binds handlers to these.
Net.initServer()

--------------------------------------------------------------------------
-- Service registry
--------------------------------------------------------------------------

type ServiceEntry = { name: string, module: ModuleScript, stage: string }

local BOOT_ORDER: { ServiceEntry } = {
	{ name = "DataService", module = Services.DataService, stage = "Data" },

	{ name = "ProgressionService", module = Services.ProgressionService, stage = "Economy" },
	{ name = "RewardService", module = Services.RewardService, stage = "Economy" },
	{ name = "QuestService", module = Services.QuestService, stage = "Economy" },
	{ name = "PurchaseService", module = Services.PurchaseService, stage = "Economy" },
	{ name = "ShopService", module = Services.ShopService, stage = "Economy" },
	{ name = "InventoryService", module = Services.InventoryService, stage = "Economy" },

	{ name = "WorldService", module = Services.WorldService, stage = "World" },

	{ name = "CrewService", module = Services.CrewService, stage = "Session" },
	{ name = "TrainService", module = Services.TrainService, stage = "Session" },
	{ name = "ExpeditionService", module = Services.ExpeditionService, stage = "Session" },

	{ name = "SurvivalService", module = Services.SurvivalService, stage = "Gameplay" },
	{ name = "InteractionService", module = Services.InteractionService, stage = "Gameplay" },
	{ name = "CreatureService", module = Services.CreatureService, stage = "Gameplay" },
	{ name = "CombatService", module = Services.CombatService, stage = "Gameplay" },
	{ name = "HorrorDirector", module = Services.HorrorDirector, stage = "Gameplay" },

	{ name = "EventService", module = Services.EventService, stage = "Live" },
	{ name = "AdminService", module = Services.AdminService, stage = "Live" },
	{ name = "AnalyticsService", module = Services.AnalyticsService, stage = "Live" },
	{ name = "LeaderboardService", module = Services.LeaderboardService, stage = "Live" },
}

local loaded: { [string]: any } = {}
local failures: { string } = {}
local currentStage = ""

for _, entry in BOOT_ORDER do
	if entry.stage ~= currentStage then
		currentStage = entry.stage
		log.info(string.format("-- %s --", currentStage))
	end

	local okRequire, service = Protect.call(require, entry.module)
	if not okRequire then
		table.insert(failures, entry.name)
		log.error(string.format("%s failed to load: %s", entry.name, tostring(service)))
		continue
	end

	loaded[entry.name] = service

	if type(service) == "table" and type(service.start) == "function" then
		local okStart, err = Protect.call(service.start)
		if not okStart then
			table.insert(failures, entry.name)
			log.error(string.format("%s failed to start: %s", entry.name, tostring(err)))
		end
	end
end

--------------------------------------------------------------------------
-- Configuration report
--------------------------------------------------------------------------

-- Printed at every boot so an operator can see, without reading any code,
-- exactly what is configured and what is switched off.
do
	log.info(string.rep("-", 58))
	log.info("Configuration")

	local money = Monetization.audit()
	if money.configured == 0 then
		log.warn(string.format("Monetization: 0 of %d products configured. The shop will show", money.total))
		log.warn("  every item as Unavailable and no purchase can be made.")
		log.warn("  Fill in the IDs in Config.Monetization. See docs/MONETIZATION.md.")
	else
		log.info(string.format("Monetization: %d of %d products configured.", money.configured, money.total))
		if #money.missing > 0 then
			log.warn("  Not yet configured: " .. table.concat(money.missing, ", "))
		end
	end

	local Admin = require(Shared.Config.Admin)
	local roles = Admin.audit()
	if roles.active == 0 then
		log.warn("Administration: no user IDs configured. Nobody has admin access.")
		log.warn("  Fill in the numeric user IDs in Config.Admin. See docs/ADMIN.md.")
	else
		log.info(string.format("Administration: %d role(s) active.", roles.active))
		if #roles.inactive > 0 then
			log.warn("  Roles with no user ID: " .. table.concat(roles.inactive, ", "))
		end
	end

	local audio = Audio.audit()
	if audio.configured == 0 then
		log.warn(string.format("Audio: 0 of %d cues configured. The game runs silently.", audio.total))
		log.warn("  The mixer, ducking, occlusion and subtitles all work; they have")
		log.warn("  nothing to play. See docs/AUDIO.md to fill in the asset IDs.")
	else
		log.info(string.format("Audio: %d of %d cues configured.", audio.configured, audio.total))
	end

	local dataStatus = (loaded.DataService and loaded.DataService.status and loaded.DataService.status()) or nil
	if dataStatus then
		if dataStatus.mock then
			log.warn("Data: Studio mock store. Progress is in memory only this session.")
		elseif not dataStatus.available then
			log.error("Data: DataStore unavailable. Every session will be read-only.")
		else
			log.info("Data: live DataStore.")
		end
	end

	if GameConfig.PlaceMode == "two" then
		if GameConfig.LobbyPlaceId <= 0 or GameConfig.ExpeditionPlaceId <= 0 then
			log.warn("Place mode is 'two' but the place IDs are not set; falling back to single-place behaviour.")
		end
	end

	log.info(string.rep("-", 58))
end

--------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------

local DataService = loaded.DataService
local WorldService = loaded.WorldService

local function onPlayerAdded(player: Player)
	-- The profile is loaded before the character exists, so nothing spawns
	-- into the world with default values that would then be saved.
	local okLoad, err = Protect.call(DataService.load, player)
	if not okLoad then
		log.error(string.format("profile load raised for %s: %s", player.Name, tostring(err)))
	end

	local lobby = WorldService and WorldService.getLobby()
	local spawnCF = if lobby then lobby.spawnCFrames[math.random(1, #lobby.spawnCFrames)] else CFrame.new(0, 10, 0)

	player.CharacterAdded:Connect(function(character)
		-- Placing the character explicitly, rather than relying on a
		-- SpawnLocation, means a respawn always lands somewhere real even if
		-- the player died in a lane that has since been torn down.
		task.defer(function()
			if character.Parent then
				local currentLobby = WorldService and WorldService.getLobby()
				local target = if currentLobby then currentLobby.spawnCFrames[math.random(1, #currentLobby.spawnCFrames)] else spawnCF
				-- Only reposition when the player is not on an expedition;
				-- ExpeditionService places its own crew.
				local ExpeditionService = loaded.ExpeditionService
				if not (ExpeditionService and ExpeditionService.forPlayer(player)) then
					character:PivotTo(target)
				end
			end
		end)
	end)

	player:LoadCharacter()
end

for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(function(player)
	task.spawn(onPlayerAdded, player)
end)

--------------------------------------------------------------------------

local elapsed = os.clock() - startedAt
if #failures == 0 then
	log.info(string.format("Ready in %.2fs. %d services started.", elapsed, #BOOT_ORDER))
else
	log.error(string.format("Ready in %.2fs with %d failure(s): %s", elapsed, #failures, table.concat(failures, ", ")))
end

if RunService:IsStudio() then
	log.info("Studio session. Press Play to test; use the F9 console to read this log.")
end
]]></string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Gameplay</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AdminService
	------------
	Administrative commands, with authorisation that cannot be faked.

	AUTHORISATION
	-------------
	Every command resolves the caller's role from Player.UserId through
	Config.Admin, on the server, on every call. Nothing trusts a client flag,
	a display name, a username string or a previously granted session token.
	A player whose user ID is not in the table has no access, and a capability
	that is not declared is denied.

	Both accounts named in the brief are already listed in Config.Admin with
	their roles set. Their numeric user IDs are 0 until an operator fills them
	in, and a role with ID 0 grants nothing, so the system ships inert rather
	than shipping a guess.

	SAFETY
	------
	  Destructive commands require a confirmation token, issued by running the
	  command once and re-sending it within a short window.
	  Resets preserve purchase records, because a wipe must not take away what
	  somebody paid Robux for.
	  Grants are clamped to sane maximums so a typo cannot write an absurd
	  number into a live profile.
	  Announcements are filtered through TextService before broadcast.
	  Every executed command is written to a bounded audit log and to output.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local Shared = ReplicatedStorage.LastSignal

local Admin = require(Shared.Config.Admin)
local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local ItemRegistry = require(Shared.Registry.ItemRegistry)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local HorrorDirector = require(script.Parent.HorrorDirector)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local SurvivalService = require(script.Parent.SurvivalService)
local WorldService = require(script.Parent.WorldService)

local log = Logger.new("AdminService")

local AdminService = {}

--------------------------------------------------------------------------
-- Audit log
--------------------------------------------------------------------------

export type AuditEntry = {
	at: number,
	userId: number,
	name: string,
	command: string,
	arguments: string,
	result: string,
}

local auditLog: { AuditEntry } = {}

local function audit(player: Player, command: string, arguments: string, result: string)
	table.insert(auditLog, {
		at = os.time(),
		userId = player.UserId,
		name = player.Name,
		command = command,
		arguments = arguments,
		result = result,
	})
	while #auditLog > Admin.AuditLogSize do
		table.remove(auditLog, 1)
	end
	log.info(string.format("[%s] %s %s -> %s", player.Name, command, arguments, result))
end

function AdminService.auditLog(): { AuditEntry }
	return table.clone(auditLog)
end

--------------------------------------------------------------------------
-- Confirmation tokens
--------------------------------------------------------------------------

type PendingConfirm = { command: string, arguments: string, expiresAt: number }
local pending: { [number]: PendingConfirm } = {}

local function requireConfirmation(player: Player, command: string, arguments: string): (boolean, string?)
	local entry = pending[player.UserId]
	local now = os.clock()
	if entry and entry.command == command and entry.arguments == arguments and now < entry.expiresAt then
		pending[player.UserId] = nil
		return true, nil
	end
	pending[player.UserId] = {
		command = command,
		arguments = arguments,
		expiresAt = now + Admin.ConfirmWindowSeconds,
	}
	return false,
		string.format(
			"This command is destructive. Run exactly the same command again within %d seconds to confirm.",
			Admin.ConfirmWindowSeconds
		)
end

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------

local function resolveTarget(raw: any): Player?
	if type(raw) == "number" then
		return Players:GetPlayerByUserId(raw)
	end
	local name = Guard.string(raw, 64)
	if not name then
		return nil
	end
	local lowered = string.lower(name)
	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end
	-- Prefix match, so an operator does not have to type a full username.
	for _, player in Players:GetPlayers() do
		if string.sub(string.lower(player.Name), 1, #lowered) == lowered then
			return player
		end
	end
	return nil
end

local function filtered(player: Player, text: string): string
	if not Admin.FilterAnnouncements then
		return text
	end
	local ok, result = Protect.call(function()
		local filterResult = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	-- Filtering failed. Refusing to broadcast is the safe outcome.
	log.warn("text filter failed; announcement suppressed")
	return ""
end

--------------------------------------------------------------------------
-- Commands
--------------------------------------------------------------------------

export type CommandDef = {
	name: string,
	capability: string,
	usage: string,
	description: string,
	run: (player: Player, a: any, b: any, c: any) -> { [string]: any },
}

local COMMANDS: { [string]: CommandDef } = {}

local function define(def: CommandDef)
	COMMANDS[def.name] = def
end

define({
	name = "help",
	capability = "teleport_self",
	usage = "help",
	description = "Lists the commands your role can use.",
	run = function(player)
		local out = {}
		for name, def in COMMANDS do
			if Admin.can(player.UserId, def.capability) then
				table.insert(out, { name = name, usage = def.usage, description = def.description })
			end
		end
		table.sort(out, function(a, b)
			return a.name < b.name
		end)
		return { ok = true, commands = out, role = Admin.roleOf(player.UserId) }
	end,
})

define({
	name = "credits",
	capability = "grant_currency",
	usage = "credits <player> <amount>",
	description = "Grants credits to a player.",
	run = function(_player, rawTarget, rawAmount)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local amount = Guard.integer(rawAmount, -Admin.GrantLimits.credits, Admin.GrantLimits.credits)
		if not amount then
			return { ok = false, error = "BAD_AMOUNT" }
		end
		ProgressionService.award(target, { credits = amount, source = "admin", exact = true })
		return { ok = true, message = string.format("%d credits to %s", amount, target.Name) }
	end,
})

define({
	name = "xp",
	capability = "grant_xp",
	usage = "xp <player> <amount>",
	description = "Grants XP to a player.",
	run = function(_player, rawTarget, rawAmount)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local amount = Guard.integer(rawAmount, 0, Admin.GrantLimits.xp)
		if not amount then
			return { ok = false, error = "BAD_AMOUNT" }
		end
		local result = ProgressionService.award(target, { xp = amount, source = "admin", exact = true })
		return { ok = true, message = string.format("%d XP to %s (now level %d)", amount, target.Name, result.newLevel) }
	end,
})

define({
	name = "item",
	capability = "grant_item",
	usage = "item <player> <itemId> [quantity]",
	description = "Places items in a player's expedition inventory.",
	run = function(_player, rawTarget, rawItem, rawQuantity)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local itemId = Guard.id(rawItem)
		if not itemId or not ItemRegistry.exists(itemId) then
			return { ok = false, error = "UNKNOWN_ITEM" }
		end
		local quantity = Guard.integer(rawQuantity, 1, Admin.GrantLimits.itemQuantity) or 1
		if not InventoryService.get(target) then
			return { ok = false, error = "TARGET_NOT_ON_EXPEDITION" }
		end
		local added = InventoryService.add(target, itemId, quantity)
		return { ok = added > 0, message = string.format("gave %d x %s to %s", added, itemId, target.Name) }
	end,
})

define({
	name = "unlock",
	capability = "unlock_content",
	usage = "unlock <player> <kind> <id>",
	description = "Grants an unlock. Kinds: cosmetic, livery, interior, train, weapon.",
	run = function(_player, rawTarget, rawKind, rawId)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local kind = Guard.enum(rawKind, { "cosmetic", "livery", "interior", "train", "weapon" })
		local id = Guard.id(rawId)
		if not kind or not id then
			return { ok = false, error = "BAD_ARGS" }
		end
		local granted = ProgressionService.grantUnlock(target, kind, id)
		return { ok = granted, message = if granted then "granted" else "already owned or unknown" }
	end,
})

define({
	name = "tp",
	capability = "teleport_self",
	usage = "tp <lobby|station N|train>",
	description = "Moves you around the world.",
	run = function(player, rawWhere, rawIndex)
		local where = Guard.enum(rawWhere, { "lobby", "station", "train" })
		if not where then
			return { ok = false, error = "BAD_DESTINATION" }
		end
		local character = player.Character
		if not character then
			return { ok = false, error = "NO_CHARACTER" }
		end

		if where == "lobby" then
			local lobby = WorldService.getLobby()
			if not lobby then
				return { ok = false, error = "NO_LOBBY" }
			end
			character:PivotTo(lobby.spawnCFrames[1])
			return { ok = true, message = "moved to the yard" }
		end

		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return { ok = false, error = "NOT_ON_EXPEDITION" }
		end
		if where == "train" then
			character:PivotTo(expedition.train.built.root.CFrame * CFrame.new(0, 8, 20))
			return { ok = true, message = "moved to the train" }
		end
		local index = Guard.integer(rawIndex, 1, 10)
		if not index then
			return { ok = false, error = "BAD_INDEX" }
		end
		local station = expedition.lane.stations[index]
		if not station then
			return { ok = false, error = "NO_SUCH_STATION" }
		end
		character:PivotTo(station.origin * CFrame.new(0, 8, 0))
		return { ok = true, message = "moved to station " .. index }
	end,
})

define({
	name = "bring",
	capability = "teleport_player",
	usage = "bring <player>",
	description = "Teleports a player to you.",
	run = function(player, rawTarget)
		local target = resolveTarget(rawTarget)
		if not target or not target.Character or not player.Character then
			return { ok = false, error = "NO_TARGET" }
		end
		target.Character:PivotTo(player.Character:GetPivot() * CFrame.new(0, 0, -5))
		return { ok = true, message = "brought " .. target.Name }
	end,
})

define({
	name = "announce",
	capability = "announce",
	usage = "announce <message>",
	description = "Broadcasts a filtered message to every player on the server.",
	run = function(player, rawMessage)
		local message = Guard.string(rawMessage, 300)
		if not message or message == "" then
			return { ok = false, error = "EMPTY" }
		end
		local safe = filtered(player, message)
		if safe == "" then
			return { ok = false, error = "FILTERED" }
		end
		Net.fireAllClients("Notify", {
			kind = "announcement",
			title = "Announcement",
			body = safe,
			duration = 12,
		})
		return { ok = true, message = "sent" }
	end,
})

define({
	name = "kick",
	capability = "kick",
	usage = "kick <player> <reason>",
	description = "Removes a player from the server.",
	run = function(player, rawTarget, rawReason)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		if Admin.rankOf(Admin.roleOf(target.UserId)) >= Admin.rankOf(Admin.roleOf(player.UserId)) then
			-- An administrator cannot kick an equal or a superior.
			return { ok = false, error = "INSUFFICIENT_RANK" }
		end
		local reason = Guard.string(rawReason, 200) or "Removed by a moderator."
		target:Kick(reason)
		return { ok = true, message = "kicked " .. target.Name }
	end,
})

define({
	name = "inspect",
	capability = "inspect_player",
	usage = "inspect <player>",
	description = "Shows a player's progression and session state.",
	run = function(_player, rawTarget)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local profile = DataService.getProfile(target)
		if not profile then
			return { ok = false, error = "NOT_LOADED" }
		end
		local expedition = ExpeditionService.forPlayer(target)
		local vitals = SurvivalService.get(target)
		return {
			ok = true,
			info = {
				name = target.Name,
				userId = target.UserId,
				level = profile.level,
				xp = profile.xp,
				credits = profile.credits,
				sessionCount = profile.sessionCount,
				writable = DataService.isWritable(target),
				readOnlyReason = DataService.readOnlyReason(target),
				expedition = if expedition then expedition.id else nil,
				station = if expedition then expedition.stationIndex else nil,
				vitals = if vitals then { health = vitals.health, state = vitals.state } else nil,
				role = Admin.roleOf(target.UserId),
				robuxSpent = profile.purchases.robuxSpent,
			},
		}
	end,
})

define({
	name = "godmode",
	capability = "toggle_godmode",
	usage = "godmode <player>",
	description = "Grants a long damage immunity, for testing.",
	run = function(_player, rawTarget)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		SurvivalService.grantImmunity(target, 3600)
		return { ok = true, message = "immunity granted for one hour" }
	end,
})

define({
	name = "threat",
	capability = "spawn_creature",
	usage = "threat <amount>",
	description = "Adds to your expedition's threat level.",
	run = function(player, rawAmount)
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return { ok = false, error = "NOT_ON_EXPEDITION" }
		end
		local amount = Guard.number(rawAmount, -100, 100)
		if not amount then
			return { ok = false, error = "BAD_AMOUNT" }
		end
		HorrorDirector.addThreat(expedition.id, amount)
		return { ok = true, message = string.format("threat is now %.0f", HorrorDirector.threatOf(expedition.id)) }
	end,
})

define({
	name = "station",
	capability = "control_expedition",
	usage = "station <index>",
	description = "Advances your expedition to a station, completing the ones before it.",
	run = function(player, rawIndex)
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return { ok = false, error = "NOT_ON_EXPEDITION" }
		end
		local index = Guard.integer(rawIndex, 1, 10)
		if not index then
			return { ok = false, error = "BAD_INDEX" }
		end
		-- Complete every outstanding objective at the current station, which is
		-- what actually advances the expedition through its normal path.
		for objectiveId in expedition.objectives do
			ExpeditionService.completeObjective(expedition, objectiveId)
		end
		return { ok = true, message = "current station objectives completed" }
	end,
})

define({
	name = "event",
	capability = "control_event",
	usage = "event <start|stop|status> [id] [hours]",
	description = "Controls live events.",
	run = function(_player, rawAction, rawId, rawHours)
		local action = Guard.enum(rawAction, { "start", "stop", "status" })
		if not action then
			return { ok = false, error = "BAD_ACTION" }
		end
		if action == "status" then
			return { ok = true, events = EventService.status() }
		end
		local id = Guard.id(rawId)
		if not id then
			return { ok = false, error = "BAD_EVENT" }
		end
		if action == "start" then
			local hours = Guard.number(rawHours, 0.1, 24 * 30) or 168
			local ok = EventService.startEvent(id, hours)
			return { ok = ok, message = if ok then "event started" else "unknown event" }
		end
		local ok = EventService.stopEvent(id)
		return { ok = ok, message = if ok then "event stopped; claims remain open" else "unknown event" }
	end,
})

define({
	name = "world",
	capability = "view_analytics",
	usage = "world",
	description = "Reports lane and server state.",
	run = function()
		local status = WorldService.status()
		local expeditions = {}
		for _, expedition in ExpeditionService.all() do
			table.insert(expeditions, {
				id = expedition.id,
				state = expedition.state,
				station = expedition.stationIndex,
				crew = expedition.crewSize,
				threat = HorrorDirector.threatOf(expedition.id),
			})
		end
		return {
			ok = true,
			world = status,
			expeditions = expeditions,
			data = DataService.status(),
			build = GameConfig.BuildId,
		}
	end,
})

define({
	name = "resetplayer",
	capability = "reset_player_data",
	usage = "resetplayer <player>",
	description = "OWNER ONLY. Wipes a player's progress. Purchases are preserved.",
	run = function(player, rawTarget)
		local target = resolveTarget(rawTarget)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end
		local confirmed, message = requireConfirmation(player, "resetplayer", tostring(target.UserId))
		if not confirmed then
			return { ok = false, error = "CONFIRM", message = message }
		end
		local ok = DataService.resetProgress(target.UserId)
		if ok then
			ProgressionService.pushToClient(target)
		end
		return {
			ok = ok,
			message = if ok then "progress reset; purchase records preserved" else "target session is not writable",
		}
	end,
})

define({
	name = "resetme",
	capability = "reset_player_data",
	usage = "resetme",
	description = "OWNER ONLY. Wipes your own progress. Purchases are preserved.",
	run = function(player)
		local confirmed, message = requireConfirmation(player, "resetme", tostring(player.UserId))
		if not confirmed then
			return { ok = false, error = "CONFIRM", message = message }
		end
		local ok = DataService.resetProgress(player.UserId)
		if ok then
			ProgressionService.pushToClient(player)
		end
		return { ok = ok, message = if ok then "your progress was reset" else "your session is not writable" }
	end,
})

--------------------------------------------------------------------------

function AdminService.roleOf(player: Player): string
	return Admin.roleOf(player.UserId)
end

function AdminService.start()
	Net.onServerInvoke("AdminCommand", function(player, rawCommand, a, b, c)
		local commandName = Guard.string(rawCommand, 32)
		if not commandName then
			return { ok = false, error = "BAD_COMMAND" }
		end
		local def = COMMANDS[string.lower(commandName)]
		if not def then
			return { ok = false, error = "UNKNOWN_COMMAND" }
		end

		-- The authorisation check. Server side, by user ID, every single call.
		if not Admin.can(player.UserId, def.capability) then
			audit(player, commandName, "", "DENIED")
			return { ok = false, error = "DENIED" }
		end

		local ok, result = Protect.call(def.run, player, a, b, c)
		if not ok then
			audit(player, commandName, tostring(a), "ERROR")
			log.error(string.format("command %s failed: %s", commandName, tostring(result)))
			return { ok = false, error = "INTERNAL" }
		end

		local payload = result :: { [string]: any }
		audit(
			player,
			commandName,
			string.format("%s %s %s", tostring(a), tostring(b), tostring(c)),
			if payload.ok then "OK" else tostring(payload.error)
		)
		return payload
	end)

	-- The client is told its own role so it can show or hide the admin panel.
	-- The panel is a convenience; every command is re-authorised server side,
	-- so a client that fakes the flag gains nothing.
	DataService.ProfileLoaded:Connect(function(player)
		local role = Admin.roleOf(player.UserId)
		if role ~= "player" then
			Net.fireClient("AdminState", player, { role = role, commands = (function()
				local out = {}
				for name, def in COMMANDS do
					if Admin.can(player.UserId, def.capability) then
						table.insert(out, { name = name, usage = def.usage, description = def.description })
					end
				end
				table.sort(out, function(x, y)
					return x.name < y.name
				end)
				return out
			end)() })
			log.info(string.format("%s connected with role %s", player.Name, role))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		pending[player.UserId] = nil
	end)

	local roleAudit = Admin.audit()
	if roleAudit.active == 0 then
		log.warn(
			"no administrator user IDs are configured. Nobody has admin access. "
				.. "Fill in the numeric user IDs in ReplicatedStorage.LastSignal.Config.Admin; see docs/ADMIN.md."
		)
	else
		log.info(string.format("%d role(s) active", roleAudit.active))
		if #roleAudit.inactive > 0 then
			log.warn("roles with no user ID: " .. table.concat(roleAudit.inactive, ", "))
		end
	end

end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AnalyticsService
	----------------
	Measurement, defined precisely enough to act on.

	WHAT THIS DOES AND DOES NOT DO
	------------------------------
	It records counters and funnel steps in server memory and writes periodic
	aggregate snapshots to an ordered DataStore, keyed by day. It does not
	collect personal information, does not send anything to a third party, and
	does not store anything about an individual player beyond their user ID
	against their own aggregate counters, which the profile already holds.

	It also does not invent numbers. Every metric below is computed from an
	event this project actually fires. There are no modelled or estimated
	values anywhere in this file, and nothing here reports a figure that has
	not been measured on a real server.

	THE FUNNEL
	----------
	The questions the operator needs answered, and the events that answer them:

	  Do players start a run?      join -> lobby_ready -> crew_formed -> departed
	  Do they finish it?           departed -> station_1..5 -> completed
	  Where do they leave?         left_at, recorded with the phase and station
	  Does the shop get opened?    shop_opened
	  Does opening convert?        shop_opened -> prompt_shown -> purchased
	  What sells?                  purchased, by product key
	  Do they come back?           session_count from the profile, at join

	Reading these is documented in docs/ANALYTICS.md, including what each one
	does not tell you.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)

local DataService = require(script.Parent.DataService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local PurchaseService = require(script.Parent.PurchaseService)
local ShopService = require(script.Parent.ShopService)
local SurvivalService = require(script.Parent.SurvivalService)

local log = Logger.new("AnalyticsService")

local AnalyticsService = {}

--------------------------------------------------------------------------
-- Counters
--------------------------------------------------------------------------

local counters: { [string]: number } = {}
local sessionStart: { [number]: number } = {}
local playerPhase: { [number]: string } = {}

local function bump(key: string, amount: number?)
	counters[key] = (counters[key] or 0) + (amount or 1)
end

AnalyticsService.bump = bump

function AnalyticsService.snapshot(): { [string]: number }
	local copy: { [string]: number } = {}
	for key, value in counters do
		copy[key] = value
	end
	copy.uptime_seconds = math.floor(os.clock())
	copy.players_online = #Players:GetPlayers()
	return copy
end

--------------------------------------------------------------------------
-- Derived rates
--------------------------------------------------------------------------

--- The numbers an operator actually reads, each defined as a ratio of two
--- measured counters. A rate with a zero denominator is reported as nil
--- rather than as zero, because "no data" and "zero percent" are different
--- answers and confusing them leads to bad decisions.
function AnalyticsService.rates(): { [string]: number? }
	local function ratio(numerator: string, denominator: string): number?
		local bottom = counters[denominator] or 0
		if bottom <= 0 then
			return nil
		end
		return (counters[numerator] or 0) / bottom
	end

	return {
		-- Of the players who joined, how many got as far as departing.
		departure_rate = ratio("departed", "joined"),
		-- Of the expeditions that departed, how many finished successfully.
		completion_rate = ratio("expedition_completed", "departed"),
		-- Of the players who opened the shop, how many saw a purchase prompt.
		prompt_rate = ratio("prompt_shown", "shop_opened"),
		-- Of the prompts shown, how many completed. This is the conversion
		-- number, and it is the one worth acting on.
		conversion_rate = ratio("purchased", "prompt_shown"),
		-- Of the purchases made, how many were by a player who had bought
		-- before. Repeat purchase is the health signal for a live game.
		repeat_purchase_rate = ratio("purchased_repeat", "purchased"),
		-- Downs per expedition, a difficulty signal.
		downs_per_expedition = ratio("player_downed", "departed"),
	}
end

--------------------------------------------------------------------------
-- Persistence
--------------------------------------------------------------------------

local store: DataStore? = nil
if not RunService:IsStudio() then
	local ok, result = Protect.call(function()
		return DataStoreService:GetDataStore("LastSignal_Analytics_v1")
	end)
	if ok then
		store = result
	else
		log.warn("analytics store unavailable; counters stay in memory for this server only")
	end
end

local function dayKey(): string
	return os.date("!%Y-%m-%d")
end

--- Merges this server's counters into the day's aggregate. UpdateAsync makes
--- the merge safe when many servers write the same key.
local function flush()
	local target = store
	if not target then
		return
	end
	local snapshot = AnalyticsService.snapshot()
	local ok, err = Protect.call(function()
		target:UpdateAsync(dayKey(), function(current)
			local aggregate = current or {}
			for key, value in snapshot do
				if key ~= "uptime_seconds" and key ~= "players_online" then
					aggregate[key] = (aggregate[key] or 0) + value
				end
			end
			aggregate.servers_reporting = (aggregate.servers_reporting or 0) + 1
			return aggregate
		end)
	end)
	if ok then
		-- Counters are reset after a successful flush so the next flush does
		-- not double-count this server's events.
		table.clear(counters)
	else
		log.warn("analytics flush failed; counters retained:", tostring(err))
	end
end

function AnalyticsService.readDay(day: string?): { [string]: any }?
	local target = store
	if not target then
		return nil
	end
	local ok, result = Protect.call(function()
		return target:GetAsync(day or dayKey())
	end)
	return if ok then result else nil
end

--------------------------------------------------------------------------

function AnalyticsService.start()
	Players.PlayerAdded:Connect(function(player)
		sessionStart[player.UserId] = os.clock()
		playerPhase[player.UserId] = "joining"
		bump("joined")
	end)

	DataService.ProfileLoaded:Connect(function(player, profile)
		playerPhase[player.UserId] = "lobby"
		bump("lobby_ready")
		if profile.sessionCount > 1 then
			bump("returning_player")
		else
			bump("new_player")
		end
		if not DataService.isWritable(player) then
			bump("session_read_only")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local phase = playerPhase[player.UserId] or "unknown"
		bump("left_at_" .. phase)
		local started = sessionStart[player.UserId]
		if started then
			bump("session_seconds", math.floor(os.clock() - started))
			bump("sessions_ended")
		end
		sessionStart[player.UserId] = nil
		playerPhase[player.UserId] = nil
	end)

	ExpeditionService.StateChanged:Connect(function(expedition, state)
		for _, player in ExpeditionService.playersOf(expedition) do
			playerPhase[player.UserId] = state
		end
		if state == "cinematic" then
			bump("departed")
			bump("departed_crew_" .. tostring(expedition.crewSize))
			bump("departed_difficulty_" .. expedition.difficulty)
		end
	end)

	ExpeditionService.StationReached:Connect(function(_expedition, index)
		bump("station_reached_" .. tostring(index))
	end)

	ExpeditionService.Ended:Connect(function(expedition, success)
		if success then
			bump("expedition_completed")
		else
			bump("expedition_failed")
		end
		bump("expedition_seconds", math.floor((expedition.endedAt or os.clock()) - expedition.startedAt))
	end)

	SurvivalService.Downed:Connect(function()
		bump("player_downed")
	end)
	SurvivalService.Died:Connect(function()
		bump("player_died")
	end)
	SurvivalService.Revived:Connect(function(_player, by)
		bump(if by then "revive_by_teammate" else "revive_self")
	end)

	PurchaseService.Purchased:Connect(function(player, productKey, robux)
		bump("purchased")
		bump("purchased_" .. productKey)
		if robux > 0 then
			bump("robux_spent", robux)
		end
		local profile = DataService.getProfile(player)
		if profile then
			local distinct = 0
			for _, count in profile.purchases.products do
				if count > 0 then
					distinct += 1
				end
			end
			if distinct > 1 then
				bump("purchased_repeat")
			end
		end
	end)

	ShopService.PromptBlocked:Connect(function(_player, reason)
		bump("prompt_blocked_" .. reason)
	end)

	-- Client-reported funnel markers. These are the only client-originated
	-- analytics, they carry no free text, and the event name is validated
	-- against a fixed list so a client cannot write arbitrary counter keys.
	local CLIENT_EVENTS = {
		"shop_opened",
		"shop_category_viewed",
		"prompt_shown",
		"settings_opened",
		"quests_opened",
		"crew_panel_opened",
		"cinematic_skipped",
		"tutorial_prompt_seen",
		"mobile_session",
		"tablet_session",
		"desktop_session",
		"console_session",
	}
	Net.onServerEvent("Analytics", function(_player, rawEvent)
		local event = Guard.enum(rawEvent, CLIENT_EVENTS)
		if not event then
			return
		end
		bump(event)
	end)

	if store then
		task.spawn(function()
			while true do
				task.wait(300)
				local ok, err = Protect.call(flush)
				if not ok then
					log.warn("flush error:", tostring(err))
				end
			end
		end)
		game:BindToClose(function()
			Protect.call(flush)
		end)
	end

	log.info(string.format("started (persistence: %s, build %s)", if store then "on" else "memory only", GameConfig.BuildId))
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CombatService
	-------------
	Server-authoritative weapons.

	WHAT THE CLIENT SENDS
	---------------------
	An origin, a direction, and for firearms the hit it believes it made. That
	is all. The server decides whether the shot was possible, whether the hit
	was plausible, and what damage results.

	WHAT THE SERVER CHECKS ON EVERY SHOT
	------------------------------------
	  the weapon is equipped and owned
	  the reload state allows firing
	  enough time has passed since the last shot, with a small grace
	  ammunition is present, and it is decremented here
	  the origin is near the player's actual character
	  the hit is within the weapon's range, with a small grace
	  the hit position is near the claimed target, with a tolerance that suits
	    a 250 ms connection and nothing more

	A shot that fails any of these is discarded silently. The client is not told
	why, because that information only helps somebody tuning an exploit.

	COMBAT AND FEAR
	---------------
	Firearms are loud, and loud is the primary input to the threat director.
	Every shot raises threat and calls the creature. Nothing here can kill the
	creature; damage fills its drive-off meter. That is what keeps a horror game
	a horror game while still letting a cornered crew fight back.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)

local CreatureService = require(script.Parent.CreatureService)
local DataService = require(script.Parent.DataService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local SurvivalService = require(script.Parent.SurvivalService)

local log = Logger.new("CombatService")

local CombatService = {}

export type WeaponState = {
	userId: number,
	equipped: string?,
	magazine: number,
	reloading: boolean,
	reloadStartedAt: number,
	reloadDuration: number,
	lastFiredAt: number,
	lastSwingAt: number,
}

local states: { [number]: WeaponState } = {}

CombatService.Fired = Signal.new() :: Signal.Signal<Player, string, Vector3>
CombatService.Hit = Signal.new() :: Signal.Signal<Player, Instance, number>

--------------------------------------------------------------------------

local function stateFor(player: Player): WeaponState
	local existing = states[player.UserId]
	if existing then
		return existing
	end
	local created: WeaponState = {
		userId = player.UserId,
		equipped = nil,
		magazine = 0,
		reloading = false,
		reloadStartedAt = 0,
		reloadDuration = 0,
		lastFiredAt = 0,
		lastSwingAt = 0,
	}
	states[player.UserId] = created
	return created
end

--- Ammunition lives in the inventory as items, not as a separate counter, so
--- there is exactly one place where it can be gained or lost.
local function ammoItemFor(ammoType: string): string?
	if ammoType == "pistol" then
		return "ammo_pistol"
	elseif ammoType == "shell" then
		return "ammo_shell"
	elseif ammoType == "rifle" then
		return "ammo_rifle"
	elseif ammoType == "flare" then
		return "flare_shell"
	end
	return nil
end

function CombatService.equip(player: Player, weaponId: string?): (boolean, string?)
	local state = stateFor(player)
	if not weaponId then
		state.equipped = nil
		state.reloading = false
		return true, nil
	end

	local def = WeaponRegistry.get(weaponId)
	if not def then
		return false, "UNKNOWN_WEAPON"
	end
	local profile = DataService.getProfile(player)
	if not profile then
		return false, "NOT_LOADED"
	end
	-- Ownership is checked here and nowhere else, so a client cannot equip a
	-- weapon it has not unlocked by any route.
	if not (def.startingLoadout or profile.weapons[weaponId]) then
		return false, "NOT_OWNED"
	end
	if profile.level < def.unlockLevel then
		return false, "LEVEL_LOCKED"
	end

	state.equipped = weaponId
	state.reloading = false
	if def.kind == "firearm" then
		-- A freshly equipped firearm starts with whatever it can load from the
		-- player's ammunition, up to a fraction of a magazine.
		local ammoItem = ammoItemFor(def.ammoType or "")
		local available = if ammoItem then InventoryService.countOf(player, ammoItem) else 0
		local wanted = math.floor((def.magazineSize or 1) * Balance.Combat.startingAmmoFraction + 0.5)
		state.magazine = math.min(def.magazineSize or 1, math.max(0, math.min(wanted, available)))
	else
		state.magazine = 0
	end
	CombatService.push(player)
	return true, nil
end

function CombatService.get(player: Player): WeaponState?
	return states[player.UserId]
end

function CombatService.push(player: Player)
	local state = states[player.UserId]
	if not state then
		return
	end
	local def = if state.equipped then WeaponRegistry.get(state.equipped) else nil
	local reserve = 0
	if def and def.kind == "firearm" then
		local ammoItem = ammoItemFor(def.ammoType or "")
		reserve = if ammoItem then InventoryService.countOf(player, ammoItem) else 0
	end
	Net.fireClient("WeaponEffect", player, {
		kind = "state",
		equipped = state.equipped,
		magazine = state.magazine,
		magazineSize = if def then def.magazineSize else nil,
		reserve = reserve,
		reloading = state.reloading,
		reloadRemaining = if state.reloading then math.max(0, state.reloadDuration - (os.clock() - state.reloadStartedAt)) else 0,
	})
end

--------------------------------------------------------------------------
-- Reloading
--------------------------------------------------------------------------

function CombatService.reload(player: Player): (boolean, string?)
	local state = stateFor(player)
	local def = if state.equipped then WeaponRegistry.get(state.equipped) else nil
	if not def or def.kind ~= "firearm" then
		return false, "NO_FIREARM"
	end
	if state.reloading then
		return false, "ALREADY_RELOADING"
	end
	local capacity = def.magazineSize or 1
	if state.magazine >= capacity then
		return false, "FULL"
	end

	local ammoItem = ammoItemFor(def.ammoType or "")
	if not ammoItem then
		return false, "NO_AMMO_TYPE"
	end
	local available = InventoryService.countOf(player, ammoItem)
	if available <= 0 then
		return false, "NO_AMMO"
	end

	local missing = capacity - state.magazine
	local loading = math.min(missing, available)
	local duration = WeaponRegistry.reloadDuration(def, loading)

	state.reloading = true
	state.reloadStartedAt = os.clock()
	state.reloadDuration = duration
	CombatService.push(player)

	task.delay(duration, function()
		-- Re-validate on completion: the player may have died, swapped weapon
		-- or spent the ammunition in the meantime.
		local current = states[player.UserId]
		if not current or not current.reloading or current.equipped ~= (def :: any).id then
			return
		end
		current.reloading = false
		local stillAvailable = InventoryService.countOf(player, ammoItem)
		local actual = math.min(loading, stillAvailable)
		if actual > 0 then
			InventoryService.remove(player, ammoItem, actual)
			current.magazine = math.min(capacity, current.magazine + actual)
		end
		CombatService.push(player)
	end)

	return true, nil
end

--------------------------------------------------------------------------
-- Damage application
--------------------------------------------------------------------------

--- Resolves what was hit and applies damage. Returns the damage dealt.
local function applyHit(player: Player, hitInstance: Instance, damage: number): number
	local expedition = ExpeditionService.forPlayer(player)
	if not expedition then
		return 0
	end

	-- The creature.
	local creatureModel = if hitInstance:IsA("Model") then hitInstance else hitInstance:FindFirstAncestorOfClass("Model")
	if creatureModel and creatureModel:HasTag("Creature") then
		for _, creature in CreatureService.forExpedition(expedition.id) do
			if creature.model == creatureModel then
				local applied = damage
				-- A hit to the head cowl counts for more, which rewards aiming
				-- at the thing that is hardest to see.
				if hitInstance.Name == "Head" or hitInstance.Name == "Cowl" then
					applied *= Balance.Combat.headshotMultiplier
				end
				CreatureService.applyDamage(creature, applied, player)
				CombatService.Hit:Fire(player, creatureModel, applied)
				return applied
			end
		end
		return 0
	end

	-- Friendly fire is off. A co-operative horror game where one player can
	-- shoot another is a griefing tool, and there is no upside.
	local character = if hitInstance:IsA("Model") then hitInstance else hitInstance:FindFirstAncestorOfClass("Model")
	if character then
		local hitPlayer = Players:GetPlayerFromCharacter(character)
		if hitPlayer then
			return 0
		end
	end

	-- Nothing else in the world takes damage. Scenery, the train and other
	-- players are all deliberately immune, so a stray shot costs ammunition and
	-- noise and nothing more.
	return 0
end

--------------------------------------------------------------------------
-- Firing
--------------------------------------------------------------------------

local function handleFire(player: Player, rawOrigin: any, rawDirection: any, rawHitInstance: any, rawHitPosition: any)
	local state = states[player.UserId]
	if not state or not state.equipped then
		return
	end
	local def = WeaponRegistry.get(state.equipped)
	if not def or def.kind ~= "firearm" then
		return
	end

	local vitals = SurvivalService.get(player)
	if not vitals or vitals.state ~= "alive" then
		return
	end
	if state.reloading then
		return
	end
	if state.magazine <= 0 then
		return
	end

	local now = os.clock()
	if (now - state.lastFiredAt) < (def.fireInterval - Balance.Combat.fireIntervalGrace) then
		return
	end

	local origin = Guard.vector3(rawOrigin, 1e5)
	local direction = Guard.direction(rawDirection)
	if not origin or not direction then
		return
	end

	local root = Guard.aliveRoot(player)
	if not root then
		return
	end
	-- The shot must come from roughly where the player is.
	if not Guard.withinDistance(origin, root.Position, 12) then
		return
	end

	state.lastFiredAt = now
	state.magazine -= 1

	local expedition = ExpeditionService.forPlayer(player)
	if expedition then
		ExpeditionService.noteWeaponFired(expedition, def.noiseRadius > Balance.Combat.noiseRadiusSuppressed)
		-- Loud, and the forest is listening. This is the real cost of firing.
		CreatureService.hearNoise(expedition.id, origin, def.noiseRadius / 40)
		ExpeditionService.ThreatEvent:Fire(expedition, "gunshot", Balance.Threat.noisePerGunshot)
		CreatureService.learnCue(expedition.id, def.fireCue)
	end
	ProgressionService.addStat(player, "shots_fired", 1)

	-- Hit resolution. The client reports what it hit; the server checks the
	-- claim is geometrically possible before acting on it.
	local totalDamage = 0
	local hitInstance = Guard.instance(rawHitInstance, "BasePart")
	local hitPosition = Guard.vector3(rawHitPosition, 1e5)

	if hitInstance and hitPosition then
		local maxRange = def.range * Balance.Combat.maxHitDistanceGrace
		local withinRange = (hitPosition - origin).Magnitude <= maxRange
		local nearTarget = ((hitInstance :: BasePart).Position - hitPosition).Magnitude
			<= Balance.Combat.hitPositionTolerance + (hitInstance :: BasePart).Size.Magnitude
		-- The hit must also be roughly along the reported aim direction.
		local toHit = (hitPosition - origin)
		local alongAim = toHit.Magnitude < 1 or toHit.Unit:Dot(direction) > 0.72

		if withinRange and nearTarget and alongAim then
			local pellets = def.pellets or 1
			for _ = 1, pellets do
				totalDamage += applyHit(player, hitInstance :: Instance, def.damage)
			end
		end
	end

	-- Effects are broadcast to the crew so everyone sees and hears the shot.
	if expedition then
		Net.fireClients("WeaponEffect", ExpeditionService.playersOf(expedition), {
			kind = "fire",
			userId = player.UserId,
			weaponId = def.id,
			origin = origin,
			direction = direction,
			hitPosition = hitPosition,
			damage = totalDamage,
		})
	end
	CombatService.Fired:Fire(player, def.id, origin)
	CombatService.push(player)

	-- Flare rounds deny ground where they land, which is the whole point of
	-- carrying a flare pistol.
	if def.id == "flare_gun" and hitPosition and expedition then
		CreatureService.denyArea(expedition.id, hitPosition, Balance.Creature.flareDenialRadius, Balance.Creature.flareDenialSeconds)
		Net.fireClients("WeaponEffect", ExpeditionService.playersOf(expedition), {
			kind = "flare",
			position = hitPosition,
			seconds = Balance.Creature.flareDenialSeconds,
		})
	end
end

--------------------------------------------------------------------------
-- Melee
--------------------------------------------------------------------------

local function handleMelee(player: Player, rawDirection: any)
	local state = states[player.UserId]
	if not state or not state.equipped then
		return
	end
	local def = WeaponRegistry.get(state.equipped)
	if not def or def.kind ~= "melee" then
		return
	end

	local vitals = SurvivalService.get(player)
	if not vitals or vitals.state ~= "alive" then
		return
	end

	local now = os.clock()
	if (now - state.lastSwingAt) < (def.fireInterval - Balance.Combat.fireIntervalGrace) then
		return
	end

	local cost = def.staminaCost or Balance.Combat.meleeStaminaCost
	if vitals.stamina < cost then
		return
	end

	local direction = Guard.direction(rawDirection)
	local root = Guard.aliveRoot(player)
	if not direction or not root then
		return
	end

	state.lastSwingAt = now
	vitals.stamina = math.max(0, vitals.stamina - cost)

	local expedition = ExpeditionService.forPlayer(player)
	if not expedition then
		return
	end

	-- Melee is resolved entirely on the server: an arc test against every
	-- creature in range. Nothing the client reports is used.
	local hits = 0
	local maxTargets = def.maxTargets or 1
	for _, creature in CreatureService.forExpedition(expedition.id) do
		if hits >= maxTargets then
			break
		end
		local delta = creature.position - root.Position
		if delta.Magnitude <= def.range then
			local angle = math.deg(math.acos(math.clamp(direction:Dot(delta.Unit), -1, 1)))
			if angle <= (def.swingArcDegrees or 70) * 0.5 then
				CreatureService.applyDamage(creature, def.damage, player)
				hits += 1
				CombatService.Hit:Fire(player, creature.model, def.damage)
			end
		end
	end

	if hits > 0 then
		ProgressionService.addStat(player, "melee_hits", hits)
	end
	CreatureService.hearNoise(expedition.id, root.Position, Balance.Combat.noiseRadiusMelee / 20)

	Net.fireClients("WeaponEffect", ExpeditionService.playersOf(expedition), {
		kind = "melee",
		userId = player.UserId,
		weaponId = def.id,
		origin = root.Position,
		direction = direction,
		hits = hits,
	})
	SurvivalService.push(player)
end

--------------------------------------------------------------------------

function CombatService.start()
	Net.onServerEvent("WeaponFire", handleFire)
	Net.onServerEvent("MeleeSwing", handleMelee)

	Net.onServerEvent("WeaponReload", function(player)
		CombatService.reload(player)
	end)

	-- Equipping is a command on the inventory channel, since it is an
	-- inventory action from the player's point of view.
	InventoryService.Changed:Connect(function(player)
		CombatService.push(player)
	end)

	ExpeditionService.StateChanged:Connect(function(expedition, phase)
		if phase ~= "cinematic" then
			return
		end
		-- Equip each player's chosen loadout at the start of the run.
		for _, player in ExpeditionService.playersOf(expedition) do
			local profile = DataService.getProfile(player)
			if profile then
				CombatService.equip(player, profile.loadout.primaryWeapon)
				-- Starting ammunition for the sidearm, so a player is never
				-- completely without an answer.
				local sidearm = WeaponRegistry.get(profile.loadout.sidearm)
				if sidearm and sidearm.ammoType then
					local ammoItem = ammoItemFor(sidearm.ammoType)
					if ammoItem then
						InventoryService.add(player, ammoItem, 2)
					end
				end
			end
		end
	end)

	ExpeditionService.Ended:Connect(function(expedition)
		for _, player in ExpeditionService.playersOf(expedition) do
			states[player.UserId] = nil
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		states[player.UserId] = nil
	end)

	log.info("started")
end

--- Exposed so the inventory command handler can equip without a second remote.
function CombatService.handleEquip(player: Player, weaponId: string?): (boolean, string?)
	return CombatService.equip(player, weaponId)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">CreatureService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CreatureService
	---------------
	The Signal-Eater: its body, its senses and its behaviour.

	IDENTITY
	--------
	Tall, thin, and wrong in the joints. It moves on four long limbs with a
	body slung between them, low to the ground, so its silhouette against the
	trees reads as an animal until it stands up, and then it does not. It has
	no face; the head is a smooth cowl with a cluster of antennae where a face
	should be. That is the identity: it is shaped like something that listens.

	It is named for what it does. It eats signals. It learns sounds it hears
	repeatedly and reproduces them: a saw, a radio callsign, a crew member's
	voice. The mimicry in RadioScript is this creature, not a separate system.

	BEHAVIOUR
	---------
	A four-state machine, driven by hearing first and sight second:

	  patrol       moves along the line, slow, indifferent
	  investigate  walks to a heard position, looks around, gives up
	  hunt         has a target, pursues, loses interest without stimulus
	  retreat      driven off, leaves and does not return for a while

	COUNTERPLAY, WHICH IS THE POINT
	-------------------------------
	It cannot be killed. Damage fills a drive-off meter instead of a health
	bar, so weapons matter without turning the forest into a shooting range.
	It will not enter a lit carriage. The train horn drives it back at close
	range. A burning flare denies an area. Breaking line of sight and staying
	quiet makes it lose you. Every one of those is available on the first run
	with no unlocks and no purchases.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local BuildKit = require(script.Parent.Parent.World.BuildKit)

local ExpeditionService = require(script.Parent.ExpeditionService)
local ProgressionService = require(script.Parent.ProgressionService)
local SurvivalService = require(script.Parent.SurvivalService)

local log = Logger.new("CreatureService")

local C = Color3.fromRGB

local CreatureService = {}

export type Creature = {
	id: string,
	expeditionId: string,
	model: Model,
	root: BasePart,
	limbs: { BasePart },
	head: BasePart,

	state: string, -- "patrol" | "investigate" | "hunt" | "retreat"
	stateSince: number,
	position: Vector3,
	facing: Vector3,
	speed: number,

	targetUserId: number?,
	investigatePoint: Vector3?,
	lastHeardAt: number,
	lastSeenTargetAt: number,

	driveOffMeter: number,
	retreatUntil: number,
	deniedZones: { { position: Vector3, radius: number, until_: number } },

	lastAttackAt: number,
	lastCallAt: number,
	-- Sounds it has heard often enough to imitate.
	learnedCues: { [string]: number },
}

local creatures: { [string]: Creature } = {}
local nextCreatureNumber = 0

CreatureService.Spawned = Signal.new() :: Signal.Signal<Creature>
CreatureService.Retreated = Signal.new() :: Signal.Signal<Creature, string>
CreatureService.Attacked = Signal.new() :: Signal.Signal<Creature, Player>

--------------------------------------------------------------------------
-- Body
--------------------------------------------------------------------------

local function buildBody(parent: Instance): (Model, BasePart, BasePart, { BasePart })
	local model = BuildKit.model("SignalEater", nil)
	local shell = C(38, 40, 44)
	local darker = C(24, 25, 28)

	-- Torso: slung low and horizontal, not upright. This is the silhouette.
	local root = BuildKit.part({
		name = "Torso",
		size = Vector3.new(3.2, 3.0, 7.0),
		cf = CFrame.new(),
		colour = shell,
		material = Enum.Material.Slate,
		canCollide = false,
		parent = model,
	})
	BuildKit.detail({
		name = "Spine",
		size = Vector3.new(0.7, 1.2, 7.6),
		cf = CFrame.new(0, 1.6, 0),
		colour = darker,
		material = Enum.Material.Slate,
		parent = model,
	})
	-- Ribbing along the flanks, which catches a flashlight beam and makes the
	-- shape readable at the edge of the light.
	for i = -2, 2 do
		for _, side in { -1, 1 } do
			BuildKit.detail({
				name = "Rib",
				size = Vector3.new(0.4, 2.6, 0.35),
				cf = CFrame.new(side * 1.5, 0.2, i * 1.3) * CFrame.Angles(0, 0, math.rad(side * 14)),
				colour = darker,
				material = Enum.Material.Slate,
				parent = model,
			})
		end
	end

	-- Head: a smooth cowl with no face, and an antenna cluster instead.
	local head = BuildKit.part({
		name = "Head",
		size = Vector3.new(2.0, 1.8, 2.8),
		cf = CFrame.new(0, 0.8, -4.4),
		colour = shell,
		material = Enum.Material.Slate,
		canCollide = false,
		parent = model,
	})
	BuildKit.detail({
		name = "Cowl",
		size = Vector3.new(2.3, 1.2, 1.6),
		cf = CFrame.new(0, 1.2, -4.0),
		colour = darker,
		material = Enum.Material.Slate,
		parent = model,
	})
	for i = 1, 7 do
		local angle = math.rad(-60 + i * 20)
		BuildKit.detail({
			name = "Antenna",
			size = Vector3.new(0.12, 0.12, 2.4 - math.abs(i - 4) * 0.3),
			cf = CFrame.new(0, 1.4, -5.0) * CFrame.Angles(math.rad(-25), angle, 0) * CFrame.new(0, 0, -1.2),
			colour = C(70, 66, 60),
			material = Enum.Material.Metal,
			parent = model,
		})
	end

	-- Four long limbs, each in three segments, folded high above the body.
	local limbs: { BasePart } = {}
	for _, side in { -1, 1 } do
		for _, front in { -1, 1 } do
			local shoulder = CFrame.new(side * 1.4, 0.8, front * 2.6)
			local upper = BuildKit.detail({
				name = "LimbUpper",
				size = Vector3.new(0.6, 5.2, 0.6),
				cf = shoulder * CFrame.new(side * 1.2, 2.2, 0) * CFrame.Angles(0, 0, math.rad(side * -22)),
				colour = darker,
				material = Enum.Material.Slate,
				parent = model,
			})
			local lower = BuildKit.detail({
				name = "LimbLower",
				size = Vector3.new(0.5, 5.6, 0.5),
				cf = shoulder * CFrame.new(side * 2.6, -1.4, front * 0.4) * CFrame.Angles(math.rad(front * 12), 0, math.rad(side * 16)),
				colour = darker,
				material = Enum.Material.Slate,
				parent = model,
			})
			BuildKit.detail({
				name = "Foot",
				size = Vector3.new(0.5, 0.4, 1.8),
				cf = shoulder * CFrame.new(side * 3.2, -4.2, front * 0.8),
				colour = C(18, 19, 21),
				material = Enum.Material.Slate,
				parent = model,
			})
			table.insert(limbs, upper)
			table.insert(limbs, lower)
		end
	end

	model.PrimaryPart = root
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = root
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
		end
	end
	root.Anchored = true
	model:AddTag("Creature")
	model.Parent = parent

	return model, root, head, limbs
end

--------------------------------------------------------------------------
-- Senses
--------------------------------------------------------------------------

local function canSee(creature: Creature, position: Vector3): boolean
	local delta = position - creature.position
	local distance = delta.Magnitude
	if distance > Balance.Creature.sightRadius then
		return false
	end
	if distance < 6 then
		return true
	end
	local forward = creature.facing
	local angle = math.deg(math.acos(math.clamp(forward:Dot(delta.Unit), -1, 1)))
	return angle <= Balance.Creature.sightAngle * 0.5
end

--- Whether a position is inside a zone the creature refuses to enter: a lit
--- train, or an area denied by a burning flare.
local function isDenied(creature: Creature, position: Vector3): boolean
	for _, zone in creature.deniedZones do
		if os.clock() < zone.until_ and (position - zone.position).Magnitude < zone.radius then
			return true
		end
	end
	return false
end

local function pruneZones(creature: Creature)
	for index = #creature.deniedZones, 1, -1 do
		if os.clock() >= creature.deniedZones[index].until_ then
			table.remove(creature.deniedZones, index)
		end
	end
end

--------------------------------------------------------------------------
-- Spawning
--------------------------------------------------------------------------

function CreatureService.spawn(expedition: ExpeditionService.Expedition, position: Vector3): Creature
	nextCreatureNumber += 1
	local model, root, head, limbs = buildBody(expedition.lane.creatureContainer)
	root.CFrame = CFrame.new(position)

	local creature: Creature = {
		id = string.format("creature_%d", nextCreatureNumber),
		expeditionId = expedition.id,
		model = model,
		root = root,
		head = head,
		limbs = limbs,
		state = "patrol",
		stateSince = os.clock(),
		position = position,
		facing = Vector3.new(0, 0, -1),
		speed = Balance.Creature.patrolSpeed,
		targetUserId = nil,
		investigatePoint = nil,
		lastHeardAt = 0,
		lastSeenTargetAt = 0,
		driveOffMeter = 0,
		retreatUntil = 0,
		deniedZones = {},
		lastAttackAt = 0,
		lastCallAt = 0,
		learnedCues = {},
	}

	creatures[creature.id] = creature
	CreatureService.Spawned:Fire(creature)
	log.info(string.format("spawned %s for expedition %s", creature.id, expedition.id))
	return creature
end

function CreatureService.despawnFor(expeditionId: string)
	for id, creature in creatures do
		if creature.expeditionId == expeditionId then
			creature.model:Destroy()
			creatures[id] = nil
		end
	end
end

function CreatureService.forExpedition(expeditionId: string): { Creature }
	local out: { Creature } = {}
	for _, creature in creatures do
		if creature.expeditionId == expeditionId then
			table.insert(out, creature)
		end
	end
	return out
end

function CreatureService.count(expeditionId: string): number
	return #CreatureService.forExpedition(expeditionId)
end

--------------------------------------------------------------------------
-- Stimuli
--------------------------------------------------------------------------

--- A noise anywhere in the world. Loud enough and close enough, the creature
--- goes to look. This is the primary sense and the primary counterplay:
--- staying quiet genuinely works.
function CreatureService.hearNoise(expeditionId: string, position: Vector3, loudness: number)
	for _, creature in CreatureService.forExpedition(expeditionId) do
		if creature.state == "retreat" then
			continue
		end
		local distance = (position - creature.position).Magnitude
		local radius = Balance.Creature.hearingRadius * math.clamp(loudness / 14, 0.2, 2.5)
		if distance <= radius then
			creature.lastHeardAt = os.clock()
			creature.investigatePoint = position
			if creature.state == "patrol" then
				creature.state = "investigate"
				creature.stateSince = os.clock()
			end
		end
	end
end

--- Damage does not kill. It fills the drive-off meter, and a full meter sends
--- the creature away for a while.
function CreatureService.applyDamage(creature: Creature, amount: number, by: Player?)
	creature.driveOffMeter += amount
	if creature.driveOffMeter >= Balance.Creature.damageToDriveOff then
		CreatureService.driveOff(creature, "damage", by)
	elseif creature.state == "patrol" then
		creature.state = "investigate"
		creature.investigatePoint = creature.position
		creature.stateSince = os.clock()
	end
end

function CreatureService.driveOff(creature: Creature, reason: string, by: Player?)
	if creature.state == "retreat" then
		return
	end
	creature.state = "retreat"
	creature.stateSince = os.clock()
	creature.retreatUntil = os.clock() + Balance.Creature.drivenOffSeconds
	creature.driveOffMeter = 0
	creature.targetUserId = nil

	local expedition = ExpeditionService.byId(creature.expeditionId)
	if expedition then
		Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), {
			cue = "creature_repelled",
			position = creature.position,
		})
		if by then
			ProgressionService.addStat(by, "creature_repelled", 1)
		else
			for _, player in ExpeditionService.playersOf(expedition) do
				ProgressionService.addStat(player, "creature_repelled", 1)
			end
		end
	end
	CreatureService.Retreated:Fire(creature, reason)
end

--- The horn. Drives it back at close range and makes it flinch further out.
function CreatureService.hearHorn(expeditionId: string, position: Vector3)
	for _, creature in CreatureService.forExpedition(expeditionId) do
		local distance = (position - creature.position).Magnitude
		if distance <= Balance.Creature.hornRepelRadius then
			CreatureService.driveOff(creature, "horn", nil)
		elseif distance <= Balance.Train.hornNoiseRadius then
			-- Outside repel range the horn is still just a very loud noise, so
			-- using it carelessly calls the thing towards you.
			CreatureService.hearNoise(expeditionId, position, Balance.Threat.noisePerHorn)
		end
	end
end

--- A flare, a burning brazier or a lit carriage: ground it will not cross.
function CreatureService.denyArea(expeditionId: string, position: Vector3, radius: number, seconds: number)
	for _, creature in CreatureService.forExpedition(expeditionId) do
		table.insert(creature.deniedZones, { position = position, radius = radius, until_ = os.clock() + seconds })
		-- If it is standing in the new zone, it leaves immediately.
		if (creature.position - position).Magnitude < radius then
			creature.state = "investigate"
			creature.investigatePoint = creature.position + (creature.position - position).Unit * (radius + 30)
			creature.stateSince = os.clock()
		end
	end
end

--- Sounds the creature hears repeatedly become sounds it can imitate.
function CreatureService.learnCue(expeditionId: string, cue: string)
	for _, creature in CreatureService.forExpedition(expeditionId) do
		creature.learnedCues[cue] = (creature.learnedCues[cue] or 0) + 1
	end
end

function CreatureService.knownCues(expeditionId: string): { string }
	local out: { string } = {}
	for _, creature in CreatureService.forExpedition(expeditionId) do
		for cue, count in creature.learnedCues do
			if count >= 3 and not table.find(out, cue) then
				table.insert(out, cue)
			end
		end
	end
	return out
end

--------------------------------------------------------------------------
-- Behaviour
--------------------------------------------------------------------------

local function nearestTarget(creature: Creature, expedition: ExpeditionService.Expedition): (Player?, Vector3?, number)
	local best: Player? = nil
	local bestPosition: Vector3? = nil
	local bestDistance = math.huge
	for _, player in ExpeditionService.playersOf(expedition) do
		local state = SurvivalService.get(player)
		if not state or state.state == "dead" then
			continue
		end
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") then
			local distance = (root.Position - creature.position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				best = player
				bestPosition = root.Position
			end
		end
	end
	return best, bestPosition, bestDistance
end

local function moveTowards(creature: Creature, destination: Vector3, dt: number)
	local delta = destination - creature.position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 1 then
		return
	end
	local direction = flat.Unit

	-- Refuse to walk into denied ground. Rather than pathfinding around it,
	-- the creature sidesteps: it is not meant to be clever, it is meant to be
	-- consistent, so players can learn what it will and will not do.
	local step = direction * creature.speed * dt
	local candidate = creature.position + step
	if isDenied(creature, candidate) then
		local sidestep = Vector3.new(-direction.Z, 0, direction.X)
		candidate = creature.position + sidestep * creature.speed * dt
		if isDenied(creature, candidate) then
			return
		end
	end

	creature.position = candidate
	creature.facing = direction

	-- Sit it on the ground. A raycast down keeps it on terrain and on station
	-- floors without needing a Humanoid or pathfinding.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { creature.model }
	local hit = workspace:Raycast(creature.position + Vector3.new(0, 60, 0), Vector3.new(0, -200, 0), params)
	local groundY = if hit then hit.Position.Y else creature.position.Y
	creature.position = Vector3.new(creature.position.X, groundY + 4.5, creature.position.Z)

	creature.root.CFrame = CFrame.lookAt(creature.position, creature.position + creature.facing)
end

local function stepCreature(creature: Creature, dt: number)
	local expedition = ExpeditionService.byId(creature.expeditionId)
	if not expedition or expedition.state == "closed" then
		creature.model:Destroy()
		creatures[creature.id] = nil
		return
	end

	pruneZones(creature)

	-- The train is denied ground while its interior lights are on. This is the
	-- shelter promise: a lit carriage is safe, and going dark is what makes it
	-- stop being safe.
	local train = expedition.train
	if train.interiorLights and train.engineRunning then
		local trainPosition = train.built.root.Position
		local alreadyDenied = false
		for _, zone in creature.deniedZones do
			if zone.position == trainPosition then
				alreadyDenied = true
				break
			end
		end
		if not alreadyDenied then
			table.insert(creature.deniedZones, {
				position = trainPosition,
				radius = 40,
				until_ = os.clock() + 2,
			})
		end
	end

	local now = os.clock()
	local target, targetPosition, targetDistance = nearestTarget(creature, expedition)

	if creature.state == "retreat" then
		creature.speed = Balance.Creature.chaseSpeed
		-- Walk away from the crew, then go quiet until the timer expires.
		if targetPosition then
			local away = creature.position + (creature.position - targetPosition).Unit * 100
			moveTowards(creature, away, dt)
		end
		if now >= creature.retreatUntil then
			creature.state = "patrol"
			creature.stateSince = now
		end
		return
	end

	if creature.state == "hunt" then
		creature.speed = Balance.Creature.chaseSpeed
		local hunted = if creature.targetUserId then Players:GetPlayerByUserId(creature.targetUserId) else nil
		local huntedState = if hunted then SurvivalService.get(hunted) else nil
		local huntedCharacter = if hunted then hunted.Character else nil
		local huntedRoot = if huntedCharacter then huntedCharacter:FindFirstChild("HumanoidRootPart") else nil

		if not hunted or not huntedRoot or not huntedRoot:IsA("BasePart") or not huntedState or huntedState.state == "dead" then
			creature.state = "investigate"
			creature.stateSince = now
			creature.targetUserId = nil
			return
		end

		local huntedPosition = (huntedRoot :: BasePart).Position
		if canSee(creature, huntedPosition) then
			creature.lastSeenTargetAt = now
		end

		-- Losing it requires breaking line of sight and then staying quiet.
		if (now - creature.lastSeenTargetAt) > Balance.Creature.loseInterestSeconds and (now - creature.lastHeardAt) > Balance.Creature.loseInterestSeconds then
			creature.state = "investigate"
			creature.investigatePoint = huntedPosition
			creature.stateSince = now
			creature.targetUserId = nil
			return
		end
		if (now - creature.stateSince) > Balance.Creature.chaseSeconds and (now - creature.lastSeenTargetAt) > 3 then
			creature.state = "patrol"
			creature.stateSince = now
			creature.targetUserId = nil
			return
		end

		if isDenied(creature, huntedPosition) then
			-- The target reached shelter. It circles rather than giving up
			-- immediately, which is what makes shelter feel earned.
			local orbit = huntedPosition + (creature.position - huntedPosition).Unit * 55
			moveTowards(creature, orbit, dt)
			return
		end

		moveTowards(creature, huntedPosition, dt)

		local distance = (huntedPosition - creature.position).Magnitude
		if distance <= Balance.Creature.attackRange and (now - creature.lastAttackAt) >= Balance.Creature.attackCooldown then
			creature.lastAttackAt = now
			SurvivalService.damage(hunted, Balance.Creature.attackDamage, "creature")
			Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), {
				cue = "creature_attack",
				position = creature.position,
			})
			CreatureService.Attacked:Fire(creature, hunted)
		end
		return
	end

	if creature.state == "investigate" then
		creature.speed = Balance.Creature.investigateSpeed
		local point = creature.investigatePoint
		if point then
			moveTowards(creature, point, dt)
			if (creature.position - point).Magnitude < 8 then
				creature.investigatePoint = nil
			end
		end

		-- Acquire a target if one is visible from here.
		if target and targetPosition and canSee(creature, targetPosition) and not isDenied(creature, targetPosition) then
			creature.state = "hunt"
			creature.stateSince = now
			creature.targetUserId = target.UserId
			creature.lastSeenTargetAt = now
			Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), {
				cue = "creature_chase",
				position = creature.position,
				targetUserId = target.UserId,
			})
			return
		end

		if (now - creature.stateSince) > Balance.Creature.investigateSeconds then
			creature.state = "patrol"
			creature.stateSince = now
		end
		return
	end

	-- patrol
	creature.speed = Balance.Creature.patrolSpeed
	if target and targetPosition and targetDistance < Balance.Creature.sightRadius and canSee(creature, targetPosition) and not isDenied(creature, targetPosition) then
		creature.state = "hunt"
		creature.stateSince = now
		creature.targetUserId = target.UserId
		creature.lastSeenTargetAt = now
		return
	end

	-- Drift along the railway, staying at the edge of where the crew is.
	local drift = creature.position + creature.facing * 40
	if math.random() < 0.02 then
		local angle = math.rad(math.random(0, 360))
		drift = creature.position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 60
	end
	moveTowards(creature, drift, dt)

	-- The occasional distant call, which is most of what players actually
	-- experience of this creature.
	if (now - creature.lastCallAt) > 45 and math.random() < 0.02 then
		creature.lastCallAt = now
		Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), {
			cue = "creature_distant",
			position = creature.position,
		})
	end
end

--------------------------------------------------------------------------

function CreatureService.start()
	local accumulator = 0
	local interval = 1 / GameConfig.CreatureTickRate
	game:GetService("RunService").Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < interval then
			return
		end
		local step = accumulator
		accumulator = 0
		for id, creature in creatures do
			local ok, err = Protect.call(stepCreature, creature, step)
			if not ok then
				log.error(string.format("creature %s step failed: %s", id, tostring(err)))
			end
		end
	end)

	ExpeditionService.Ended:Connect(function(expedition)
		CreatureService.despawnFor(expedition.id)
	end)

	log.info("started")
end

return CreatureService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">CrewService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CrewService
	-----------
	Crews: forming them, joining them, readying up and departing.

	The flow the brief asks for is Play, create or join, choose train and
	loadout, ready, depart. This service owns all of it except the loadout,
	which lives on the profile.

	FAILURE CASES HANDLED HERE, BECAUSE THEY ARE THE ONES THAT STRAND PLAYERS
	------------------------------------------------------------------------
	  - The leader leaves. The crew is handed to the longest-present member
	    after a short grace, not disbanded.
	  - A member leaves mid-countdown. The countdown continues if the crew is
	    still valid, and cancels with a reason if it is not.
	  - A member unreadies during the countdown. The countdown cancels and says
	    who cancelled it, so nobody is left guessing.
	  - A player joins a crew that departs while they are still loading. They
	    are placed with the crew rather than left in the lobby.
	  - Everybody leaves. The crew is disposed of and its expedition torn down.

	Departure itself is delegated: this service decides when a crew departs and
	who is in it, and ExpeditionService does the work.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
local DataService = require(script.Parent.DataService)

local log = Logger.new("CrewService")

local CrewService = {}

export type MemberState = {
	userId: number,
	name: string,
	displayName: string,
	ready: boolean,
	joinedAt: number,
	role: string,
	level: number,
	patch: string,
	-- True while the player is between servers or still loading.
	connected: boolean,
}

export type Crew = {
	id: string,
	leaderUserId: number,
	private: boolean,
	name: string,
	trainId: string,
	difficulty: string,
	members: { [number]: MemberState },
	memberOrder: { number },
	createdAt: number,
	-- nil unless a countdown is running.
	countdownEndsAt: number?,
	countdownThread: thread?,
	-- "forming" | "departing" | "active" | "closed". Kept as a plain string so
	-- the solver does not narrow it across the async countdown thread.
	state: string,
	-- Set once the expedition exists.
	expeditionId: string?,
}

local crews: { [string]: Crew } = {}
local playerCrew: { [number]: string } = {}
local nextCrewNumber = 0

CrewService.CrewDeparted = Signal.new() :: Signal.Signal<Crew, { Player }>
CrewService.CrewClosed = Signal.new() :: Signal.Signal<Crew>
CrewService.CrewChanged = Signal.new() :: Signal.Signal<Crew>

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------

--- Reads the state field through a function so the type solver does not carry
--- a narrowed literal from an earlier guard into an async closure, where the
--- value has since been reassigned.
local function stateOf(crew: Crew): string
	return crew.state
end

local function memberCount(crew: Crew): number
	return #crew.memberOrder
end

local function playersOf(crew: Crew): { Player }
	local out: { Player } = {}
	for _, userId in crew.memberOrder do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			table.insert(out, player)
		end
	end
	return out
end

local function describe(crew: Crew): { [string]: any }
	local members = {}
	for _, userId in crew.memberOrder do
		local member = crew.members[userId]
		if member then
			table.insert(members, {
				userId = member.userId,
				name = member.name,
				displayName = member.displayName,
				ready = member.ready,
				role = member.role,
				level = member.level,
				patch = member.patch,
				connected = member.connected,
				isLeader = member.userId == crew.leaderUserId,
			})
		end
	end
	local trainDef = TrainRegistry.getOrStarter(crew.trainId)
	return {
		id = crew.id,
		name = crew.name,
		leaderUserId = crew.leaderUserId,
		private = crew.private,
		trainId = crew.trainId,
		trainName = trainDef.name,
		difficulty = crew.difficulty,
		members = members,
		size = memberCount(crew),
		maxSize = GameConfig.MaxCrewSize,
		state = crew.state,
		countdownEndsAt = crew.countdownEndsAt,
	}
end

local function push(crew: Crew)
	local payload = describe(crew)
	for _, player in playersOf(crew) do
		Net.fireClient("CrewState", player, payload)
	end
	CrewService.CrewChanged:Fire(crew)
end

--- The list of open crews shown on the crew board.
local function browseList(): { { [string]: any } }
	local out = {}
	for _, crew in crews do
		if not crew.private and crew.state == "forming" and memberCount(crew) < GameConfig.MaxCrewSize then
			local trainDef = TrainRegistry.getOrStarter(crew.trainId)
			table.insert(out, {
				id = crew.id,
				name = crew.name,
				size = memberCount(crew),
				maxSize = GameConfig.MaxCrewSize,
				trainName = trainDef.name,
				difficulty = crew.difficulty,
				leaderName = (function()
					local leader = crew.members[crew.leaderUserId]
					return if leader then leader.displayName else "?"
				end)(),
			})
		end
	end
	table.sort(out, function(a, b)
		return a.size > b.size
	end)
	return out
end

--------------------------------------------------------------------------
-- Countdown
--------------------------------------------------------------------------

local function cancelCountdown(crew: Crew, reason: string)
	if crew.countdownThread then
		task.cancel(crew.countdownThread)
		crew.countdownThread = nil
	end
	if crew.countdownEndsAt then
		crew.countdownEndsAt = nil
		crew.state = "forming"
		for _, player in playersOf(crew) do
			Net.fireClient("Notify", player, {
				kind = "info",
				title = "Departure cancelled",
				body = reason,
				duration = 5,
			})
		end
		push(crew)
	end
end

local function everyoneReady(crew: Crew): boolean
	local connected = 0
	local ready = 0
	for _, userId in crew.memberOrder do
		local member = crew.members[userId]
		if member and member.connected then
			connected += 1
			if member.ready then
				ready += 1
			end
		end
	end
	if connected == 0 then
		return false
	end
	return ready >= math.ceil(connected * GameConfig.ReadyRequiredFraction)
end

--------------------------------------------------------------------------
-- Crew operations
--------------------------------------------------------------------------

local function memberFor(player: Player): MemberState
	local profile = DataService.getProfile(player)
	return {
		userId = player.UserId,
		name = player.Name,
		displayName = player.DisplayName,
		ready = false,
		joinedAt = os.clock(),
		role = if profile then profile.loadout.role else "crew",
		level = if profile then profile.level else 1,
		patch = if profile then profile.loadout.patch else "",
		connected = true,
	}
end

function CrewService.create(player: Player, private: boolean): (Crew?, string?)
	if playerCrew[player.UserId] then
		return nil, "ALREADY_IN_CREW"
	end
	local profile = DataService.getProfile(player)
	if not profile then
		return nil, "NOT_LOADED"
	end

	nextCrewNumber += 1
	local id = string.format("crew_%d_%d", nextCrewNumber, math.floor(os.clock() * 1000) % 100000)
	local crew: Crew = {
		id = id,
		leaderUserId = player.UserId,
		private = private,
		name = string.format("%s's crew", player.DisplayName),
		trainId = profile.loadout.train,
		difficulty = GameConfig.DefaultDifficulty,
		members = {},
		memberOrder = {},
		createdAt = os.clock(),
		state = "forming",
	}
	crew.members[player.UserId] = memberFor(player)
	table.insert(crew.memberOrder, player.UserId)
	crews[id] = crew
	playerCrew[player.UserId] = id

	log.info(string.format("%s created crew %s (%s)", player.Name, id, if private then "private" else "public"))
	push(crew)
	return crew, nil
end

function CrewService.join(player: Player, crewId: string): (Crew?, string?)
	if playerCrew[player.UserId] then
		return nil, "ALREADY_IN_CREW"
	end
	local crew = crews[crewId]
	if not crew then
		return nil, "NO_SUCH_CREW"
	end
	if crew.state ~= "forming" then
		return nil, "ALREADY_DEPARTED"
	end
	if memberCount(crew) >= GameConfig.MaxCrewSize then
		return nil, "CREW_FULL"
	end

	crew.members[player.UserId] = memberFor(player)
	table.insert(crew.memberOrder, player.UserId)
	playerCrew[player.UserId] = crewId

	-- A new member invalidates a running countdown: the arriving player has
	-- not readied, and departing without them would be exactly the stranding
	-- case this service exists to prevent.
	cancelCountdown(crew, string.format("%s joined the crew.", player.DisplayName))
	push(crew)
	return crew, nil
end

function CrewService.leave(player: Player): boolean
	local crewId = playerCrew[player.UserId]
	if not crewId then
		return false
	end
	local crew = crews[crewId]
	playerCrew[player.UserId] = nil
	if not crew then
		return false
	end

	crew.members[player.UserId] = nil
	local index = table.find(crew.memberOrder, player.UserId)
	if index then
		table.remove(crew.memberOrder, index)
	end

	if memberCount(crew) == 0 then
		CrewService.close(crew, "empty")
		return true
	end

	-- Leader transfer: the longest-present remaining member takes over.
	if crew.leaderUserId == player.UserId then
		local bestUserId: number? = nil
		local bestJoinedAt = math.huge
		for _, userId in crew.memberOrder do
			local member = crew.members[userId]
			if member and member.joinedAt < bestJoinedAt then
				bestJoinedAt = member.joinedAt
				bestUserId = userId
			end
		end
		if bestUserId then
			crew.leaderUserId = bestUserId
			local newLeader = crew.members[bestUserId]
			for _, remaining in playersOf(crew) do
				Net.fireClient("Notify", remaining, {
					kind = "info",
					title = "Crew leader changed",
					body = string.format("%s is now the crew leader.", if newLeader then newLeader.displayName else "A crew member"),
					duration = 5,
				})
			end
		end
	end

	if crew.state == "departing" and not everyoneReady(crew) then
		cancelCountdown(crew, "A crew member left.")
	end

	push(crew)
	return true
end

function CrewService.close(crew: Crew, reason: string)
	if crew.state == "closed" then
		return
	end
	if crew.countdownThread then
		task.cancel(crew.countdownThread)
		crew.countdownThread = nil
	end
	crew.state = "closed"
	for _, userId in crew.memberOrder do
		playerCrew[userId] = nil
	end
	crews[crew.id] = nil
	log.info(string.format("crew %s closed (%s)", crew.id, reason))
	CrewService.CrewClosed:Fire(crew)
end

function CrewService.setReady(player: Player, ready: boolean): boolean
	local crew = CrewService.crewOf(player)
	if not crew then
		return false
	end
	local member = crew.members[player.UserId]
	if not member then
		return false
	end
	member.ready = ready
	if not ready and crew.state == "departing" then
		cancelCountdown(crew, string.format("%s is not ready.", player.DisplayName))
	end
	push(crew)
	return true
end

function CrewService.setTrain(player: Player, trainId: string): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	local def = TrainRegistry.get(trainId)
	if not def then
		return false, "UNKNOWN_TRAIN"
	end
	-- The leader must own the train they pick for the crew.
	local profile = DataService.getProfile(player)
	if not profile or not profile.trains[trainId] then
		return false, "NOT_OWNED"
	end
	crew.trainId = trainId
	cancelCountdown(crew, "The train was changed.")
	push(crew)
	return true, nil
end

function CrewService.setDifficulty(player: Player, difficulty: string): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	local entry = GameConfig.getDifficulty(difficulty)
	if entry.id ~= difficulty then
		return false, "UNKNOWN_DIFFICULTY"
	end
	local profile = DataService.getProfile(player)
	if profile and profile.level < entry.unlockLevel then
		return false, "LEVEL_LOCKED"
	end
	crew.difficulty = difficulty
	cancelCountdown(crew, "The difficulty was changed.")
	push(crew)
	return true, nil
end

function CrewService.transferLeadership(player: Player, targetUserId: number): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	if not crew.members[targetUserId] then
		return false, "NOT_IN_CREW"
	end
	crew.leaderUserId = targetUserId
	push(crew)
	return true, nil
end

function CrewService.kick(player: Player, targetUserId: number): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	if targetUserId == player.UserId then
		return false, "CANNOT_KICK_SELF"
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if target then
		Net.fireClient("Notify", target, {
			kind = "warning",
			title = "Removed from crew",
			body = "The crew leader removed you.",
			duration = 6,
		})
		CrewService.leave(target)
	else
		crew.members[targetUserId] = nil
		local index = table.find(crew.memberOrder, targetUserId)
		if index then
			table.remove(crew.memberOrder, index)
		end
		playerCrew[targetUserId] = nil
		push(crew)
	end
	return true, nil
end

--------------------------------------------------------------------------
-- Departure
--------------------------------------------------------------------------

function CrewService.beginDeparture(player: Player): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	if crew.state ~= "forming" then
		return false, "BUSY"
	end
	if not everyoneReady(crew) then
		return false, "NOT_ALL_READY"
	end
	if memberCount(crew) < GameConfig.MinCrewSize then
		return false, "CREW_TOO_SMALL"
	end

	crew.state = "departing"
	crew.countdownEndsAt = os.time() + GameConfig.DepartureCountdownSeconds
	push(crew)

	crew.countdownThread = task.spawn(function()
		local remaining = GameConfig.DepartureCountdownSeconds
		while remaining > 0 do
			task.wait(1)
			remaining -= 1
			-- Re-validate every second rather than only at the end. A crew that
			-- becomes invalid mid-countdown should stop immediately.
			if stateOf(crew) ~= "departing" then
				return
			end
			if memberCount(crew) < GameConfig.MinCrewSize then
				cancelCountdown(crew, "The crew is too small to depart.")
				return
			end
			if not everyoneReady(crew) then
				cancelCountdown(crew, "A crew member is no longer ready.")
				return
			end
		end

		crew.countdownThread = nil
		crew.countdownEndsAt = nil
		crew.state = "active"

		local departing = playersOf(crew)
		if #departing == 0 then
			CrewService.close(crew, "nobody left to depart")
			return
		end
		log.info(string.format("crew %s departing with %d", crew.id, #departing))
		push(crew)
		CrewService.CrewDeparted:Fire(crew, departing)
	end)

	return true, nil
end

function CrewService.cancelDeparture(player: Player): (boolean, string?)
	local crew = CrewService.crewOf(player)
	if not crew then
		return false, "NO_CREW"
	end
	if crew.leaderUserId ~= player.UserId then
		return false, "NOT_LEADER"
	end
	cancelCountdown(crew, string.format("%s cancelled the departure.", player.DisplayName))
	return true, nil
end

--------------------------------------------------------------------------
-- Accessors
--------------------------------------------------------------------------

function CrewService.crewOf(player: Player): Crew?
	local crewId = playerCrew[player.UserId]
	return if crewId then crews[crewId] else nil
end

function CrewService.crewById(crewId: string): Crew?
	return crews[crewId]
end

function CrewService.playersOf(crew: Crew): { Player }
	return playersOf(crew)
end

function CrewService.push(crew: Crew)
	push(crew)
end

--- Solo convenience: creates a private crew of one and departs immediately.
--- Every part of the game supports one player, so this is a shortcut rather
--- than a separate mode.
function CrewService.soloDepart(player: Player): (boolean, string?)
	if CrewService.crewOf(player) then
		return false, "ALREADY_IN_CREW"
	end
	local crew, err = CrewService.create(player, true)
	if not crew then
		return false, err
	end
	crew.name = string.format("%s, solo", player.DisplayName)
	CrewService.setReady(player, true)
	return CrewService.beginDeparture(player)
end

--------------------------------------------------------------------------

function CrewService.start()
	Net.onServerInvoke("CrewCommand", function(player, rawCommand, rawA)
		local command = Guard.enum(rawCommand, {
			"create_public",
			"create_private",
			"join",
			"leave",
			"ready",
			"unready",
			"set_train",
			"set_difficulty",
			"set_role",
			"transfer_leader",
			"kick",
			"depart",
			"cancel_depart",
			"browse",
			"solo",
			"state",
		})
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end

		if command == "browse" then
			return { ok = true, crews = browseList() }
		end

		if command == "state" then
			local crew = CrewService.crewOf(player)
			return { ok = true, crew = if crew then describe(crew) else nil, crews = browseList() }
		end

		if command == "create_public" or command == "create_private" then
			local crew, err = CrewService.create(player, command == "create_private")
			return { ok = crew ~= nil, error = err, crew = if crew then describe(crew) else nil }
		end

		if command == "join" then
			local crewId = Guard.string(rawA, 48)
			if not crewId then
				return { ok = false, error = "BAD_CREW" }
			end
			local crew, err = CrewService.join(player, crewId)
			return { ok = crew ~= nil, error = err, crew = if crew then describe(crew) else nil }
		end

		if command == "leave" then
			return { ok = CrewService.leave(player) }
		end

		if command == "ready" or command == "unready" then
			return { ok = CrewService.setReady(player, command == "ready") }
		end

		if command == "set_train" then
			local trainId = Guard.id(rawA)
			if not trainId then
				return { ok = false, error = "BAD_TRAIN" }
			end
			local ok, err = CrewService.setTrain(player, trainId)
			return { ok = ok, error = err }
		end

		if command == "set_difficulty" then
			local difficulty = Guard.id(rawA)
			if not difficulty then
				return { ok = false, error = "BAD_DIFFICULTY" }
			end
			local ok, err = CrewService.setDifficulty(player, difficulty)
			return { ok = ok, error = err }
		end

		if command == "set_role" then
			local role = Guard.enum(rawA, { "crew", "driver", "mechanic", "medic", "scout", "guard" })
			if not role then
				return { ok = false, error = "BAD_ROLE" }
			end
			DataService.update(player, function(p)
				p.loadout.role = role
			end)
			local crew = CrewService.crewOf(player)
			if crew then
				local member = crew.members[player.UserId]
				if member then
					member.role = role
				end
				push(crew)
			end
			return { ok = true }
		end

		if command == "transfer_leader" then
			local userId = Guard.integer(rawA, 1)
			if not userId then
				return { ok = false, error = "BAD_TARGET" }
			end
			local ok, err = CrewService.transferLeadership(player, userId)
			return { ok = ok, error = err }
		end

		if command == "kick" then
			local userId = Guard.integer(rawA, 1)
			if not userId then
				return { ok = false, error = "BAD_TARGET" }
			end
			local ok, err = CrewService.kick(player, userId)
			return { ok = ok, error = err }
		end

		if command == "depart" then
			local ok, err = CrewService.beginDeparture(player)
			return { ok = ok, error = err }
		end

		if command == "cancel_depart" then
			local ok, err = CrewService.cancelDeparture(player)
			return { ok = ok, error = err }
		end

		-- solo
		local ok, err = CrewService.soloDepart(player)
		return { ok = ok, error = err }
	end)

	Players.PlayerRemoving:Connect(function(player)
		local crew = CrewService.crewOf(player)
		if not crew then
			return
		end
		if stateOf(crew) == "active" then
			-- Mid-expedition disconnect: keep the slot open for a reconnect
			-- rather than removing them, so they can come back to their crew.
			local member = crew.members[player.UserId]
			if member then
				member.connected = false
			end
			push(crew)
			task.delay(GameConfig.ReconnectGraceSeconds, function()
				local stillCrew = crews[crew.id]
				if not stillCrew then
					return
				end
				local stillMember = stillCrew.members[player.UserId]
				if stillMember and not stillMember.connected then
					stillCrew.members[player.UserId] = nil
					local index = table.find(stillCrew.memberOrder, player.UserId)
					if index then
						table.remove(stillCrew.memberOrder, index)
					end
					playerCrew[player.UserId] = nil
					if memberCount(stillCrew) == 0 then
						CrewService.close(stillCrew, "all members disconnected")
					else
						push(stillCrew)
					end
				end
			end)
		else
			CrewService.leave(player)
		end
	end)

	-- Reconnection: a returning player rejoins the crew slot held for them.
	Players.PlayerAdded:Connect(function(player)
		for _, crew in crews do
			local member = crew.members[player.UserId]
			if member and not member.connected then
				member.connected = true
				member.name = player.Name
				member.displayName = player.DisplayName
				playerCrew[player.UserId] = crew.id
				log.info(string.format("%s reconnected to crew %s", player.Name, crew.id))
				push(crew)
				break
			end
		end
	end)

	log.info("started")
end

return CrewService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService
	-----------
	Profile loading, session locking, autosave and shutdown safety.

	THE RULE THAT MATTERS
	---------------------
	Never overwrite real progress with defaults. Every failure path in this
	file either keeps the player's existing data or refuses to save, and none
	of them silently substitute a fresh profile. A player whose load failed
	gets a clearly-marked read-only session and a visible warning; they do not
	get a blank profile that then saves over eight hours of progress.

	SESSION LOCKING
	---------------
	Two servers editing the same profile is the classic duplication bug. Each
	profile carries a lock: server job id plus a heartbeat timestamp. Loading
	claims the lock; a lock whose heartbeat is older than the stale threshold
	is considered abandoned and can be taken over, which is what recovers a
	profile after a server crash.

	STUDIO
	------
	Studio usually has no DataStore access, and using live data from Studio is
	how test edits reach real players. With GameConfig.UseMockDataInStudio the
	service uses an in-memory store instead, so the full progression loop is
	testable and nothing touches production. That is logged loudly at boot.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Signal = require(Shared.Core.Signal)
local TableUtil = require(Shared.Core.TableUtil)
local Protect = require(Shared.Core.Protect)
local ProfileSchema = require(script.Parent.ProfileSchema)

local log = Logger.new("DataService")

local DataService = {}

export type Profile = ProfileSchema.Profile

export type Session = {
	player: Player,
	userId: number,
	profile: Profile,
	-- False when the profile could not be loaded or the lock could not be
	-- taken. A read-only session never saves.
	writable: boolean,
	-- Why the session is read-only, surfaced to the player.
	readOnlyReason: string?,
	loadedAt: number,
	lastSave: number,
	dirty: boolean,
	-- Guards against two concurrent saves for the same player.
	saving: boolean,
}

--------------------------------------------------------------------------

local sessions: { [number]: Session } = {}
local shuttingDown = false

DataService.ProfileLoaded = Signal.new() :: Signal.Signal<Player, Profile>
DataService.ProfileReleased = Signal.new() :: Signal.Signal<Player, Profile>
DataService.ProfileChanged = Signal.new() :: Signal.Signal<Player, Profile>

--------------------------------------------------------------------------
-- Store abstraction
--------------------------------------------------------------------------

type StoreLike = {
	update: (key: string, transform: (any) -> any?) -> (boolean, any),
	read: (key: string) -> (boolean, any),
}

local useMock = RunService:IsStudio() and GameConfig.UseMockDataInStudio

local realStore: DataStore? = nil
local mockData: { [string]: any } = {}

if not useMock then
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		realStore = store
	else
		log.error("could not open DataStore; all sessions will be read-only:", tostring(store))
	end
else
	log.warn("Studio mock data is ACTIVE. Progress is in memory only and no live player data is touched.")
end

--- UpdateAsync with retries and exponential backoff. Returns (ok, value).
--- The transform may return nil to abort the write without erroring.
local function storeUpdate(key: string, transform: (any) -> any?): (boolean, any)
	if useMock then
		local result = transform(TableUtil.deepCopy(mockData[key]))
		if result == nil then
			return false, mockData[key]
		end
		mockData[key] = TableUtil.deepCopy(result)
		return true, result
	end

	local store = realStore
	if not store then
		return false, nil
	end

	local delaySeconds = 0.6
	for attempt = 1, GameConfig.DataRetryAttempts do
		local aborted = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(current)
				local transformed = transform(current)
				if transformed == nil then
					aborted = true
					return nil
				end
				return transformed
			end)
		end)
		if ok and not aborted then
			return true, result
		end
		if aborted then
			return false, result
		end
		log.warn(string.format("UpdateAsync attempt %d for %s failed: %s", attempt, key, tostring(result)))
		if attempt < GameConfig.DataRetryAttempts then
			task.wait(delaySeconds)
			delaySeconds *= 2
		end
	end
	return false, nil
end

local function storeRead(key: string): (boolean, any)
	if useMock then
		return true, TableUtil.deepCopy(mockData[key])
	end
	local store = realStore
	if not store then
		return false, nil
	end
	local delaySeconds = 0.6
	for attempt = 1, GameConfig.DataRetryAttempts do
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			return true, result
		end
		log.warn(string.format("GetAsync attempt %d for %s failed: %s", attempt, key, tostring(result)))
		if attempt < GameConfig.DataRetryAttempts then
			task.wait(delaySeconds)
			delaySeconds *= 2
		end
	end
	return false, nil
end

local function keyFor(userId: number): string
	return "player_" .. tostring(userId)
end

--------------------------------------------------------------------------
-- Locking
--------------------------------------------------------------------------

type Envelope = {
	data: any,
	lockJobId: string?,
	lockHeartbeat: number?,
}

local function lockIsStale(envelope: Envelope): boolean
	local heartbeat = envelope.lockHeartbeat
	if not heartbeat then
		return true
	end
	return (os.time() - heartbeat) > GameConfig.SessionLockStaleSeconds
end

--------------------------------------------------------------------------
-- Loading
--------------------------------------------------------------------------

local function buildSession(player: Player, profile: Profile, writable: boolean, reason: string?): Session
	return {
		player = player,
		userId = player.UserId,
		profile = profile,
		writable = writable,
		readOnlyReason = reason,
		loadedAt = os.clock(),
		lastSave = os.clock(),
		dirty = false,
		saving = false,
	}
end

--- Loads a profile and claims its session lock.
function DataService.load(player: Player): Session
	local userId = player.UserId
	local existing = sessions[userId]
	if existing then
		return existing
	end

	local key = keyFor(userId)
	local jobId = if game.JobId ~= "" then game.JobId else "studio"

	local claimed = false
	local loadedData: any = nil
	local lockedByOther = false

	local ok, result = storeUpdate(key, function(current: any): any?
		local envelope: Envelope = current or { data = nil, lockJobId = nil, lockHeartbeat = nil }

		-- Someone else holds a live lock. Do not take the profile.
		if envelope.lockJobId and envelope.lockJobId ~= jobId and not lockIsStale(envelope) then
			lockedByOther = true
			return nil -- abort the write, leaving their lock intact
		end

		envelope.lockJobId = jobId
		envelope.lockHeartbeat = os.time()
		claimed = true
		loadedData = envelope.data
		return envelope
	end)

	if lockedByOther then
		-- A read-only session: the player can play, but nothing is written.
		-- This is far better than kicking them, and far better than writing.
		log.warn(string.format("%s is locked by another server; session is read-only", player.Name))
		local fallbackOk, fallbackEnvelope = storeRead(key)
		local fallbackProfile: Profile
		if fallbackOk and fallbackEnvelope and fallbackEnvelope.data then
			local migrated = ProfileSchema.migrate(fallbackEnvelope.data)
			fallbackProfile = ProfileSchema.normalise(migrated)
		else
			fallbackProfile = ProfileSchema.fresh()
		end
		local session = buildSession(player, fallbackProfile, false, "SESSION_LOCKED")
		sessions[userId] = session
		DataService.ProfileLoaded:Fire(player, session.profile)
		return session
	end

	if not ok or not claimed then
		-- The store is unavailable. A fresh profile here that later saved would
		-- destroy the player's progress, so this session never writes.
		log.error(string.format("could not load %s (%s); session is read-only", player.Name, tostring(result)))
		local session = buildSession(player, ProfileSchema.fresh(), false, "LOAD_FAILED")
		sessions[userId] = session
		DataService.ProfileLoaded:Fire(player, session.profile)
		return session
	end

	local profile: Profile
	local isNew = loadedData == nil
	if isNew then
		profile = ProfileSchema.fresh()
		log.info(string.format("new profile for %s", player.Name))
	else
		local migrated, migrationChanged = ProfileSchema.migrate(loadedData)
		if migrated.version ~= GameConfig.DataVersion then
			-- Migration did not complete. The profile is playable but must not
			-- be written back in a half-migrated state.
			log.error(
				string.format("migration incomplete for %s (at v%s); session is read-only", player.Name, tostring(migrated.version))
			)
			local session = buildSession(player, ProfileSchema.normalise(migrated), false, "MIGRATION_FAILED")
			sessions[userId] = session
			DataService.ProfileLoaded:Fire(player, session.profile)
			return session
		end
		profile = ProfileSchema.normalise(migrated)
		if migrationChanged then
			log.info(string.format("migrated %s to v%d", player.Name, GameConfig.DataVersion))
		end
	end

	profile.lastSeen = os.time()
	profile.sessionCount += 1
	if profile.firstJoin == 0 then
		profile.firstJoin = os.time()
	end

	local session = buildSession(player, profile, true, nil)
	session.dirty = true
	sessions[userId] = session
	DataService.ProfileLoaded:Fire(player, profile)
	return session
end

--------------------------------------------------------------------------
-- Saving
--------------------------------------------------------------------------

--- Writes the profile and refreshes the lock heartbeat.
--- `release` drops the lock, which must happen when the player leaves.
function DataService.save(userId: number, release: boolean?): boolean
	local session = sessions[userId]
	if not session then
		return false
	end
	if not session.writable then
		return false
	end
	if session.saving then
		return false
	end
	session.saving = true

	local jobId = if game.JobId ~= "" then game.JobId else "studio"
	local snapshot = TableUtil.deepCopy(session.profile)
	snapshot.lastSeen = os.time()

	local ok = storeUpdate(keyFor(userId), function(current: any): any?
		local envelope: Envelope = current or {}

		-- Another server took the profile while we held it. That means our lock
		-- went stale, which means our copy may be behind theirs. Merging blindly
		-- risks reverting their work, so we refuse and mark the session
		-- read-only rather than overwrite.
		if envelope.lockJobId and envelope.lockJobId ~= jobId then
			return nil
		end

		-- Purchase receipts are unioned rather than replaced. If a receipt was
		-- processed on another server between our load and our save, it must
		-- survive; losing one means a player paid and got nothing.
		if envelope.data and envelope.data.purchases then
			local stored = envelope.data.purchases
			if type(stored.receipts) == "table" then
				for receiptId, timestamp in stored.receipts do
					if snapshot.purchases.receipts[receiptId] == nil then
						snapshot.purchases.receipts[receiptId] = timestamp
					end
				end
			end
			if type(stored.products) == "table" then
				for productKey, count in stored.products do
					local mine = snapshot.purchases.products[productKey] or 0
					if type(count) == "number" and count > mine then
						snapshot.purchases.products[productKey] = count
					end
				end
			end
			if type(stored.robuxSpent) == "number" and stored.robuxSpent > snapshot.purchases.robuxSpent then
				snapshot.purchases.robuxSpent = stored.robuxSpent
			end
		end

		envelope.data = snapshot
		if release then
			envelope.lockJobId = nil
			envelope.lockHeartbeat = nil
		else
			envelope.lockJobId = jobId
			envelope.lockHeartbeat = os.time()
		end
		return envelope
	end)

	session.saving = false
	if ok then
		session.lastSave = os.clock()
		session.dirty = false
	else
		log.error(string.format("save failed for %d; marking session read-only", userId))
		session.writable = false
		session.readOnlyReason = "SAVE_CONFLICT"
	end
	return ok
end

--------------------------------------------------------------------------
-- Accessors
--------------------------------------------------------------------------

function DataService.getSession(player: Player): Session?
	return sessions[player.UserId]
end

function DataService.getProfile(player: Player): Profile?
	local session = sessions[player.UserId]
	return if session then session.profile else nil
end

--- Mutates a profile through a callback and marks it dirty. Every write to a
--- profile in this project goes through here, so nothing can change the data
--- without the autosave noticing.
function DataService.update(player: Player, mutator: (Profile) -> ()): boolean
	local session = sessions[player.UserId]
	if not session then
		return false
	end
	local ok, err = Protect.call(mutator, session.profile)
	if not ok then
		log.error("profile mutation failed:", tostring(err))
		return false
	end
	session.dirty = true
	DataService.ProfileChanged:Fire(player, session.profile)
	return true
end

function DataService.isWritable(player: Player): boolean
	local session = sessions[player.UserId]
	return session ~= nil and session.writable
end

function DataService.readOnlyReason(player: Player): string?
	local session = sessions[player.UserId]
	return if session then session.readOnlyReason else nil
end

--- Reads another player's profile without claiming it. Used by admin tools
--- and the leaderboard. Never returns a writable handle.
function DataService.peek(userId: number): Profile?
	local live = sessions[userId]
	if live then
		return TableUtil.deepCopy(live.profile) :: Profile
	end
	local ok, envelope = storeRead(keyFor(userId))
	if not ok or not envelope or not envelope.data then
		return nil
	end
	local migrated = ProfileSchema.migrate(envelope.data)
	return ProfileSchema.normalise(migrated)
end

--------------------------------------------------------------------------
-- Release and lifecycle
--------------------------------------------------------------------------

function DataService.release(player: Player)
	local userId = player.UserId
	local session = sessions[userId]
	if not session then
		return
	end
	if session.writable then
		DataService.save(userId, true)
	end
	DataService.ProfileReleased:Fire(player, session.profile)
	sessions[userId] = nil
end

--- Owner-only. Wipes gameplay progress but preserves purchase records, because
--- a player who spent Robux keeps what they bought regardless of a reset.
function DataService.resetProgress(userId: number): boolean
	local session = sessions[userId]
	if not session or not session.writable then
		return false
	end
	local preservedPurchases = TableUtil.deepCopy(session.profile.purchases)
	local fresh = ProfileSchema.fresh()
	fresh.purchases = preservedPurchases
	fresh.firstJoin = session.profile.firstJoin
	fresh.sessionCount = session.profile.sessionCount

	-- Re-grant everything the preserved purchases entitle them to. Without
	-- this, a reset would take away paid cosmetics while keeping the receipt.
	session.profile = fresh
	session.dirty = true
	DataService.ProfileChanged:Fire(session.player, fresh)
	return true
end

function DataService.start()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	-- Autosave loop. Staggered by user id so twenty players do not all write
	-- in the same second and exhaust the DataStore budget.
	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local now = os.clock()
			for userId, session in sessions do
				if session.writable and session.dirty then
					local stagger = (userId % 30)
					if now - session.lastSave >= GameConfig.AutosaveIntervalSeconds + stagger then
						task.spawn(DataService.save, userId, false)
					end
				end
			end
		end
	end)

	-- Lock heartbeat. Refreshing while playing is what stops another server
	-- deciding our lock is stale during a long session.
	task.spawn(function()
		while not shuttingDown do
			task.wait(GameConfig.SessionLockStaleSeconds / 4)
			for userId, session in sessions do
				if session.writable and not session.dirty then
					task.spawn(DataService.save, userId, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		log.info("shutdown: flushing profiles")
		local pending = 0
		local completed = 0
		for userId, session in sessions do
			if session.writable then
				pending += 1
				task.spawn(function()
					DataService.save(userId, true)
					completed += 1
				end)
			end
		end
		-- Roblox allows roughly 30 seconds at shutdown. Waiting for real
		-- completion rather than a fixed sleep means a fast flush does not
		-- stall the shutdown and a slow one is not cut off early.
		local deadline = os.clock() + 25
		while completed < pending and os.clock() < deadline do
			task.wait(0.2)
		end
		log.info(string.format("shutdown: saved %d/%d profiles", completed, pending))
	end)

	log.info(string.format("started (store: %s)", if useMock then "STUDIO MOCK" else GameConfig.DataStoreName))
end

--- Exposed for the admin tools and the boot report.
function DataService.status(): { mock: boolean, available: boolean, sessions: number, readOnly: number }
	local total, readOnly = 0, 0
	for _, session in sessions do
		total += 1
		if not session.writable then
			readOnly += 1
		end
	end
	return {
		mock = useMock,
		available = useMock or realStore ~= nil,
		sessions = total,
		readOnly = readOnly,
	}
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EventService
	------------
	Runs live events. Ships with The Lost Conductor.

	The design goal is that a future event is data, not code: EventRegistry
	declares the window, the token, the encounter behaviour and the reward
	ladder, and this service runs whatever it finds there.

	THE FOUR SAFETY PROPERTIES
	--------------------------
	  Idempotent claims.  A reward threshold is marked claimed in the same
	                      profile update that checks it, so a double click, a
	                      reconnect or two servers cannot grant it twice.
	  Nothing is removed. Ending an event stops new progress. Tokens already
	                      collected and rewards already claimed stay.
	  Grace on expiry.    After the window closes, earned rewards remain
	                      claimable for the configured grace period, so an
	                      expedition that runs past midnight is not punished.
	  Safe stop.          An administrator stopping an event early settles
	                      outstanding claims first.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local EventRegistry = require(Shared.Registry.EventRegistry)
local BuildKit = require(script.Parent.Parent.World.BuildKit)

local DataService = require(script.Parent.DataService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local SurvivalService = require(script.Parent.SurvivalService)

local log = Logger.new("EventService")

local EventService = {}

EventService.TokenCollected = Signal.new() :: Signal.Signal<Player, string, number>
EventService.RewardClaimed = Signal.new() :: Signal.Signal<Player, string, number>

-- Runtime overrides an administrator can apply without editing the registry.
local overrides: { [string]: { startsAt: number, endsAt: number } } = {}

--------------------------------------------------------------------------
-- Window resolution
--------------------------------------------------------------------------

local function resolved(def: EventRegistry.EventDef): EventRegistry.EventDef
	local override = overrides[def.id]
	if not override then
		return def
	end
	local copy = table.clone(def) :: any
	copy.startsAt = override.startsAt
	copy.endsAt = override.endsAt
	return copy
end

function EventService.activeEvent(): EventRegistry.EventDef?
	for _, def in EventRegistry.all() do
		local current = resolved(def)
		if EventRegistry.isActive(current) then
			return current
		end
	end
	return nil
end

function EventService.claimableEvent(): EventRegistry.EventDef?
	for _, def in EventRegistry.all() do
		local current = resolved(def)
		if EventRegistry.isClaimable(current) then
			return current
		end
	end
	return nil
end

--------------------------------------------------------------------------
-- Profile access
--------------------------------------------------------------------------

local function ensureEventRecord(player: Player, eventId: string)
	DataService.update(player, function(p)
		if not p.events[eventId] then
			p.events[eventId] = { tokens = 0, claimed = {}, firstSeen = os.time() }
		end
	end)
end

function EventService.tokensOf(player: Player, eventId: string): number
	local profile = DataService.getProfile(player)
	if not profile then
		return 0
	end
	local record = profile.events[eventId]
	return if record then record.tokens else 0
end

--------------------------------------------------------------------------
-- Tokens
--------------------------------------------------------------------------

function EventService.addTokens(player: Player, eventId: string, amount: number): number
	local def = EventRegistry.get(eventId)
	if not def then
		return 0
	end
	local current = resolved(def)
	if not EventRegistry.isActive(current) then
		-- The window closed. Nothing is taken away, but nothing more is earned.
		return 0
	end
	if not DataService.isWritable(player) then
		return 0
	end

	ensureEventRecord(player, eventId)
	local total = 0
	DataService.update(player, function(p)
		local record = p.events[eventId]
		record.tokens += amount
		total = record.tokens
	end)

	EventService.TokenCollected:Fire(player, eventId, amount)
	EventService.push(player)
	return total
end

--------------------------------------------------------------------------
-- Claims
--------------------------------------------------------------------------

function EventService.claim(player: Player, eventId: string, threshold: number): (boolean, string?)
	local def = EventRegistry.get(eventId)
	if not def then
		return false, "UNKNOWN_EVENT"
	end
	local current = resolved(def)
	if not EventRegistry.isClaimable(current) then
		return false, "EXPIRED"
	end
	if not DataService.isWritable(player) then
		return false, "READ_ONLY"
	end

	local reward: EventRegistry.EventReward? = nil
	for _, candidate in def.rewards do
		if candidate.threshold == threshold then
			reward = candidate
			break
		end
	end
	if not reward then
		return false, "UNKNOWN_REWARD"
	end

	local tokens = EventService.tokensOf(player, eventId)
	if tokens < threshold then
		return false, "NOT_EARNED"
	end

	local key = tostring(threshold)
	local granted = false
	DataService.update(player, function(p)
		local record = p.events[eventId]
		if not record then
			return
		end
		-- Read and write the claimed flag inside one update. This is the line
		-- that makes double-claiming impossible.
		if record.claimed[key] then
			return
		end
		record.claimed[key] = true
		granted = true
	end)

	if not granted then
		return false, "ALREADY_CLAIMED"
	end

	local unlocks = {}
	local resolvedReward = reward :: EventRegistry.EventReward
	if resolvedReward.cosmetic then
		table.insert(unlocks, { kind = "cosmetic", id = resolvedReward.cosmetic })
	end
	if resolvedReward.livery then
		table.insert(unlocks, { kind = "livery", id = resolvedReward.livery })
	end

	ProgressionService.award(player, {
		credits = resolvedReward.credits or 0,
		xp = resolvedReward.xp or 0,
		unlocks = unlocks,
		source = "event:" .. eventId .. ":" .. key,
		exact = true,
	})

	EventService.RewardClaimed:Fire(player, eventId, threshold)
	EventService.push(player)
	log.info(string.format("%s claimed %s reward at %d tokens", player.Name, eventId, threshold))
	return true, nil
end

--------------------------------------------------------------------------
-- Token spawning during expeditions
--------------------------------------------------------------------------

local function spawnTokensForStation(expedition: ExpeditionService.Expedition)
	local def = EventService.activeEvent()
	if not def then
		return
	end
	local station = expedition.lane.stations[expedition.stationIndex]
	if not station then
		return
	end

	local count = def.tokensPerStation
	local origin = station.origin
	for index = 1, count do
		local angle = math.rad((360 / count) * index + math.random(-30, 30))
		local radius = math.random(40, 140)
		local position = origin.Position + Vector3.new(math.cos(angle) * radius, 4, math.sin(angle) * radius)

		local model = BuildKit.model("EventToken", expedition.lane.dropContainer)
		local ticket = BuildKit.part({
			name = "Ticket",
			size = Vector3.new(0.9, 0.05, 1.4),
			cf = CFrame.new(position) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0),
			colour = Color3.fromRGB(212, 186, 140),
			material = Enum.Material.SmoothPlastic,
			canCollide = false,
			parent = model,
		})
		-- A faint glow, because a paper ticket on a forest floor at night is
		-- otherwise genuinely invisible and that is not a fun hunt.
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 226, 186)
		glow.Brightness = 1.1
		glow.Range = 14
		glow.Parent = ticket

		model.PrimaryPart = ticket
		model:SetAttribute("EventId", def.id)
		model:AddTag("EventToken")

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Take"
		prompt.ObjectText = def.tokenName
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.Parent = ticket

		prompt.Triggered:Connect(function(player)
			if not model.Parent then
				return
			end
			local playerExpedition = ExpeditionService.forPlayer(player)
			if playerExpedition ~= expedition then
				return
			end
			model:Destroy()
			EventService.addTokens(player, def.id, 1)
			InventoryService.add(player, def.tokenItem, 1)
			Net.fireClient("Notify", player, {
				kind = "event",
				title = def.tokenName,
				body = string.format("%d collected.", EventService.tokensOf(player, def.id)),
				duration = 4,
			})
		end)
	end
end

--------------------------------------------------------------------------
-- The Conductor encounter
--------------------------------------------------------------------------

local conductors: { [string]: { model: Model, thread: thread } } = {}

--- Builds and runs the patrol_inspector behaviour: a figure that walks the
--- length of the train checking tickets. It cannot be stopped, it does no
--- damage, and it can be avoided entirely by being elsewhere.
local function runConductor(expedition: ExpeditionService.Expedition, def: EventRegistry.EventDef)
	if conductors[expedition.id] then
		return
	end
	local encounter = def.encounter
	if not encounter then
		return
	end

	local train = expedition.train
	local model = BuildKit.model("TheConductor", expedition.lane.creatureContainer)
	local body = BuildKit.part({
		name = "Body",
		size = Vector3.new(2.2, 6.0, 1.4),
		cf = CFrame.new(),
		colour = Color3.fromRGB(38, 34, 40),
		material = Enum.Material.Fabric,
		canCollide = false,
		parent = model,
	})
	BuildKit.detail({
		name = "Head",
		size = Vector3.new(1.4, 1.6, 1.4),
		cf = CFrame.new(0, 3.8, 0),
		colour = Color3.fromRGB(28, 26, 30),
		material = Enum.Material.Fabric,
		parent = model,
	})
	BuildKit.detail({
		name = "Cap",
		size = Vector3.new(1.8, 0.5, 1.8),
		cf = CFrame.new(0, 4.7, 0),
		colour = Color3.fromRGB(20, 19, 22),
		material = Enum.Material.Fabric,
		parent = model,
	})
	BuildKit.detail({
		name = "CapBadge",
		size = Vector3.new(0.5, 0.3, 0.1),
		cf = CFrame.new(0, 4.7, -0.9),
		colour = Color3.fromRGB(186, 162, 116),
		material = Enum.Material.Metal,
		parent = model,
	})
	-- The punch in his hand, which is the only thing about him that catches
	-- the light.
	BuildKit.detail({
		name = "Punch",
		size = Vector3.new(0.3, 0.9, 0.3),
		cf = CFrame.new(1.0, 2.0, -0.6),
		colour = Color3.fromRGB(198, 176, 120),
		material = Enum.Material.Metal,
		parent = model,
	})
	model.PrimaryPart = body
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= body then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = body
			weld.Part1 = descendant
			weld.Parent = body
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
		end
	end
	body.Anchored = true

	local thread = task.spawn(function()
		-- Walks from the rear of the consist to the cab, in train-local space,
		-- so he stays with the train while it moves.
		local length = train.built.volumeSize.Z
		local travelled = 0
		local speed = encounter.params.speed or 6

		Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), {
			cue = "conductor_appears",
			position = train.built.root.Position,
		})

		while travelled < length do
			task.wait(0.1)
			if expedition.state == "closed" or not model.Parent then
				break
			end
			travelled += speed * 0.1
			local localCF = CFrame.new(0, 6, length - travelled)
			body.CFrame = train.built.root.CFrame * localCF

			-- Check anybody he reaches.
			for _, player in ExpeditionService.playersOf(expedition) do
				local character = player.Character
				local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
				if root and root:IsA("BasePart") and (root.Position - body.Position).Magnitude < 7 then
					local hasTicket = InventoryService.has(player, def.tokenItem, 1)
					if hasTicket then
						InventoryService.remove(player, def.tokenItem, 1)
						Net.fireClient("Notify", player, {
							kind = "event",
							title = "Ticket punched",
							body = "He nods, and moves on.",
							duration = 5,
						})
					else
						-- The penalty is inconvenience, never damage.
						local vitals = SurvivalService.get(player)
						if vitals then
							vitals.flashlightOn = false
							vitals.flashlight = 0
							SurvivalService.push(player)
						end
						Net.fireClient("Notify", player, {
							kind = "event",
							title = "No ticket",
							body = "Your lamp goes out. It will not light again until the next station.",
							duration = 7,
						})
					end
				end
			end
		end

		if model.Parent then
			model:Destroy()
		end
		conductors[expedition.id] = nil
	end)

	conductors[expedition.id] = { model = model, thread = thread }
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

function EventService.push(player: Player)
	local def = EventService.claimableEvent()
	if not def then
		Net.fireClient("EventState", player, { active = false })
		return
	end
	local tokens = EventService.tokensOf(player, def.id)
	local profile = DataService.getProfile(player)
	local record = if profile then profile.events[def.id] else nil

	local rewards = {}
	for _, reward in def.rewards do
		table.insert(rewards, {
			threshold = reward.threshold,
			title = reward.title,
			description = reward.description,
			credits = reward.credits,
			xp = reward.xp,
			cosmetic = reward.cosmetic,
			livery = reward.livery,
			earned = tokens >= reward.threshold,
			claimed = record ~= nil and record.claimed[tostring(reward.threshold)] == true,
		})
	end
	table.sort(rewards, function(a, b)
		return a.threshold < b.threshold
	end)

	local nextReward = EventRegistry.nextReward(def, tokens)
	Net.fireClient("EventState", player, {
		active = true,
		accepting = EventRegistry.isActive(def),
		id = def.id,
		name = def.name,
		tagline = def.tagline,
		description = def.description,
		tokenName = def.tokenName,
		tokens = tokens,
		rewards = rewards,
		nextThreshold = if nextReward then nextReward.threshold else nil,
		endsAt = def.endsAt,
		claimUntil = def.endsAt + def.claimGraceSeconds,
	})
end

--------------------------------------------------------------------------
-- Administration
--------------------------------------------------------------------------

--- Starts an event now, for the given number of hours.
function EventService.startEvent(eventId: string, hours: number): boolean
	local def = EventRegistry.get(eventId)
	if not def then
		return false
	end
	local now = os.time()
	overrides[eventId] = { startsAt = now, endsAt = now + math.floor(hours * 3600) }
	log.info(string.format("event %s started for %.1f hours", eventId, hours))
	for _, player in Players:GetPlayers() do
		EventService.push(player)
		Net.fireClient("Notify", player, {
			kind = "event",
			title = def.name,
			body = def.tagline,
			duration = 10,
		})
	end
	return true
end

--- Stops an event. Already-earned rewards stay claimable for the grace period.
function EventService.stopEvent(eventId: string): boolean
	local def = EventRegistry.get(eventId)
	if not def then
		return false
	end
	local existing = overrides[eventId]
	overrides[eventId] = {
		startsAt = if existing then existing.startsAt else os.time() - 1,
		endsAt = os.time(),
	}
	log.info(string.format("event %s stopped; claims remain open for %d seconds", eventId, def.claimGraceSeconds))
	for _, player in Players:GetPlayers() do
		EventService.push(player)
	end
	return true
end

function EventService.status(): { { id: string, name: string, active: boolean, claimable: boolean, endsAt: number } }
	local out = {}
	for _, def in EventRegistry.all() do
		local current = resolved(def)
		table.insert(out, {
			id = def.id,
			name = def.name,
			active = EventRegistry.isActive(current),
			claimable = EventRegistry.isClaimable(current),
			endsAt = current.endsAt,
		})
	end
	return out
end

--------------------------------------------------------------------------

function EventService.start()
	Net.onServerInvoke("EventCommand", function(player, rawCommand, rawArg)
		local command = Guard.enum(rawCommand, { "state", "claim" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end
		if command == "state" then
			EventService.push(player)
			return { ok = true }
		end
		local def = EventService.claimableEvent()
		if not def then
			return { ok = false, error = "NO_EVENT" }
		end
		local threshold = Guard.integer(rawArg, 1, 100000)
		if not threshold then
			return { ok = false, error = "BAD_THRESHOLD" }
		end
		local ok, err = EventService.claim(player, def.id, threshold)
		return { ok = ok, error = err }
	end)

	DataService.ProfileLoaded:Connect(function(player)
		task.delay(4, function()
			if player.Parent then
				EventService.push(player)
			end
		end)
	end)

	ExpeditionService.StationReached:Connect(function(expedition)
		local def = EventService.activeEvent()
		if not def then
			return
		end
		local ok, err = Protect.call(spawnTokensForStation, expedition)
		if not ok then
			log.error("token spawn failed:", tostring(err))
		end
	end)

	ExpeditionService.StateChanged:Connect(function(expedition, phase)
		if phase ~= "travelling" then
			return
		end
		local def = EventService.activeEvent()
		if not def or not def.encounter then
			return
		end
		if math.random() > def.encounterChance then
			return
		end
		-- Never during the cinematic, never on a station stop.
		task.delay(math.random(20, 60), function()
			if expedition.state == "travelling" then
				local ok, err = Protect.call(runConductor, expedition, def)
				if not ok then
					log.error("conductor failed:", tostring(err))
				end
			end
		end)
	end)

	ExpeditionService.Ended:Connect(function(expedition)
		local entry = conductors[expedition.id]
		if entry then
			if entry.model.Parent then
				entry.model:Destroy()
			end
			conductors[expedition.id] = nil
		end
	end)

	-- Lamps that were put out by the Conductor come back at the next station.
	ExpeditionService.StationReached:Connect(function(expedition)
		for _, player in ExpeditionService.playersOf(expedition) do
			local vitals = SurvivalService.get(player)
			if vitals and vitals.flashlight <= 0 then
				vitals.flashlight = 25
				SurvivalService.push(player)
			end
		end
	end)

	local active = EventService.activeEvent()
	if active then
		log.info(string.format("event '%s' is live", active.name))
	else
		log.info("no event is currently scheduled; see docs/EVENTS.md to start one")
	end
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ExpeditionService
	-----------------
	Runs an expedition from departure to ending.

	This is the orchestrator. It owns the state machine, the objective logic,
	the radio beats and the results, and it delegates everything else: the
	world to WorldService, the train to TrainService, loot to InteractionService,
	threat to HorrorDirector.

	STATE MACHINE
	-------------
	  preparing   lane claimed, world resetting, players still in the lobby
	  cinematic   opening sequence, synchronised, skippable
	  travelling  between stations, travel events fire here
	  onstation   stopped, objectives active
	  climax      final station, last objective running
	  ending      success or failure, results being shown
	  closed      torn down

	Every transition is one-way and guarded, so a late callback from a previous
	state cannot drag the expedition backwards.

	SAFETY PROPERTIES
	-----------------
	  - No player is ever left in a loading state: joining, dying, reconnecting
	    and the expedition ending all resolve to a definite place.
	  - Threat is suppressed during the cinematic, during loading and for a
	    grace period after every respawn and boarding, which is what makes
	    "no unavoidable deaths" a guarantee rather than a hope.
	  - Teardown always runs, including on failure, so a lane is never leaked.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local Format = require(Shared.Core.Format)
local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Maid = require(Shared.Core.Maid)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local RadioScript = require(Shared.Registry.RadioScript)
local StationRegistry = require(Shared.Registry.StationRegistry)

local CrewService = require(script.Parent.CrewService)
local DataService = require(script.Parent.DataService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local ShopService = require(script.Parent.ShopService)
local TrainService = require(script.Parent.TrainService)
local WorldService = require(script.Parent.WorldService)

local log = Logger.new("ExpeditionService")

local ExpeditionService = {}

export type ObjectiveProgress = {
	id: string,
	complete: boolean,
	progress: number,
	target: number,
	stepIndex: number,
	stepProgress: number,
	startedAt: number?,
}

export type Expedition = {
	id: string,
	crewId: string,
	lane: WorldService.Lane,
	train: TrainService.TrainState,
	difficulty: string,
	crewSize: number,

	state: string,
	stationIndex: number,
	objectives: { [string]: ObjectiveProgress },

	startedAt: number,
	endedAt: number?,
	success: boolean?,

	-- Per-run bookkeeping used by the results screen and the quest stats.
	stationsCleared: number,
	optionalCleared: number,
	revives: number,
	downs: number,
	shotsFired: number,
	falseInstructionsIgnored: number,
	falseInstructionsFollowed: number,
	discoveriesFound: { [string]: boolean },
	recordingsFound: { [string]: boolean },
	firedBeats: { [string]: boolean },
	silentAtStation: boolean,

	-- The generated code for the Ninety-Three relay puzzle, so it differs
	-- between runs and cannot be memorised.
	leverCode: { number },

	maid: Maid.Maid,
	members: { number }, -- user ids
}

local expeditions: { [string]: Expedition } = {}
local playerExpedition: { [number]: string } = {}
local nextExpeditionNumber = 0

ExpeditionService.StateChanged = Signal.new() :: Signal.Signal<Expedition, string>
ExpeditionService.ObjectiveCompleted = Signal.new() :: Signal.Signal<Expedition, string, boolean>
ExpeditionService.StationReached = Signal.new() :: Signal.Signal<Expedition, number>
ExpeditionService.Ended = Signal.new() :: Signal.Signal<Expedition, boolean>
ExpeditionService.ThreatEvent = Signal.new() :: Signal.Signal<Expedition, string, number>

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------

local function playersOf(expedition: Expedition): { Player }
	local out: { Player } = {}
	for _, userId in expedition.members do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			table.insert(out, player)
		end
	end
	return out
end

ExpeditionService.playersOf = playersOf

local function broadcast(expedition: Expedition, remote: string, payload: any)
	Net.fireClients(remote, playersOf(expedition), payload)
end

local function notify(expedition: Expedition, kind: string, title: string, body: string, duration: number?)
	broadcast(expedition, "Notify", { kind = kind, title = title, body = body, duration = duration or 5 })
end

local function currentStation(expedition: Expedition): StationRegistry.StationDef?
	return StationRegistry.byIndex(expedition.stationIndex)
end

local function setState(expedition: Expedition, state: string)
	if expedition.state == state or expedition.state == "closed" then
		return
	end
	expedition.state = state
	log.info(string.format("expedition %s -> %s", expedition.id, state))

	-- Purchase prompts are blocked during moments where selling would be
	-- intrusive. This is the mechanism behind Monetization.PromptBlockedStates.
	local blockedBy: string? = nil
	if state == "cinematic" then
		blockedBy = "cinematic"
	elseif state == "climax" then
		blockedBy = "expedition_climax"
	elseif state == "preparing" then
		blockedBy = "loading"
	end
	for _, player in playersOf(expedition) do
		ShopService.setBlockedState(player, blockedBy)
	end

	ExpeditionService.StateChanged:Fire(expedition, state)
	ExpeditionService.push(expedition)
end

--------------------------------------------------------------------------
-- Radio
--------------------------------------------------------------------------

local radioBusyUntil: { [string]: number } = {}

--- Fires a radio beat if its trigger matches and it has not already fired.
function ExpeditionService.fireRadio(expedition: Expedition, trigger: string, params: { [string]: any }?)
	local now = os.clock()
	if (radioBusyUntil[expedition.id] or 0) > now then
		-- The radio is mid-transmission. Beats do not talk over each other;
		-- a lower-priority beat is simply dropped rather than queued forever.
		return
	end

	for _, beat in RadioScript.beatsFor(trigger) do
		if beat.once and expedition.firedBeats[beat.id] then
			continue
		end
		-- Match the beat's trigger parameters against the event's.
		local matches = true
		if beat.triggerParams then
			for key, expected in beat.triggerParams do
				if key == "fraction" then
					local actual = if params then params[key] else nil
					if type(actual) ~= "number" or actual < expected then
						matches = false
						break
					end
				elseif key == "requiresMimicry" then
					local station = currentStation(expedition)
					if not station or not station.threat.mimicryEnabled then
						matches = false
						break
					end
				else
					local actual = if params then params[key] else nil
					if actual ~= expected then
						matches = false
						break
					end
				end
			end
		end
		if not matches then
			continue
		end

		expedition.firedBeats[beat.id] = true
		radioBusyUntil[expedition.id] = now + RadioScript.beatDuration(beat)

		task.spawn(function()
			for _, line in beat.lines do
				if expedition.state == "closed" then
					return
				end
				broadcast(expedition, "RadioMessage", {
					id = line.id,
					source = line.source,
					text = line.text,
					duration = line.duration,
					cue = line.cue,
					-- The attribution the subtitle shows. A player relying on
					-- subtitles gets the same information the audio carries.
					attribution = if line.source == "dispatch" then "Dispatch" elseif line.source == "other" then "Unknown" else "Crew",
					isFalse = line.falseInstruction ~= nil,
				})
				if line.falseInstruction then
					-- Recorded so the results screen can report whether the crew
					-- was taken in, and so the "never fooled" milestone works.
					expedition.maid:Give(task.delay(line.duration + 25, function()
						-- If nothing acted on the instruction within the window,
						-- the crew is credited with ignoring it.
						if expedition.state ~= "closed" then
							expedition.falseInstructionsIgnored += 1
							for _, player in playersOf(expedition) do
								ProgressionService.addStat(player, "false_instructions_ignored", 1)
							end
						end
					end))
				end
				task.wait(line.duration + 0.4)
			end
		end)
		return
	end
end

--- Called when the crew demonstrably follows a false instruction.
function ExpeditionService.falseInstructionFollowed(expedition: Expedition, action: string)
	expedition.falseInstructionsFollowed += 1
	for _, player in playersOf(expedition) do
		ProgressionService.addStat(player, "false_instructions_followed", 1)
	end
	ExpeditionService.ThreatEvent:Fire(expedition, "false_instruction", 18)
	log.info(string.format("expedition %s followed a false instruction: %s", expedition.id, action))
end

--------------------------------------------------------------------------
-- Objectives
--------------------------------------------------------------------------

local function scaledTarget(expedition: Expedition, base: number): number
	local scaling = Balance.crewScaling(expedition.crewSize)
	return math.max(1, math.floor(base * scaling.objectiveQuantity + 0.5))
end

local function initialiseObjectives(expedition: Expedition, station: StationRegistry.StationDef)
	expedition.objectives = {}
	for _, def in station.objectives do
		local target = 1
		if def.kind == "collect" then
			target = scaledTarget(expedition, def.params.quantity or 1)
		elseif def.kind == "sequence" then
			target = #(def.params.steps or {})
		end
		expedition.objectives[def.id] = {
			id = def.id,
			complete = false,
			progress = 0,
			target = target,
			stepIndex = 1,
			stepProgress = 0,
		}
	end
	expedition.silentAtStation = true
end

local function objectiveDef(station: StationRegistry.StationDef, id: string): StationRegistry.ObjectiveDef?
	for _, def in station.objectives do
		if def.id == id then
			return def
		end
	end
	return nil
end

local function requirementsMet(expedition: Expedition, def: StationRegistry.ObjectiveDef): boolean
	if not def.requires then
		return true
	end
	for _, requiredId in def.requires do
		local progress = expedition.objectives[requiredId]
		if not progress or not progress.complete then
			return false
		end
	end
	return true
end

--- Marks an objective complete, awards it, and checks whether the station is
--- finished. Idempotent: completing twice grants once.
function ExpeditionService.completeObjective(expedition: Expedition, objectiveId: string)
	local station = currentStation(expedition)
	if not station then
		return
	end
	local progress = expedition.objectives[objectiveId]
	local def = objectiveDef(station, objectiveId)
	if not progress or not def or progress.complete then
		return
	end

	progress.complete = true
	progress.progress = progress.target

	local difficulty = GameConfig.getDifficulty(expedition.difficulty)
	for _, player in playersOf(expedition) do
		ProgressionService.award(player, {
			credits = math.floor(def.credits * difficulty.creditMultiplier),
			xp = math.floor(def.xp * difficulty.xpMultiplier),
			stats = if def.optional then { optional_objectives = 1 } else { unique_objectives_completed = 1 },
			source = "objective:" .. objectiveId,
		}, expedition.crewSize)
	end

	if def.optional then
		expedition.optionalCleared += 1
	end

	ExpeditionService.ThreatEvent:Fire(expedition, "objective_complete", Balance.Threat.objectiveCompleteRelief)
	ExpeditionService.ObjectiveCompleted:Fire(expedition, objectiveId, def.optional)
	ExpeditionService.fireRadio(expedition, "objective_complete", { station = station.id, objective = objectiveId })

	notify(expedition, "objective", "Objective complete", def.title, 5)
	ExpeditionService.push(expedition)

	-- Station complete when every required objective is done.
	local allRequired = true
	for _, candidate in station.objectives do
		if not candidate.optional then
			local candidateProgress = expedition.objectives[candidate.id]
			if not candidateProgress or not candidateProgress.complete then
				allRequired = false
				break
			end
		end
	end
	if allRequired then
		ExpeditionService.completeStation(expedition)
	end
end

--- Adds progress to a counting objective.
function ExpeditionService.addObjectiveProgress(expedition: Expedition, objectiveId: string, amount: number)
	local progress = expedition.objectives[objectiveId]
	if not progress or progress.complete then
		return
	end
	progress.progress = math.min(progress.target, progress.progress + amount)

	local station = currentStation(expedition)
	if station then
		local fraction = progress.progress / math.max(1, progress.target)
		ExpeditionService.fireRadio(expedition, "objective_progress", {
			station = station.id,
			objective = objectiveId,
			fraction = fraction,
		})
	end

	if progress.progress >= progress.target then
		ExpeditionService.completeObjective(expedition, objectiveId)
	else
		ExpeditionService.push(expedition)
	end
end

--- Advances a sequence objective to the next step.
function ExpeditionService.advanceStep(expedition: Expedition, objectiveId: string)
	local station = currentStation(expedition)
	if not station then
		return
	end
	local def = objectiveDef(station, objectiveId)
	local progress = expedition.objectives[objectiveId]
	if not def or not progress or progress.complete then
		return
	end
	local steps = def.params.steps or {}
	progress.stepIndex = math.min(#steps + 1, progress.stepIndex + 1)
	progress.stepProgress = 0
	progress.progress = progress.stepIndex - 1

	if progress.stepIndex > #steps then
		ExpeditionService.completeObjective(expedition, objectiveId)
	else
		local step = steps[progress.stepIndex]
		ExpeditionService.fireRadio(expedition, "step_start", { station = station.id, step = step.id })
		ExpeditionService.push(expedition)
	end
end

function ExpeditionService.currentStep(expedition: Expedition, objectiveId: string): StationRegistry.StepDef?
	local station = currentStation(expedition)
	if not station then
		return nil
	end
	local def = objectiveDef(station, objectiveId)
	local progress = expedition.objectives[objectiveId]
	if not def or not progress then
		return nil
	end
	local steps = def.params.steps
	if not steps then
		return nil
	end
	return steps[progress.stepIndex]
end

--------------------------------------------------------------------------
-- Station flow
--------------------------------------------------------------------------

function ExpeditionService.completeStation(expedition: Expedition)
	local station = currentStation(expedition)
	if not station then
		return
	end
	expedition.stationsCleared += 1

	local difficulty = GameConfig.getDifficulty(expedition.difficulty)
	for _, player in playersOf(expedition) do
		local stats: { [string]: number } = { stations_cleared = 1 }
		if expedition.silentAtStation then
			stats.silent_stations = 1
		end
		ProgressionService.award(player, {
			credits = math.floor(Balance.Economy.creditsPerStationCleared * difficulty.creditMultiplier),
			xp = math.floor(Balance.Economy.xpPerStationCleared * difficulty.xpMultiplier),
			stats = stats,
			source = "station:" .. station.id,
		}, expedition.crewSize)
	end

	ExpeditionService.fireRadio(expedition, "station_complete", { station = station.id })
	notify(expedition, "objective", station.name .. " clear", "Board the train and continue.", 7)

	-- The train is released to run to the next station.
	local nextStation = StationRegistry.byIndex(expedition.stationIndex + 1)
	if nextStation then
		TrainService.setStopDistance(expedition.train, nextStation.distance)
		setState(expedition, "travelling")
	else
		-- Final station done: the chapter ends.
		ExpeditionService.finish(expedition, true)
	end
	ExpeditionService.push(expedition)
end

local function arriveAtStation(expedition: Expedition, index: number)
	local station = StationRegistry.byIndex(index)
	if not station then
		return
	end
	expedition.stationIndex = index
	initialiseObjectives(expedition, station)

	-- Power off, doors closed, lights dark: every station starts cold.
	setState(expedition, if station.index >= StationRegistry.count() then "climax" else "onstation")

	ExpeditionService.StationReached:Fire(expedition, index)
	ExpeditionService.fireRadio(expedition, "station_approach", { station = station.id })
	notify(expedition, "info", station.name, station.subtitle, 7)
	ExpeditionService.push(expedition)
end

--------------------------------------------------------------------------
-- Client state
--------------------------------------------------------------------------

local function describe(expedition: Expedition): { [string]: any }
	local station = currentStation(expedition)
	local objectives = {}
	if station then
		for _, def in station.objectives do
			local progress = expedition.objectives[def.id]
			if progress and requirementsMet(expedition, def) then
				local stepText: string? = nil
				if def.kind == "sequence" then
					local steps = def.params.steps or {}
					local step = steps[progress.stepIndex]
					if step then
						stepText = step.text
					end
				end
				table.insert(objectives, {
					id = def.id,
					title = def.title,
					detail = def.detail,
					optional = def.optional,
					complete = progress.complete,
					progress = progress.progress,
					target = progress.target,
					stepText = stepText,
					stepProgress = progress.stepProgress,
				})
			end
		end
	end

	return {
		id = expedition.id,
		state = expedition.state,
		stationIndex = expedition.stationIndex,
		stationCount = StationRegistry.count(),
		stationName = if station then station.name else nil,
		stationSubtitle = if station then station.subtitle else nil,
		difficulty = expedition.difficulty,
		objectives = objectives,
		elapsed = os.clock() - expedition.startedAt,
		crewSize = expedition.crewSize,
		storyClock = Format.storyClock((os.clock() - expedition.startedAt) / 60),
	}
end

function ExpeditionService.push(expedition: Expedition)
	broadcast(expedition, "ExpeditionState", describe(expedition))
end

--------------------------------------------------------------------------
-- Spawning players
--------------------------------------------------------------------------

local function spawnIntoTrain(expedition: Expedition, player: Player)
	local train = expedition.train
	local carriage = train.built.carriages[1] or train.built.model
	local pivot = carriage:GetPivot()

	local function place(character: Model)
		local root = character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			-- Spread arrivals so a crew of six does not stack inside one another.
			local offset = Vector3.new(math.random(-3, 3), 5, math.random(-8, 8))
			root.CFrame = pivot * CFrame.new(offset)
		end
	end

	if player.Character and player.Character.Parent then
		place(player.Character)
	else
		player.CharacterAdded:Once(function(character)
			task.wait(0.1)
			place(character)
		end)
		player:LoadCharacter()
	end
end

ExpeditionService.spawnIntoTrain = spawnIntoTrain

--------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------

function ExpeditionService.begin(crew: CrewService.Crew, members: { Player })
	nextExpeditionNumber += 1
	local id = string.format("exp_%d", nextExpeditionNumber)

	-- Tell the crew what is happening before anything slow starts, so nobody
	-- sits looking at an unexplained loading screen.
	for _, player in members do
		Net.fireClient("ExpeditionState", player, { state = "preparing", id = id, progress = 0, label = "Claiming the line" })
		ShopService.setBlockedState(player, "loading")
	end

	local lane = WorldService.claimLane(crew.id, function(fraction, label)
		for _, player in members do
			Net.fireClient("ExpeditionState", player, { state = "preparing", id = id, progress = fraction, label = label })
		end
	end)

	if not lane then
		-- Every lane is busy. This is a real limit of single-place mode and the
		-- crew is told plainly rather than left waiting.
		for _, player in members do
			Net.fireClient("Notify", player, {
				kind = "error",
				title = "The line is occupied",
				body = string.format(
					"All %d expedition lines on this server are in use. Try another server, or wait for a crew to return.",
					GameConfig.MaxConcurrentExpeditions
				),
				duration = 10,
			})
			Net.fireClient("ExpeditionState", player, { state = "cancelled", id = id })
			ShopService.setBlockedState(player, nil)
		end
		CrewService.close(crew, "no lane available")
		return
	end

	local memberIds: { number } = {}
	for _, player in members do
		table.insert(memberIds, player.UserId)
	end

	local leader = Players:GetPlayerByUserId(crew.leaderUserId)
	local leaderProfile = if leader then DataService.getProfile(leader) else nil
	local livery = if leaderProfile then leaderProfile.loadout.livery else nil
	local interior = if leaderProfile then leaderProfile.loadout.interior else nil

	local trainOrigin = CFrame.new(lane.origin + Vector3.new(0, 0, 60)) * CFrame.Angles(0, math.rad(180), 0)
	local train = TrainService.spawn(crew.id, crew.trainId, livery, interior, trainOrigin, lane.trainContainer)

	local expedition: Expedition = {
		id = id,
		crewId = crew.id,
		lane = lane,
		train = train,
		difficulty = crew.difficulty,
		crewSize = #members,
		state = "preparing",
		stationIndex = 0,
		objectives = {},
		startedAt = os.clock(),
		stationsCleared = 0,
		optionalCleared = 0,
		revives = 0,
		downs = 0,
		shotsFired = 0,
		falseInstructionsIgnored = 0,
		falseInstructionsFollowed = 0,
		discoveriesFound = {},
		recordingsFound = {},
		firedBeats = {},
		silentAtStation = true,
		leverCode = { math.random(1, 3), math.random(1, 3), math.random(1, 3), math.random(1, 3) },
		maid = Maid.new(),
		members = memberIds,
	}

	expeditions[id] = expedition
	crew.expeditionId = id
	TrainService.setSubscribers(crew.id, members)

	-- Carry capacity bonuses that a crew member shares with the whole crew.
	local sharedSlots, sharedWeight = 0, 0
	for _, player in members do
		local profile = DataService.getProfile(player)
		if profile then
			for productKey, count in profile.purchases.products do
				if count > 0 then
					local Monetization = require(Shared.Config.Monetization)
					local def = Monetization.get(productKey)
					if def and def.id > 0 and def.grants.sharedWithCrew then
						sharedSlots = math.max(sharedSlots, def.grants.inventorySlots or 0)
						sharedWeight = math.max(sharedWeight, def.grants.carryWeight or 0)
					end
				end
			end
		end
	end

	for _, player in members do
		playerExpedition[player.UserId] = id
		InventoryService.create(player, crew.trainId, sharedSlots, sharedWeight)
		InventoryService.bindCrewStore(crew.id, player)
		ProgressionService.addStat(player, "expeditions_started", 1)
		DataService.update(player, function(p)
			p.activeExpedition = { crewId = crew.id, stationIndex = 0, startedAt = os.time() }
		end)
		-- Starting kit, so nobody begins with nothing.
		InventoryService.add(player, "bandage", 2)
		InventoryService.add(player, "battery", 1)
		spawnIntoTrain(expedition, player)
	end

	InventoryService.configureDrops(lane.dropContainer, WorldService.buildDroppedItem)

	-- Cinematic, synchronised across the crew.
	setState(expedition, "cinematic")
	broadcast(expedition, "Cinematic", {
		action = "play",
		duration = GameConfig.CinematicSeconds,
		skippableAfter = GameConfig.CinematicSkippableAfter,
		trainCFrame = train.built.root.CFrame,
	})
	ExpeditionService.fireRadio(expedition, "expedition_start")

	expedition.maid:Give(task.delay(GameConfig.CinematicSeconds, function()
		ExpeditionService.endCinematic(expedition)
	end))

	log.info(string.format("expedition %s begun on lane %d with %d crew", id, lane.index, #members))
end

local cinematicSkipVotes: { [string]: { [number]: boolean } } = {}

function ExpeditionService.endCinematic(expedition: Expedition)
	if expedition.state ~= "cinematic" then
		return
	end
	broadcast(expedition, "Cinematic", { action = "stop" })
	TrainService.setStopDistance(expedition.train, StationRegistry.Stations[1].distance)
	expedition.train.direction = 1
	expedition.train.doorsOpen = false
	TrainService.applyDoors(expedition.train)
	setState(expedition, "travelling")
	notify(expedition, "info", "02:17", "The last train out. Keep her moving.", 6)
end

--------------------------------------------------------------------------
-- Ending
--------------------------------------------------------------------------

function ExpeditionService.finish(expedition: Expedition, success: boolean)
	if expedition.state == "ending" or expedition.state == "closed" then
		return
	end
	setState(expedition, "ending")
	expedition.success = success
	local endedAt = os.clock()
	expedition.endedAt = endedAt

	local difficulty = GameConfig.getDifficulty(expedition.difficulty)
	local elapsed = endedAt - expedition.startedAt

	ExpeditionService.fireRadio(expedition, if success then "expedition_success" else "expedition_failure")

	for _, player in playersOf(expedition) do
		local stats: { [string]: number } = {}
		if success then
			stats.expeditions_completed = 1
			if expedition.stationsCleared >= StationRegistry.count() then
				stats.full_line_runs = 1
			end
			if expedition.difficulty == "blackout" then
				stats.expeditions_completed_blackout = 1
			elseif expedition.difficulty == "derelict" then
				stats.expeditions_completed_derelict = 1
			end
			if expedition.crewSize >= 4 then
				stats.large_crew_completions = 1
			end
			if expedition.downs == 0 then
				stats.flawless_expeditions = 1
			end
			if expedition.falseInstructionsFollowed == 0 then
				stats.clean_signal_runs = 1
			end
		else
			stats.expeditions_failed = 1
		end

		local baseCredits = if success
			then Balance.Economy.creditsPerExpeditionComplete
			else math.floor(Balance.Economy.creditsPerExpeditionComplete * Balance.Economy.creditsFailurePenaltyFraction)
		local baseXp = if success then Balance.Economy.xpPerExpeditionComplete else math.floor(Balance.Economy.xpPerExpeditionComplete * 0.4)

		local result = ProgressionService.award(player, {
			credits = math.floor(baseCredits * difficulty.creditMultiplier),
			xp = math.floor(baseXp * difficulty.xpMultiplier),
			stats = stats,
			source = "expedition_end",
		}, expedition.crewSize)

		Net.fireClient("ExpeditionState", player, {
			state = "results",
			success = success,
			elapsed = elapsed,
			stationsCleared = expedition.stationsCleared,
			stationCount = StationRegistry.count(),
			optionalCleared = expedition.optionalCleared,
			revives = expedition.revives,
			downs = expedition.downs,
			discoveries = (function()
				local n = 0
				for _ in expedition.discoveriesFound do
					n += 1
				end
				return n
			end)(),
			falseIgnored = expedition.falseInstructionsIgnored,
			falseFollowed = expedition.falseInstructionsFollowed,
			credits = result.credits,
			xp = result.xp,
			level = result.newLevel,
			levelsGained = result.levelsGained,
			difficulty = expedition.difficulty,
		})
	end

	-- Results are read, then the crew goes home. The delay is generous because
	-- being yanked out of a results screen is a bad last impression.
	expedition.maid:Give(task.delay(18, function()
		ExpeditionService.close(expedition)
	end))
end

function ExpeditionService.close(expedition: Expedition)
	if expedition.state == "closed" then
		return
	end
	expedition.state = "closed"

	local lobby = WorldService.getLobby()
	for _, player in playersOf(expedition) do
		playerExpedition[player.UserId] = nil
		InventoryService.destroy(player)
		ShopService.setBlockedState(player, nil)
		DataService.update(player, function(p)
			p.activeExpedition = {}
		end)
		-- Back to the yard. Respawning in the lobby is the definite resolution
		-- that stops anybody being stranded in an unloaded lane.
		if lobby then
			local spawnCF = lobby.spawnCFrames[math.random(1, #lobby.spawnCFrames)]
			if player.Character and player.Character.Parent then
				player.Character:PivotTo(spawnCF)
			else
				player.CharacterAdded:Once(function(character)
					task.wait(0.1)
					character:PivotTo(spawnCF)
				end)
				player:LoadCharacter()
			end
		end
		Net.fireClient("ExpeditionState", player, { state = "lobby" })
	end

	InventoryService.releaseCrewStore(expedition.crewId)
	TrainService.despawn(expedition.crewId)
	TrainService.setSubscribers(expedition.crewId, {})
	WorldService.releaseLane(expedition.lane)
	expedition.maid:Destroy()
	expeditions[expedition.id] = nil
	radioBusyUntil[expedition.id] = nil
	cinematicSkipVotes[expedition.id] = nil

	local crew = CrewService.crewById(expedition.crewId)
	if crew then
		CrewService.close(crew, "expedition ended")
	end

	ExpeditionService.Ended:Fire(expedition, expedition.success == true)
	log.info(string.format("expedition %s closed", expedition.id))
end

--------------------------------------------------------------------------
-- Accessors
--------------------------------------------------------------------------

function ExpeditionService.forPlayer(player: Player): Expedition?
	local id = playerExpedition[player.UserId]
	return if id then expeditions[id] else nil
end

function ExpeditionService.byId(id: string): Expedition?
	return expeditions[id]
end

function ExpeditionService.all(): { Expedition }
	local out = {}
	for _, expedition in expeditions do
		table.insert(out, expedition)
	end
	return out
end

--- Records a discovery once per expedition and awards it.
function ExpeditionService.recordDiscovery(expedition: Expedition, player: Player, discoveryId: string)
	if expedition.discoveriesFound[discoveryId] then
		return
	end
	expedition.discoveriesFound[discoveryId] = true
	DataService.update(player, function(p)
		p.discoveries[discoveryId] = true
	end)
	ProgressionService.award(player, {
		credits = Balance.Economy.creditsPerCollectible,
		xp = 25,
		stats = { discoveries_found = 1 },
		source = "discovery:" .. discoveryId,
	}, expedition.crewSize)
end

function ExpeditionService.recordRecording(expedition: Expedition, player: Player, recordingId: string)
	if expedition.recordingsFound[recordingId] then
		return
	end
	expedition.recordingsFound[recordingId] = true
	local wasNew = false
	DataService.update(player, function(p)
		if not p.recordings[recordingId] then
			p.recordings[recordingId] = true
			wasNew = true
		end
	end)
	if wasNew then
		local count = 0
		local profile = DataService.getProfile(player)
		if profile then
			for _ in profile.recordings do
				count += 1
			end
		end
		ProgressionService.setStatMax(player, "unique_recordings", count)
	end
	ProgressionService.addStat(player, "records_found", 1)
end

--- Called by CombatService: a gunshot at a station ends the silent bonus.
function ExpeditionService.noteWeaponFired(expedition: Expedition, loud: boolean)
	expedition.shotsFired += 1
	if loud then
		expedition.silentAtStation = false
	end
end

--------------------------------------------------------------------------

function ExpeditionService.start()
	CrewService.CrewDeparted:Connect(function(crew, members)
		task.spawn(function()
			local ok, err = Protect.call(ExpeditionService.begin, crew, members)
			if not ok then
				log.error("expedition start failed:", tostring(err))
				for _, player in members do
					Net.fireClient("Notify", player, {
						kind = "error",
						title = "The expedition could not start",
						body = "Something went wrong preparing the line. You have been returned to the yard.",
						duration = 10,
					})
					Net.fireClient("ExpeditionState", player, { state = "lobby" })
					ShopService.setBlockedState(player, nil)
				end
				CrewService.close(crew, "start failed")
			end
		end)
	end)

	-- Arrival at a station is driven by the train reaching its stop distance.
	TrainService.ArrivedAt:Connect(function(train, distance)
		for _, expedition in expeditions do
			if expedition.train == train then
				for index, station in StationRegistry.Stations do
					if math.abs(station.distance - distance) < 2 and index ~= expedition.stationIndex then
						arriveAtStation(expedition, index)
						break
					end
				end
				break
			end
		end
	end)

	-- A stalled train between stations is a failure state only when it cannot
	-- be recovered: with fuel in the supply rack, the crew can restart it.
	TrainService.Stalled:Connect(function(train, reason)
		for _, expedition in expeditions do
			if expedition.train == train then
				notify(
					expedition,
					"warning",
					if reason == "fuel" then "The engine has run dry" else "The engine has failed",
					if reason == "fuel" then "Refuel at the engine bay to restart." else "Repair at the engine bay to restart.",
					10
				)
				ExpeditionService.fireRadio(expedition, if reason == "fuel" then "train_low_fuel" else "train_low_condition")
				break
			end
		end
	end)

	Net.onServerEvent("CinematicSkip", function(player)
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition or expedition.state ~= "cinematic" then
			return
		end
		local votes: { [number]: boolean } = cinematicSkipVotes[expedition.id] or {}
		cinematicSkipVotes[expedition.id] = votes
		votes[player.UserId] = true

		local count = 0
		for _ in votes do
			count += 1
		end
		local needed = math.ceil(#playersOf(expedition) / 2)
		broadcast(expedition, "Cinematic", { action = "skipvote", votes = count, needed = needed })
		if count >= needed then
			ExpeditionService.endCinematic(expedition)
		end
	end)

	Net.onServerInvoke("ExpeditionCommand", function(player, rawCommand)
		local command = Guard.enum(rawCommand, { "state", "abandon" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return { ok = false, error = "NO_EXPEDITION" }
		end
		if command == "state" then
			return { ok = true, expedition = describe(expedition) }
		end
		-- Abandoning is per-player: it returns you to the lobby without ending
		-- the run for everybody else.
		playerExpedition[player.UserId] = nil
		InventoryService.destroy(player)
		local index = table.find(expedition.members, player.UserId)
		if index then
			table.remove(expedition.members, index)
		end
		local lobby = WorldService.getLobby()
		if lobby and player.Character then
			player.Character:PivotTo(lobby.spawnCFrames[1])
		end
		Net.fireClient("ExpeditionState", player, { state = "lobby" })
		if #expedition.members == 0 then
			ExpeditionService.close(expedition)
		end
		return { ok = true }
	end)

	Players.PlayerRemoving:Connect(function(player)
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return
		end
		playerExpedition[player.UserId] = nil
		-- The member is kept in the list during the reconnect grace so their
		-- slot and their crew survive a dropped connection.
		task.delay(GameConfig.ReconnectGraceSeconds, function()
			if expedition.state == "closed" then
				return
			end
			if Players:GetPlayerByUserId(player.UserId) then
				return
			end
			local index = table.find(expedition.members, player.UserId)
			if index then
				table.remove(expedition.members, index)
			end
			if #expedition.members == 0 then
				ExpeditionService.close(expedition)
			end
		end)
	end)

	-- Reconnecting mid-expedition puts the player back with their crew.
	Players.PlayerAdded:Connect(function(player)
		task.wait(1)
		for _, expedition in expeditions do
			if table.find(expedition.members, player.UserId) and expedition.state ~= "closed" then
				playerExpedition[player.UserId] = expedition.id
				InventoryService.create(player, expedition.train.def.id)
				InventoryService.bindCrewStore(expedition.crewId, player)
				spawnIntoTrain(expedition, player)
				Net.fireClient("Notify", player, {
					kind = "info",
					title = "Welcome back",
					body = "You have rejoined your crew. Your inventory did not survive the disconnect.",
					duration = 8,
				})
				ExpeditionService.push(expedition)
				break
			end
		end
	end)

	log.info("started")
end

return ExpeditionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">HorrorDirector</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HorrorDirector
	--------------
	Decides what frightening thing happens, and when.

	THE PROBLEM IT SOLVES
	---------------------
	Horror on a timer stops working after about ten minutes, because players
	learn the timer. Horror at random stops working sooner, because random
	means "sometimes three in a row and then nothing for five minutes". Both
	produce the same complaint: the scares feel cheap.

	So this director schedules against a threat value the players themselves
	drive, with cooldowns that guarantee quiet, escalation bands that stop a
	loud event firing during a calm stretch, and repetition control so the same
	beat never lands twice in a row.

	THREAT
	------
	A 0-100 value per expedition, raised by noise, by being away from the train,
	by being alone, and by time; lowered by completing objectives and by simply
	being quiet. It is never shown to players as a number: they read it through
	the ambience, the music bed and how often something moves at the treeline.

	HARD RAILS
	----------
	Nothing schedules during the cinematic, during loading, during the results,
	or within the immunity window after a respawn or a boarding. Those are
	checked before any event is considered, which is what makes "no unavoidable
	deaths during loading, cinematics or respawns" a property of the system
	rather than a promise.

	ADDING AN EVENT
	---------------
	Add a table to EVENTS. It declares its band, its cooldown, whether it needs
	the crew inside or outside the train, and a `run` function. Nothing else in
	the project needs to change.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local StationRegistry = require(Shared.Registry.StationRegistry)

local CreatureService = require(script.Parent.CreatureService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local InteractionService = require(script.Parent.InteractionService)
local SurvivalService = require(script.Parent.SurvivalService)
local TrainService = require(script.Parent.TrainService)

local log = Logger.new("HorrorDirector")

local HorrorDirector = {}

export type DirectorState = {
	expeditionId: string,
	threat: number,
	band: number,
	lastEventAt: number,
	lastEventId: string?,
	calmUntil: number,
	eventCooldowns: { [string]: number },
	firedScriptedBeats: { [string]: boolean },
	creaturesSpawned: boolean,
}

local states: { [string]: DirectorState } = {}

HorrorDirector.EventFired = Signal.new() :: Signal.Signal<string, string>
HorrorDirector.BandChanged = Signal.new() :: Signal.Signal<string, number>

--------------------------------------------------------------------------
-- Event catalogue
--------------------------------------------------------------------------

export type DirectorEvent = {
	id: string,
	name: string,
	-- Lowest threat band this may fire in. Band 0 events are atmosphere.
	minBand: number,
	maxBand: number?,
	cooldown: number,
	-- "inside" requires the crew in the train, "outside" requires them out of
	-- it, nil means either.
	requires: string?,
	-- Whether the creature must be active at this station.
	needsCreature: boolean?,
	weight: number,
	run: (expedition: ExpeditionService.Expedition, state: DirectorState) -> boolean,
}

local function playersInside(expedition: ExpeditionService.Expedition): ({ Player }, { Player })
	local inside: { Player } = {}
	local outside: { Player } = {}
	local train = expedition.train
	local volumeCF = train.built.root.CFrame * train.built.volumeOffset
	local half = train.built.volumeSize * 0.5

	for _, player in ExpeditionService.playersOf(expedition) do
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if root and root:IsA("BasePart") then
			local localPoint = volumeCF:PointToObjectSpace(root.Position)
			if math.abs(localPoint.X) <= half.X and math.abs(localPoint.Y) <= half.Y and math.abs(localPoint.Z) <= half.Z then
				table.insert(inside, player)
			else
				table.insert(outside, player)
			end
		end
	end
	return inside, outside
end

HorrorDirector.playersInside = playersInside

local function cue(expedition: ExpeditionService.Expedition, players: { Player }, cueName: string, position: Vector3?, extra: { [string]: any }?)
	local payload: { [string]: any } = { cue = cueName, position = position }
	if extra then
		for key, value in extra do
			payload[key] = value
		end
	end
	Net.fireClients("HorrorCue", players, payload)
end

local EVENTS: { DirectorEvent } = {
	{
		id = "footsteps_outside",
		name = "Footsteps on the ballast",
		minBand = 1,
		cooldown = 150,
		requires = "inside",
		weight = 14,
		run = function(expedition)
			local inside = playersInside(expedition)
			if #inside == 0 then
				return false
			end
			local train = expedition.train
			local side = if math.random() < 0.5 then 1 else -1
			local position = train.built.root.Position + Vector3.new(side * 9, 0, math.random(-30, 30))
			cue(expedition, inside, "footsteps_outside", position)
			return true
		end,
	},
	{
		id = "distant_silhouette",
		name = "Something at the treeline",
		minBand = 1,
		cooldown = 130,
		requires = "outside",
		weight = 16,
		run = function(expedition)
			local _, outside = playersInside(expedition)
			if #outside == 0 then
				return false
			end
			local subject = outside[math.random(1, #outside)]
			local character = subject.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if not root or not root:IsA("BasePart") then
				return false
			end
			-- Placed behind the player and at the edge of readable distance, so
			-- it is seen on the turn rather than shoved into the face.
			local behind = (root :: BasePart).CFrame * CFrame.new(math.random(-30, 30), 0, 70)
			cue(expedition, { subject }, "silhouette", behind.Position, { duration = 2.2 })
			return true
		end,
	},
	{
		id = "lights_flicker",
		name = "Localised electrical failure",
		minBand = 1,
		cooldown = 160,
		weight = 12,
		run = function(expedition)
			local train = expedition.train
			local players = ExpeditionService.playersOf(expedition)
			cue(expedition, players, "lights_flicker", train.built.root.Position, { seconds = 3.5 })
			-- Actually cut the lights, rather than only playing a client effect.
			local wasOn = train.interiorLights
			train.interiorLights = false
			TrainService.applyLights(train)
			task.delay(3.5, function()
				train.interiorLights = wasOn
				TrainService.applyLights(train)
			end)
			return true
		end,
	},
	{
		id = "door_moves",
		name = "A door that was closed",
		minBand = 2,
		cooldown = 200,
		requires = "inside",
		weight = 10,
		run = function(expedition)
			local inside = playersInside(expedition)
			if #inside == 0 then
				return false
			end
			local train = expedition.train
			if train.doorsOpen then
				return false
			end
			-- One carriage door swings open, then closes again.
			local doors = train.built.doors
			if #doors == 0 then
				return false
			end
			local door = doors[math.random(1, #doors)]
			local closed = door.model:GetAttribute("ClosedCFrame")
			if typeof(closed) ~= "CFrame" then
				return false
			end
			door.model:PivotTo((closed :: CFrame) * CFrame.Angles(0, math.rad(70), 0))
			cue(expedition, inside, "door_moves", door.hinge.Position)
			task.delay(9, function()
				if expedition.state ~= "closed" then
					door.model:PivotTo(closed :: CFrame)
				end
			end)
			return true
		end,
	},
	{
		id = "mimic_call",
		name = "A familiar sound, not quite right",
		minBand = 2,
		cooldown = 190,
		needsCreature = true,
		weight = 12,
		run = function(expedition)
			local station = StationRegistry.byIndex(expedition.stationIndex)
			if not station or not station.threat.mimicryEnabled then
				return false
			end
			local _, outside = playersInside(expedition)
			if #outside == 0 then
				return false
			end
			local subject = outside[math.random(1, #outside)]
			local character = subject.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if not root or not root:IsA("BasePart") then
				return false
			end
			local away = (root :: BasePart).CFrame * CFrame.new(math.random(-50, 50), 0, -math.random(40, 90))
			cue(expedition, { subject }, "creature_mimic", away.Position)
			return true
		end,
	},
	{
		id = "false_radio",
		name = "Not the dispatcher",
		minBand = 2,
		cooldown = 240,
		weight = 11,
		run = function(expedition)
			local station = StationRegistry.byIndex(expedition.stationIndex)
			if not station or not station.threat.mimicryEnabled then
				return false
			end
			ExpeditionService.fireRadio(expedition, "threat_band", { band = 3, requiresMimicry = true })
			return true
		end,
	},
	{
		id = "evidence",
		name = "Evidence of a visitor",
		minBand = 1,
		cooldown = 210,
		requires = "outside",
		weight = 9,
		run = function(expedition)
			local _, outside = playersInside(expedition)
			if #outside == 0 then
				return false
			end
			local subject = outside[math.random(1, #outside)]
			local character = subject.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if not root or not root:IsA("BasePart") then
				return false
			end
			cue(expedition, { subject }, "evidence", (root :: BasePart).Position, {
				variant = ({ "prints", "scratches", "disturbed" })[math.random(1, 3)],
			})
			return true
		end,
	},
	{
		id = "creature_approach",
		name = "It comes to look",
		minBand = 3,
		cooldown = 180,
		needsCreature = true,
		weight = 15,
		run = function(expedition)
			local list = CreatureService.forExpedition(expedition.id)
			if #list == 0 then
				return false
			end
			local _, outside = playersInside(expedition)
			if #outside == 0 then
				return false
			end
			local subject = outside[math.random(1, #outside)]
			local character = subject.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if not root or not root:IsA("BasePart") then
				return false
			end
			-- Sends the creature to investigate, rather than teleporting it on
			-- top of anybody. It still has to walk there, and it can still be
			-- avoided, which is what keeps the encounter fair.
			CreatureService.hearNoise(expedition.id, (root :: BasePart).Position, 20)
			return true
		end,
	},
	{
		id = "hunt",
		name = "It has your scent",
		minBand = 3,
		cooldown = 260,
		needsCreature = true,
		requires = "outside",
		weight = 10,
		run = function(expedition)
			local list = CreatureService.forExpedition(expedition.id)
			if #list == 0 then
				return false
			end
			local _, outside = playersInside(expedition)
			if #outside == 0 then
				return false
			end
			local creature = list[1]
			local subject = outside[math.random(1, #outside)]
			creature.state = "hunt"
			creature.targetUserId = subject.UserId
			creature.stateSince = os.clock()
			creature.lastSeenTargetAt = os.clock()
			cue(expedition, ExpeditionService.playersOf(expedition), "creature_chase", creature.position, {
				targetUserId = subject.UserId,
			})
			return true
		end,
	},
}

--------------------------------------------------------------------------
-- Threat
--------------------------------------------------------------------------

local function bandFor(threat: number): number
	local bands = Balance.Threat.bands
	local band = 0
	for index, floor in bands do
		if threat >= floor then
			band = index - 1
		end
	end
	return band
end

function HorrorDirector.addThreat(expeditionId: string, amount: number)
	local state = states[expeditionId]
	if not state then
		return
	end
	local expedition = ExpeditionService.byId(expeditionId)
	local difficulty = GameConfig.getDifficulty(if expedition then expedition.difficulty else nil)
	state.threat = math.clamp(state.threat + amount * (if amount > 0 then difficulty.threatRate else 1), 0, 100)

	local newBand = bandFor(state.threat)
	if newBand ~= state.band then
		state.band = newBand
		HorrorDirector.BandChanged:Fire(expeditionId, newBand)
		if expedition then
			-- The client uses the band to pick its music and ambience bed. The
			-- number itself is never rendered.
			Net.fireClients("HorrorCue", ExpeditionService.playersOf(expedition), { cue = "band", band = newBand })
		end
	end
end

function HorrorDirector.threatOf(expeditionId: string): number
	local state = states[expeditionId]
	return if state then state.threat else 0
end

--------------------------------------------------------------------------
-- Rails
--------------------------------------------------------------------------

--- Every reason the director must stay silent. Checked before anything else.
local function suppressed(expedition: ExpeditionService.Expedition): boolean
	local phase = expedition.state
	if phase == "preparing" or phase == "ending" or phase == "closed" then
		return true
	end
	if phase == "cinematic" and Balance.Threat.blockedDuringCinematic then
		return true
	end

	-- If every living crew member is still inside their immunity window, the
	-- crew has just respawned or boarded and is not a valid target yet.
	local anyVulnerable = false
	for _, player in ExpeditionService.playersOf(expedition) do
		local vitals = SurvivalService.get(player)
		if vitals and vitals.state == "alive" and os.clock() >= vitals.immuneUntil then
			anyVulnerable = true
			break
		end
	end
	return not anyVulnerable
end

--------------------------------------------------------------------------
-- Scheduling
--------------------------------------------------------------------------

local function chooseEvent(expedition: ExpeditionService.Expedition, state: DirectorState): DirectorEvent?
	local now = os.clock()
	local station = StationRegistry.byIndex(expedition.stationIndex)
	local creatureActive = station ~= nil and station.threat.creatureActive
	local inside, outside = playersInside(expedition)

	local candidates: { DirectorEvent } = {}
	local totalWeight = 0

	for _, event in EVENTS do
		if event.minBand > state.band then
			continue
		end
		if event.maxBand and event.maxBand < state.band then
			continue
		end
		if (state.eventCooldowns[event.id] or 0) > now then
			continue
		end
		-- Never the same event twice running, regardless of cooldown.
		if state.lastEventId == event.id then
			continue
		end
		if event.needsCreature and not creatureActive then
			continue
		end
		if event.requires == "inside" and #inside == 0 then
			continue
		end
		if event.requires == "outside" and #outside == 0 then
			continue
		end
		table.insert(candidates, event)
		totalWeight += event.weight
	end

	if #candidates == 0 or totalWeight <= 0 then
		return nil
	end

	local roll = math.random() * totalWeight
	for _, event in candidates do
		roll -= event.weight
		if roll <= 0 then
			return event
		end
	end
	return candidates[#candidates]
end

local function tickExpedition(expedition: ExpeditionService.Expedition, state: DirectorState, dt: number)
	local station = StationRegistry.byIndex(expedition.stationIndex)

	-- Passive threat accumulation.
	local inside, outside = playersInside(expedition)
	local delta = -Balance.Threat.decayPerSecond * dt
	delta += #outside * Balance.Threat.perSecondAwayFromTrain * dt
	if #outside == 1 and #inside == 0 then
		delta += Balance.Threat.perSecondAlone * dt
	end
	-- Every station has a baseline the threat drifts towards.
	local baseline = if station then station.threat.baseline else Balance.Threat.baseline
	if state.threat < baseline then
		delta += (baseline - state.threat) * 0.06 * dt
	end
	HorrorDirector.addThreat(expedition.id, delta)

	-- Creature presence follows the station's declaration.
	if station and station.threat.creatureActive then
		local scaling = Balance.crewScaling(expedition.crewSize)
		local wanted = scaling.creatureCount
		local existing = CreatureService.count(expedition.id)
		if existing < wanted then
			-- Spawned well away from the crew, at the edge of the clearing, so
			-- nothing ever appears on top of a player.
			local origin = StationRegistry.originFor(station, expedition.lane.origin)
			local angle = math.rad(math.random(0, 360))
			local spawnAt = origin + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (station.layout.radius * 0.9)
			CreatureService.spawn(expedition, spawnAt + Vector3.new(0, 6, 0))
		end
	elseif CreatureService.count(expedition.id) > 0 and station and not station.threat.creatureActive then
		CreatureService.despawnFor(expedition.id)
	end

	if suppressed(expedition) then
		return
	end

	local now = os.clock()
	if now < state.calmUntil then
		return
	end
	if (now - state.lastEventAt) < Balance.Threat.globalCooldown then
		return
	end

	-- Above the global cooldown, the chance of firing scales with threat, so a
	-- calm crew gets long quiet stretches and a loud one gets pressure.
	local pressure = math.clamp(state.threat / 100, 0, 1)
	if math.random() > (0.08 + pressure * 0.35) then
		return
	end

	local event = chooseEvent(expedition, state)
	if not event then
		return
	end

	local ok, fired = Protect.call(event.run, expedition, state)
	if not ok then
		log.error(string.format("event %s failed: %s", event.id, tostring(fired)))
		return
	end
	if fired ~= true then
		return
	end

	state.lastEventAt = now
	state.lastEventId = event.id
	state.eventCooldowns[event.id] = now + math.max(event.cooldown, Balance.Threat.perEventCooldown)
	HorrorDirector.EventFired:Fire(expedition.id, event.id)
	log.debug(string.format("expedition %s: %s (threat %.0f, band %d)", expedition.id, event.id, state.threat, state.band))
end

--------------------------------------------------------------------------
-- Scripted beats
--------------------------------------------------------------------------

--- A station's scripted beat fires once, when its first objective completes.
--- These are the authored moments; everything else is the director.
local function fireScriptedBeat(expedition: ExpeditionService.Expedition, beat: string)
	local state = states[expedition.id]
	if not state or state.firedScriptedBeats[beat] then
		return
	end
	state.firedScriptedBeats[beat] = true
	local players = ExpeditionService.playersOf(expedition)

	if beat == "first_call" then
		-- The chapter's first indication that anything is out there.
		task.delay(3, function()
			if expedition.state ~= "closed" then
				local far = expedition.train.built.root.Position + Vector3.new(math.random(-400, 400), 0, -math.random(300, 600))
				cue(expedition, players, "creature_distant", far)
			end
		end)
	elseif beat == "first_sighting" then
		cue(expedition, players, "silhouette", expedition.train.built.root.Position + Vector3.new(120, 0, -80), { duration = 3 })
	elseif beat == "false_dispatcher" then
		ExpeditionService.fireRadio(expedition, "threat_band", { band = 3, requiresMimicry = true })
	elseif beat == "bridge_siege" then
		-- The pumps step is the chapter's set piece: threat is pushed hard and
		-- the creature is committed, but the crew has flares, the horn and the
		-- train, all of which work.
		HorrorDirector.addThreat(expedition.id, 35)
		local list = CreatureService.forExpedition(expedition.id)
		if #list > 0 then
			list[1].state = "investigate"
			list[1].investigatePoint = expedition.train.built.root.Position
			list[1].stateSince = os.clock()
		end
	elseif beat == "finale" then
		HorrorDirector.addThreat(expedition.id, 45)
		cue(expedition, players, "creature_near", expedition.train.built.root.Position)
	end
end

--------------------------------------------------------------------------

function HorrorDirector.start()
	ExpeditionService.StateChanged:Connect(function(expedition, phase)
		if phase == "cinematic" and not states[expedition.id] then
			states[expedition.id] = {
				expeditionId = expedition.id,
				threat = Balance.Threat.baseline,
				band = 0,
				lastEventAt = os.clock(),
				lastEventId = nil,
				calmUntil = os.clock() + 60,
				eventCooldowns = {},
				firedScriptedBeats = {},
				creaturesSpawned = false,
			}
		end
	end)

	ExpeditionService.Ended:Connect(function(expedition)
		states[expedition.id] = nil
	end)

	ExpeditionService.StationReached:Connect(function(expedition, index)
		local state = states[expedition.id]
		local station = StationRegistry.byIndex(index)
		if not state or not station then
			return
		end
		-- Arriving at a station resets the pressure to that station's baseline
		-- and buys a short calm, so the first minute on a platform is always
		-- yours to orient in.
		state.threat = math.max(state.threat * 0.5, station.threat.baseline)
		state.calmUntil = os.clock() + 25
	end)

	ExpeditionService.ObjectiveCompleted:Connect(function(expedition, _objectiveId, optional)
		if optional then
			return
		end
		local station = StationRegistry.byIndex(expedition.stationIndex)
		if station and station.threat.scriptedBeat then
			fireScriptedBeat(expedition, station.threat.scriptedBeat)
		end
		-- Genuine relief after a real accomplishment.
		local state = states[expedition.id]
		if state then
			state.calmUntil = math.max(state.calmUntil, os.clock() + 20)
		end
	end)

	ExpeditionService.ThreatEvent:Connect(function(expedition, _kind, amount)
		HorrorDirector.addThreat(expedition.id, amount)
	end)

	-- Noise sources feed both the threat meter and the creature's hearing.
	InteractionService.NoiseMade:Connect(function(position, loudness, player)
		local expedition = if player then ExpeditionService.forPlayer(player) else nil
		if not expedition then
			return
		end
		HorrorDirector.addThreat(expedition.id, loudness * 0.4)
		CreatureService.hearNoise(expedition.id, position, loudness)
	end)

	TrainService.EmergencyBrake:Connect(function(train, player)
		local expedition = if player then ExpeditionService.forPlayer(player) else nil
		if not expedition then
			return
		end
		HorrorDirector.addThreat(expedition.id, Balance.Threat.noisePerEmergencyBrake)
		CreatureService.hearNoise(expedition.id, train.built.root.Position, Balance.Threat.noisePerEmergencyBrake)
	end)

	TrainService.HornSounded:Connect(function(train, player)
		local expedition = if player then ExpeditionService.forPlayer(player) else nil
		if not expedition then
			return
		end
		CreatureService.hearHorn(expedition.id, train.built.root.Position)
		CreatureService.learnCue(expedition.id, "train_horn")
	end)

	SurvivalService.Downed:Connect(function(player)
		local expedition = ExpeditionService.forPlayer(player)
		if not expedition then
			return
		end
		-- A down is already the worst moment; the director backs off so the
		-- rescue is about the rescue.
		local state = states[expedition.id]
		if state then
			state.calmUntil = math.max(state.calmUntil, os.clock() + 30)
		end
	end)

	-- After the creature is driven off, enforce real quiet. Relief is what
	-- makes the next encounter land.
	CreatureService.Retreated:Connect(function(creature)
		local state = states[creature.expeditionId]
		if state then
			state.calmUntil = math.max(state.calmUntil, os.clock() + Balance.Threat.postEncounterCalm)
			state.threat = math.max(0, state.threat - 25)
		end
	end)

	local accumulator = 0
	local interval = 1 / GameConfig.DirectorTickRate
	game:GetService("RunService").Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < interval then
			return
		end
		local step = accumulator
		accumulator = 0
		for expeditionId, state in states do
			local expedition = ExpeditionService.byId(expeditionId)
			if expedition then
				local ok, err = Protect.call(tickExpedition, expedition, state, step)
				if not ok then
					log.error("director tick failed:", tostring(err))
				end
			else
				states[expeditionId] = nil
			end
		end
	end)

	log.info(string.format("started with %d events", #EVENTS))
end

HorrorDirector.Events = EVENTS

return HorrorDirector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	InteractionService
	------------------
	Everything a player can walk up to and use.

	One remote, one validator, one place where "can this player do this right
	now" is decided. Searching a locker, throwing a breaker, fitting a valve,
	refuelling the train, picking up a dropped can and reading a recording all
	arrive here and are checked the same way:

	  the target exists, is in the world, and belongs to this player's lane
	  the player is alive and within reach of it
	  the action is valid for this target in its current state
	  any prerequisite item is genuinely held

	The client sends the target instance and an action name. It never sends an
	outcome, a quantity or a position, so there is nothing useful to forge.

	Held actions (searching, repairing, priming pumps) are tracked server-side
	with a start time and validated on completion, so a client cannot claim a
	nine-second repair finished instantly.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local RadioScript = require(Shared.Registry.RadioScript)
local StationRegistry = require(Shared.Registry.StationRegistry)

local ExpeditionService = require(script.Parent.ExpeditionService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local TrainService = require(script.Parent.TrainService)
local WorldService = require(script.Parent.WorldService)

local log = Logger.new("InteractionService")

local InteractionService = {}

InteractionService.FixtureOperated = Signal.new() :: Signal.Signal<string, Player, BasePart>
InteractionService.NoiseMade = Signal.new() :: Signal.Signal<Vector3, number, Player?>

local MAX_REACH = 12

--- Attributes come back as an unknown union, so every numeric read goes
--- through here rather than being cast at each call site.
local function numberAttribute(instance: Instance, name: string, default: number): number
	local value = instance:GetAttribute(name)
	if type(value) == "number" and value == value then
		return value
	end
	return default
end

--------------------------------------------------------------------------
-- Held actions
--------------------------------------------------------------------------

type HeldAction = {
	target: Instance,
	action: string,
	startedAt: number,
	duration: number,
	position: Vector3,
}

local held: { [number]: HeldAction } = {}

local function beginHold(player: Player, target: Instance, action: string, duration: number, position: Vector3)
	held[player.UserId] = {
		target = target,
		action = action,
		startedAt = os.clock(),
		duration = duration,
		position = position,
	}
	Net.fireClient("InteractResult", player, { ok = true, action = "hold_start", duration = duration, target = target })
end

--- Validates a completion claim. The server owns the clock, so a client that
--- reports finishing early is simply refused.
local function completeHold(player: Player, target: Instance, action: string): boolean
	local entry = held[player.UserId]
	if not entry then
		return false
	end
	if entry.target ~= target or entry.action ~= action then
		return false
	end
	-- A small tolerance absorbs network jitter, nothing more.
	if (os.clock() - entry.startedAt) < entry.duration - 0.25 then
		return false
	end
	local root = Guard.aliveRoot(player)
	if not root or not Guard.withinDistance(root.Position, entry.position, MAX_REACH + 4) then
		return false
	end
	held[player.UserId] = nil
	return true
end

function InteractionService.cancelHold(player: Player)
	held[player.UserId] = nil
end

--------------------------------------------------------------------------
-- Loot
--------------------------------------------------------------------------

local function rollLootNode(node: BasePart, expedition: ExpeditionService.Expedition): { { id: string, quantity: number } }
	local lane = expedition.lane
	local contents: { { id: string, quantity: number } } = {}

	-- Find the node's declaration so guaranteed contents are honoured.
	local guaranteed: { string } = {}
	local tier = numberAttribute(node, "Tier", 1)
	local rolls = numberAttribute(node, "Rolls", 1)
	for _, station in lane.stations do
		for _, entry in station.lootNodes do
			if entry.part == node then
				guaranteed = entry.guaranteed
				tier = entry.tier
				rolls = entry.rolls
				break
			end
		end
	end

	local difficulty = require(Shared.Config.GameConfig).getDifficulty(expedition.difficulty)
	local scaling = Balance.crewScaling(expedition.crewSize)
	local rng = Random.new(os.clock() * 1000 % 1000000)

	for _, itemId in guaranteed do
		table.insert(contents, { id = itemId, quantity = 1 })
	end

	local effectiveRolls = math.max(0, math.floor(rolls * difficulty.lootRate * scaling.loot + 0.5))
	for _ = 1, effectiveRolls do
		local itemId = ItemRegistry.rollLoot(tier, rng)
		if itemId then
			local def = ItemRegistry.getOrFallback(itemId)
			local quantity = if def.stackSize > 1 then rng:NextInteger(1, math.min(3, def.stackSize)) else 1
			table.insert(contents, { id = itemId, quantity = quantity })
		end
	end

	return contents
end

--------------------------------------------------------------------------
-- Fixtures
--------------------------------------------------------------------------

local function fixtureStation(expedition: ExpeditionService.Expedition, fixture: BasePart): (WorldService.Lane?, any)
	for _, station in expedition.lane.stations do
		for id, candidate in station.fixtures do
			if candidate == fixture then
				return expedition.lane, station
			end
		end
	end
	return nil, nil
end

--- Powers a station's lights. Called when the breaker sequence completes.
local function powerStation(station: any, on: boolean)
	for _, light in station.lights do
		light.Enabled = on
	end
	for _, fixture in station.fixtures do
		fixture:SetAttribute("Powered", on)
	end
end

--- Runs the step logic for a sequence objective when its fixture is operated.
local function operateFixture(player: Player, expedition: ExpeditionService.Expedition, fixture: BasePart, station: any): (boolean, string?)
	local objectiveId = fixture:GetAttribute("Objective")
	local stepId = fixture:GetAttribute("Step")
	if type(objectiveId) ~= "string" then
		return false, "NO_OBJECTIVE"
	end

	local stationDef = StationRegistry.byId(station.stationId)
	if not stationDef then
		return false, "NO_STATION"
	end
	local objectiveDef: StationRegistry.ObjectiveDef? = nil
	for _, candidate in stationDef.objectives do
		if candidate.id == objectiveId then
			objectiveDef = candidate
			break
		end
	end
	if not objectiveDef then
		return false, "NO_OBJECTIVE"
	end
	local def = objectiveDef :: StationRegistry.ObjectiveDef

	local progress = expedition.objectives[objectiveId]
	if not progress or progress.complete then
		return false, "DONE"
	end

	-- Sequence objectives: only the current step's fixture responds.
	if def.kind == "sequence" then
		local step = ExpeditionService.currentStep(expedition, objectiveId)
		if not step or step.id ~= stepId then
			return false, "WRONG_STEP"
		end

		-- A step that needs an item consumes it here.
		if step.item then
			if not InventoryService.has(player, step.item, 1) then
				local itemDef = ItemRegistry.getOrFallback(step.item)
				return false, "NEEDS:" .. itemDef.name
			end
		end
		-- Generator steps need fuel in hand.
		if step.needsFuel and not InventoryService.has(player, "fuel_can", 1) then
			return false, "NEEDS:Jerry Can"
		end

		local duration = step.seconds or 2
		local entry = held[player.UserId]
		if not entry or entry.target ~= fixture then
			beginHold(player, fixture, "operate", duration, fixture.Position)
			return true, "HOLD"
		end
		if not completeHold(player, fixture, "operate") then
			return false, "TOO_EARLY"
		end

		if step.item then
			InventoryService.remove(player, step.item, 1)
		end
		if step.needsFuel then
			InventoryService.remove(player, "fuel_can", 1)
		end

		fixture:SetAttribute("State", "done")

		-- Side effects by fixture kind.
		local kind = fixture:GetAttribute("FixtureKind")
		if kind == "breaker" then
			powerStation(station, true)
			InteractionService.NoiseMade:Fire(fixture.Position, Balance.Threat.noisePerGenerator, player)
		elseif kind == "generator" then
			InteractionService.NoiseMade:Fire(fixture.Position, Balance.Threat.noisePerGenerator * 1.6, player)
		end

		ExpeditionService.advanceStep(expedition, objectiveId)
		return true, nil
	end

	-- Deliver objectives: bring an item to a fixture.
	if def.kind == "deliver" then
		local itemId = def.params.item
		if type(itemId) == "string" then
			if not InventoryService.has(player, itemId, 1) then
				return false, "NEEDS:" .. ItemRegistry.getOrFallback(itemId).name
			end
			local duration = def.params.seconds or 4
			local entry = held[player.UserId]
			if not entry or entry.target ~= fixture then
				beginHold(player, fixture, "operate", duration, fixture.Position)
				return true, "HOLD"
			end
			if not completeHold(player, fixture, "operate") then
				return false, "TOO_EARLY"
			end
			InventoryService.remove(player, itemId, 1)
			ExpeditionService.completeObjective(expedition, objectiveId)
			return true, nil
		end

		-- Fuel delivery to a station fuel point, which fills the locomotive.
		if def.params.requiresPower and not fixture:GetAttribute("Powered") then
			return false, "NO_POWER"
		end
		if not InventoryService.has(player, "fuel_can", 1) then
			return false, "NEEDS:Jerry Can"
		end
		local duration = 4
		local entry = held[player.UserId]
		if not entry or entry.target ~= fixture then
			beginHold(player, fixture, "operate", duration, fixture.Position)
			return true, "HOLD"
		end
		if not completeHold(player, fixture, "operate") then
			return false, "TOO_EARLY"
		end
		InventoryService.remove(player, "fuel_can", 1)
		local added = TrainService.addFuel(expedition.train, Balance.Train.fuelCanRestore)
		ProgressionService.addStat(player, "fuel_delivered", 1)
		if expedition.train.fuel >= (def.params.targetFuel or 80) then
			ExpeditionService.completeObjective(expedition, objectiveId)
		else
			ExpeditionService.push(expedition)
		end
		Net.fireClient("InteractResult", player, { ok = true, action = "refuel", amount = added })
		return true, nil
	end

	-- Simultaneous objectives: levers that must be held together.
	if def.kind == "simultaneous" then
		local fixtures = def.params.holdFixtures or {}
		if table.find(fixtures, fixture.Name) then
			fixture:SetAttribute("State", "held")
			fixture:SetAttribute("HeldBy", player.UserId)
			fixture:SetAttribute("HeldAt", os.clock())

			-- Solo allowance: one lever stays held on a timer, so a single
			-- player can sprint between them. Without this the objective would
			-- simply be impossible alone, which the brief forbids.
			local soloTimer = def.params.soloTimerSeconds
			if expedition.crewSize == 1 and soloTimer then
				task.delay(soloTimer, function()
					if fixture:GetAttribute("HeldBy") == player.UserId then
						fixture:SetAttribute("State", "idle")
						fixture:SetAttribute("HeldBy", 0)
					end
				end)
			end

			-- Check whether every lever is held right now.
			local allHeld = true
			for _, fixtureId in fixtures do
				local other = station.fixtures[fixtureId]
				if not other or other:GetAttribute("State") ~= "held" then
					allHeld = false
					break
				end
			end
			if allHeld then
				for _, fixtureId in fixtures do
					local other = station.fixtures[fixtureId]
					if other then
						other:SetAttribute("State", "released")
					end
				end
				local thenFixture = station.fixtures[def.params.thenFixture]
				if thenFixture then
					thenFixture:SetAttribute("State", "ready")
				end
				Net.fireClients("Notify", ExpeditionService.playersOf(expedition), {
					kind = "objective",
					title = "Interlock released",
					body = "The loader controls are live.",
					duration = 6,
				})
			end
			return true, nil
		end

		-- The final fixture, live only once the interlock is released.
		if fixture.Name == def.params.thenFixture then
			if fixture:GetAttribute("State") ~= "ready" then
				return false, "INTERLOCK_NOT_RELEASED"
			end
			local duration = def.params.thenSeconds or 6
			local entry = held[player.UserId]
			if not entry or entry.target ~= fixture then
				beginHold(player, fixture, "operate", duration, fixture.Position)
				return true, "HOLD"
			end
			if not completeHold(player, fixture, "operate") then
				return false, "TOO_EARLY"
			end
			InteractionService.NoiseMade:Fire(fixture.Position, 10, player)
			ExpeditionService.completeObjective(expedition, objectiveId)
			return true, nil
		end
		return false, "NOT_PART_OF_OBJECTIVE"
	end

	-- Relay objectives: read a value in one place, enter it in another.
	if def.kind == "relay" then
		if fixture.Name == def.params.readerFixture then
			-- Reading the frame reveals the code to this player only.
			Net.fireClient("InteractResult", player, {
				ok = true,
				action = "read_code",
				code = expedition.leverCode,
				title = "Interlocking frame",
				body = "The diagram board reads:",
			})
			return true, nil
		end

		local leverFixtures = def.params.leverFixtures or {}
		local leverIndex = table.find(leverFixtures, fixture.Name)
		if leverIndex then
			local positions: number = def.params.positions or 3
			local current = numberAttribute(fixture, "Position", 1)
			local nextPosition = (current % positions) + 1
			fixture:SetAttribute("Position", nextPosition)

			-- Check the whole code.
			local correct = true
			for index, fixtureId in leverFixtures do
				local lever = station.fixtures[fixtureId]
				local value = if lever then numberAttribute(lever, "Position", 1) else 1
				if value ~= expedition.leverCode[index] then
					correct = false
					break
				end
			end

			if correct then
				ExpeditionService.completeObjective(expedition, objectiveId)
			else
				-- Wrong combinations are recoverable but noisy, which is the
				-- cost of guessing instead of communicating.
				InteractionService.NoiseMade:Fire(fixture.Position, def.params.wrongAttemptNoise or 8, player)
			end
			Net.fireClient("InteractResult", player, { ok = true, action = "lever", position = nextPosition })
			return true, nil
		end
		return false, "NOT_PART_OF_OBJECTIVE"
	end

	-- Plain operate objectives.
	if def.kind == "operate" then
		local duration = def.params.seconds or 2
		local entry = held[player.UserId]
		if duration > 0 then
			if not entry or entry.target ~= fixture then
				beginHold(player, fixture, "operate", duration, fixture.Position)
				return true, "HOLD"
			end
			if not completeHold(player, fixture, "operate") then
				return false, "TOO_EARLY"
			end
		end
		ExpeditionService.completeObjective(expedition, objectiveId)
		return true, nil
	end

	return false, "UNSUPPORTED"
end

--------------------------------------------------------------------------
-- Defend steps (pumps priming, mast power)
--------------------------------------------------------------------------

local defendTimers: { [string]: thread } = {}

--- Starts a timed hold-the-area step. Progress continues while at least one
--- crew member is alive near the fixture; it pauses otherwise rather than
--- failing, so a wipe-and-recover is survivable.
local function startDefend(expedition: ExpeditionService.Expedition, objectiveId: string, fixture: BasePart, seconds: number)
	local key = expedition.id .. ":" .. objectiveId
	if defendTimers[key] then
		return
	end
	defendTimers[key] = task.spawn(function()
		local elapsed = 0
		local progressState = expedition.objectives[objectiveId]
		while elapsed < seconds do
			task.wait(1)
			if expedition.state == "closed" then
				break
			end
			local anyoneNear = false
			for _, player in ExpeditionService.playersOf(expedition) do
				local root = Guard.aliveRoot(player)
				if root and Guard.withinDistance(root.Position, fixture.Position, 90) then
					anyoneNear = true
					break
				end
			end
			if anyoneNear then
				elapsed += 1
				if progressState then
					progressState.stepProgress = elapsed / seconds
				end
				ExpeditionService.fireRadio(expedition, "step_progress", {
					station = StationRegistry.byIndex(expedition.stationIndex) and (StationRegistry.byIndex(expedition.stationIndex) :: any).id,
					step = fixture:GetAttribute("Step"),
					fraction = elapsed / seconds,
				})
				if elapsed % 5 == 0 then
					ExpeditionService.push(expedition)
				end
			end
		end
		defendTimers[key] = nil
		if expedition.state ~= "closed" then
			ExpeditionService.advanceStep(expedition, objectiveId)
		end
	end)
end

--------------------------------------------------------------------------
-- Main handler
--------------------------------------------------------------------------

local function handleInteract(player: Player, rawTarget: any, rawAction: any)
	local action = Guard.enum(rawAction, {
		"search",
		"operate",
		"pickup",
		"read",
		"refuel_train",
		"repair_train",
		"store",
		"take",
		"door",
		"discover",
		"cancel",
	})
	if not action then
		return
	end

	if action == "cancel" then
		InteractionService.cancelHold(player)
		return
	end

	local target = Guard.instance(rawTarget, "Instance")
	if not target then
		return
	end

	local root = Guard.aliveRoot(player)
	if not root then
		Net.fireClient("InteractResult", player, { ok = false, error = "NOT_ALIVE" })
		return
	end

	-- Resolve a position to check reach against, whether the target is a part
	-- or a model.
	local targetPosition: Vector3
	if target:IsA("BasePart") then
		targetPosition = target.Position
	elseif target:IsA("Model") then
		targetPosition = target:GetPivot().Position
	else
		return
	end
	if not Guard.withinDistance(root.Position, targetPosition, MAX_REACH) then
		Net.fireClient("InteractResult", player, { ok = false, error = "TOO_FAR" })
		return
	end

	local expedition = ExpeditionService.forPlayer(player)

	----------------------------------------------------------------------
	-- Dropped items
	----------------------------------------------------------------------
	if action == "pickup" then
		local model = if target:IsA("Model") then target else target:FindFirstAncestorOfClass("Model")
		if not model or not model:HasTag("DroppedItem") then
			return
		end
		local itemId = model:GetAttribute("ItemId")
		local quantity = numberAttribute(model, "Quantity", 1)
		if type(itemId) ~= "string" then
			return
		end
		local added = InventoryService.add(player, itemId, quantity)
		if added <= 0 then
			Net.fireClient("InteractResult", player, { ok = false, error = "NO_SPACE" })
			return
		end
		if added >= quantity then
			model:Destroy()
		else
			model:SetAttribute("Quantity", quantity - added)
		end
		ProgressionService.addStat(player, "items_collected", added)
		Net.fireClient("InteractResult", player, { ok = true, action = "pickup", itemId = itemId, quantity = added })
		return
	end

	----------------------------------------------------------------------
	-- Everything below needs an expedition
	----------------------------------------------------------------------
	if not expedition then
		Net.fireClient("InteractResult", player, { ok = false, error = "NOT_ON_EXPEDITION" })
		return
	end
	if not target:IsDescendantOf(expedition.lane.root) and not target:IsDescendantOf(expedition.train.built.model) then
		-- The target is not in this crew's lane. This is the check that stops
		-- one crew reaching into another crew's world.
		Net.fireClient("InteractResult", player, { ok = false, error = "WRONG_LANE" })
		return
	end

	local part = target :: BasePart

	----------------------------------------------------------------------
	-- Loot nodes
	----------------------------------------------------------------------
	if action == "search" then
		if not part:HasTag("LootNode") then
			return
		end
		if part:GetAttribute("Searched") then
			Net.fireClient("InteractResult", player, { ok = false, error = "ALREADY_SEARCHED" })
			return
		end

		local duration = 1.8
		local entry = held[player.UserId]
		if not entry or entry.target ~= part then
			beginHold(player, part, "search", duration, part.Position)
			return
		end
		if not completeHold(player, part, "search") then
			return
		end

		part:SetAttribute("Searched", true)
		local contents = rollLootNode(part, expedition)
		local taken: { { id: string, quantity: number } } = {}
		local overflow: { { id: string, quantity: number } } = {}
		for _, stack in contents do
			local added = InventoryService.add(player, stack.id, stack.quantity)
			if added > 0 then
				table.insert(taken, { id = stack.id, quantity = added })
				ProgressionService.addStat(player, "items_collected", added)
			end
			if added < stack.quantity then
				table.insert(overflow, { id = stack.id, quantity = stack.quantity - added })
			end
		end

		-- Anything that did not fit is dropped at the container rather than
		-- destroyed, so a full inventory never loses loot.
		for _, stack in overflow do
			WorldService.buildDroppedItem(
				stack.id,
				stack.quantity,
				CFrame.new(part.Position + Vector3.new(math.random(-2, 2), 2, math.random(-2, 2))),
				expedition.lane.dropContainer
			)
		end

		-- Collecting story items counts for the optional objectives.
		for _, stack in taken do
			local def = ItemRegistry.get(stack.id)
			if def and def.effect then
				if def.effect.collectible == "dispatch_log" then
					ProgressionService.addStat(player, "records_found", stack.quantity)
				end
			end
		end

		-- Any active "collect anything" objective progresses.
		local station = StationRegistry.byIndex(expedition.stationIndex)
		if station then
			for _, def in station.objectives do
				local objectiveProgress = expedition.objectives[def.id]
				if objectiveProgress and not objectiveProgress.complete and def.kind == "collect" and def.params.anyItems then
					local total = 0
					for _, stack in taken do
						total += stack.quantity
					end
					if total > 0 then
						ExpeditionService.addObjectiveProgress(expedition, def.id, total)
					end
				end
			end
		end

		InteractionService.NoiseMade:Fire(part.Position, 2, player)
		Net.fireClient("InteractResult", player, { ok = true, action = "search", contents = taken, overflow = #overflow })
		return
	end

	----------------------------------------------------------------------
	-- Station fixtures
	----------------------------------------------------------------------
	if action == "operate" then
		if not part:HasTag("StationFixture") then
			return
		end
		local _, station = fixtureStation(expedition, part)
		if not station then
			return
		end
		local ok, err = operateFixture(player, expedition, part, station)
		if ok and err == "HOLD" then
			return
		end
		if not ok then
			Net.fireClient("InteractResult", player, { ok = false, error = err })
			return
		end

		-- A completed step that is a defend step starts its timer.
		local objectiveId = part:GetAttribute("Objective")
		if type(objectiveId) == "string" then
			local step = ExpeditionService.currentStep(expedition, objectiveId)
			if step and step.kind == "defend" and step.fixture == part.Name then
				startDefend(expedition, objectiveId, part, step.seconds or 60)
			end
		end
		InteractionService.FixtureOperated:Fire(expedition.id, player, part)
		Net.fireClient("InteractResult", player, { ok = true, action = "operate" })
		return
	end

	----------------------------------------------------------------------
	-- Train interactions
	----------------------------------------------------------------------
	if action == "refuel_train" then
		if not part:HasTag("TrainFuelPoint") then
			return
		end
		if not InventoryService.has(player, "fuel_can", 1) then
			Net.fireClient("InteractResult", player, { ok = false, error = "NEEDS:Jerry Can" })
			return
		end
		local duration = ItemRegistry.getOrFallback("fuel_can").useSeconds or 4.5
		local entry = held[player.UserId]
		if not entry or entry.target ~= part then
			beginHold(player, part, "refuel_train", duration, part.Position)
			return
		end
		if not completeHold(player, part, "refuel_train") then
			return
		end
		InventoryService.remove(player, "fuel_can", 1)
		local added = TrainService.addFuel(expedition.train, Balance.Train.fuelCanRestore)
		ProgressionService.addStat(player, "fuel_delivered", 1)
		Net.fireClient("InteractResult", player, { ok = true, action = "refuel", amount = added })
		return
	end

	if action == "repair_train" then
		if not part:HasTag("TrainRepairPoint") then
			return
		end
		if not InventoryService.has(player, "repair_kit", 1) then
			Net.fireClient("InteractResult", player, { ok = false, error = "NEEDS:Repair Kit" })
			return
		end
		local duration = ItemRegistry.getOrFallback("repair_kit").useSeconds or 7
		local entry = held[player.UserId]
		if not entry or entry.target ~= part then
			beginHold(player, part, "repair_train", duration, part.Position)
			return
		end
		if not completeHold(player, part, "repair_train") then
			return
		end
		InventoryService.remove(player, "repair_kit", 1)
		local restored = TrainService.repair(expedition.train, Balance.Train.repairKitRestore)
		ProgressionService.addStat(player, "condition_repaired", math.floor(restored))
		InteractionService.NoiseMade:Fire(part.Position, 4, player)
		Net.fireClient("InteractResult", player, { ok = true, action = "repair", amount = restored })
		return
	end

	if action == "store" or action == "take" then
		if not part:HasTag("SupplyRack") then
			return
		end
		Net.fireClient("InteractResult", player, {
			ok = true,
			action = "supply_rack",
			contents = InventoryService.trainStore(expedition.crewId),
		})
		return
	end

	----------------------------------------------------------------------
	-- Discoveries and recordings
	----------------------------------------------------------------------
	if action == "discover" then
		if not part:HasTag("Discovery") then
			return
		end
		local discoveryId = part:GetAttribute("DiscoveryId")
		if type(discoveryId) ~= "string" then
			return
		end
		if expedition.discoveriesFound[discoveryId] then
			return
		end
		local stationId = part:GetAttribute("StationId")
		local stationDef = if type(stationId) == "string" then StationRegistry.byId(stationId) else nil
		local hint = ""
		local name = discoveryId
		if stationDef then
			for _, entry in stationDef.discoveries do
				if entry.id == discoveryId then
					hint = entry.hint
					name = entry.name
					break
				end
			end
		end
		ExpeditionService.recordDiscovery(expedition, player, discoveryId)
		Net.fireClient("InteractResult", player, { ok = true, action = "discover", title = name, body = hint })
		return
	end

	if action == "read" then
		-- A recorder in the player's inventory plays the station's recording.
		local stationDef = StationRegistry.byIndex(expedition.stationIndex)
		if not stationDef then
			return
		end
		local recordings = RadioScript.recordingsFor(stationDef.id)
		if #recordings == 0 then
			return
		end
		local pick: any = nil
		for _, recording in recordings do
			if not expedition.recordingsFound[recording.id] then
				pick = recording
				break
			end
		end
		pick = pick or recordings[1]
		ExpeditionService.recordRecording(expedition, player, pick.id)
		Net.fireClients("RadioMessage", ExpeditionService.playersOf(expedition), {
			id = pick.id,
			source = "recording",
			text = pick.text,
			duration = pick.duration,
			attribution = pick.title,
		})
		ProgressionService.award(player, { credits = pick.credits, xp = 20, source = "recording:" .. pick.id }, expedition.crewSize)
		return
	end
end

--------------------------------------------------------------------------

function InteractionService.start()
	Net.onServerEvent("Interact", handleInteract)

	Players.PlayerRemoving:Connect(function(player)
		held[player.UserId] = nil
	end)

	-- Attach proximity prompts to every interactable the world builders tagged.
	-- Prompts are created on the server so the client cannot fabricate one for
	-- an object that has no behaviour.
	local function attachPrompt(instance: Instance, actionText: string, objectText: string, hold: number?)
		if not instance:IsA("BasePart") then
			return
		end
		if instance:FindFirstChildOfClass("ProximityPrompt") then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = actionText
		prompt.ObjectText = objectText
		prompt.HoldDuration = hold or 0
		prompt.MaxActivationDistance = MAX_REACH - 2
		prompt.RequiresLineOfSight = false
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.Parent = instance
	end

	local function wire(tag: string, actionText: string, objectText: string)
		for _, instance in CollectionService:GetTagged(tag) do
			attachPrompt(instance, actionText, objectText)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
			attachPrompt(instance, actionText, objectText)
		end)
	end

	wire("LootNode", "Search", "")
	wire("StationFixture", "Use", "")
	wire("TrainFuelPoint", "Refuel", "Locomotive")
	wire("TrainRepairPoint", "Repair", "Locomotive")
	wire("SupplyRack", "Open", "Supply rack")
	wire("DroppedItem", "Take", "")
	wire("RadioSet", "Radio", "")

	log.info("started")
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	InventoryService
	----------------
	Server-authoritative inventory: what each player is carrying, what it
	weighs, and every way an item can move.

	Inventories are per-expedition, not persistent. Nothing a player picks up
	in the forest follows them home, which is what keeps the survival pressure
	real and removes the entire class of duplication exploits that persistent
	loot inventories attract.

	Every operation validates on the server: the item exists, the player has
	it, the quantity is sane, the capacity allows it, the target is in range,
	and the player is alive. The client sends intent; it never sends outcomes.

	CAPACITY
	--------
	Two limits apply at once. Slots keep the grid readable; weight is the limit
	that actually forces choices. Cargo Rigging raises both, and is the only
	purchase in the project that touches either, which is why it is priced as
	convenience rather than power.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local Monetization = require(Shared.Config.Monetization)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local DataService = require(script.Parent.DataService)

local log = Logger.new("InventoryService")

local InventoryService = {}

export type Stack = { id: string, quantity: number }

export type Inventory = {
	userId: number,
	stacks: { Stack },
	quickSlots: { string? }, -- item ids assigned to the five quick slots
	slotLimit: number,
	weightLimit: number,
}

local inventories: { [number]: Inventory } = {}

InventoryService.Changed = Signal.new() :: Signal.Signal<Player, Inventory>
InventoryService.ItemUsed = Signal.new() :: Signal.Signal<Player, string, ItemRegistry.ItemDef>
InventoryService.ItemCollected = Signal.new() :: Signal.Signal<Player, string, number>

--------------------------------------------------------------------------
-- Capacity
--------------------------------------------------------------------------

--- Resolves a player's limits from their base values, their train, and any
--- owned capacity product. Crew-shared bonuses are applied by the expedition,
--- which passes the crew's best bonus in.
function InventoryService.limitsFor(player: Player, trainId: string?, crewBonusSlots: number?, crewBonusWeight: number?): (number, number)
	local slots = Balance.Player.baseInventorySlots
	local weight = Balance.Player.baseCarryWeight

	local profile = DataService.getProfile(player)
	if profile then
		for productKey, count in profile.purchases.products do
			if count > 0 then
				local def = Monetization.get(productKey)
				if def and def.id > 0 then
					if type(def.grants.inventorySlots) == "number" then
						slots += def.grants.inventorySlots
					end
					if type(def.grants.carryWeight) == "number" then
						weight += def.grants.carryWeight
					end
				end
			end
		end
	end

	if trainId then
		local trainDef = TrainRegistry.get(trainId)
		if trainDef then
			slots += trainDef.handling.inventoryBonusSlots
		end
	end

	slots += crewBonusSlots or 0
	weight += crewBonusWeight or 0

	return math.max(4, slots), math.max(10, weight)
end

--------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------

function InventoryService.create(player: Player, trainId: string?, crewBonusSlots: number?, crewBonusWeight: number?): Inventory
	local slots, weight = InventoryService.limitsFor(player, trainId, crewBonusSlots, crewBonusWeight)
	local inventory: Inventory = {
		userId = player.UserId,
		stacks = {},
		quickSlots = table.create(Balance.Player.quickSlots),
		slotLimit = slots,
		weightLimit = weight,
	}
	inventories[player.UserId] = inventory
	InventoryService.push(player)
	return inventory
end

function InventoryService.destroy(player: Player)
	inventories[player.UserId] = nil
	Net.fireClient("Inventory", player, { stacks = {}, quickSlots = {}, slotLimit = 0, weightLimit = 0, weight = 0, active = false })
end

function InventoryService.get(player: Player): Inventory?
	return inventories[player.UserId]
end

--------------------------------------------------------------------------
-- Queries
--------------------------------------------------------------------------

function InventoryService.weightOf(inventory: Inventory): number
	local total = 0
	for _, stack in inventory.stacks do
		local def = ItemRegistry.get(stack.id)
		if def then
			total += def.weight * stack.quantity
		end
	end
	return total
end

function InventoryService.countOf(player: Player, itemId: string): number
	local inventory = inventories[player.UserId]
	if not inventory then
		return 0
	end
	local total = 0
	for _, stack in inventory.stacks do
		if stack.id == itemId then
			total += stack.quantity
		end
	end
	return total
end

function InventoryService.has(player: Player, itemId: string, quantity: number?): boolean
	return InventoryService.countOf(player, itemId) >= (quantity or 1)
end

--- How many of `itemId` would fit right now, given slots and weight.
function InventoryService.spaceFor(player: Player, itemId: string): number
	local inventory = inventories[player.UserId]
	local def = ItemRegistry.get(itemId)
	if not inventory or not def then
		return 0
	end

	-- Room in existing partial stacks costs no slot.
	local roomInStacks = 0
	for _, stack in inventory.stacks do
		if stack.id == itemId then
			roomInStacks += math.max(0, def.stackSize - stack.quantity)
		end
	end

	local freeSlots = math.max(0, inventory.slotLimit - #inventory.stacks)
	local bySlots = roomInStacks + freeSlots * def.stackSize

	local byWeight = if def.weight > 0 then math.floor((inventory.weightLimit - InventoryService.weightOf(inventory)) / def.weight) else math.huge

	return math.max(0, math.min(bySlots, byWeight))
end

--------------------------------------------------------------------------
-- Mutation
--------------------------------------------------------------------------

--- Adds items. Returns how many were actually added, which may be fewer than
--- requested. Callers must handle a partial add rather than assuming success:
--- the leftover is what gets dropped on the ground.
function InventoryService.add(player: Player, itemId: string, quantity: number): number
	local inventory = inventories[player.UserId]
	local def = ItemRegistry.get(itemId)
	if not inventory or not def or quantity <= 0 then
		return 0
	end

	local canTake = math.min(quantity, InventoryService.spaceFor(player, itemId))
	if canTake <= 0 then
		return 0
	end

	local remaining = canTake
	-- Top up existing stacks first so the grid stays tidy.
	for _, stack in inventory.stacks do
		if remaining <= 0 then
			break
		end
		if stack.id == itemId and stack.quantity < def.stackSize then
			local room = def.stackSize - stack.quantity
			local moved = math.min(room, remaining)
			stack.quantity += moved
			remaining -= moved
		end
	end
	while remaining > 0 and #inventory.stacks < inventory.slotLimit do
		local moved = math.min(def.stackSize, remaining)
		table.insert(inventory.stacks, { id = itemId, quantity = moved })
		remaining -= moved
	end

	local added = canTake - remaining
	if added > 0 then
		InventoryService.push(player)
		InventoryService.Changed:Fire(player, inventory)
		InventoryService.ItemCollected:Fire(player, itemId, added)
	end
	return added
end

--- Removes items. Returns how many were removed.
function InventoryService.remove(player: Player, itemId: string, quantity: number): number
	local inventory = inventories[player.UserId]
	if not inventory or quantity <= 0 then
		return 0
	end

	local remaining = quantity
	for index = #inventory.stacks, 1, -1 do
		if remaining <= 0 then
			break
		end
		local stack = inventory.stacks[index]
		if stack.id == itemId then
			local taken = math.min(stack.quantity, remaining)
			stack.quantity -= taken
			remaining -= taken
			if stack.quantity <= 0 then
				table.remove(inventory.stacks, index)
			end
		end
	end

	local removed = quantity - remaining
	if removed > 0 then
		-- Clear any quick slot that now points at nothing.
		for slot, assigned in inventory.quickSlots do
			if assigned == itemId and InventoryService.countOf(player, itemId) <= 0 then
				inventory.quickSlots[slot] = nil
			end
		end
		InventoryService.push(player)
		InventoryService.Changed:Fire(player, inventory)
	end
	return removed
end

--- Moves items between two players. Used by the hand-over interaction, which
--- is how a crew redistributes weight before a long walk back.
function InventoryService.transfer(from: Player, to: Player, itemId: string, quantity: number): (number, string?)
	if from == to then
		return 0, "SAME_PLAYER"
	end
	local fromRoot = Guard.aliveRoot(from)
	local toRoot = Guard.aliveRoot(to)
	if not fromRoot or not toRoot then
		return 0, "NOT_ALIVE"
	end
	if not Guard.withinDistance(fromRoot.Position, toRoot.Position, 14) then
		return 0, "TOO_FAR"
	end
	if not InventoryService.has(from, itemId, quantity) then
		return 0, "NOT_HELD"
	end

	local space = InventoryService.spaceFor(to, itemId)
	if space <= 0 then
		return 0, "NO_SPACE"
	end

	local moving = math.min(quantity, space)
	local removed = InventoryService.remove(from, itemId, moving)
	local added = InventoryService.add(to, itemId, removed)
	-- If the receiver could not take everything after all, give the remainder
	-- back rather than destroying it.
	if added < removed then
		InventoryService.add(from, itemId, removed - added)
	end
	return added, nil
end

--------------------------------------------------------------------------
-- Dropping
--------------------------------------------------------------------------

-- Set by ExpeditionService so drops land in the right world container.
local dropContainer: Instance? = nil
local dropBuilder: ((string, number, CFrame, Instance) -> Instance?)? = nil

function InventoryService.configureDrops(container: Instance, builder: (string, number, CFrame, Instance) -> Instance?)
	dropContainer = container
	dropBuilder = builder
end

function InventoryService.drop(player: Player, itemId: string, quantity: number): (number, string?)
	local def = ItemRegistry.get(itemId)
	if not def then
		return 0, "UNKNOWN_ITEM"
	end
	local root = Guard.aliveRoot(player)
	if not root then
		return 0, "NOT_ALIVE"
	end
	if not InventoryService.has(player, itemId, quantity) then
		return 0, "NOT_HELD"
	end

	local removed = InventoryService.remove(player, itemId, quantity)
	if removed <= 0 then
		return 0, "NOT_HELD"
	end

	if dropBuilder and dropContainer then
		local cf = root.CFrame * CFrame.new(0, -1.5, -4)
		local instance = dropBuilder(itemId, removed, cf, dropContainer)
		if instance then
			-- Dropped items do not live forever; the world would fill up over
			-- a long expedition.
			task.delay(GameConfig.DroppedItemLifetimeSeconds, function()
				if instance.Parent then
					instance:Destroy()
				end
			end)
		end
	end

	return removed, nil
end

--------------------------------------------------------------------------
-- Using
--------------------------------------------------------------------------

--- Consumes one of an item and reports its effect block to the caller.
--- The systems that act on effects (vitals, flashlight, train) subscribe to
--- ItemUsed rather than being called from here, so this service does not need
--- to know about any of them.
function InventoryService.use(player: Player, itemId: string): (boolean, string?)
	local def = ItemRegistry.get(itemId)
	if not def then
		return false, "UNKNOWN_ITEM"
	end
	if not def.quickUsable then
		return false, "NOT_USABLE"
	end
	if not Guard.aliveRoot(player) then
		return false, "NOT_ALIVE"
	end
	if not InventoryService.has(player, itemId, 1) then
		return false, "NOT_HELD"
	end

	-- Consume first. If a listener errors, the item is still gone, which is
	-- the correct failure: a consumable that survives its own use is an
	-- infinite-item exploit.
	if InventoryService.remove(player, itemId, 1) <= 0 then
		return false, "NOT_HELD"
	end
	InventoryService.ItemUsed:Fire(player, itemId, def)
	return true, nil
end

--------------------------------------------------------------------------
-- Quick slots
--------------------------------------------------------------------------

function InventoryService.setQuickSlot(player: Player, slot: number, itemId: string?): boolean
	local inventory = inventories[player.UserId]
	if not inventory then
		return false
	end
	if slot < 1 or slot > Balance.Player.quickSlots then
		return false
	end
	if itemId then
		local def = ItemRegistry.get(itemId)
		if not def or not def.quickUsable then
			return false
		end
		-- Clear the item from any other slot, so one item is never in two.
		for index, assigned in inventory.quickSlots do
			if assigned == itemId then
				inventory.quickSlots[index] = nil
			end
		end
	end
	inventory.quickSlots[slot] = itemId
	InventoryService.push(player)
	return true
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

function InventoryService.push(player: Player)
	local inventory = inventories[player.UserId]
	if not inventory then
		return
	end
	Net.fireClient("Inventory", player, {
		active = true,
		stacks = inventory.stacks,
		quickSlots = inventory.quickSlots,
		slotLimit = inventory.slotLimit,
		weightLimit = inventory.weightLimit,
		weight = InventoryService.weightOf(inventory),
		overweight = InventoryService.weightOf(inventory) > inventory.weightLimit * 0.85,
	})
end

--------------------------------------------------------------------------

function InventoryService.start()
	Net.onServerInvoke("InventoryCommand", function(player, rawCommand, rawA, rawB)
		local command = Guard.enum(rawCommand, { "use", "drop", "transfer", "quickslot", "refresh" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end

		if command == "refresh" then
			InventoryService.push(player)
			return { ok = true }
		end

		if command == "use" then
			local itemId = Guard.id(rawA)
			if not itemId then
				return { ok = false, error = "BAD_ITEM" }
			end
			local ok, err = InventoryService.use(player, itemId)
			return { ok = ok, error = err }
		end

		if command == "drop" then
			local itemId = Guard.id(rawA)
			local quantity = Guard.integer(rawB, 1, 999) or 1
			if not itemId then
				return { ok = false, error = "BAD_ITEM" }
			end
			local def = ItemRegistry.get(itemId)
			if def and def.essential and Balance.AntiGrief.essentialItemsIndestructible then
				-- Essential items are never destroyed. They can still be handed
				-- over or stored, which is the co-operative alternative to
				-- letting one player bin the crew's only valve.
				local stored = InventoryService.storeInTrain(player, itemId, quantity)
				if stored > 0 then
					return { ok = true, storedInTrain = stored }
				end
			end
			local dropped, err = InventoryService.drop(player, itemId, quantity)
			return { ok = dropped > 0, error = err, quantity = dropped }
		end

		if command == "transfer" then
			local itemId = Guard.id(rawA)
			local targetUserId = Guard.integer(rawB, 1)
			if not itemId or not targetUserId then
				return { ok = false, error = "BAD_ARGS" }
			end
			local target = Players:GetPlayerByUserId(targetUserId)
			if not target then
				return { ok = false, error = "NO_TARGET" }
			end
			local moved, err = InventoryService.transfer(player, target, itemId, 1)
			return { ok = moved > 0, error = err, quantity = moved }
		end

		-- quickslot
		local slot = Guard.integer(rawA, 1, Balance.Player.quickSlots)
		if not slot then
			return { ok = false, error = "BAD_SLOT" }
		end
		local itemId = if rawB == nil then nil else Guard.id(rawB)
		local ok = InventoryService.setQuickSlot(player, slot, itemId)
		return { ok = ok }
	end)

	Players.PlayerRemoving:Connect(function(player)
		inventories[player.UserId] = nil
	end)

	log.info("started")
end

--------------------------------------------------------------------------
-- Train storage
--------------------------------------------------------------------------

-- Set by ExpeditionService: the shared supply rack for the current crew.
local trainStores: { [string]: { [string]: number } } = {}
local playerCrew: { [number]: string } = {}

function InventoryService.bindCrewStore(crewId: string, player: Player)
	playerCrew[player.UserId] = crewId
	trainStores[crewId] = trainStores[crewId] or {}
end

function InventoryService.releaseCrewStore(crewId: string)
	trainStores[crewId] = nil
end

--- Moves items into the crew's shared supply rack. Returns how many moved.
function InventoryService.storeInTrain(player: Player, itemId: string, quantity: number): number
	local crewId = playerCrew[player.UserId]
	if not crewId then
		return 0
	end
	local store = trainStores[crewId]
	if not store then
		return 0
	end
	local removed = InventoryService.remove(player, itemId, quantity)
	if removed > 0 then
		store[itemId] = (store[itemId] or 0) + removed
	end
	return removed
end

function InventoryService.takeFromTrain(player: Player, itemId: string, quantity: number): number
	local crewId = playerCrew[player.UserId]
	if not crewId then
		return 0
	end
	local store = trainStores[crewId]
	if not store or (store[itemId] or 0) <= 0 then
		return 0
	end
	local available = math.min(quantity, store[itemId])
	local taken = InventoryService.add(player, itemId, available)
	store[itemId] -= taken
	if store[itemId] <= 0 then
		store[itemId] = nil
	end
	return taken
end

function InventoryService.trainStore(crewId: string): { [string]: number }
	return trainStores[crewId] or {}
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardService
	------------------
	Global boards, on OrderedDataStores.

	WHAT IS RANKED, AND WHY
	-----------------------
	Only things that reward playing well or playing together. Deliberately not
	ranked: credits held, Robux spent, or anything else that would put a paying
	player at the top of a public list. A board that a purchase can climb turns
	the shop into a status ladder, which is the fastest way to make a paid item
	feel compulsory.

	  Expeditions completed   the headline board
	  Rescues                 cooperation
	  Records recovered       exploration
	  Fastest completion      skill, stored as a duration and ranked ascending

	OrderedDataStore only ranks integers ascending, so the fastest-time board
	stores (a large constant minus the duration) and is converted back when
	read. That is the standard approach and it is documented here because it is
	otherwise baffling to whoever maintains this next.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)

local DataService = require(script.Parent.DataService)
local ExpeditionService = require(script.Parent.ExpeditionService)

local log = Logger.new("LeaderboardService")

local LeaderboardService = {}

-- Fastest-time inversion constant. Any run longer than this is not ranked,
-- which is fine: it is well beyond the maximum sensible run length.
local TIME_CEILING = 7200

export type BoardDef = {
	id: string,
	name: string,
	description: string,
	stat: string?, -- profile stat that feeds it, when applicable
	inverted: boolean?, -- true for lower-is-better boards
	format: string, -- "number" | "duration"
}

local BOARDS: { BoardDef } = {
	{
		id = "completions",
		name = "Expeditions Completed",
		description = "Runs finished, all difficulties.",
		stat = "expeditions_completed",
		format = "number",
	},
	{
		id = "rescues",
		name = "Crew Recovered",
		description = "Teammates revived.",
		stat = "revives_given",
		format = "number",
	},
	{
		id = "records",
		name = "Records Recovered",
		description = "Dispatch logs and recordings found.",
		stat = "records_found",
		format = "number",
	},
	{
		id = "fastest",
		name = "Fastest Line",
		description = "Quickest complete run of the chapter.",
		inverted = true,
		format = "duration",
	},
}

LeaderboardService.Boards = BOARDS

--------------------------------------------------------------------------

local stores: { [string]: OrderedDataStore } = {}
local cache: { [string]: { fetchedAt: number, entries: { any } } } = {}
local CACHE_TTL = 120

local available = not RunService:IsStudio()

local function storeFor(boardId: string): OrderedDataStore?
	if not available then
		return nil
	end
	local existing = stores[boardId]
	if existing then
		return existing
	end
	local ok, result = Protect.call(function()
		return DataStoreService:GetOrderedDataStore(GameConfig.LeaderboardStoreName .. "_" .. boardId)
	end)
	if not ok then
		log.warn(string.format("board %s unavailable: %s", boardId, tostring(result)))
		return nil
	end
	stores[boardId] = result
	return result
end

--------------------------------------------------------------------------
-- Submission
--------------------------------------------------------------------------

local function submit(boardId: string, userId: number, value: number)
	local store = storeFor(boardId)
	if not store then
		return
	end
	local rounded = math.floor(value)
	if rounded <= 0 then
		return
	end
	local ok, err = Protect.call(function()
		-- The transform returns nil to abort the write when the new value is
		-- not an improvement. Luau types the callback as always returning a
		-- number, so the cast keeps the abort form the API actually supports.
		local transform = (function(current: any): any
			local existing = tonumber(current) or 0
			-- Boards only ever move up, which also means a partial or failed
			-- read can never lower somebody's standing.
			if rounded <= existing then
				return nil
			end
			return rounded
		end :: any) :: (any) -> number
		store:UpdateAsync(tostring(userId), transform)
	end)
	if not ok then
		log.warn(string.format("submit to %s failed: %s", boardId, tostring(err)))
	end
end

--- Pushes a player's current standing to every stat-backed board.
function LeaderboardService.submitAll(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end
	for _, board in BOARDS do
		if board.stat then
			submit(board.id, player.UserId, profile.stats[board.stat] or 0)
		end
	end
end

--------------------------------------------------------------------------
-- Reading
--------------------------------------------------------------------------

function LeaderboardService.read(boardId: string, limit: number?): { any }
	local cached = cache[boardId]
	if cached and (os.clock() - cached.fetchedAt) < CACHE_TTL then
		return cached.entries
	end

	local store = storeFor(boardId)
	if not store then
		return {}
	end

	local board: BoardDef? = nil
	for _, candidate in BOARDS do
		if candidate.id == boardId then
			board = candidate
			break
		end
	end
	if not board then
		return {}
	end

	local count = math.clamp(limit or 25, 1, 100)
	local ok, pages = Protect.call(function()
		return store:GetSortedAsync(false, count)
	end)
	if not ok then
		log.warn(string.format("read of %s failed: %s", boardId, tostring(pages)))
		return cached and cached.entries or {}
	end

	local entries: { any } = {}
	local okPage, page = Protect.call(function()
		return (pages :: any):GetCurrentPage()
	end)
	if okPage and type(page) == "table" then
		for rank, entry in page do
			local userId = tonumber(entry.key) or 0
			local value = entry.value
			if (board :: BoardDef).inverted then
				value = TIME_CEILING - value
			end
			-- Names are resolved lazily and failures fall back to the user ID,
			-- so a rate-limited name lookup never blanks the board.
			local name = "Player " .. tostring(userId)
			local okName, resolvedName = Protect.call(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if okName and type(resolvedName) == "string" then
				name = resolvedName
			end
			table.insert(entries, { rank = rank, userId = userId, name = name, value = value })
		end
	end

	cache[boardId] = { fetchedAt = os.clock(), entries = entries }
	return entries
end

--------------------------------------------------------------------------

function LeaderboardService.start()
	if not available then
		log.warn("leaderboards are disabled in Studio; OrderedDataStore access is not reliable there")
	end

	Net.onServerInvoke("LeaderboardData", function(player, rawBoard)
		local boardId = Guard.id(rawBoard)
		local descriptors = {}
		for _, board in BOARDS do
			table.insert(descriptors, {
				id = board.id,
				name = board.name,
				description = board.description,
				format = board.format,
			})
		end
		if not boardId then
			return { ok = true, boards = descriptors, entries = {} }
		end
		local profile = DataService.getProfile(player)
		local personal: number? = nil
		for _, board in BOARDS do
			if board.id == boardId and board.stat and profile then
				personal = profile.stats[board.stat]
			end
		end
		return {
			ok = true,
			boards = descriptors,
			board = boardId,
			entries = LeaderboardService.read(boardId, 25),
			personal = personal,
			available = available,
		}
	end)

	-- Standings are submitted when a run ends rather than continuously, which
	-- keeps well inside the DataStore write budget.
	ExpeditionService.Ended:Connect(function(expedition, success)
		for _, player in ExpeditionService.playersOf(expedition) do
			task.spawn(LeaderboardService.submitAll, player)
		end
		if not success then
			return
		end
		-- Fastest board: only a full clear of every station counts.
		local elapsed = math.floor((expedition.endedAt or os.clock()) - expedition.startedAt)
		if elapsed > 0 and elapsed < TIME_CEILING and expedition.stationsCleared >= 5 then
			for _, player in ExpeditionService.playersOf(expedition) do
				task.spawn(submit, "fastest", player.UserId, TIME_CEILING - elapsed)
			end
		end
	end)

	-- Also submit on leave, so progress made without finishing a run counts.
	Players.PlayerRemoving:Connect(function(player)
		task.spawn(LeaderboardService.submitAll, player)
	end)

	log.info(string.format("started with %d boards", #BOARDS))
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProfileSchema
	-------------
	The shape of a saved player profile, plus the migration chain.

	Rules this file enforces:

	  1. `template` is the authority. New fields are added here and reach
	     existing players through TableUtil.reconcile at load, with no
	     migration step and no risk to existing data.
	  2. Migrations are only for changes reconcile cannot express: renamed
	     fields, changed units, restructured tables. Each migration is a pure
	     function from version N to N+1 and must never delete data it does not
	     understand.
	  3. Purchase records are append-only. No migration and no admin reset
	     removes them, because a player who paid Robux must keep what they paid
	     for even if every other part of the profile is wiped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local CosmeticRegistry = require(Shared.Registry.CosmeticRegistry)
local TableUtil = require(Shared.Core.TableUtil)

local ProfileSchema = {}

export type Profile = {
	version: number,

	-- Economy and progression -------------------------------------------
	credits: number,
	xp: number,
	level: number,

	-- Ownership ----------------------------------------------------------
	trains: { [string]: boolean },
	liveries: { [string]: boolean },
	interiors: { [string]: boolean },
	cosmetics: { [string]: boolean },
	weapons: { [string]: boolean },

	-- Loadout and appearance ---------------------------------------------
	loadout: {
		train: string,
		livery: string,
		interior: string,
		primaryWeapon: string,
		sidearm: string,
		role: string,
		lamp: string,
		outfit: string,
		finish: string,
		patch: string,
	},

	-- Settings -------------------------------------------------------------
	settings: {
		masterVolume: number,
		musicVolume: number,
		ambienceVolume: number,
		sfxVolume: number,
		trainVolume: number,
		voiceVolume: number,
		uiVolume: number,
		creatureVolume: number,
		subtitles: boolean,
		directionalCues: boolean,
		reducedMotion: boolean,
		reducedFlashing: boolean,
		cameraShake: number,
		fieldOfView: number,
		hudScale: number,
		invertY: boolean,
		sensitivity: number,
		holdToSprint: boolean,
		holdToCrouch: boolean,
		touchLayout: string,
		highContrast: boolean,
		showDamageNumbers: boolean,
	},

	-- Statistics. Also the source of truth for quest progress counters.
	stats: { [string]: number },

	-- Quests ----------------------------------------------------------------
	quests: {
		dailyDay: number,
		daily: { [string]: number }, -- questId -> progress
		dailyClaimed: { [string]: boolean },
		weeklyWeek: number,
		weekly: { [string]: number },
		weeklyClaimed: { [string]: boolean },
		milestones: { [string]: boolean },
	},

	-- Daily rewards ----------------------------------------------------------
	login: {
		lastClaimDay: number,
		streak: number,
		bestStreak: number,
	},
	playtime: {
		day: number,
		secondsToday: number,
		rewardsClaimedToday: number,
	},

	-- Live events -------------------------------------------------------------
	events: {
		[string]: {
			tokens: number,
			claimed: { [string]: boolean }, -- threshold key -> claimed
			firstSeen: number,
		},
	},

	-- Achievements -------------------------------------------------------------
	achievements: { [string]: number }, -- id -> unlock timestamp

	-- Collections ----------------------------------------------------------------
	recordings: { [string]: boolean },
	discoveries: { [string]: boolean },

	-- Purchases. Append-only, never cleared. ------------------------------------
	purchases: {
		-- Roblox PurchaseId values already granted. This is what makes
		-- ProcessReceipt duplicate-safe across servers and reconnects.
		receipts: { [string]: number },
		-- Product key -> count of times purchased (consumables) or 1 (permanent).
		products: { [string]: number },
		-- Total Robux spent, for the operator's own reporting only.
		robuxSpent: number,
	},

	-- Session bookkeeping ---------------------------------------------------------
	firstJoin: number,
	lastSeen: number,
	sessionCount: number,
	-- Set while an expedition is in progress so a crash mid-run can restore
	-- the player to the right place rather than to a broken state.
	activeExpedition: {
		crewId: string?,
		stationIndex: number?,
		startedAt: number?,
	},
}

--------------------------------------------------------------------------
-- Template
--------------------------------------------------------------------------

local function defaultStats(): { [string]: number }
	-- Every stat a quest or achievement can reference must exist here, so a
	-- counter is never nil and progress arithmetic is always safe.
	return {
		expeditions_started = 0,
		expeditions_completed = 0,
		expeditions_failed = 0,
		expeditions_completed_blackout = 0,
		expeditions_completed_derelict = 0,
		full_line_runs = 0,
		clean_signal_runs = 0,
		large_crew_completions = 0,
		flawless_expeditions = 0,
		stations_cleared = 0,
		optional_objectives = 0,
		unique_objectives_completed = 0,
		silent_stations = 0,
		records_found = 0,
		unique_recordings = 0,
		discoveries_found = 0,
		revives_given = 0,
		revives_received = 0,
		times_downed = 0,
		deaths = 0,
		condition_repaired = 0,
		fuel_delivered = 0,
		distance_driven = 0,
		creature_repelled = 0,
		false_instructions_ignored = 0,
		false_instructions_followed = 0,
		shots_fired = 0,
		melee_hits = 0,
		items_collected = 0,
		credits_earned = 0,
		playtime_seconds = 0,
	}
end

local function defaultSettings()
	return {
		masterVolume = 0.85,
		musicVolume = 0.6,
		ambienceVolume = 0.8,
		sfxVolume = 0.9,
		trainVolume = 0.85,
		voiceVolume = 1.0,
		uiVolume = 0.7,
		creatureVolume = 1.0,
		subtitles = true,
		directionalCues = false,
		reducedMotion = false,
		reducedFlashing = false,
		cameraShake = 1.0,
		fieldOfView = 70,
		hudScale = 1.0,
		invertY = false,
		sensitivity = 1.0,
		holdToSprint = true,
		holdToCrouch = false,
		touchLayout = "default",
		highContrast = false,
		showDamageNumbers = false,
	}
end

function ProfileSchema.template(): Profile
	return {
		version = GameConfig.DataVersion,

		credits = 350, -- a small starting float so the shop is not empty on day one
		xp = 0,
		level = 1,

		trains = { warden = true },
		liveries = { livery_depot = true, livery_freight = true, livery_express = true, livery_engineering = true },
		interiors = { interior_standard = true },
		cosmetics = CosmeticRegistry.defaultOwned(),
		weapons = { wrench = true, crowbar = true, revolver = true },

		loadout = {
			train = "warden",
			livery = "livery_depot",
			interior = "interior_standard",
			primaryWeapon = "wrench",
			sidearm = "revolver",
			role = "crew",
			lamp = "lantern_standard",
			outfit = "outfit_crew",
			finish = "finish_standard",
			patch = "",
		},

		settings = defaultSettings(),
		stats = defaultStats(),

		quests = {
			dailyDay = 0,
			daily = {},
			dailyClaimed = {},
			weeklyWeek = 0,
			weekly = {},
			weeklyClaimed = {},
			milestones = {},
		},

		login = { lastClaimDay = 0, streak = 0, bestStreak = 0 },
		playtime = { day = 0, secondsToday = 0, rewardsClaimedToday = 0 },

		events = {},
		achievements = {},
		recordings = {},
		discoveries = {},

		purchases = { receipts = {}, products = {}, robuxSpent = 0 },

		firstJoin = 0,
		lastSeen = 0,
		sessionCount = 0,
		activeExpedition = {},
	}
end

--------------------------------------------------------------------------
-- Migrations
--------------------------------------------------------------------------

-- Each entry migrates FROM its key TO key + 1. Missing entries are treated as
-- no-ops, which is correct for versions whose only change was additive.
local MIGRATIONS: { [number]: (any) -> any } = {
	[1] = function(data: any): any
		-- v1 -> v2: cosmetics were stored as an array of ids; they are now a set.
		if type(data.cosmetics) == "table" and #data.cosmetics > 0 then
			local set: { [string]: boolean } = {}
			for _, id in data.cosmetics do
				if type(id) == "string" then
					set[id] = true
				end
			end
			data.cosmetics = set
		end
		return data
	end,

	[2] = function(data: any): any
		-- v2 -> v3: split the single `volume` setting into per-bus volumes, and
		-- moved purchase records under `purchases` so they can be protected as
		-- a unit. The old fields are read, then left in place rather than
		-- deleted, so a rollback to v2 still finds them.
		data.settings = data.settings or {}
		local legacyVolume = data.settings.volume
		if type(legacyVolume) == "number" then
			data.settings.masterVolume = legacyVolume
			data.settings.musicVolume = legacyVolume * 0.7
			data.settings.ambienceVolume = legacyVolume
			data.settings.sfxVolume = legacyVolume
			data.settings.trainVolume = legacyVolume
			data.settings.voiceVolume = math.min(1, legacyVolume * 1.15)
			data.settings.uiVolume = legacyVolume * 0.8
			data.settings.creatureVolume = legacyVolume
		end

		data.purchases = data.purchases or { receipts = {}, products = {}, robuxSpent = 0 }
		if type(data.receipts) == "table" then
			for key, value in data.receipts do
				if data.purchases.receipts[key] == nil then
					data.purchases.receipts[key] = value
				end
			end
		end
		if type(data.ownedProducts) == "table" then
			for key, value in data.ownedProducts do
				if data.purchases.products[key] == nil then
					data.purchases.products[key] = if type(value) == "number" then value else 1
				end
			end
		end
		return data
	end,
}

--- Runs every migration needed to bring `data` up to the current version.
--- Returns the migrated table and whether anything changed.
function ProfileSchema.migrate(data: any): (any, boolean)
	local from = tonumber(data.version) or 1
	local changed = false
	local current = data

	while from < GameConfig.DataVersion do
		local migration = MIGRATIONS[from]
		if migration then
			local ok, result = pcall(migration, current)
			if ok and type(result) == "table" then
				current = result
				changed = true
			else
				-- A failing migration must not destroy the profile. The data is
				-- left at its current version and the caller decides; DataService
				-- treats this as an uncertain load and refuses to overwrite.
				warn(string.format("[ProfileSchema] migration %d -> %d failed: %s", from, from + 1, tostring(result)))
				return current, changed
			end
		end
		from += 1
		current.version = from
		changed = true
	end

	return current, changed
end

--- Fills in anything missing and clamps values that must stay in range.
function ProfileSchema.normalise(data: any): Profile
	local profile = TableUtil.reconcile(data, ProfileSchema.template() :: any) :: any

	-- Numeric hygiene. A corrupted or tampered value must not propagate into
	-- gameplay maths, where NaN spreads silently.
	local function sane(value: any, fallback: number, min: number?, max: number?): number
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return fallback
		end
		if min and value < min then
			return min
		end
		if max and value > max then
			return max
		end
		return value
	end

	profile.credits = math.floor(sane(profile.credits, 0, 0))
	profile.xp = math.floor(sane(profile.xp, 0, 0))
	profile.level = math.floor(sane(profile.level, 1, 1, 60))

	for key, value in profile.stats do
		profile.stats[key] = math.floor(sane(value, 0, 0))
	end

	local settings = profile.settings
	for _, key in { "masterVolume", "musicVolume", "ambienceVolume", "sfxVolume", "trainVolume", "voiceVolume", "uiVolume", "creatureVolume" } do
		settings[key] = sane(settings[key], 0.8, 0, 1)
	end
	settings.fieldOfView = sane(settings.fieldOfView, 70, 55, 100)
	settings.hudScale = sane(settings.hudScale, 1, 0.75, 1.5)
	settings.sensitivity = sane(settings.sensitivity, 1, 0.2, 3)
	settings.cameraShake = sane(settings.cameraShake, 1, 0, 1)

	profile.purchases.robuxSpent = math.floor(sane(profile.purchases.robuxSpent, 0, 0))

	return profile :: Profile
end

--- A fresh profile for a player who has never played.
function ProfileSchema.fresh(): Profile
	local profile = ProfileSchema.template()
	profile.firstJoin = os.time()
	profile.lastSeen = os.time()
	return profile
end

--- The subset of a profile that is safe and useful to send to the client.
--- Receipts are deliberately excluded: the client has no use for them and they
--- are the one thing worth keeping entirely server-side.
function ProfileSchema.toClient(profile: Profile): { [string]: any }
	return {
		credits = profile.credits,
		xp = profile.xp,
		level = profile.level,
		trains = profile.trains,
		liveries = profile.liveries,
		interiors = profile.interiors,
		cosmetics = profile.cosmetics,
		weapons = profile.weapons,
		loadout = profile.loadout,
		settings = profile.settings,
		stats = profile.stats,
		quests = profile.quests,
		login = profile.login,
		playtime = profile.playtime,
		events = profile.events,
		achievements = profile.achievements,
		recordings = profile.recordings,
		discoveries = profile.discoveries,
		ownedProducts = profile.purchases.products,
		sessionCount = profile.sessionCount,
	}
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProgressionService
	------------------
	Credits, XP, levels, statistics and achievements.

	Everything that grants a reward in this game funnels through `award`, which
	means there is exactly one place that applies multipliers, one place that
	writes the profile, and one place that tells the client. That matters for
	the paid multipliers: the Signalman's Pass bonus cannot be applied twice or
	forgotten, because no other code path can grant credits.

	Statistics are the single source of truth for quest progress. A system
	reports "this happened" by bumping a stat; QuestService watches stats. No
	system ever reports progress to a quest directly, so a quest can never
	drift out of sync with the statistic it claims to track.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local Monetization = require(Shared.Config.Monetization)
local CosmeticRegistry = require(Shared.Registry.CosmeticRegistry)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
local DataService = require(script.Parent.DataService)
local ProfileSchema = require(script.Parent.ProfileSchema)

local log = Logger.new("ProgressionService")

local ProgressionService = {}

export type AwardSource = string

export type Award = {
	credits: number?,
	xp: number?,
	-- Stats to increment, as name -> amount.
	stats: { [string]: number }?,
	-- Cosmetics, liveries, interiors, trains or weapons to grant.
	unlocks: { { kind: string, id: string } }?,
	-- Where this came from, for analytics and for the reward feed.
	source: AwardSource,
	-- Skips multipliers. Used for admin grants and refunds, which must be exact.
	exact: boolean?,
}

export type AwardResult = {
	credits: number,
	xp: number,
	levelsGained: number,
	newLevel: number,
	unlocked: { { kind: string, id: string } },
}

ProgressionService.Awarded = Signal.new() :: Signal.Signal<Player, AwardResult, AwardSource>
ProgressionService.LevelUp = Signal.new() :: Signal.Signal<Player, number>
ProgressionService.StatChanged = Signal.new() :: Signal.Signal<Player, string, number>

--------------------------------------------------------------------------
-- Achievements
--------------------------------------------------------------------------

export type AchievementDef = {
	id: string,
	name: string,
	description: string,
	stat: string,
	target: number,
	credits: number,
	xp: number,
	cosmetic: string?,
	hidden: boolean?,
}

local ACHIEVEMENTS: { AchievementDef } = {
	{ id = "a_first_stop", name = "Request Stop", description = "Clear your first station.", stat = "stations_cleared", target = 1, credits = 120, xp = 100 },
	{ id = "a_ten_stops", name = "Regular Service", description = "Clear fifty stations.", stat = "stations_cleared", target = 50, credits = 800, xp = 650 },
	{ id = "a_hundred_stops", name = "Timetabled", description = "Clear two hundred stations.", stat = "stations_cleared", target = 200, credits = 2400, xp = 1900, cosmetic = "lantern_steel" },
	{ id = "a_driver", name = "Second Man", description = "Drive fifty kilometres of track.", stat = "distance_driven", target = 50000, credits = 600, xp = 500 },
	{ id = "a_long_driver", name = "Top Link", description = "Drive four hundred kilometres of track.", stat = "distance_driven", target = 400000, credits = 2800, xp = 2200, cosmetic = "outfit_yard" },
	{ id = "a_medic", name = "First Responder", description = "Revive twenty-five crew members.", stat = "revives_given", target = 25, credits = 700, xp = 600 },
	{ id = "a_medic_2", name = "Nobody Left", description = "Revive one hundred crew members.", stat = "revives_given", target = 100, credits = 2200, xp = 1800 },
	{ id = "a_mechanic", name = "Fitter", description = "Restore one thousand points of condition.", stat = "condition_repaired", target = 1000, credits = 700, xp = 600 },
	{ id = "a_archivist", name = "Paper Trail", description = "Recover one hundred records.", stat = "records_found", target = 100, credits = 900, xp = 750 },
	{ id = "a_explorer", name = "Off the Timetable", description = "Find thirty discoveries.", stat = "discoveries_found", target = 30, credits = 800, xp = 700 },
	{ id = "a_repel", name = "Not Tonight", description = "Drive off the Signal-Eater twenty times.", stat = "creature_repelled", target = 20, credits = 1100, xp = 950 },
	{ id = "a_sceptic", name = "Sceptic", description = "Ignore fifty false transmissions.", stat = "false_instructions_ignored", target = 50, credits = 1200, xp = 1000 },
	{ id = "a_complete", name = "The Long Grade", description = "Complete the chapter ten times.", stat = "expeditions_completed", target = 10, credits = 1500, xp = 1300 },
	{ id = "a_veteran", name = "Veteran Crew", description = "Complete the chapter fifty times.", stat = "expeditions_completed", target = 50, credits = 4000, xp = 3400, cosmetic = "lantern_operator" },
	{
		id = "a_never_down",
		name = "Untouched",
		description = "Complete five expeditions without being downed.",
		stat = "flawless_expeditions",
		target = 5,
		credits = 1800,
		xp = 1500,
		hidden = true,
	},
}

ProgressionService.Achievements = ACHIEVEMENTS

--------------------------------------------------------------------------
-- Multipliers
--------------------------------------------------------------------------

--- Everything that multiplies a reward, resolved in one place.
--- `crewSize` is passed by the expedition; elsewhere it is 1.
function ProgressionService.multipliers(player: Player, crewSize: number?): { credits: number, xp: number, reasons: { string } }
	local profile = DataService.getProfile(player)
	local creditMultiplier = 1.0
	local xpMultiplier = 1.0
	local reasons: { string } = {}

	if profile then
		-- Paid multipliers come from owned products, resolved through the
		-- monetization config so a product with no configured ID grants nothing.
		for productKey, count in profile.purchases.products do
			if count > 0 then
				local def = Monetization.get(productKey)
				if def and def.id > 0 then
					local grants = def.grants
					if type(grants.creditMultiplier) == "number" then
						creditMultiplier *= grants.creditMultiplier
						table.insert(reasons, def.name)
					end
					if type(grants.xpMultiplier) == "number" then
						xpMultiplier *= grants.xpMultiplier
					end
				end
			end
		end
	end

	-- Cooperation bonus. Scales with crew size, capped, and applies to
	-- everyone in the crew equally.
	if crewSize and crewSize > 1 then
		local bonus = math.min(Balance.Economy.maxCrewBonus, (crewSize - 1) * Balance.Economy.crewBonusPerMember)
		creditMultiplier *= (1 + bonus)
		xpMultiplier *= (1 + bonus)
		table.insert(reasons, string.format("Crew of %d", crewSize))
	end

	return { credits = creditMultiplier, xp = xpMultiplier, reasons = reasons }
end

--------------------------------------------------------------------------
-- Levelling
--------------------------------------------------------------------------

local function applyLevels(profile: ProfileSchema.Profile): number
	local gained = 0
	while profile.level < Balance.Progression.maxLevel do
		local needed = Balance.xpForLevel(profile.level)
		if profile.xp < needed then
			break
		end
		profile.xp -= needed
		profile.level += 1
		gained += 1
		-- A runaway grant should not loop forever.
		if gained > 100 then
			break
		end
	end
	if profile.level >= Balance.Progression.maxLevel then
		profile.xp = 0
	end
	return gained
end

--- XP still needed for the next level, for the HUD bar.
function ProgressionService.xpToNext(player: Player): (number, number)
	local profile = DataService.getProfile(player)
	if not profile then
		return 0, 1
	end
	if profile.level >= Balance.Progression.maxLevel then
		return 0, 1
	end
	return profile.xp, Balance.xpForLevel(profile.level)
end

--------------------------------------------------------------------------
-- Unlocks
--------------------------------------------------------------------------

--- Grants an unlock idempotently. Returns true only when it was newly granted,
--- so the reward feed does not announce something the player already had.
function ProgressionService.grantUnlock(player: Player, kind: string, id: string): boolean
	local profile = DataService.getProfile(player)
	if not profile then
		return false
	end

	local bucket: { [string]: boolean }?
	if kind == "cosmetic" then
		bucket = profile.cosmetics
		if not CosmeticRegistry.get(id) then
			log.warn("unknown cosmetic:", id)
			return false
		end
	elseif kind == "livery" then
		bucket = profile.liveries
		if not TrainRegistry.getLivery(id) or TrainRegistry.Liveries[id] == nil then
			log.warn("unknown livery:", id)
			return false
		end
	elseif kind == "interior" then
		bucket = profile.interiors
		if TrainRegistry.Interiors[id] == nil then
			log.warn("unknown interior:", id)
			return false
		end
	elseif kind == "train" then
		bucket = profile.trains
		if not TrainRegistry.get(id) then
			log.warn("unknown train:", id)
			return false
		end
	elseif kind == "weapon" then
		bucket = profile.weapons
		if not WeaponRegistry.exists(id) then
			log.warn("unknown weapon:", id)
			return false
		end
	else
		log.warn("unknown unlock kind:", kind)
		return false
	end

	local resolved = bucket :: { [string]: boolean }
	if resolved[id] then
		return false
	end
	DataService.update(player, function(p)
		local target: { [string]: boolean }
		if kind == "cosmetic" then
			target = p.cosmetics
		elseif kind == "livery" then
			target = p.liveries
		elseif kind == "interior" then
			target = p.interiors
		elseif kind == "train" then
			target = p.trains
		else
			target = p.weapons
		end
		target[id] = true
	end)
	return true
end

function ProgressionService.owns(player: Player, kind: string, id: string): boolean
	local profile = DataService.getProfile(player)
	if not profile then
		return false
	end
	if kind == "cosmetic" then
		return profile.cosmetics[id] == true
	elseif kind == "livery" then
		return profile.liveries[id] == true
	elseif kind == "interior" then
		return profile.interiors[id] == true
	elseif kind == "train" then
		return profile.trains[id] == true
	elseif kind == "weapon" then
		return profile.weapons[id] == true
	end
	return false
end

--------------------------------------------------------------------------
-- Statistics
--------------------------------------------------------------------------

function ProgressionService.addStat(player: Player, stat: string, amount: number): number
	local profile = DataService.getProfile(player)
	if not profile then
		return 0
	end
	if profile.stats[stat] == nil then
		-- An unknown stat is a bug, not a reason to lose the event. It is
		-- created so the data survives, and logged so it gets fixed.
		log.warn("stat not in schema, creating:", stat)
		profile.stats[stat] = 0
	end
	local newValue = 0
	DataService.update(player, function(p)
		p.stats[stat] = math.max(0, (p.stats[stat] or 0) + amount)
		newValue = p.stats[stat]
	end)
	ProgressionService.StatChanged:Fire(player, stat, newValue)
	ProgressionService.checkAchievements(player)
	return newValue
end

function ProgressionService.setStatMax(player: Player, stat: string, value: number): number
	local profile = DataService.getProfile(player)
	if not profile then
		return 0
	end
	local current = profile.stats[stat] or 0
	if value <= current then
		return current
	end
	return ProgressionService.addStat(player, stat, value - current)
end

function ProgressionService.getStat(player: Player, stat: string): number
	local profile = DataService.getProfile(player)
	if not profile then
		return 0
	end
	return profile.stats[stat] or 0
end

--------------------------------------------------------------------------
-- Awarding
--------------------------------------------------------------------------

--- The single entry point for granting anything. Returns exactly what was
--- granted after multipliers, which is what the reward feed displays.
function ProgressionService.award(player: Player, award: Award, crewSize: number?): AwardResult
	local result: AwardResult = { credits = 0, xp = 0, levelsGained = 0, newLevel = 1, unlocked = {} }
	local profile = DataService.getProfile(player)
	if not profile then
		return result
	end

	local multipliers = if award.exact then { credits = 1, xp = 1, reasons = {} } else ProgressionService.multipliers(player, crewSize)

	local credits = math.floor((award.credits or 0) * multipliers.credits + 0.5)
	local xp = math.floor((award.xp or 0) * multipliers.xp + 0.5)

	DataService.update(player, function(p)
		if credits ~= 0 then
			p.credits = math.max(0, p.credits + credits)
			if credits > 0 then
				p.stats.credits_earned = (p.stats.credits_earned or 0) + credits
			end
		end
		if xp > 0 then
			p.xp += xp
		end
		result.levelsGained = applyLevels(p)
		result.newLevel = p.level
	end)

	result.credits = credits
	result.xp = xp

	if award.stats then
		for stat, amount in award.stats do
			ProgressionService.addStat(player, stat, amount)
		end
	end

	if award.unlocks then
		for _, unlock in award.unlocks do
			if ProgressionService.grantUnlock(player, unlock.kind, unlock.id) then
				table.insert(result.unlocked, unlock)
			end
		end
	end

	if result.levelsGained > 0 then
		ProgressionService.LevelUp:Fire(player, result.newLevel)
	end

	ProgressionService.Awarded:Fire(player, result, award.source)
	ProgressionService.pushToClient(player)

	if result.credits ~= 0 or result.xp ~= 0 or #result.unlocked > 0 then
		Net.fireClient("RewardGranted", player, {
			credits = result.credits,
			xp = result.xp,
			levelsGained = result.levelsGained,
			level = result.newLevel,
			unlocked = result.unlocked,
			source = award.source,
			multiplierReasons = multipliers.reasons,
		})
	end

	return result
end

--- Spends credits. Returns false without spending when the balance is short,
--- which every caller must handle rather than assuming success.
function ProgressionService.spendCredits(player: Player, amount: number, reason: string): boolean
	if amount <= 0 then
		return false
	end
	local profile = DataService.getProfile(player)
	if not profile or profile.credits < amount then
		return false
	end
	if not DataService.isWritable(player) then
		-- A read-only session must not be allowed to spend, because the spend
		-- would not persist and the player would lose the purchase on rejoin.
		return false
	end
	DataService.update(player, function(p)
		p.credits -= amount
	end)
	log.debug(string.format("%s spent %d credits on %s", player.Name, amount, reason))
	ProgressionService.pushToClient(player)
	return true
end

--------------------------------------------------------------------------
-- Achievements
--------------------------------------------------------------------------

function ProgressionService.checkAchievements(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end
	for _, def in ACHIEVEMENTS do
		if profile.achievements[def.id] == nil then
			local value = profile.stats[def.stat] or 0
			if value >= def.target then
				DataService.update(player, function(p)
					p.achievements[def.id] = os.time()
				end)
				local unlocks = {}
				if def.cosmetic then
					table.insert(unlocks, { kind = "cosmetic", id = def.cosmetic })
				end
				-- Achievement rewards are exact: they are a fixed prize, not
				-- something a multiplier should inflate.
				ProgressionService.award(player, {
					credits = def.credits,
					xp = def.xp,
					unlocks = unlocks,
					source = "achievement:" .. def.id,
					exact = true,
				})
				Net.fireClient("Notify", player, {
					kind = "achievement",
					title = def.name,
					body = def.description,
					duration = 6,
				})
				log.info(string.format("%s unlocked achievement %s", player.Name, def.id))
			end
		end
	end
end

function ProgressionService.achievementProgress(player: Player): { { id: string, name: string, description: string, progress: number, target: number, unlockedAt: number? } }
	local profile = DataService.getProfile(player)
	local out = {}
	if not profile then
		return out
	end
	for _, def in ACHIEVEMENTS do
		local unlockedAt = profile.achievements[def.id]
		if not def.hidden or unlockedAt then
			table.insert(out, {
				id = def.id,
				name = def.name,
				description = def.description,
				progress = math.min(def.target, profile.stats[def.stat] or 0),
				target = def.target,
				unlockedAt = unlockedAt,
			})
		end
	end
	return out
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

function ProgressionService.pushToClient(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end
	local payload = ProfileSchema.toClient(profile)
	payload.xpToNext = if profile.level < Balance.Progression.maxLevel then Balance.xpForLevel(profile.level) else 0
	payload.readOnly = not DataService.isWritable(player)
	payload.readOnlyReason = DataService.readOnlyReason(player)
	Net.fireClient("ProfileSnapshot", player, payload)
end

function ProgressionService.start()
	DataService.ProfileLoaded:Connect(function(player)
		ProgressionService.pushToClient(player)
		ProgressionService.checkAchievements(player)
		if not DataService.isWritable(player) then
			Net.fireClient("Notify", player, {
				kind = "warning",
				title = "Progress is not being saved",
				body = "Your data could not be loaded safely, so nothing will be written this session. Rejoining usually fixes it.",
				duration = 12,
				persistent = true,
			})
		end
	end)

	Net.onServerInvoke("RequestProfile", function(player)
		local profile = DataService.getProfile(player)
		if not profile then
			return { ok = false, error = "NOT_LOADED" }
		end
		ProgressionService.pushToClient(player)
		return { ok = true }
	end)

	log.info(string.format("started with %d achievements", #ACHIEVEMENTS))
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PurchaseService
	---------------
	Every Robux transaction in LAST SIGNAL passes through this file.

	THE FOUR THINGS THAT GO WRONG WITH ROBLOX PURCHASES, AND WHAT IS DONE HERE
	-------------------------------------------------------------------------
	1. Double-granting. ProcessReceipt can be called more than once for the
	   same PurchaseId, across servers and across rejoins. Every receipt id is
	   recorded in the profile before the grant is acknowledged, and a receipt
	   already present is acknowledged without granting again.

	2. Losing a purchase. If the profile cannot be written, returning
	   PurchaseGranted tells Roblox the player got their goods when they did
	   not. This service returns NotProcessedYet in that case, so Roblox retries
	   later, including on the player's next join. Nothing is ever acknowledged
	   before it is safely recorded.

	3. Granting to a player who has left. ProcessReceipt fires with a UserId,
	   not a Player. If that player is gone, this returns NotProcessedYet and
	   Roblox re-delivers when they next join. The purchase is never dropped.

	4. Unconfigured products. Every product ships with id = 0. A zero id means
	   the product does not exist yet, so it cannot be prompted, cannot be
	   matched by a receipt, and is shown as Unavailable. Nothing simulates a
	   purchase and no code path grants anything for free.

	GAME PASSES
	-----------
	Passes are entitlements rather than transactions: ownership is queried from
	Roblox, then mirrored into the profile so the rest of the game can read it
	without a web call. The mirror is refreshed on join and after a prompt, and
	the profile copy is only ever additive, so a temporary Roblox API failure
	cannot revoke a pass a player owns.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local Protect = require(Shared.Core.Protect)
local Monetization = require(Shared.Config.Monetization)
local CosmeticRegistry = require(Shared.Registry.CosmeticRegistry)
local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local log = Logger.new("PurchaseService")

local PurchaseService = {}

PurchaseService.Purchased = Signal.new() :: Signal.Signal<Player, string, number>

--------------------------------------------------------------------------
-- Price cache
--------------------------------------------------------------------------

-- GetProductInfo is a web call and is rate limited. Prices are cached, and the
-- cache is what the shop displays, so the panel never blocks on the network.
type PriceEntry = { price: number, name: string, fetchedAt: number, ok: boolean }
local priceCache: { [string]: PriceEntry } = {}
local PRICE_TTL = 600

local function cacheKey(kind: string, id: number): string
	return kind .. ":" .. tostring(id)
end

--- Fetches the live price. Returns nil when the product is unconfigured or
--- the lookup failed; callers must render that as Unavailable, never as free.
function PurchaseService.getPrice(productKey: string): (number?, string?)
	local def = Monetization.get(productKey)
	if not def or def.id <= 0 then
		return nil, nil
	end

	local key = cacheKey(def.kind, def.id)
	local cached = priceCache[key]
	if cached and cached.ok and (os.clock() - cached.fetchedAt) < PRICE_TTL then
		return cached.price, cached.name
	end

	local infoType = if def.kind == "gamepass" then Enum.InfoType.GamePass else Enum.InfoType.Product
	local ok, info = Protect.call(function()
		return MarketplaceService:GetProductInfo(def.id, infoType)
	end)

	if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
		priceCache[key] = {
			price = info.PriceInRobux,
			name = info.Name or def.name,
			fetchedAt = os.clock(),
			ok = true,
		}
		return info.PriceInRobux, info.Name or def.name
	end

	log.warn(string.format("price lookup failed for %s (%s %d): %s", productKey, def.kind, def.id, tostring(info)))
	priceCache[key] = { price = 0, name = def.name, fetchedAt = os.clock(), ok = false }
	return nil, nil
end

--------------------------------------------------------------------------
-- Granting
--------------------------------------------------------------------------

--- Applies a product's `grants` block to a profile. Returns a description of
--- what changed, for the purchase confirmation panel.
local function applyGrants(player: Player, def: Monetization.ProductDef): { [string]: any }
	local summary: { [string]: any } = { credits = 0, cosmetics = {} }
	local grants = def.grants

	if type(grants.credits) == "number" and grants.credits > 0 then
		-- Purchased credits are exact: a multiplier on bought currency would
		-- make the pass a currency amplifier, which is not what it says it is.
		ProgressionService.award(player, {
			credits = grants.credits,
			source = "purchase:" .. def.key,
			exact = true,
		})
		summary.credits = grants.credits
	end

	-- Cosmetics listed on the product, plus anything in the cosmetic registry
	-- that names this product. The registry is the authority, so adding a
	-- cosmetic to a bundle never needs this file to change.
	local cosmeticIds: { [string]: boolean } = {}
	if type(grants.cosmetics) == "table" then
		for _, id in grants.cosmetics do
			cosmeticIds[id] = true
		end
	end
	for _, id in CosmeticRegistry.grantedByProduct(def.key) do
		cosmeticIds[id] = true
	end
	for id in cosmeticIds do
		if ProgressionService.grantUnlock(player, "cosmetic", id) then
			table.insert(summary.cosmetics, id)
		end
	end

	-- Liveries and interiors named by the product key.
	local TrainRegistry = require(Shared.Registry.TrainRegistry)
	for id, livery in TrainRegistry.Liveries do
		if livery.productKey == def.key then
			if ProgressionService.grantUnlock(player, "livery", id) then
				table.insert(summary.cosmetics, id)
			end
		end
	end
	for id, interior in TrainRegistry.Interiors do
		if interior.productKey == def.key then
			if ProgressionService.grantUnlock(player, "interior", id) then
				table.insert(summary.cosmetics, id)
			end
		end
	end

	-- Consumable field effects are handled by the system that offers them
	-- (DownedService for the self revive). This service only records that the
	-- consumable was bought and fires the signal.
	return summary
end

--- Records the purchase on the profile. Returns false when the write could not
--- be made, which is the signal to tell Roblox to retry later.
local function recordPurchase(player: Player, def: Monetization.ProductDef, receiptId: string?, robux: number): boolean
	if not DataService.isWritable(player) then
		return false
	end
	local recorded = false
	DataService.update(player, function(p)
		if receiptId then
			if p.purchases.receipts[receiptId] then
				-- Already recorded on this profile. Not an error: this is the
				-- duplicate path, and it must still report success.
				recorded = true
				return
			end
			p.purchases.receipts[receiptId] = os.time()
		end
		p.purchases.products[def.key] = (p.purchases.products[def.key] or 0) + 1
		p.purchases.robuxSpent += math.max(0, robux)
		recorded = true
	end)
	if not recorded then
		return false
	end
	-- Force an immediate save. Waiting for the autosave window would leave a
	-- gap where a server crash loses a paid purchase.
	return DataService.save(player.UserId, false)
end

--------------------------------------------------------------------------
-- Developer products: ProcessReceipt
--------------------------------------------------------------------------

local function processReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local userId = receiptInfo.PlayerId
	local productId = receiptInfo.ProductId
	local receiptId = tostring(receiptInfo.PurchaseId)
	local robux = receiptInfo.CurrencySpent or 0

	local player = Players:GetPlayerByUserId(userId)
	if not player then
		-- The player left before we could grant. Roblox will call again when
		-- they next join. Acknowledging here would lose the purchase.
		log.info(string.format("receipt %s for absent user %d, deferring", receiptId, userId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profile = DataService.getProfile(player)
	if not profile then
		log.warn(string.format("receipt %s: profile not loaded for %s, deferring", receiptId, player.Name))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Already granted. Acknowledge so Roblox stops re-delivering.
	if profile.purchases.receipts[receiptId] then
		log.info(string.format("receipt %s already granted to %s", receiptId, player.Name))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local def = Monetization.byId("developerproduct", productId)
	if not def then
		-- An unrecognised product id. This happens when a product exists on the
		-- Roblox side but is not in Monetization, which is a configuration
		-- error. Granting nothing and acknowledging would take the player's
		-- Robux for nothing, so this defers and logs loudly for the operator.
		log.error(
			string.format(
				"receipt %s is for product id %d, which is not in Config.Monetization. Add it, then the purchase will be delivered automatically.",
				receiptId,
				productId
			)
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not DataService.isWritable(player) then
		log.warn(string.format("receipt %s: %s has a read-only session, deferring", receiptId, player.Name))
		Net.fireClient("PurchaseResult", player, {
			ok = false,
			error = "SESSION_READ_ONLY",
			productKey = def.key,
			message = "Your purchase is safe and will be delivered when your data loads correctly. Try rejoining.",
		})
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Record first, then grant. If recording fails, nothing has been given and
	-- Roblox retries. If recording succeeds but a grant errors, the grant is
	-- replayed by the reconciliation pass on the next join.
	if not recordPurchase(player, def, receiptId, robux) then
		log.error(string.format("receipt %s: could not persist for %s, deferring", receiptId, player.Name))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local summary = applyGrants(player, def)

	log.info(string.format("granted %s to %s (receipt %s, %d Robux)", def.key, player.Name, receiptId, robux))
	PurchaseService.Purchased:Fire(player, def.key, robux)

	Net.fireClient("PurchaseResult", player, {
		ok = true,
		productKey = def.key,
		productName = def.name,
		summary = summary,
	})

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------

--- Queries Roblox for pass ownership and mirrors it into the profile.
--- Only ever adds. A failed query must never revoke a pass.
function PurchaseService.refreshPasses(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end
	for _, def in Monetization.GamePasses do
		if def.id > 0 then
			local ok, owns = Protect.call(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns == true then
				if (profile.purchases.products[def.key] or 0) <= 0 then
					if recordPurchase(player, def, nil, 0) then
						applyGrants(player, def)
						log.info(string.format("%s owns pass %s; mirrored to profile", player.Name, def.key))
						PurchaseService.Purchased:Fire(player, def.key, 0)
					end
				else
					-- Already mirrored, but re-apply grants so a pass bundle
					-- that gained a new cosmetic in an update reaches players
					-- who bought it before that update shipped.
					applyGrants(player, def)
				end
			elseif not ok then
				log.warn(string.format("pass check failed for %s / %s: %s", player.Name, def.key, tostring(owns)))
			end
		end
	end
end

function PurchaseService.ownsProduct(player: Player, productKey: string): boolean
	local profile = DataService.getProfile(player)
	if not profile then
		return false
	end
	return (profile.purchases.products[productKey] or 0) > 0
end

--------------------------------------------------------------------------
-- Prompting
--------------------------------------------------------------------------

--- Opens the Roblox purchase prompt. Returns false with a reason when the
--- product is unconfigured, already owned, or prompts are currently blocked.
function PurchaseService.prompt(player: Player, productKey: string, blockedReason: string?): (boolean, string?)
	local def = Monetization.get(productKey)
	if not def then
		return false, "UNKNOWN_PRODUCT"
	end
	if def.id <= 0 then
		return false, "NOT_CONFIGURED"
	end
	if blockedReason then
		-- Prompts are suppressed during cinematics, encounters and other
		-- moments listed in Monetization.PromptBlockedStates.
		return false, "BLOCKED:" .. blockedReason
	end
	if def.permanent and PurchaseService.ownsProduct(player, productKey) then
		return false, "ALREADY_OWNED"
	end

	local ok, err = Protect.call(function()
		if def.kind == "gamepass" then
			MarketplaceService:PromptGamePassPurchase(player, def.id)
		else
			MarketplaceService:PromptProductPurchase(player, def.id)
		end
	end)
	if not ok then
		log.warn(string.format("prompt failed for %s: %s", productKey, tostring(err)))
		return false, "PROMPT_FAILED"
	end
	return true, nil
end

--------------------------------------------------------------------------

function PurchaseService.start()
	-- There can be only one ProcessReceipt callback in a place. Assigning it
	-- here, once, is deliberate: a second assignment anywhere would silently
	-- disable this one and start losing purchases.
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local ok, decision = Protect.call(processReceipt, receiptInfo)
		if not ok then
			-- An error in the handler must not acknowledge the purchase.
			log.error("ProcessReceipt raised:", tostring(decision))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return decision
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if wasPurchased then
			-- Re-query rather than trusting the event, so the profile mirror
			-- always reflects what Roblox actually believes.
			task.spawn(PurchaseService.refreshPasses, player)
			local def = Monetization.byId("gamepass", gamePassId)
			if def then
				Net.fireClient("PurchaseResult", player, { ok = true, productKey = def.key, productName = def.name })
			end
		end
	end)

	DataService.ProfileLoaded:Connect(function(player)
		task.spawn(function()
			PurchaseService.refreshPasses(player)
			ProgressionService.pushToClient(player)
		end)
	end)

	local audit = Monetization.audit()
	if audit.configured == 0 then
		log.warn(
			string.format(
				"no products are configured (0 of %d have an ID). The shop will show every item as Unavailable and no purchase can be made. See docs/MONETIZATION.md.",
				audit.total
			)
		)
	else
		log.info(string.format("%d of %d products configured", audit.configured, audit.total))
		if #audit.missing > 0 then
			log.warn("unconfigured products: " .. table.concat(audit.missing, ", "))
		end
	end
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	QuestService
	------------
	Daily quests, weekly quests and chapter milestones.

	Progress is derived from statistics rather than pushed by gameplay systems.
	When a stat changes, every quest watching that stat re-evaluates. This makes
	it impossible for a quest to miss an event, and it means quest progress
	survives a server crash: the stat is in the profile, so the progress is too.

	Daily and weekly sets are chosen from a shared seed, so everyone in a server
	is working on the same objectives and a crew can co-operate on them.

	Claims are explicit. Completing a quest does not auto-grant; the player
	claims it from the notice board or the quest panel. That is both a better
	reward moment and the thing that makes double-granting impossible, because
	the claimed flag is checked and set in one profile update.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local QuestRegistry = require(Shared.Registry.QuestRegistry)
local Monetization = require(Shared.Config.Monetization)
local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local log = Logger.new("QuestService")

local QuestService = {}

--------------------------------------------------------------------------
-- Slot resolution
--------------------------------------------------------------------------

--- Extra daily slots granted by owned products, resolved through the
--- monetization config so an unconfigured product grants nothing.
local function extraDailySlots(player: Player): number
	local profile = DataService.getProfile(player)
	if not profile then
		return 0
	end
	local extra = 0
	for productKey, count in profile.purchases.products do
		if count > 0 then
			local def = Monetization.get(productKey)
			if def and def.id > 0 and type(def.grants.extraDailyQuest) == "number" then
				extra += def.grants.extraDailyQuest
			end
		end
	end
	return extra
end

--- Rolls the daily and weekly sets forward if the period has changed.
--- Progress on the previous period is dropped, but nothing already claimed is
--- ever taken back.
function QuestService.refresh(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end

	local day = QuestRegistry.currentDay()
	local week = QuestRegistry.currentWeek()

	DataService.update(player, function(p)
		if p.quests.dailyDay ~= day then
			p.quests.dailyDay = day
			p.quests.daily = {}
			p.quests.dailyClaimed = {}
			for _, def in QuestRegistry.selectDaily(day, extraDailySlots(player)) do
				p.quests.daily[def.id] = 0
			end
		end
		if p.quests.weeklyWeek ~= week then
			p.quests.weeklyWeek = week
			p.quests.weekly = {}
			p.quests.weeklyClaimed = {}
			for _, def in QuestRegistry.selectWeekly(week) do
				p.quests.weekly[def.id] = 0
			end
		end
	end)

	QuestService.evaluate(player)
end

--------------------------------------------------------------------------
-- Progress
--------------------------------------------------------------------------

--- Recomputes progress for every active quest from the player's statistics.
--- Daily and weekly quests measure progress from a baseline captured when the
--- period rolled over, so a weekly "recover twenty records" counts records
--- recovered this week, not since the account was created.
function QuestService.evaluate(player: Player)
	local profile = DataService.getProfile(player)
	if not profile then
		return
	end

	DataService.update(player, function(p)
		for questId in p.quests.daily do
			local def = QuestRegistry.get(questId)
			if def then
				local baselineKey = "__baseline_daily_" .. def.stat
				local baseline = p.quests.daily[baselineKey]
				if baseline == nil then
					baseline = p.stats[def.stat] or 0
					p.quests.daily[baselineKey] = baseline
				end
				p.quests.daily[questId] = math.max(0, (p.stats[def.stat] or 0) - baseline)
			end
		end
		for questId in p.quests.weekly do
			local def = QuestRegistry.get(questId)
			if def then
				local baselineKey = "__baseline_weekly_" .. def.stat
				local baseline = p.quests.weekly[baselineKey]
				if baseline == nil then
					baseline = p.stats[def.stat] or 0
					p.quests.weekly[baselineKey] = baseline
				end
				p.quests.weekly[questId] = math.max(0, (p.stats[def.stat] or 0) - baseline)
			end
		end
	end)

	QuestService.pushToClient(player)
end

--------------------------------------------------------------------------
-- Claiming
--------------------------------------------------------------------------

local function questState(profile: any, questId: string): (string?, number, boolean)
	if profile.quests.daily[questId] ~= nil then
		return "daily", profile.quests.daily[questId], profile.quests.dailyClaimed[questId] == true
	end
	if profile.quests.weekly[questId] ~= nil then
		return "weekly", profile.quests.weekly[questId], profile.quests.weeklyClaimed[questId] == true
	end
	local def = QuestRegistry.get(questId)
	if def and def.period == "milestone" then
		return "milestone", profile.stats[def.stat] or 0, profile.quests.milestones[questId] == true
	end
	return nil, 0, false
end

function QuestService.claim(player: Player, questId: string): (boolean, string?)
	local profile = DataService.getProfile(player)
	if not profile then
		return false, "NOT_LOADED"
	end
	if not DataService.isWritable(player) then
		return false, "READ_ONLY"
	end

	local def = QuestRegistry.get(questId)
	if not def then
		return false, "UNKNOWN_QUEST"
	end

	local period, progress, alreadyClaimed = questState(profile, questId)
	if not period then
		return false, "NOT_ACTIVE"
	end
	if alreadyClaimed then
		return false, "ALREADY_CLAIMED"
	end
	if progress < def.target then
		return false, "INCOMPLETE"
	end

	-- Mark claimed inside the same update that reads the flag. Two rapid
	-- claims cannot both pass, because the second sees the flag already set.
	local granted = false
	DataService.update(player, function(p)
		local _, _, claimedNow = questState(p, questId)
		if claimedNow then
			return
		end
		if period == "daily" then
			p.quests.dailyClaimed[questId] = true
		elseif period == "weekly" then
			p.quests.weeklyClaimed[questId] = true
		else
			p.quests.milestones[questId] = true
		end
		granted = true
	end)

	if not granted then
		return false, "ALREADY_CLAIMED"
	end

	local unlocks = {}
	if def.reward then
		table.insert(unlocks, { kind = def.reward.kind, id = def.reward.id })
	end

	-- Quest rewards are exact. A multiplier on a fixed daily reward would make
	-- the paid pass feel mandatory for dailies, which is not the intent.
	ProgressionService.award(player, {
		credits = def.credits,
		xp = def.xp,
		unlocks = unlocks,
		source = "quest:" .. questId,
		exact = true,
	})

	log.info(string.format("%s claimed quest %s", player.Name, questId))
	QuestService.pushToClient(player)
	return true, nil
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

local function describe(player: Player): { [string]: any }
	local profile = DataService.getProfile(player)
	if not profile then
		return { daily = {}, weekly = {}, milestones = {} }
	end

	local function pack(period: string, progressTable: { [string]: number }, claimedTable: { [string]: boolean })
		local out = {}
		for questId, progress in progressTable do
			-- Baseline bookkeeping keys are internal and never shown.
			if string.sub(questId, 1, 2) ~= "__" then
				local def = QuestRegistry.get(questId)
				if def then
					table.insert(out, {
						id = def.id,
						name = def.name,
						description = def.description,
						progress = math.min(progress, def.target),
						target = def.target,
						credits = def.credits,
						xp = def.xp,
						reward = def.reward,
						claimed = claimedTable[questId] == true,
						cooperative = def.cooperative == true,
						tier = def.tier,
						period = period,
					})
				end
			end
		end
		table.sort(out, function(a, b)
			return a.id < b.id
		end)
		return out
	end

	local milestones = {}
	for _, def in QuestRegistry.Milestones do
		local progress = profile.stats[def.stat] or 0
		table.insert(milestones, {
			id = def.id,
			name = def.name,
			description = def.description,
			progress = math.min(progress, def.target),
			target = def.target,
			credits = def.credits,
			xp = def.xp,
			reward = def.reward,
			claimed = profile.quests.milestones[def.id] == true,
			period = "milestone",
			tier = def.tier,
		})
	end

	return {
		daily = pack("daily", profile.quests.daily, profile.quests.dailyClaimed),
		weekly = pack("weekly", profile.quests.weekly, profile.quests.weeklyClaimed),
		milestones = milestones,
		dailyResetIn = QuestRegistry.secondsUntilDailyReset(),
		weeklyResetIn = QuestRegistry.secondsUntilWeeklyReset(),
	}
end

function QuestService.pushToClient(player: Player)
	Net.fireClient("QuestState", player, describe(player))
end

--------------------------------------------------------------------------

function QuestService.start()
	-- Cross-check that every quest watches a statistic that actually exists.
	-- A quest pointing at a stat nothing writes can never be completed, and
	-- shipping one of those is a silent trap for players.
	do
		local template = require(script.Parent.ProfileSchema).template()
		local missing: { string } = {}
		for _, stat in QuestRegistry.requiredStats() do
			if template.stats[stat] == nil then
				table.insert(missing, stat)
			end
		end
		if #missing > 0 then
			log.error("quests reference stats that are not in the profile schema: " .. table.concat(missing, ", "))
		end
	end

	DataService.ProfileLoaded:Connect(function(player)
		QuestService.refresh(player)
	end)

	ProgressionService.StatChanged:Connect(function(player)
		QuestService.evaluate(player)
	end)

	-- This service owns the RewardCommand remote. RewardService's commands are
	-- dispatched from here rather than by binding the remote twice, because a
	-- second OnServerInvoke binding silently replaces the first.
	local RewardService = require(script.Parent.RewardService)

	Net.onServerInvoke("RewardCommand", function(player, rawCommand, rawArg)
		local allowed = { "claim_quest", "refresh_quests" }
		for _, name in RewardService.Commands do
			table.insert(allowed, name)
		end

		local command = Guard.enum(rawCommand, allowed)
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end

		if command == "refresh_quests" then
			QuestService.refresh(player)
			return { ok = true }
		end

		if command == "claim_quest" then
			local questId = Guard.id(rawArg)
			if not questId then
				return { ok = false, error = "BAD_QUEST" }
			end
			local ok, err = QuestService.claim(player, questId)
			return { ok = ok, error = err }
		end

		local handled = RewardService.handleCommand(player, command)
		if handled then
			return handled
		end
		return { ok = false, error = "BAD_COMMAND" }
	end)

	-- Roll periods over for players who stay online across a reset.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in game:GetService("Players"):GetPlayers() do
				local profile = DataService.getProfile(player)
				if profile then
					if profile.quests.dailyDay ~= QuestRegistry.currentDay() or profile.quests.weeklyWeek ~= QuestRegistry.currentWeek() then
						QuestService.refresh(player)
					end
				end
			end
		end
	end)

	log.info("started")
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RewardService
	-------------
	Daily login rewards, login streaks and playtime rewards.

	Two design decisions here are deliberate and worth stating plainly:

	  1. Missing a day steps the streak back by one, it does not reset it.
	     A seven-day streak broken on day four becomes a three-day streak.
	     Nothing is ever taken away, and there is no product sold anywhere in
	     this project that protects or restores a streak.

	  2. Playtime rewards are capped per day. A reward that keeps paying out
	     forever turns into an incentive to idle in the lobby, which is the
	     opposite of what a session-based co-op game wants.

	Every claim writes a claimed-marker in the same profile update that reads
	it, so a double click, a reconnect or two servers cannot double-grant.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local QuestRegistry = require(Shared.Registry.QuestRegistry)
local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local log = Logger.new("RewardService")

local RewardService = {}

--------------------------------------------------------------------------
-- Login rewards
--------------------------------------------------------------------------

--- The reward for a given streak position, wrapping once the table runs out
--- so a long streak keeps paying the top value rather than falling to zero.
local function loginRewardFor(streak: number): number
	local table_ = Balance.Economy.dailyLoginCredits
	local index = math.clamp(streak, 1, #table_)
	return table_[index]
end

--- Where the player's streak stands today, without changing anything.
function RewardService.loginState(player: Player): { available: boolean, streak: number, nextStreak: number, credits: number, claimedToday: boolean, resetIn: number }
	local profile = DataService.getProfile(player)
	local today = QuestRegistry.currentDay()
	if not profile then
		return { available = false, streak = 0, nextStreak = 1, credits = 0, claimedToday = false, resetIn = 0 }
	end

	local claimedToday = profile.login.lastClaimDay == today
	local gap = today - profile.login.lastClaimDay
	local nextStreak: number
	if profile.login.lastClaimDay == 0 then
		nextStreak = 1
	elseif gap <= 1 then
		nextStreak = profile.login.streak + (if claimedToday then 0 else 1)
	else
		-- Step back one for each missed day beyond the grace, floored at 1.
		local penalty = math.max(0, gap - 1 - Balance.Economy.streakGraceDays)
		nextStreak = math.max(1, profile.login.streak - penalty + 1)
	end

	return {
		available = not claimedToday,
		streak = profile.login.streak,
		nextStreak = nextStreak,
		credits = loginRewardFor(nextStreak),
		claimedToday = claimedToday,
		resetIn = QuestRegistry.secondsUntilDailyReset(),
	}
end

function RewardService.claimLogin(player: Player): (boolean, string?, number?)
	local profile = DataService.getProfile(player)
	if not profile then
		return false, "NOT_LOADED", nil
	end
	if not DataService.isWritable(player) then
		return false, "READ_ONLY", nil
	end

	local today = QuestRegistry.currentDay()
	if profile.login.lastClaimDay == today then
		return false, "ALREADY_CLAIMED", nil
	end

	local state = RewardService.loginState(player)
	local granted = false
	local awardedStreak = state.nextStreak

	DataService.update(player, function(p)
		-- Re-check inside the update: this is the line that makes the claim
		-- safe against a double click or a racing second call.
		if p.login.lastClaimDay == today then
			return
		end
		p.login.lastClaimDay = today
		p.login.streak = awardedStreak
		p.login.bestStreak = math.max(p.login.bestStreak, awardedStreak)
		granted = true
	end)

	if not granted then
		return false, "ALREADY_CLAIMED", nil
	end

	local credits = loginRewardFor(awardedStreak)
	ProgressionService.award(player, {
		credits = credits,
		xp = 0,
		source = "daily_login",
		exact = true,
	})

	log.info(string.format("%s claimed daily login, streak %d", player.Name, awardedStreak))
	RewardService.pushToClient(player)
	return true, nil, credits
end

--------------------------------------------------------------------------
-- Playtime rewards
--------------------------------------------------------------------------

local sessionSeconds: { [number]: number } = {}

function RewardService.playtimeState(player: Player): { secondsToday: number, claimed: number, maximum: number, nextAt: number, available: boolean }
	local profile = DataService.getProfile(player)
	if not profile then
		return { secondsToday = 0, claimed = 0, maximum = 0, nextAt = 0, available = false }
	end
	local interval = Balance.Economy.playtimeRewardIntervalSeconds
	local maximum = Balance.Economy.maxPlaytimeRewardsPerDay
	local earned = math.floor(profile.playtime.secondsToday / interval)
	local claimed = profile.playtime.rewardsClaimedToday
	return {
		secondsToday = profile.playtime.secondsToday,
		claimed = claimed,
		maximum = maximum,
		nextAt = (claimed + 1) * interval,
		available = claimed < maximum and earned > claimed,
	}
end

function RewardService.claimPlaytime(player: Player): (boolean, string?, number?)
	local profile = DataService.getProfile(player)
	if not profile then
		return false, "NOT_LOADED", nil
	end
	if not DataService.isWritable(player) then
		return false, "READ_ONLY", nil
	end

	local state = RewardService.playtimeState(player)
	if not state.available then
		return false, if state.claimed >= state.maximum then "DAILY_CAP" else "NOT_READY", nil
	end

	local granted = false
	DataService.update(player, function(p)
		local interval = Balance.Economy.playtimeRewardIntervalSeconds
		local earned = math.floor(p.playtime.secondsToday / interval)
		if p.playtime.rewardsClaimedToday >= Balance.Economy.maxPlaytimeRewardsPerDay then
			return
		end
		if earned <= p.playtime.rewardsClaimedToday then
			return
		end
		p.playtime.rewardsClaimedToday += 1
		granted = true
	end)

	if not granted then
		return false, "NOT_READY", nil
	end

	local credits = Balance.Economy.playtimeRewardCredits
	ProgressionService.award(player, { credits = credits, xp = 0, source = "playtime", exact = true })
	RewardService.pushToClient(player)
	return true, nil, credits
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

function RewardService.pushToClient(player: Player)
	Net.fireClient("Notify", player, {
		kind = "rewards_state",
		login = RewardService.loginState(player),
		playtime = RewardService.playtimeState(player),
		silent = true,
	})
end

--------------------------------------------------------------------------

function RewardService.start()
	DataService.ProfileLoaded:Connect(function(player)
		sessionSeconds[player.UserId] = 0
		local today = QuestRegistry.currentDay()
		DataService.update(player, function(p)
			if p.playtime.day ~= today then
				p.playtime.day = today
				p.playtime.secondsToday = 0
				p.playtime.rewardsClaimedToday = 0
			end
		end)
		-- A short delay so the login panel does not fight the loading screen
		-- for the player's attention.
		task.delay(3, function()
			if player.Parent then
				RewardService.pushToClient(player)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessionSeconds[player.UserId] = nil
	end)

	-- Playtime accrual. Counted in whole minutes so the write rate stays low.
	task.spawn(function()
		while true do
			task.wait(60)
			local today = QuestRegistry.currentDay()
			for _, player in Players:GetPlayers() do
				local profile = DataService.getProfile(player)
				if profile then
					DataService.update(player, function(p)
						if p.playtime.day ~= today then
							p.playtime.day = today
							p.playtime.secondsToday = 0
							p.playtime.rewardsClaimedToday = 0
						end
						p.playtime.secondsToday += 60
						p.stats.playtime_seconds = (p.stats.playtime_seconds or 0) + 60
					end)
					sessionSeconds[player.UserId] = (sessionSeconds[player.UserId] or 0) + 60
					local state = RewardService.playtimeState(player)
					if state.available then
						Net.fireClient("Notify", player, {
							kind = "reward_ready",
							title = "Playtime reward ready",
							body = "Collect it from the notice board or the rewards panel.",
							duration = 6,
						})
					end
					RewardService.pushToClient(player)
				end
			end
		end
	end)

	-- Reward claims share the single RewardCommand remote with quests.
	-- QuestService owns that remote's handler and dispatches unknown commands
	-- here, so neither service can overwrite the other's binding. A remote can
	-- only have one OnServerInvoke, and silently replacing one is a bug that
	-- looks like a rate limit.

	log.info("started")
end

--- Command handlers surfaced to QuestService's dispatcher, so both services
--- can share the single RewardCommand remote without one clobbering the other.
function RewardService.handleCommand(player: Player, command: string): { [string]: any }?
	if command == "claim_login" then
		local ok, err, credits = RewardService.claimLogin(player)
		return { ok = ok, error = err, credits = credits }
	elseif command == "claim_playtime" then
		local ok, err, credits = RewardService.claimPlaytime(player)
		return { ok = ok, error = err, credits = credits }
	elseif command == "reward_state" then
		return {
			ok = true,
			login = RewardService.loginState(player),
			playtime = RewardService.playtimeState(player),
		}
	end
	return nil
end

RewardService.Commands = { "claim_login", "claim_playtime", "reward_state" }

--- Used by QuestService when validating an incoming command name.
function RewardService.ownsCommand(command: string): boolean
	return table.find(RewardService.Commands, command) ~= nil
end

--- Kept so the Guard enum in QuestService stays in one place.
RewardService.GuardHelper = Guard

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ShopService
	-----------
	Assembles the shop catalogue and handles both currencies.

	What the client is sent is a fully-resolved list: live Robux price, owned
	state, eligibility, and whether the item is purchasable at all. The client
	renders that and nothing else, so the panel can never offer something the
	server would refuse, and an unconfigured product can never be presented as
	buyable.

	Prompt gating lives here. The shop refuses to open a Robux prompt while the
	player is in any of the states listed in Monetization.PromptBlockedStates:
	a cinematic, an encounter, a critical rescue, the expedition climax, or
	loading. Selling into a frightening moment is the kind of thing that makes
	players distrust a game, and it is cheap to prevent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Signal = require(Shared.Core.Signal)
local Monetization = require(Shared.Config.Monetization)
local CosmeticRegistry = require(Shared.Registry.CosmeticRegistry)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local WeaponRegistry = require(Shared.Registry.WeaponRegistry)
local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)
local PurchaseService = require(script.Parent.PurchaseService)

local log = Logger.new("ShopService")

local ShopService = {}

ShopService.PromptBlocked = Signal.new() :: Signal.Signal<Player, string>

-- Set by ExpeditionService and the cinematic controller. A player in a blocked
-- state cannot be shown a Robux prompt.
local blockedStates: { [number]: string } = {}

function ShopService.setBlockedState(player: Player, reason: string?)
	if reason and table.find(Monetization.PromptBlockedStates, reason) then
		blockedStates[player.UserId] = reason
	else
		blockedStates[player.UserId] = nil
	end
end

function ShopService.blockedReason(player: Player): string?
	return blockedStates[player.UserId]
end

--------------------------------------------------------------------------
-- Catalogue assembly
--------------------------------------------------------------------------

type Entry = {
	key: string,
	name: string,
	blurb: string,
	category: string,
	currency: string, -- "robux" | "credits"
	price: number?, -- live Robux price, or credit cost
	priceText: string?,
	owned: boolean,
	purchasable: boolean,
	unavailableReason: string?,
	permanent: boolean,
	order: number,
	preview: { [string]: any }?,
}

local function robuxEntries(player: Player): { Entry }
	local out: { Entry } = {}
	for _, def in Monetization.All do
		local owned = def.permanent and PurchaseService.ownsProduct(player, def.key)
		local price, liveName = PurchaseService.getPrice(def.key)

		local purchasable = true
		local reason: string? = nil
		if def.id <= 0 then
			purchasable = false
			reason = "This item is not available yet."
		elseif not price then
			purchasable = false
			reason = "Price unavailable. Try again in a moment."
		elseif owned then
			purchasable = false
			reason = "Owned"
		end

		table.insert(out, {
			key = def.key,
			-- The live Roblox name wins when available, so what the player sees
			-- in the shop matches what the purchase prompt will say.
			name = liveName or def.name,
			blurb = def.blurb,
			category = def.category,
			currency = "robux",
			price = price,
			owned = owned,
			purchasable = purchasable,
			unavailableReason = reason,
			permanent = def.permanent,
			order = def.order,
			preview = def.grants,
		})
	end
	return out
end

local function creditEntries(player: Player): { Entry }
	local out: { Entry } = {}
	local profile = DataService.getProfile(player)
	if not profile then
		return out
	end

	local function add(key: string, name: string, blurb: string, cost: number, owned: boolean, unlockLevel: number?, preview: { [string]: any }?)
		local purchasable = not owned
		local reason: string? = if owned then "Owned" else nil
		if not owned and unlockLevel and profile.level < unlockLevel then
			purchasable = false
			reason = string.format("Unlocks at level %d", unlockLevel)
		elseif not owned and profile.credits < cost then
			purchasable = false
			reason = "Not enough credits"
		end
		table.insert(out, {
			key = key,
			name = name,
			blurb = blurb,
			category = "exchange",
			currency = "credits",
			price = cost,
			owned = owned,
			purchasable = purchasable,
			unavailableReason = reason,
			permanent = true,
			order = cost,
			preview = preview,
		})
	end

	for _, def in CosmeticRegistry.creditPurchasable() do
		add("cosmetic:" .. def.id, def.name, def.description, def.creditCost or 0, profile.cosmetics[def.id] == true, nil, { slot = def.slot })
	end
	for _, def in TrainRegistry.allLiveries() do
		if def.source == "credits" and (def.creditCost or 0) > 0 then
			add("livery:" .. def.id, def.name, def.description, def.creditCost or 0, profile.liveries[def.id] == true, nil, { body = def.body, trim = def.trim })
		end
	end
	for _, def in TrainRegistry.allInteriors() do
		if def.source == "credits" and (def.creditCost or 0) > 0 then
			add("interior:" .. def.id, def.name, def.description, def.creditCost or 0, profile.interiors[def.id] == true)
		end
	end
	for _, def in TrainRegistry.allTrains() do
		if def.creditCost > 0 then
			add(
				"train:" .. def.id,
				def.name,
				def.tagline .. " " .. def.description,
				def.creditCost,
				profile.trains[def.id] == true,
				def.unlockLevel,
				{ class = def.class, handling = def.handling }
			)
		end
	end
	for _, def in WeaponRegistry.all() do
		if def.creditCost > 0 then
			add(
				"weapon:" .. def.id,
				def.name,
				def.description,
				def.creditCost,
				profile.weapons[def.id] == true,
				def.unlockLevel,
				{ kind = def.kind, damage = def.damage, range = def.range }
			)
		end
	end

	return out
end

function ShopService.catalogue(player: Player): { [string]: any }
	local entries: { Entry } = {}
	for _, entry in robuxEntries(player) do
		table.insert(entries, entry)
	end
	for _, entry in creditEntries(player) do
		table.insert(entries, entry)
	end
	table.sort(entries, function(a, b)
		if a.category ~= b.category then
			return a.category < b.category
		end
		return a.order < b.order
	end)

	local profile = DataService.getProfile(player)
	return {
		categories = Monetization.Categories,
		entries = entries,
		credits = if profile then profile.credits else 0,
		promptBlocked = ShopService.blockedReason(player),
		-- Told plainly rather than hidden, so an operator testing the shop can
		-- see immediately why nothing is buyable.
		anyRobuxConfigured = Monetization.audit().configured > 0,
	}
end

function ShopService.pushToClient(player: Player)
	Net.fireClient("ShopState", player, ShopService.catalogue(player))
end

--------------------------------------------------------------------------
-- Credit purchases
--------------------------------------------------------------------------

local function buyWithCredits(player: Player, entryKey: string): (boolean, string?)
	local kind, id = string.match(entryKey, "^(%a+):(.+)$")
	if not kind or not id then
		return false, "BAD_ENTRY"
	end

	local profile = DataService.getProfile(player)
	if not profile then
		return false, "NOT_LOADED"
	end
	if not DataService.isWritable(player) then
		return false, "READ_ONLY"
	end

	local cost: number? = nil
	local unlockLevel = 0

	if kind == "cosmetic" then
		local def = CosmeticRegistry.get(id)
		if not def or def.source ~= "credits" then
			return false, "NOT_FOR_SALE"
		end
		cost = def.creditCost
	elseif kind == "livery" then
		local def = TrainRegistry.Liveries[id]
		if not def or def.source ~= "credits" then
			return false, "NOT_FOR_SALE"
		end
		cost = def.creditCost
	elseif kind == "interior" then
		local def = TrainRegistry.Interiors[id]
		if not def or def.source ~= "credits" then
			return false, "NOT_FOR_SALE"
		end
		cost = def.creditCost
	elseif kind == "train" then
		local def = TrainRegistry.get(id)
		if not def or def.creditCost <= 0 then
			return false, "NOT_FOR_SALE"
		end
		cost = def.creditCost
		unlockLevel = def.unlockLevel
	elseif kind == "weapon" then
		local def = WeaponRegistry.get(id)
		if not def or def.creditCost <= 0 then
			return false, "NOT_FOR_SALE"
		end
		cost = def.creditCost
		unlockLevel = def.unlockLevel
	else
		return false, "BAD_ENTRY"
	end

	if not cost or cost <= 0 then
		return false, "NOT_FOR_SALE"
	end
	if ProgressionService.owns(player, kind, id) then
		return false, "ALREADY_OWNED"
	end
	if profile.level < unlockLevel then
		return false, "LEVEL_LOCKED"
	end

	-- Spend before granting. If the grant somehow fails, the refund below
	-- restores the credits rather than leaving the player short.
	if not ProgressionService.spendCredits(player, cost, entryKey) then
		return false, "INSUFFICIENT_CREDITS"
	end
	if not ProgressionService.grantUnlock(player, kind, id) then
		ProgressionService.award(player, { credits = cost, source = "refund:" .. entryKey, exact = true })
		return false, "GRANT_FAILED"
	end

	log.info(string.format("%s bought %s for %d credits", player.Name, entryKey, cost))
	ShopService.pushToClient(player)
	ProgressionService.pushToClient(player)
	return true, nil
end

--------------------------------------------------------------------------

function ShopService.start()
	Net.onServerInvoke("ShopCommand", function(player, rawCommand, rawArg)
		local command = Guard.enum(rawCommand, { "catalogue", "buy_credits", "prompt_robux" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end

		if command == "catalogue" then
			return { ok = true, catalogue = ShopService.catalogue(player) }
		end

		if command == "buy_credits" then
			local entryKey = Guard.string(rawArg, 96)
			if not entryKey then
				return { ok = false, error = "BAD_ENTRY" }
			end
			local ok, err = buyWithCredits(player, entryKey)
			return { ok = ok, error = err, catalogue = ShopService.catalogue(player) }
		end

		-- prompt_robux
		local productKey = Guard.id(rawArg)
		if not productKey then
			return { ok = false, error = "BAD_PRODUCT" }
		end
		local blocked = ShopService.blockedReason(player)
		if blocked then
			ShopService.PromptBlocked:Fire(player, blocked)
			return { ok = false, error = "BLOCKED", blockedBy = blocked }
		end
		local ok, err = PurchaseService.prompt(player, productKey, nil)
		return { ok = ok, error = err }
	end)

	DataService.ProfileLoaded:Connect(function(player)
		task.delay(2, function()
			if player.Parent then
				ShopService.pushToClient(player)
			end
		end)
	end)

	PurchaseService.Purchased:Connect(function(player)
		ShopService.pushToClient(player)
	end)

	ProgressionService.Awarded:Connect(function(player)
		ShopService.pushToClient(player)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		blockedStates[player.UserId] = nil
	end)

	log.info("started")
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">SurvivalService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SurvivalService
	---------------
	Player condition: health, stamina, flashlight charge, the downed state,
	revival and spectating.

	WHY THESE ARE ONE SERVICE
	-------------------------
	They are one state machine. A player is alive, downed, or dead-and-
	spectating, and stamina, light and health all behave differently in each.
	Splitting them across files produced exactly the bug this design avoids:
	stamina draining while downed, or a flashlight running on a corpse.

	THE DOWNED STATE
	----------------
	Going down is not death. A downed player crawls, keeps their inventory,
	keeps talking, and bleeds out over a window long enough to cross a station.
	Any teammate can revive them by holding position beside them. That is always
	available and always free.

	There is also a paid self-revive. It is a Developer Product, it is only ever
	offered while you are actually down, it is never offered while a teammate is
	already reviving you, and it is not offered at all when the product has no
	configured ID. If the purchase completes after the player has already been
	revived or the run has ended, the entitlement is banked rather than lost.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Monetization = require(Shared.Config.Monetization)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local DataService = require(script.Parent.DataService)
local ExpeditionService = require(script.Parent.ExpeditionService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressionService = require(script.Parent.ProgressionService)
local PurchaseService = require(script.Parent.PurchaseService)
local WorldService = require(script.Parent.WorldService)

local log = Logger.new("SurvivalService")

local SurvivalService = {}

export type Vitals = {
	userId: number,
	health: number,
	maxHealth: number,
	stamina: number,
	maxStamina: number,
	flashlight: number,
	flashlightOn: boolean,
	sprinting: boolean,
	bleeding: boolean,
	exhausted: boolean,

	state: string, -- "alive" | "downed" | "dead"
	downedAt: number?,
	bleedoutSeconds: number,
	downCount: number,
	-- Who is currently reviving, and since when.
	reviverUserId: number?,
	reviveStartedAt: number?,
	-- Banked self-revive entitlements bought but not yet spent.
	bankedSelfRevives: number,

	lastDamageAt: number,
	lastStaminaUseAt: number,
	immuneUntil: number,
	spectatingUserId: number?,
	lastSpectateSwitch: number,
}

local vitals: { [number]: Vitals } = {}

SurvivalService.Downed = Signal.new() :: Signal.Signal<Player>
SurvivalService.Revived = Signal.new() :: Signal.Signal<Player, Player?>
SurvivalService.Died = Signal.new() :: Signal.Signal<Player>
SurvivalService.Damaged = Signal.new() :: Signal.Signal<Player, number, string>

--------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------

local function fresh(player: Player): Vitals
	return {
		userId = player.UserId,
		health = Balance.Player.maxHealth,
		maxHealth = Balance.Player.maxHealth,
		stamina = Balance.Player.maxStamina,
		maxStamina = Balance.Player.maxStamina,
		flashlight = Balance.Flashlight.maxCharge,
		flashlightOn = true,
		sprinting = false,
		bleeding = false,
		exhausted = false,
		state = "alive",
		downedAt = nil,
		bleedoutSeconds = Balance.Downed.bleedoutSeconds,
		downCount = 0,
		reviverUserId = nil,
		reviveStartedAt = nil,
		bankedSelfRevives = 0,
		lastDamageAt = 0,
		lastStaminaUseAt = 0,
		immuneUntil = os.clock() + Balance.Threat.respawnImmunitySeconds,
		spectatingUserId = nil,
		lastSpectateSwitch = 0,
	}
end

function SurvivalService.begin(player: Player)
	local existing = vitals[player.UserId]
	local banked = if existing then existing.bankedSelfRevives else 0
	local state = fresh(player)
	state.bankedSelfRevives = banked
	vitals[player.UserId] = state
	SurvivalService.push(player)
end

function SurvivalService.get(player: Player): Vitals?
	return vitals[player.UserId]
end

function SurvivalService.clear(player: Player)
	vitals[player.UserId] = nil
end

--- Grants temporary damage immunity. Used after respawn, after boarding and
--- during any scripted sequence, which is how "no unavoidable deaths" holds.
function SurvivalService.grantImmunity(player: Player, seconds: number)
	local state = vitals[player.UserId]
	if state then
		state.immuneUntil = math.max(state.immuneUntil, os.clock() + seconds)
	end
end

--------------------------------------------------------------------------
-- Damage
--------------------------------------------------------------------------

function SurvivalService.damage(player: Player, amount: number, source: string): boolean
	local state = vitals[player.UserId]
	if not state or state.state ~= "alive" then
		return false
	end
	if os.clock() < state.immuneUntil then
		return false
	end
	if amount <= 0 then
		return false
	end

	local expedition = ExpeditionService.forPlayer(player)
	local difficulty = GameConfig.getDifficulty(if expedition then expedition.difficulty else nil)
	local applied = amount * difficulty.damageTaken

	state.health = math.max(0, state.health - applied)
	state.lastDamageAt = os.clock()
	if applied >= 12 then
		state.bleeding = true
	end

	-- The Humanoid mirrors our health so death, ragdoll and the default health
	-- bar all behave, but this service remains the authority.
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		humanoid.Health = math.max(1, state.health)
	end

	SurvivalService.Damaged:Fire(player, applied, source)

	if state.health <= 0 then
		SurvivalService.down(player, source)
	end
	SurvivalService.push(player)
	return true
end

function SurvivalService.heal(player: Player, amount: number, stopBleed: boolean?)
	local state = vitals[player.UserId]
	if not state or state.state == "dead" then
		return
	end
	state.health = math.clamp(state.health + amount, 0, state.maxHealth)
	if stopBleed then
		state.bleeding = false
	end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		humanoid.Health = math.max(1, state.health)
	end
	SurvivalService.push(player)
end

--------------------------------------------------------------------------
-- Downed
--------------------------------------------------------------------------

function SurvivalService.down(player: Player, source: string)
	local state = vitals[player.UserId]
	if not state or state.state ~= "alive" then
		return
	end

	state.state = "downed"
	state.downedAt = os.clock()
	state.downCount += 1
	state.health = 0
	state.sprinting = false
	state.reviverUserId = nil
	state.reviveStartedAt = nil

	-- Each subsequent down shortens the next bleedout, so a crew that keeps
	-- going down is under real pressure without any single down being fatal.
	state.bleedoutSeconds = math.max(
		Balance.Downed.minBleedoutSeconds,
		Balance.Downed.bleedoutSeconds * (Balance.Downed.bleedoutDecayPerDown ^ (state.downCount - 1))
	)

	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		humanoid.WalkSpeed = Balance.Downed.crawlSpeed
		humanoid.JumpPower = 0
		humanoid.Health = 1
	end

	local expedition = ExpeditionService.forPlayer(player)
	if expedition then
		expedition.downs += 1
		ExpeditionService.fireRadio(expedition, "crew_downed")
		Net.fireClients("Notify", ExpeditionService.playersOf(expedition), {
			kind = "warning",
			title = player.DisplayName .. " is down",
			body = "Get to them before they bleed out.",
			duration = 8,
		})
	end

	ProgressionService.addStat(player, "times_downed", 1)
	SurvivalService.Downed:Fire(player)
	SurvivalService.push(player)
	log.info(string.format("%s downed by %s", player.Name, source))
end

function SurvivalService.revive(player: Player, by: Player?, healthFraction: number?)
	local state = vitals[player.UserId]
	if not state or state.state ~= "downed" then
		return
	end

	state.state = "alive"
	state.downedAt = nil
	state.reviverUserId = nil
	state.reviveStartedAt = nil
	state.health = state.maxHealth * (healthFraction or Balance.Downed.reviveHealthFraction)
	state.bleeding = false
	state.stamina = state.maxStamina * 0.4
	-- A brief immunity so a revive inside a fight is not instantly undone.
	state.immuneUntil = os.clock() + 3

	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		humanoid.WalkSpeed = Balance.Player.walkSpeed
		humanoid.JumpPower = Balance.Player.jumpPower
		humanoid.Health = state.health
	end

	local expedition = ExpeditionService.forPlayer(player)
	if expedition and by then
		expedition.revives += 1
		ProgressionService.award(by, {
			credits = Balance.Economy.creditsPerRescue,
			xp = Balance.Economy.xpPerRescue,
			stats = { revives_given = 1 },
			source = "revive",
		}, expedition.crewSize)
		ProgressionService.addStat(player, "revives_received", 1)
	end

	SurvivalService.Revived:Fire(player, by)
	SurvivalService.push(player)
end

function SurvivalService.die(player: Player)
	local state = vitals[player.UserId]
	if not state or state.state == "dead" then
		return
	end
	state.state = "dead"
	state.health = 0

	-- Half the inventory is dropped at the body, recoverable by the crew.
	local expedition = ExpeditionService.forPlayer(player)
	if expedition then
		local inventory = InventoryService.get(player)
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if inventory and root and root:IsA("BasePart") then
			local dropPoint = root.CFrame
			for _, stack in table.clone(inventory.stacks) do
				local dropQuantity = math.floor(stack.quantity * Balance.Downed.dropFractionOnDeath + 0.5)
				if dropQuantity > 0 then
					InventoryService.remove(player, stack.id, dropQuantity)
					WorldService.buildDroppedItem(
						stack.id,
						dropQuantity,
						dropPoint * CFrame.new(math.random(-3, 3), 1, math.random(-3, 3)),
						expedition.lane.dropContainer
					)
				end
			end
		end
	end

	ProgressionService.addStat(player, "deaths", 1)
	SurvivalService.Died:Fire(player)
	SurvivalService.push(player)

	-- Straight into spectator rather than a black screen.
	SurvivalService.startSpectating(player)

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		end
		task.delay(GameConfig.CorpseCleanupSeconds, function()
			if character.Parent then
				character:Destroy()
			end
		end)
	end
end

--------------------------------------------------------------------------
-- Reviving
--------------------------------------------------------------------------

local function reviveDuration(expedition: ExpeditionService.Expedition?): number
	local difficulty = GameConfig.getDifficulty(if expedition then expedition.difficulty else nil)
	return difficulty.reviveSeconds
end

local function beginRevive(reviver: Player, target: Player): (boolean, string?)
	local targetState = vitals[target.UserId]
	if not targetState or targetState.state ~= "downed" then
		return false, "NOT_DOWNED"
	end
	local reviverState = vitals[reviver.UserId]
	if not reviverState or reviverState.state ~= "alive" then
		return false, "NOT_ALIVE"
	end
	local reviverRoot = Guard.aliveRoot(reviver)
	local targetCharacter = target.Character
	local targetRoot = if targetCharacter then targetCharacter:FindFirstChild("HumanoidRootPart") else nil
	if not reviverRoot or not targetRoot or not targetRoot:IsA("BasePart") then
		return false, "NO_TARGET"
	end
	if not Guard.withinDistance(reviverRoot.Position, targetRoot.Position, 10) then
		return false, "TOO_FAR"
	end
	if targetState.reviverUserId and targetState.reviverUserId ~= reviver.UserId then
		return false, "ALREADY_BEING_REVIVED"
	end

	targetState.reviverUserId = reviver.UserId
	targetState.reviveStartedAt = os.clock()
	SurvivalService.push(target)
	SurvivalService.push(reviver)
	return true, nil
end

local function cancelRevive(target: Player)
	local state = vitals[target.UserId]
	if state then
		state.reviverUserId = nil
		state.reviveStartedAt = nil
		SurvivalService.push(target)
	end
end

--------------------------------------------------------------------------
-- Self revive
--------------------------------------------------------------------------

--- Whether the paid self-revive may be offered right now. Every one of these
--- conditions has to hold; the offer is deliberately narrow.
function SurvivalService.selfReviveOffered(player: Player): (boolean, string?)
	local state = vitals[player.UserId]
	if not state or state.state ~= "downed" then
		return false, "NOT_DOWNED"
	end
	if state.reviverUserId then
		-- A teammate is already on the way. Selling into that moment would be
		-- selling relief from a problem that is already being solved.
		return false, "BEING_REVIVED"
	end
	if state.bankedSelfRevives > 0 then
		return true, "BANKED"
	end
	if not Monetization.isConfigured("field_revive") then
		return false, "NOT_CONFIGURED"
	end
	return true, nil
end

function SurvivalService.useSelfRevive(player: Player): (boolean, string?)
	local state = vitals[player.UserId]
	if not state or state.state ~= "downed" then
		return false, "NOT_DOWNED"
	end
	if state.bankedSelfRevives <= 0 then
		return false, "NONE_BANKED"
	end
	state.bankedSelfRevives -= 1
	SurvivalService.revive(player, nil, Balance.Downed.selfReviveHealthFraction)
	return true, nil
end

--------------------------------------------------------------------------
-- Spectating
--------------------------------------------------------------------------

function SurvivalService.startSpectating(player: Player)
	local expedition = ExpeditionService.forPlayer(player)
	if not expedition then
		Net.fireClient("DownedState", player, { state = "dead", spectating = nil })
		return
	end
	local candidates = {}
	for _, other in ExpeditionService.playersOf(expedition) do
		local otherState = vitals[other.UserId]
		if other ~= player and otherState and otherState.state ~= "dead" then
			table.insert(candidates, other.UserId)
		end
	end
	local state = vitals[player.UserId]
	if state then
		state.spectatingUserId = candidates[1]
	end
	Net.fireClient("DownedState", player, {
		state = "dead",
		spectating = candidates[1],
		candidates = candidates,
	})
end

local function cycleSpectate(player: Player, direction: number)
	local state = vitals[player.UserId]
	if not state or state.state ~= "dead" then
		return
	end
	if os.clock() - state.lastSpectateSwitch < Balance.Downed.spectatorSwitchCooldown then
		return
	end
	state.lastSpectateSwitch = os.clock()

	local expedition = ExpeditionService.forPlayer(player)
	if not expedition then
		return
	end
	local candidates = {}
	for _, other in ExpeditionService.playersOf(expedition) do
		local otherState = vitals[other.UserId]
		if other ~= player and otherState and otherState.state ~= "dead" then
			table.insert(candidates, other.UserId)
		end
	end
	if #candidates == 0 then
		state.spectatingUserId = nil
		Net.fireClient("DownedState", player, { state = "dead", spectating = nil, candidates = {} })
		return
	end
	local currentIndex = table.find(candidates, state.spectatingUserId or 0) or 0
	local nextIndex = ((currentIndex - 1 + direction) % #candidates) + 1
	state.spectatingUserId = candidates[nextIndex]
	Net.fireClient("DownedState", player, {
		state = "dead",
		spectating = state.spectatingUserId,
		candidates = candidates,
	})
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

function SurvivalService.push(player: Player)
	local state = vitals[player.UserId]
	if not state then
		return
	end
	local offered, offerReason = SurvivalService.selfReviveOffered(player)
	Net.fireClient("VitalsState", player, {
		health = state.health,
		maxHealth = state.maxHealth,
		stamina = state.stamina,
		maxStamina = state.maxStamina,
		flashlight = state.flashlight,
		maxFlashlight = Balance.Flashlight.maxCharge,
		flashlightOn = state.flashlightOn,
		bleeding = state.bleeding,
		exhausted = state.exhausted,
		state = state.state,
		bleedoutRemaining = if state.downedAt then math.max(0, state.bleedoutSeconds - (os.clock() - state.downedAt)) else nil,
		bleedoutTotal = state.bleedoutSeconds,
		reviverUserId = state.reviverUserId,
		reviveProgress = if state.reviveStartedAt
			then math.clamp((os.clock() - state.reviveStartedAt) / reviveDuration(ExpeditionService.forPlayer(player)), 0, 1)
			else 0,
		selfReviveOffered = offered,
		selfReviveReason = offerReason,
		bankedSelfRevives = state.bankedSelfRevives,
	})
end

--------------------------------------------------------------------------
-- Tick
--------------------------------------------------------------------------

local function tick(dt: number)
	for userId, state in vitals do
		local player = Players:GetPlayerByUserId(userId)
		if not player then
			continue
		end

		if state.state == "alive" then
			-- Stamina.
			if state.sprinting and state.stamina > 0 then
				state.stamina = math.max(0, state.stamina - Balance.Player.sprintDrainPerSecond * dt)
				state.lastStaminaUseAt = os.clock()
				if state.stamina <= Balance.Player.staminaExhaustedAt then
					state.exhausted = true
					state.sprinting = false
				end
			elseif os.clock() - state.lastStaminaUseAt > Balance.Player.staminaRegenDelay then
				state.stamina = math.min(state.maxStamina, state.stamina + Balance.Player.staminaRegenPerSecond * dt)
				if state.exhausted and state.stamina >= Balance.Player.staminaRecoverGate then
					state.exhausted = false
				end
			end

			-- Flashlight.
			if state.flashlightOn and state.flashlight > 0 then
				state.flashlight = math.max(0, state.flashlight - Balance.Flashlight.drainPerSecond * dt)
				if state.flashlight <= 0 then
					state.flashlightOn = false
				end
			end

			-- Bleeding and regeneration.
			if state.bleeding then
				state.health = math.max(1, state.health - 0.8 * dt)
				if state.health <= 1 then
					SurvivalService.down(player, "bleeding")
				end
			elseif os.clock() - state.lastDamageAt > Balance.Player.healthRegenDelay then
				state.health = math.min(state.maxHealth, state.health + Balance.Player.healthRegenPerSecond * dt)
			end

			-- Walk speed follows stamina and carried weight.
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then
				local speed = if state.sprinting and not state.exhausted then Balance.Player.sprintSpeed else Balance.Player.walkSpeed
				local inventory = InventoryService.get(player)
				if inventory then
					local weight = InventoryService.weightOf(inventory)
					if weight > inventory.weightLimit * 0.85 then
						speed *= Balance.Player.carryHeavySpeedMultiplier
					end
				end
				if humanoid.WalkSpeed ~= speed then
					humanoid.WalkSpeed = speed
				end
			end
		elseif state.state == "downed" then
			-- Revive progress.
			if state.reviverUserId and state.reviveStartedAt then
				local reviver = Players:GetPlayerByUserId(state.reviverUserId)
				local reviverRoot = if reviver then Guard.aliveRoot(reviver) else nil
				local character = player.Character
				local targetRoot = if character then character:FindFirstChild("HumanoidRootPart") else nil
				local stillValid = reviver ~= nil
					and reviverRoot ~= nil
					and targetRoot ~= nil
					and targetRoot:IsA("BasePart")
					and Guard.withinDistance(reviverRoot.Position, (targetRoot :: BasePart).Position, 12)
				if not stillValid then
					cancelRevive(player)
				elseif (os.clock() - state.reviveStartedAt) >= reviveDuration(ExpeditionService.forPlayer(player)) then
					SurvivalService.revive(player, reviver)
				end
			end

			-- Bleedout.
			if state.downedAt and (os.clock() - state.downedAt) >= state.bleedoutSeconds then
				SurvivalService.die(player)
			end
		end
	end
end

--------------------------------------------------------------------------

function SurvivalService.start()
	-- Item effects are consumed here rather than in InventoryService, so the
	-- inventory does not need to know what a bandage does.
	InventoryService.ItemUsed:Connect(function(player, _itemId, def)
		local effect = def.effect
		if not effect then
			return
		end
		local state = vitals[player.UserId]
		if not state then
			return
		end
		if type(effect.heal) == "number" then
			SurvivalService.heal(player, effect.heal, effect.stopBleed == true)
		end
		if type(effect.stamina) == "number" then
			state.stamina = math.min(state.maxStamina, state.stamina + effect.stamina)
			state.exhausted = false
		end
		if type(effect.flashlightCharge) == "number" then
			state.flashlight = math.clamp(state.flashlight + effect.flashlightCharge, 0, Balance.Flashlight.maxCharge)
			if state.flashlight > 0 then
				state.flashlightOn = true
			end
		end
		SurvivalService.push(player)
	end)

	Net.onServerInvoke("ReviveCommand", function(player, rawCommand, rawTarget)
		local command = Guard.enum(rawCommand, { "start", "stop", "self", "buy_self" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end

		if command == "self" then
			local ok, err = SurvivalService.useSelfRevive(player)
			return { ok = ok, error = err }
		end

		if command == "buy_self" then
			local offered, reason = SurvivalService.selfReviveOffered(player)
			if not offered then
				return { ok = false, error = reason }
			end
			if reason == "BANKED" then
				local ok, err = SurvivalService.useSelfRevive(player)
				return { ok = ok, error = err }
			end
			-- Prompt gating does not apply here: this is a purchase the player
			-- explicitly asked for, at the only moment it is useful.
			local ok, err = PurchaseService.prompt(player, "field_revive", nil)
			return { ok = ok, error = err }
		end

		local targetUserId = Guard.integer(rawTarget, 1)
		if not targetUserId then
			return { ok = false, error = "BAD_TARGET" }
		end
		local target = Players:GetPlayerByUserId(targetUserId)
		if not target then
			return { ok = false, error = "NO_TARGET" }
		end

		if command == "stop" then
			local targetState = vitals[target.UserId]
			if targetState and targetState.reviverUserId == player.UserId then
				cancelRevive(target)
			end
			return { ok = true }
		end

		local ok, err = beginRevive(player, target)
		return { ok = ok, error = err }
	end)

	Net.onServerEvent("SpectateCommand", function(player, rawDirection)
		local direction = Guard.integer(rawDirection, -1, 1)
		if not direction or direction == 0 then
			return
		end
		cycleSpectate(player, direction)
	end)

	-- Sprint and flashlight toggles come in on the vitals channel rather than
	-- as their own remotes, because they are frequent and trivially validated.
	Net.onServerEvent("SetSetting", function(player, rawKey, rawValue)
		local key = Guard.enum(rawKey, { "sprinting", "flashlight" })
		if not key then
			-- Fall through to the profile setting handler, which owns the rest
			-- of this remote.
			return
		end
		local state = vitals[player.UserId]
		if not state or state.state ~= "alive" then
			return
		end
		if key == "sprinting" then
			local wants = Guard.boolean(rawValue)
			if wants == nil then
				return
			end
			state.sprinting = wants and not state.exhausted and state.stamina > 0
		else
			local wants = Guard.boolean(rawValue)
			if wants == nil then
				return
			end
			state.flashlightOn = wants and state.flashlight > 0
		end
		SurvivalService.push(player)
	end)

	-- A completed self-revive purchase banks an entitlement. Banking rather
	-- than applying immediately is what makes the purchase safe if the player
	-- was revived, died or the run ended between prompt and receipt.
	PurchaseService.Purchased:Connect(function(player, productKey)
		if productKey ~= "field_revive" then
			return
		end
		local state = vitals[player.UserId]
		if not state then
			-- No session at all: bank it on the profile so it survives.
			DataService.update(player, function(p)
				p.purchases.products.field_revive = (p.purchases.products.field_revive or 0)
			end)
			return
		end
		state.bankedSelfRevives += 1
		if state.state == "downed" and not state.reviverUserId then
			SurvivalService.useSelfRevive(player)
		else
			Net.fireClient("Notify", player, {
				kind = "info",
				title = "Stimulant banked",
				body = "You were already up. It is saved for the next time you go down.",
				duration = 7,
			})
			SurvivalService.push(player)
		end
	end)

	ExpeditionService.StateChanged:Connect(function(expedition, state)
		if state == "cinematic" or state == "preparing" then
			for _, player in ExpeditionService.playersOf(expedition) do
				SurvivalService.begin(player)
				SurvivalService.grantImmunity(player, GameConfig.CinematicSeconds + 6)
			end
		end
	end)

	ExpeditionService.Ended:Connect(function(expedition)
		for _, player in ExpeditionService.playersOf(expedition) do
			SurvivalService.clear(player)
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then
				humanoid.WalkSpeed = Balance.Player.walkSpeed
				humanoid.JumpPower = Balance.Player.jumpPower
				humanoid.Health = humanoid.MaxHealth
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		vitals[player.UserId] = nil
	end)

	local accumulator = 0
	-- Simulation runs at 8 Hz: fast enough for stamina and bleed to feel
	-- continuous, slow enough that a full server costs almost nothing.
	local interval = 1 / 8
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < interval then
			return
		end
		local step = accumulator
		accumulator = 0
		local ok, err = Protect.call(tick, step)
		if not ok then
			log.error("tick failed:", tostring(err))
		end
	end)

	-- Vitals are pushed at a slower rate than they are simulated; the HUD
	-- interpolates between updates rather than needing every tick.
	task.spawn(function()
		while true do
			task.wait(1 / GameConfig.VitalsTickRate)
			for userId in vitals do
				local player = Players:GetPlayerByUserId(userId)
				if player then
					SurvivalService.push(player)
				end
			end
		end
	end)

	log.info("started")
end

return SurvivalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">TrainService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainService
	------------
	Drives the train: movement, cab controls, lights, doors, fuel and condition.

	MOVEMENT MODEL
	--------------
	The train is a welded rigid assembly on an anchored root (see TrainBuilder).
	This service integrates speed on a fixed tick and writes the root CFrame.
	It does not use physics forces, constraints or a PrismaticConstraint, and
	that is deliberate: rolling stock driven by Roblox physics with six players
	walking around inside it produces jitter, stretched welds and passengers
	falling through floors, every time. A kinematically driven rigid body has
	none of those failure modes and is also far cheaper.

	Passengers ride by reference frame. Each tick the server publishes the
	train's CFrame and the delta since the last tick; clients apply that delta
	to their own character while it is inside the train volume. The client owns
	its character's physics, so the result is smooth at any framerate. See
	TrainRideController.

	AUTHORITY
	---------
	One driver at a time, and only while seated in the driver's seat. Control
	inputs are validated against that, rate limited by Net, and clamped. A
	client cannot set speed directly; it can only move the levers.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage.LastSignal

local Balance = require(Shared.Config.Balance)
local GameConfig = require(Shared.Config.GameConfig)
local Guard = require(Shared.Core.Guard)
local Logger = require(Shared.Core.Logger)
local Net = require(Shared.Core.Net)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local TrainRegistry = require(Shared.Registry.TrainRegistry)
local TrainBuilder = require(script.Parent.Parent.World.TrainBuilder)

local log = Logger.new("TrainService")

local TrainService = {}

export type TrainState = {
	crewId: string,
	built: TrainBuilder.BuiltTrain,
	def: TrainRegistry.TrainDef,

	-- Kinematics --------------------------------------------------------
	distance: number, -- studs travelled from the lane origin
	speed: number, -- studs per second, always >= 0
	direction: number, -- 1 forward, -1 reverse, 0 neutral
	throttle: number, -- 0 .. notches
	serviceBrake: number, -- 0 .. 1
	emergencyBrake: boolean,
	wheelAngle: number,

	-- Resources ----------------------------------------------------------
	fuel: number,
	condition: number,
	overheating: boolean,
	coolantUntil: number,

	-- Systems --------------------------------------------------------------
	headlights: boolean,
	cabinLights: boolean,
	interiorLights: boolean,
	wipers: boolean,
	doorsOpen: boolean,
	engineRunning: boolean,

	-- Authority --------------------------------------------------------------
	driverUserId: number?,

	-- Where the train is allowed to travel to. The expedition sets this to the
	-- next station so the train cannot be driven past the chapter.
	targetDistance: number,
	stopDistance: number?,

	-- Bookkeeping.
	lastTick: number,
	lastCFrame: CFrame,
	emergencyBrakeCooldown: { [number]: number },
	doorCooldown: { [number]: number },
}

local trains: { [string]: TrainState } = {}

TrainService.SpeedChanged = Signal.new() :: Signal.Signal<TrainState, number>
TrainService.EmergencyBrake = Signal.new() :: Signal.Signal<TrainState, Player?>
TrainService.HornSounded = Signal.new() :: Signal.Signal<TrainState, Player?>
TrainService.Stalled = Signal.new() :: Signal.Signal<TrainState, string>
TrainService.ArrivedAt = Signal.new() :: Signal.Signal<TrainState, number>
TrainService.DoorsToggled = Signal.new() :: Signal.Signal<TrainState, boolean>

--------------------------------------------------------------------------
-- Creation
--------------------------------------------------------------------------

function TrainService.spawn(crewId: string, trainId: string, liveryId: string?, interiorId: string?, originCF: CFrame, parent: Instance): TrainState
	local def = TrainRegistry.getOrStarter(trainId)
	local built = TrainBuilder.build(trainId, liveryId, interiorId, originCF, parent, 20217)

	local state: TrainState = {
		crewId = crewId,
		built = built,
		def = def,
		distance = 0,
		speed = 0,
		direction = 0,
		throttle = 0,
		serviceBrake = 1, -- parked with the brake on, which is how a train sits
		emergencyBrake = false,
		wheelAngle = 0,
		fuel = Balance.Train.maxFuel * 0.55,
		condition = Balance.Train.maxCondition,
		overheating = false,
		coolantUntil = 0,
		headlights = true,
		cabinLights = true,
		interiorLights = true,
		wipers = false,
		doorsOpen = true,
		engineRunning = true,
		driverUserId = nil,
		targetDistance = 0,
		stopDistance = nil,
		lastTick = os.clock(),
		lastCFrame = originCF,
		emergencyBrakeCooldown = {},
		doorCooldown = {},
	}

	trains[crewId] = state
	TrainService.applyLights(state)
	TrainService.applyDoors(state, true)
	log.info(string.format("spawned %s for crew %s (%d parts)", def.name, crewId, built.partCount))
	return state
end

function TrainService.despawn(crewId: string)
	local state = trains[crewId]
	if not state then
		return
	end
	state.built.model:Destroy()
	trains[crewId] = nil
end

function TrainService.get(crewId: string): TrainState?
	return trains[crewId]
end

--------------------------------------------------------------------------
-- Presentation helpers
--------------------------------------------------------------------------

function TrainService.applyLights(state: TrainState)
	-- Condition failures cut lighting before they cut motion, because a train
	-- going dark is a better warning than a train stopping.
	local failing = state.condition < Balance.Train.conditionFailureThreshold
	local powered = state.engineRunning

	for _, spot in state.built.headlights do
		spot.Enabled = powered and state.headlights
		spot.Brightness = if failing then 2.6 else 4.5
	end
	for _, light in state.built.cabinLights do
		light.Enabled = powered and state.cabinLights
	end
	for _, light in state.built.interiorLights do
		light.Enabled = powered and state.interiorLights
	end
	for _, light in state.built.tailLights do
		light.Enabled = powered
	end

	-- Lens emissive follows the lamp, so the headlight reads as on from outside.
	for _, descendant in state.built.model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:HasTag("HeadlampLens") then
			descendant.Material = if (powered and state.headlights) then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

function TrainService.applyDoors(state: TrainState, immediate: boolean?)
	local openAngle = math.rad(105)
	for _, door in state.built.doors do
		local hinge = door.hinge
		local model = door.model
		local closed = model:GetAttribute("ClosedCFrame")
		if typeof(closed) ~= "CFrame" then
			closed = hinge.CFrame
			model:SetAttribute("ClosedCFrame", closed)
		end
		local target = (closed :: CFrame) * CFrame.Angles(0, if state.doorsOpen then openAngle else 0, 0)
		if immediate then
			model:PivotTo(target)
		else
			-- Doors swing over their configured duration. A tween per door is
			-- cheap because there are at most a dozen and they move rarely.
			local start = model:GetPivot()
			local duration = Balance.Train.doorOpenSeconds
			task.spawn(function()
				local elapsed = 0
				while elapsed < duration do
					local dt = task.wait()
					elapsed += dt
					local alpha = math.clamp(elapsed / duration, 0, 1)
					-- Ease out, so a pneumatic door does not snap.
					alpha = 1 - (1 - alpha) ^ 3
					model:PivotTo(start:Lerp(target, alpha))
				end
				model:PivotTo(target)
			end)
		end
	end
	TrainService.DoorsToggled:Fire(state, state.doorsOpen)
end

local function applyGauges(state: TrainState)
	local cab = state.built.cab
	local function setNeedle(needle: BasePart, fraction: number)
		local base = needle:GetAttribute("BaseCFrame")
		if typeof(base) ~= "CFrame" then
			base = needle.CFrame
			needle:SetAttribute("BaseCFrame", base)
		end
		-- Needles sweep 240 degrees, which is what a real dial does.
		local angle = math.rad(-120 + math.clamp(fraction, 0, 1) * 240)
		-- The needle is welded, so the weld is what must move. Rotating the
		-- part directly would be undone by the weld on the next physics step.
		local weld = needle:FindFirstChildOfClass("WeldConstraint")
		if weld then
			weld:Destroy()
		end
		needle.CFrame = (base :: CFrame) * CFrame.Angles(0, angle, 0)
	end

	setNeedle(cab.speedNeedle, state.speed / (Balance.Train.maxSpeed * state.def.handling.maxSpeedMultiplier))
	setNeedle(cab.fuelNeedle, state.fuel / Balance.Train.maxFuel)
	setNeedle(cab.conditionNeedle, state.condition / Balance.Train.maxCondition)
end

--------------------------------------------------------------------------
-- Simulation
--------------------------------------------------------------------------

local function targetAcceleration(state: TrainState): number
	local handling = state.def.handling
	if state.emergencyBrake then
		return -Balance.Train.emergencyBrakeDeceleration * handling.brakingMultiplier
	end
	if state.serviceBrake > 0.01 then
		return -Balance.Train.serviceBrakeDeceleration * handling.brakingMultiplier * state.serviceBrake
	end
	if state.direction == 0 or state.throttle <= 0 or not state.engineRunning then
		return -Balance.Train.coastDeceleration
	end
	return Balance.Train.accelerationPerNotch * state.throttle * handling.accelerationMultiplier
end

local function maxSpeedFor(state: TrainState): number
	if state.direction < 0 then
		return Balance.Train.reverseMaxSpeed
	end
	local base = Balance.Train.maxSpeed * state.def.handling.maxSpeedMultiplier
	-- A damaged train cannot reach full speed. This is the mechanical failure
	-- the brief asks for: it changes how you play rather than just ticking down.
	if state.condition < Balance.Train.conditionFailureThreshold then
		base *= 0.6
	end
	if state.overheating then
		base *= 0.5
	end
	return base
end

local function step(state: TrainState, dt: number)
	local handling = state.def.handling

	-- Speed integration.
	local acceleration = targetAcceleration(state)
	state.speed = math.max(0, state.speed + acceleration * dt)
	state.speed = math.min(state.speed, maxSpeedFor(state))

	-- A train with the doors open does not move above a crawl, which removes
	-- the entire class of "somebody drove off while I was boarding" problems
	-- without taking control away from the driver.
	if state.doorsOpen then
		state.speed = math.min(state.speed, Balance.Train.boardingSpeedLimit)
	end

	-- Fuel. Idle drain plus a distance-proportional burn.
	if state.engineRunning then
		local burn = Balance.Train.fuelIdleDrainPerSecond * dt
		burn += state.speed * dt * Balance.Train.fuelPerStudAtFullSpeed * handling.fuelUseMultiplier
		state.fuel = math.max(0, state.fuel - burn)
		if state.fuel <= 0 then
			state.engineRunning = false
			state.throttle = 0
			TrainService.applyLights(state)
			TrainService.Stalled:Fire(state, "fuel")
		end
	end

	-- Condition drift, faster under load and when overheating.
	local drift = (Balance.Train.conditionDriftPerMinute / 60) * handling.conditionDriftMultiplier * dt
	if state.speed > maxSpeedFor(state) * 0.85 then
		drift *= 1.6
	end
	if state.overheating then
		drift *= 2.2
	end
	state.condition = math.max(0, state.condition - drift / math.max(0.2, handling.damageResistance))
	if state.condition <= 0 and state.engineRunning then
		state.engineRunning = false
		state.throttle = 0
		TrainService.applyLights(state)
		TrainService.Stalled:Fire(state, "condition")
	end

	-- Movement along the line.
	if state.speed > 0.01 and state.direction ~= 0 then
		local delta = state.speed * dt * state.direction
		local nextDistance = state.distance + delta

		-- A stop point is a hard limit, not a suggestion. The train decelerates
		-- into it and never passes it, which is what stops a crew from driving
		-- through a station or off the end of the built world.
		local limit = state.stopDistance
		if limit and nextDistance >= limit then
			nextDistance = limit
			state.speed = 0
			state.throttle = 0
			state.serviceBrake = 1
			TrainService.ArrivedAt:Fire(state, limit)
		end
		nextDistance = math.clamp(nextDistance, 0, GameConfig.TrackLength)
		state.distance = nextDistance

		-- Wheel rotation, derived from distance so it never drifts out of sync
		-- with actual movement.
		local radius = state.def.build.wheelRadius
		state.wheelAngle = (state.wheelAngle + delta / radius) % (math.pi * 2)
	end

	-- Write the pose.
	local root = state.built.root
	local origin = root:GetAttribute("OriginCFrame")
	if typeof(origin) ~= "CFrame" then
		origin = root.CFrame
		root:SetAttribute("OriginCFrame", origin)
	end
	state.lastCFrame = root.CFrame
	root.CFrame = (origin :: CFrame) * CFrame.new(0, 0, -state.distance)

	applyGauges(state)
end

--------------------------------------------------------------------------
-- Driver authority
--------------------------------------------------------------------------

local function isDriver(state: TrainState, player: Player): boolean
	if state.driverUserId ~= player.UserId then
		return false
	end
	-- Seat occupancy is the authority, so leaving the seat gives up control
	-- immediately without needing a separate release action.
	local seat = state.built.cab.driverSeat
	local occupant = seat.Occupant
	if not occupant then
		return false
	end
	local character = occupant.Parent
	return character ~= nil and Players:GetPlayerFromCharacter(character) == player
end

--- Claims the controls. Refused when somebody else is already driving.
function TrainService.claimDriver(state: TrainState, player: Player): (boolean, string?)
	local seat = state.built.cab.driverSeat
	local occupant = seat.Occupant
	if not occupant then
		return false, "NOT_SEATED"
	end
	local character = occupant.Parent
	if not character or Players:GetPlayerFromCharacter(character) ~= player then
		return false, "NOT_SEATED"
	end
	if state.driverUserId and state.driverUserId ~= player.UserId then
		local current = Players:GetPlayerByUserId(state.driverUserId)
		-- A driver who left the seat or the game releases control automatically.
		if current and isDriver(state, current) then
			return false, "OCCUPIED"
		end
	end
	state.driverUserId = player.UserId
	return true, nil
end

function TrainService.releaseDriver(state: TrainState, player: Player)
	if state.driverUserId == player.UserId then
		state.driverUserId = nil
		-- Leaving the controls applies the brake. A train left rolling with
		-- nobody at the desk is a griefing tool, not a feature.
		state.throttle = 0
		state.serviceBrake = 1
	end
end

--------------------------------------------------------------------------
-- Control inputs
--------------------------------------------------------------------------

local CONTROLS = {
	"throttle",
	"brake",
	"emergency",
	"reverser",
	"horn",
	"headlights",
	"cabin_lights",
	"interior_lights",
	"wipers",
	"doors",
	"start_engine",
}

function TrainService.applyControl(player: Player, state: TrainState, control: string, value: any): (boolean, string?)
	if not isDriver(state, player) then
		-- Doors are the exception: any crew member can work a carriage door
		-- from inside, which is how boarding works with one driver.
		if control ~= "doors" then
			return false, "NOT_DRIVER"
		end
	end

	if control == "throttle" then
		local notch = Guard.integer(value, 0, Balance.Train.notches)
		if not notch then
			return false, "BAD_VALUE"
		end
		if not state.engineRunning then
			return false, "ENGINE_OFF"
		end
		state.throttle = notch
		if notch > 0 then
			state.serviceBrake = 0
			state.emergencyBrake = false
		end
		return true, nil
	elseif control == "brake" then
		local amount = Guard.number(value, 0, 1)
		if not amount then
			return false, "BAD_VALUE"
		end
		state.serviceBrake = amount
		if amount > 0 then
			state.throttle = 0
		end
		return true, nil
	elseif control == "emergency" then
		local now = os.clock()
		local last = state.emergencyBrakeCooldown[player.UserId] or -math.huge
		if now - last < Balance.AntiGrief.emergencyBrakeCooldown then
			return false, "COOLDOWN"
		end
		state.emergencyBrakeCooldown[player.UserId] = now
		state.emergencyBrake = true
		state.throttle = 0
		state.condition = math.max(0, state.condition - Balance.Train.emergencyBrakeConditionCost)
		TrainService.EmergencyBrake:Fire(state, player)
		-- The emergency brake releases itself once stopped, as a real one does
		-- after the reservoir recharges.
		task.delay(4, function()
			if trains[state.crewId] == state then
				state.emergencyBrake = false
			end
		end)
		return true, nil
	elseif control == "reverser" then
		local dir = Guard.integer(value, -1, 1)
		if not dir then
			return false, "BAD_VALUE"
		end
		-- The reverser cannot be moved while rolling. That is both prototypical
		-- and stops instant direction flips being used as a brake.
		if state.speed > 1.5 then
			return false, "STILL_MOVING"
		end
		state.direction = dir
		return true, nil
	elseif control == "horn" then
		TrainService.HornSounded:Fire(state, player)
		return true, nil
	elseif control == "headlights" then
		state.headlights = not state.headlights
		TrainService.applyLights(state)
		return true, nil
	elseif control == "cabin_lights" then
		state.cabinLights = not state.cabinLights
		TrainService.applyLights(state)
		return true, nil
	elseif control == "interior_lights" then
		state.interiorLights = not state.interiorLights
		TrainService.applyLights(state)
		return true, nil
	elseif control == "wipers" then
		state.wipers = not state.wipers
		return true, nil
	elseif control == "doors" then
		local now = os.clock()
		local last = state.doorCooldown[player.UserId] or -math.huge
		if now - last < Balance.AntiGrief.doorToggleCooldown then
			return false, "COOLDOWN"
		end
		state.doorCooldown[player.UserId] = now
		if state.speed > Balance.Train.boardingSpeedLimit then
			return false, "MOVING"
		end
		state.doorsOpen = not state.doorsOpen
		TrainService.applyDoors(state)
		return true, nil
	elseif control == "start_engine" then
		if state.engineRunning then
			return false, "ALREADY_RUNNING"
		end
		if state.fuel <= 0 then
			return false, "NO_FUEL"
		end
		if state.condition <= 0 then
			return false, "NO_CONDITION"
		end
		state.engineRunning = true
		TrainService.applyLights(state)
		return true, nil
	end

	return false, "UNKNOWN_CONTROL"
end

--------------------------------------------------------------------------
-- Resources
--------------------------------------------------------------------------

function TrainService.addFuel(state: TrainState, amount: number): number
	local before = state.fuel
	state.fuel = math.clamp(state.fuel + amount, 0, Balance.Train.maxFuel)
	return state.fuel - before
end

function TrainService.repair(state: TrainState, amount: number): number
	local before = state.condition
	state.condition = math.clamp(state.condition + amount, 0, Balance.Train.maxCondition)
	TrainService.applyLights(state)
	return state.condition - before
end

function TrainService.applyCoolant(state: TrainState, seconds: number)
	state.coolantUntil = os.clock() + seconds
	state.overheating = false
end

function TrainService.setOverheating(state: TrainState, overheating: boolean)
	if overheating and os.clock() < state.coolantUntil then
		return
	end
	state.overheating = overheating
end

--- Sets the next hard stop. The expedition uses this to hold the train at a
--- station until its objectives are done.
function TrainService.setStopDistance(state: TrainState, distance: number?)
	state.stopDistance = distance
end

--------------------------------------------------------------------------
-- Client sync
--------------------------------------------------------------------------

local function describe(state: TrainState): { [string]: any }
	return {
		crewId = state.crewId,
		trainId = state.def.id,
		distance = state.distance,
		speed = state.speed,
		maxSpeed = maxSpeedFor(state),
		direction = state.direction,
		throttle = state.throttle,
		notches = Balance.Train.notches,
		serviceBrake = state.serviceBrake,
		emergencyBrake = state.emergencyBrake,
		fuel = state.fuel,
		maxFuel = Balance.Train.maxFuel,
		condition = state.condition,
		maxCondition = Balance.Train.maxCondition,
		engineRunning = state.engineRunning,
		overheating = state.overheating,
		headlights = state.headlights,
		cabinLights = state.cabinLights,
		interiorLights = state.interiorLights,
		wipers = state.wipers,
		doorsOpen = state.doorsOpen,
		driverUserId = state.driverUserId,
		wheelAngle = state.wheelAngle,
		-- The pose and the delta, which is what the client ride controller and
		-- the wheel animation need.
		cframe = state.built.root.CFrame,
		stopDistance = state.stopDistance,
	}
end

TrainService.describe = describe

--------------------------------------------------------------------------

local subscribers: { [string]: { Player } } = {}

function TrainService.setSubscribers(crewId: string, players: { Player })
	subscribers[crewId] = players
end

function TrainService.start()
	Net.onServerEvent("TrainControl", function(player, rawControl, rawValue)
		local control = Guard.enum(rawControl, CONTROLS)
		if not control then
			return
		end
		-- The player's train is the one for their crew; a client cannot name
		-- another crew's train.
		for _, state in trains do
			if state.driverUserId == player.UserId or control == "doors" then
				-- Confirm membership by proximity to the train, which also
				-- prevents a lobby player operating a train in a lane.
				local root = Guard.aliveRoot(player)
				if root then
					local distance = (root.Position - state.built.root.Position).Magnitude
					if distance < 400 then
						TrainService.applyControl(player, state, control, rawValue)
						return
					end
				end
			end
		end
	end)

	Net.onServerInvoke("TrainCommand", function(player, rawCommand)
		local command = Guard.enum(rawCommand, { "claim_driver", "release_driver", "state" })
		if not command then
			return { ok = false, error = "BAD_COMMAND" }
		end
		for _, state in trains do
			local seat = state.built.cab.driverSeat
			local occupant = seat.Occupant
			local character = if occupant then occupant.Parent else nil
			if character and Players:GetPlayerFromCharacter(character) == player then
				if command == "claim_driver" then
					local ok, err = TrainService.claimDriver(state, player)
					return { ok = ok, error = err, train = describe(state) }
				elseif command == "release_driver" then
					TrainService.releaseDriver(state, player)
					return { ok = true }
				else
					return { ok = true, train = describe(state) }
				end
			end
		end
		return { ok = false, error = "NOT_AT_CONTROLS" }
	end)

	-- Fixed-rate simulation. Running on a timer rather than per frame keeps CPU
	-- predictable and makes the physics identical regardless of server load.
	local accumulator = 0
	local tickInterval = 1 / GameConfig.TrainTickRate
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < tickInterval then
			return
		end
		local stepDelta = accumulator
		accumulator = 0

		for crewId, state in trains do
			local ok, err = Protect.call(step, state, stepDelta)
			if not ok then
				log.error(string.format("train step failed for %s: %s", crewId, tostring(err)))
			end

			-- Release a driver who left their seat or the game.
			if state.driverUserId then
				local driver = Players:GetPlayerByUserId(state.driverUserId)
				if not driver or not isDriver(state, driver) then
					state.driverUserId = nil
					state.throttle = 0
					state.serviceBrake = 1
				end
			end

			local audience = subscribers[crewId]
			if audience then
				Net.fireClients("TrainState", audience, describe(state))
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, state in trains do
			if state.driverUserId == player.UserId then
				TrainService.releaseDriver(state, player)
			end
		end
	end)

	log.info("started")
end

return TrainService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WorldService
	------------
	Owns every piece of built geometry and hands lanes out to expeditions.

	LANES
	-----
	In single-place mode the lobby and the expeditions share one server, so an
	expedition cannot simply be built at a fixed spot: two crews would occupy
	the same track. Instead the server holds a small number of lanes, each a
	complete 14,000 stud corridor of track, forest and stations, separated far
	enough along X that streaming never loads two at once.

	A lane is built once, the first time it is claimed, and then reused. Between
	expeditions its state is reset (loot restocked, doors closed, lights off,
	fixtures returned to their starting positions) rather than its geometry
	rebuilt, because rebuilding a forest takes seconds and resetting takes
	milliseconds.

	Building is incremental: the builders yield periodically so a lane coming
	online never stalls the server heartbeat, and the crew waiting for it sees
	real progress rather than a frozen loading screen.

	The honest limitation: the number of concurrent expeditions on one server is
	bounded by memory, and GameConfig.MaxConcurrentExpeditions is that bound.
	Two-place mode removes it entirely by giving each crew its own server.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.LastSignal

local GameConfig = require(Shared.Config.GameConfig)
local Logger = require(Shared.Core.Logger)
local Protect = require(Shared.Core.Protect)
local Signal = require(Shared.Core.Signal)
local StationRegistry = require(Shared.Registry.StationRegistry)
local ItemRegistry = require(Shared.Registry.ItemRegistry)
local BuildKit = require(script.Parent.Parent.World.BuildKit)
local ForestBuilder = require(script.Parent.Parent.World.ForestBuilder)
local LobbyBuilder = require(script.Parent.Parent.World.LobbyBuilder)
local StationBuilder = require(script.Parent.Parent.World.StationBuilder)

local log = Logger.new("WorldService")

local WorldService = {}

export type Lane = {
	index: number,
	origin: Vector3,
	root: Folder,
	built: boolean,
	building: boolean,
	claimedBy: string?, -- crew id
	stations: { StationBuilder.BuiltStation },
	track: Model?,
	forest: Model?,
	dropContainer: Folder,
	creatureContainer: Folder,
	trainContainer: Folder,
	partCount: number,
}

local lanes: { Lane } = {}
local lobby: LobbyBuilder.BuiltLobby? = nil
local worldRoot: Folder? = nil

WorldService.LaneReady = Signal.new() :: Signal.Signal<Lane>
WorldService.BuildProgress = Signal.new() :: Signal.Signal<number, number, string>

--------------------------------------------------------------------------
-- Lobby
--------------------------------------------------------------------------

function WorldService.buildLobby(): LobbyBuilder.BuiltLobby
	if lobby then
		return lobby
	end
	local root = worldRoot :: Folder
	local started = os.clock()
	local built = LobbyBuilder.build(GameConfig.LobbyOrigin, root, 217)

	-- A ring of forest around the yard, so the lobby sits in the same world as
	-- the expedition rather than on a floating pad.
	ForestBuilder.populate({
		centre = GameConfig.LobbyOrigin,
		halfExtents = Vector2.new(320, 380),
		trackClearance = 150,
		clearings = { { position = GameConfig.LobbyOrigin, radius = 175 } },
		density = 4.0,
		seed = 991,
		parent = built.model,
	})

	lobby = built
	log.info(
		string.format(
			"lobby built in %.1fs (%d parts)",
			os.clock() - started,
			BuildKit.countParts(built.model)
		)
	)
	return built
end

function WorldService.getLobby(): LobbyBuilder.BuiltLobby?
	return lobby
end

--------------------------------------------------------------------------
-- Lane construction
--------------------------------------------------------------------------

local function laneOrigin(index: number): Vector3
	return GameConfig.ExpeditionOrigin + Vector3.new((index - 1) * GameConfig.ExpeditionLaneSpacing, 0, 0)
end

--- Builds a lane incrementally. Yields between phases so the server keeps
--- ticking; the caller is expected to be a coroutine that can wait.
local function buildLane(lane: Lane, onProgress: (number, string) -> ())
	lane.building = true
	local started = os.clock()
	local origin = lane.origin

	onProgress(0.05, "Laying track")
	-- Track is laid in segments so a 14,000 stud line does not build in one
	-- uninterrupted burst.
	local trackModel = BuildKit.model("Track", lane.root)
	local segmentLength = 1000
	local segments = math.ceil(GameConfig.TrackLength / segmentLength)
	local rng = Random.new(4000 + lane.index)
	for i = 0, segments - 1 do
		local segment = BuildKit.trackSection(
			CFrame.new(origin + Vector3.new(0, 0, -i * segmentLength)),
			math.min(segmentLength, GameConfig.TrackLength - i * segmentLength),
			trackModel,
			rng
		)
		segment.Name = "TrackSegment" .. i
		if i % 2 == 1 then
			task.wait()
		end
		onProgress(0.05 + 0.2 * ((i + 1) / segments), "Laying track")
	end
	lane.track = trackModel

	onProgress(0.28, "Building stations")
	local clearings: { { position: Vector3, radius: number } } = {}
	for index, def in StationRegistry.Stations do
		local stationOrigin = StationRegistry.originFor(def, origin)
		local built = StationBuilder.build(def, CFrame.new(stationOrigin), lane.root, 7000 + lane.index * 100 + index)
		table.insert(lane.stations, built)
		table.insert(clearings, { position = stationOrigin, radius = def.layout.radius })
		task.wait()
		onProgress(0.28 + 0.27 * (index / #StationRegistry.Stations), "Building " .. def.name)
	end

	onProgress(0.56, "Growing the forest")
	-- The forest is the expensive phase. It is built in slices along the line
	-- so progress is honest and the server never blocks for more than a frame.
	local forestRoot = BuildKit.model("Forest", lane.root)
	local sliceLength = 2000
	local slices = math.ceil(GameConfig.TrackLength / sliceLength)
	for i = 0, slices - 1 do
		local sliceCentreZ = origin.Z - (i * sliceLength + sliceLength * 0.5)
		local sliceExtent = math.min(sliceLength, GameConfig.TrackLength - i * sliceLength) * 0.5
		ForestBuilder.populate({
			centre = Vector3.new(origin.X, origin.Y, sliceCentreZ),
			halfExtents = Vector2.new(GameConfig.ForestCorridorHalfWidth, sliceExtent),
			trackClearance = 30,
			clearings = clearings,
			density = GameConfig.ForestDensity,
			seed = 12000 + lane.index * 1000 + i,
			parent = forestRoot,
		})
		task.wait()
		onProgress(0.56 + 0.4 * ((i + 1) / slices), "Growing the forest")
	end
	lane.forest = forestRoot

	onProgress(0.98, "Final checks")
	lane.partCount = BuildKit.countParts(lane.root)
	lane.built = true
	lane.building = false

	log.info(
		string.format(
			"lane %d built in %.1fs (%d parts, %d stations)",
			lane.index,
			os.clock() - started,
			lane.partCount,
			#lane.stations
		)
	)
	onProgress(1, "Ready")
	WorldService.LaneReady:Fire(lane)
end

--------------------------------------------------------------------------
-- Lane state reset
--------------------------------------------------------------------------

--- Returns a lane to its starting condition without rebuilding geometry.
function WorldService.resetLane(lane: Lane)
	-- Clear anything spawned during the last run.
	lane.dropContainer:ClearAllChildren()
	lane.creatureContainer:ClearAllChildren()
	lane.trainContainer:ClearAllChildren()

	for _, station in lane.stations do
		-- Loot nodes become searchable again and their contents are re-rolled
		-- by ExpeditionService, so two runs never find the same layout.
		for _, node in station.lootNodes do
			node.part:SetAttribute("Searched", false)
		end
		-- Lights off: every station starts dark.
		for _, light in station.lights do
			light.Enabled = false
		end
		-- Doors closed and fixtures reset.
		for _, door in station.doors do
			local hinge = door.PrimaryPart
			if hinge then
				local baseCF = door:GetAttribute("ClosedCFrame")
				if typeof(baseCF) == "CFrame" then
					door:PivotTo(baseCF)
				end
			end
		end
		for _, fixture in station.fixtures do
			fixture:SetAttribute("State", "idle")
			fixture:SetAttribute("Progress", 0)
			fixture:SetAttribute("Powered", false)
		end
	end
end

--------------------------------------------------------------------------
-- Claiming
--------------------------------------------------------------------------

--- Claims a lane for a crew, building it if needed. Yields until ready.
--- Returns nil when every lane is occupied, which the lobby reports plainly.
function WorldService.claimLane(crewId: string, onProgress: ((number, string) -> ())?): Lane?
	local progress: (number, string) -> () = onProgress or function() end

	-- Prefer an already-built free lane, so a crew that can start immediately
	-- does not wait for a fresh build.
	local candidate: Lane? = nil
	for _, lane in lanes do
		if not lane.claimedBy and lane.built and not lane.building then
			candidate = lane
			break
		end
	end
	if not candidate then
		for _, lane in lanes do
			if not lane.claimedBy and not lane.building then
				candidate = lane
				break
			end
		end
	end
	if not candidate then
		return nil
	end

	local lane = candidate :: Lane
	lane.claimedBy = crewId

	if not lane.built then
		local ok, err = Protect.call(buildLane, lane, function(fraction: number, label: string)
			progress(fraction, label)
			WorldService.BuildProgress:Fire(lane.index, fraction, label)
		end)
		if not ok then
			log.error(string.format("lane %d build failed: %s", lane.index, tostring(err)))
			lane.building = false
			lane.claimedBy = nil
			return nil
		end
	else
		progress(0.5, "Preparing the line")
		WorldService.resetLane(lane)
		task.wait()
		progress(1, "Ready")
	end

	return lane
end

function WorldService.releaseLane(lane: Lane)
	lane.claimedBy = nil
	WorldService.resetLane(lane)
	log.info(string.format("lane %d released", lane.index))
end

function WorldService.laneFor(crewId: string): Lane?
	for _, lane in lanes do
		if lane.claimedBy == crewId then
			return lane
		end
	end
	return nil
end

function WorldService.availableLanes(): number
	local free = 0
	for _, lane in lanes do
		if not lane.claimedBy then
			free += 1
		end
	end
	return free
end

--------------------------------------------------------------------------
-- Dropped items
--------------------------------------------------------------------------

--- Builds a physical dropped item from its registry model spec. Dropped
--- objects use real geometry, not a generic box with a label.
function WorldService.buildDroppedItem(itemId: string, quantity: number, cf: CFrame, parent: Instance): Instance?
	local def = ItemRegistry.get(itemId)
	if not def then
		return nil
	end

	local model = BuildKit.model("Dropped_" .. itemId, nil)
	local spec = def.model
	local root: BasePart

	local shape = spec.shape
	if shape == "cylinder" or shape == "vial" or shape == "bottle" or shape == "roll" then
		root = BuildKit.cylinder({
			name = "Body",
			size = Vector3.new(spec.size.Y, spec.size.X, spec.size.Z),
			cf = cf * CFrame.Angles(0, 0, math.rad(90)),
			colour = spec.colour,
			material = spec.material,
			parent = model,
		})
	elseif shape == "jerrycan" then
		root = BuildKit.part({
			name = "Body",
			size = spec.size,
			cf = cf,
			colour = spec.colour,
			material = spec.material,
			parent = model,
		})
		-- Spout and handle, so a jerry can reads as one at a glance.
		BuildKit.detail({
			name = "Spout",
			size = Vector3.new(0.18, 0.3, 0.18),
			cf = cf * CFrame.new(spec.size.X * 0.3, spec.size.Y * 0.55, 0),
			colour = spec.accent or spec.colour,
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.detail({
			name = "Handle",
			size = Vector3.new(spec.size.X * 0.7, 0.12, 0.12),
			cf = cf * CFrame.new(0, spec.size.Y * 0.58, 0),
			colour = spec.accent or spec.colour,
			material = Enum.Material.Metal,
			parent = model,
		})
	elseif shape == "case" then
		root = BuildKit.part({
			name = "Body",
			size = spec.size,
			cf = cf,
			colour = spec.colour,
			material = spec.material,
			parent = model,
		})
		BuildKit.detail({
			name = "Latch",
			size = Vector3.new(0.12, 0.18, spec.size.Z * 0.35),
			cf = cf * CFrame.new(spec.size.X * 0.5, 0, 0),
			colour = spec.accent or Color3.fromRGB(180, 180, 180),
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.detail({
			name = "Marking",
			size = Vector3.new(spec.size.X * 0.5, 0.05, spec.size.Z * 0.5),
			cf = cf * CFrame.new(0, spec.size.Y * 0.5, 0),
			colour = spec.accent or Color3.fromRGB(240, 240, 240),
			material = Enum.Material.SmoothPlastic,
			parent = model,
		})
	elseif shape == "page" then
		root = BuildKit.part({
			name = "Body",
			size = spec.size,
			cf = cf * CFrame.Angles(0, math.rad(math.random(0, 180)), 0),
			colour = spec.colour,
			material = spec.material,
			parent = model,
		})
	else
		root = BuildKit.part({
			name = "Body",
			size = spec.size,
			cf = cf,
			colour = spec.colour,
			material = spec.material,
			parent = model,
		})
		if spec.accent then
			BuildKit.detail({
				name = "Accent",
				size = Vector3.new(spec.size.X * 1.02, spec.size.Y * 0.25, spec.size.Z * 1.02),
				cf = cf * CFrame.new(0, spec.size.Y * 0.3, 0),
				colour = spec.accent,
				material = spec.material,
				parent = model,
			})
		end
	end

	if spec.emissive and spec.emissive > 0 then
		local glow = Instance.new("PointLight")
		glow.Color = spec.accent or spec.colour
		glow.Brightness = spec.emissive * 3
		glow.Range = 12
		glow.Parent = root
	end

	model.PrimaryPart = root
	BuildKit.weldAssembly(model, root)
	root.Name = "Body"
	model:SetAttribute("ItemId", itemId)
	model:SetAttribute("Quantity", quantity)
	model:AddTag("DroppedItem")
	model.Parent = parent
	return model
end

--------------------------------------------------------------------------

function WorldService.start()
	local root = Instance.new("Folder")
	root.Name = "LastSignalWorld"
	root.Parent = Workspace
	worldRoot = root

	-- Remove the default baseplate and spawn if the place still has them, so
	-- the built world is what the player actually stands on.
	for _, name in { "Baseplate", "SpawnLocation" } do
		local existing = Workspace:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end

	WorldService.buildLobby()

	for index = 1, GameConfig.MaxConcurrentExpeditions do
		local laneRoot = Instance.new("Folder")
		laneRoot.Name = "Lane" .. index
		laneRoot.Parent = root

		local drops = Instance.new("Folder")
		drops.Name = "Drops"
		drops.Parent = laneRoot

		local creatures = Instance.new("Folder")
		creatures.Name = "Creatures"
		creatures.Parent = laneRoot

		local trains = Instance.new("Folder")
		trains.Name = "Trains"
		trains.Parent = laneRoot

		table.insert(lanes, {
			index = index,
			origin = laneOrigin(index),
			root = laneRoot,
			built = false,
			building = false,
			claimedBy = nil,
			stations = {},
			dropContainer = drops,
			creatureContainer = creatures,
			trainContainer = trains,
			partCount = 0,
		})
	end

	-- Pre-build the first lane in the background so the first crew of the
	-- server departs without a long wait. Later lanes build on demand.
	task.spawn(function()
		task.wait(2)
		local first = lanes[1]
		if first and not first.built and not first.building and not first.claimedBy then
			log.info("pre-building lane 1")
			local ok, err = Protect.call(buildLane, first, function() end)
			if not ok then
				log.error("pre-build failed:", tostring(err))
				first.building = false
			end
		end
	end)

	log.info(string.format("started with %d lane(s)", #lanes))
end

function WorldService.status(): { lanes: { { index: number, built: boolean, claimed: boolean, parts: number } }, lobbyParts: number }
	local out = {}
	for _, lane in lanes do
		table.insert(out, {
			index = lane.index,
			built = lane.built,
			claimed = lane.claimedBy ~= nil,
			parts = lane.partCount,
		})
	end
	return {
		lanes = out,
		lobbyParts = if lobby then lobby.partCount else 0,
	}
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="57">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">BuildKit</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BuildKit
	--------
	Construction primitives for every piece of geometry in LAST SIGNAL.

	WHY THE WORLD IS BUILT IN CODE
	------------------------------
	This project ships no third-party meshes or textures. Importing somebody
	else's model because it appeared in a search result is exactly what the
	brief forbids, and this project has no way to license, verify or attribute
	assets on the operator's behalf. So every object is built from Roblox
	primitives at runtime, out of parts, wedges, cylinders and the standard
	material set, which are the assets Roblox already licenses to you.

	That constraint is a real one and it shows: these are detailed constructed
	objects, not sculpted meshes. What it buys is a world with no licensing
	risk, no download weight, and geometry the operator can edit. docs/ASSETS.md
	records exactly this, and describes where to drop in real meshes later
	without touching gameplay code.

	PERFORMANCE RULES BAKED INTO THIS FILE
	--------------------------------------
	  - Everything static is Anchored and CanTouch = false. Touch events on
	    scenery are the single biggest avoidable server cost in Roblox.
	  - Small decorative parts get CanCollide = false and CanQuery = false, so
	    they cost nothing for physics or raycasts.
	  - Repeated geometry is built once and cloned, never rebuilt per instance.
	  - Nothing built here uses a script inside the model. All behaviour lives
	    in services, so a model can be deleted without breaking logic.
]]

local BuildKit = {}

local C = Color3.fromRGB

--------------------------------------------------------------------------
-- Primitives
--------------------------------------------------------------------------

export type PartProps = {
	name: string?,
	size: Vector3,
	cfrmame: CFrame?,
	cf: CFrame?,
	colour: Color3?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	shape: Enum.PartType?,
	anchored: boolean?,
	canCollide: boolean?,
	canQuery: boolean?,
	castShadow: boolean?,
	parent: Instance?,
}

--- The base constructor. Every other helper funnels through this so the
--- performance defaults above are applied exactly once, in one place.
function BuildKit.part(props: PartProps): Part
	local p = Instance.new("Part")
	p.Name = props.name or "Part"
	p.Size = props.size
	p.CFrame = props.cf or props.cfrmame or CFrame.new()
	p.Color = props.colour or C(128, 128, 128)
	p.Material = props.material or Enum.Material.SmoothPlastic
	p.Transparency = props.transparency or 0
	p.Reflectance = props.reflectance or 0
	p.Anchored = if props.anchored == nil then true else props.anchored
	p.CanCollide = if props.canCollide == nil then true else props.canCollide
	p.CanQuery = if props.canQuery == nil then true else props.canQuery
	p.CanTouch = false
	p.CastShadow = if props.castShadow == nil then true else props.castShadow
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.shape then
		p.Shape = props.shape
	end
	if props.parent then
		p.Parent = props.parent
	end
	return p
end

--- Decorative detail: no collision, no raycast hits, no shadow. Use for
--- rivets, trim strips, small pipework and anything a player cannot interact
--- with. Hundreds of these are affordable; hundreds of collidable parts are not.
function BuildKit.detail(props: PartProps): Part
	local merged: PartProps = table.clone(props)
	merged.canCollide = false
	merged.canQuery = false
	merged.castShadow = if props.castShadow == nil then false else props.castShadow
	return BuildKit.part(merged)
end

function BuildKit.wedge(props: PartProps): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = props.name or "Wedge"
	p.Size = props.size
	p.CFrame = props.cf or CFrame.new()
	p.Color = props.colour or C(128, 128, 128)
	p.Material = props.material or Enum.Material.SmoothPlastic
	p.Transparency = props.transparency or 0
	p.Anchored = if props.anchored == nil then true else props.anchored
	p.CanCollide = if props.canCollide == nil then true else props.canCollide
	p.CanQuery = if props.canQuery == nil then true else props.canQuery
	p.CanTouch = false
	p.CastShadow = if props.castShadow == nil then true else props.castShadow
	if props.parent then
		p.Parent = props.parent
	end
	return p
end

function BuildKit.cylinder(props: PartProps): Part
	local merged: PartProps = table.clone(props)
	merged.shape = Enum.PartType.Cylinder
	return BuildKit.part(merged)
end

function BuildKit.sphere(props: PartProps): Part
	local merged: PartProps = table.clone(props)
	merged.shape = Enum.PartType.Ball
	return BuildKit.part(merged)
end

--- A rounded-corner box built from a block plus cylinders. Used for tank
--- bodies, lamp housings and anything that should not read as a cube.
function BuildKit.roundedBox(cf: CFrame, size: Vector3, radius: number, props: PartProps, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = props.name or "RoundedBox"

	local core = BuildKit.part({
		name = "Core",
		size = Vector3.new(size.X, size.Y - radius * 2, size.Z),
		cf = cf,
		colour = props.colour,
		material = props.material,
		parent = model,
	})
	core.Name = "Core"

	for _, sign in { 1, -1 } do
		BuildKit.part({
			name = "Cap",
			size = Vector3.new(size.X - radius * 0.1, radius * 2, size.Z),
			cf = cf * CFrame.new(0, sign * (size.Y * 0.5 - radius), 0),
			colour = props.colour,
			material = props.material,
			parent = model,
		})
	end
	model.Parent = parent
	return model
end

--------------------------------------------------------------------------
-- Composite detail helpers
--------------------------------------------------------------------------

--- A run of rivets along a line. The single cheapest way to make a flat metal
--- panel read as fabricated rather than extruded.
function BuildKit.rivetStrip(startCF: CFrame, length: number, spacing: number, radius: number, colour: Color3, parent: Instance)
	local count = math.max(2, math.floor(length / spacing))
	local step = length / (count - 1)
	for i = 0, count - 1 do
		BuildKit.detail({
			name = "Rivet",
			size = Vector3.new(radius * 2, radius * 2, radius * 2),
			cf = startCF * CFrame.new(0, 0, -i * step),
			colour = colour,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Ball,
			parent = parent,
		})
	end
end

--- A tubular handrail: two uprights and a top rail, with optional mid rail.
function BuildKit.handrail(baseCF: CFrame, length: number, height: number, colour: Color3, parent: Instance, midRail: boolean?)
	local thickness = 0.18
	BuildKit.detail({
		name = "RailTop",
		size = Vector3.new(thickness, thickness, length),
		cf = baseCF * CFrame.new(0, height, 0),
		colour = colour,
		material = Enum.Material.Metal,
		parent = parent,
	})
	if midRail then
		BuildKit.detail({
			name = "RailMid",
			size = Vector3.new(thickness, thickness, length),
			cf = baseCF * CFrame.new(0, height * 0.55, 0),
			colour = colour,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	local posts = math.max(2, math.floor(length / 8) + 1)
	for i = 0, posts - 1 do
		local z = -length * 0.5 + (length / (posts - 1)) * i
		BuildKit.detail({
			name = "RailPost",
			size = Vector3.new(thickness, height, thickness),
			cf = baseCF * CFrame.new(0, height * 0.5, z),
			colour = colour,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
end

--- A pipe run with elbow joints. Takes a list of local points.
function BuildKit.pipeRun(originCF: CFrame, points: { Vector3 }, diameter: number, colour: Color3, parent: Instance)
	for i = 1, #points - 1 do
		local a = points[i]
		local b = points[i + 1]
		local delta = b - a
		local length = delta.Magnitude
		if length > 0.05 then
			local mid = a + delta * 0.5
			BuildKit.detail({
				name = "Pipe",
				size = Vector3.new(diameter, diameter, length),
				cf = originCF * CFrame.new(mid) * CFrame.lookAt(Vector3.zero, delta.Unit).Rotation,
				colour = colour,
				material = Enum.Material.Metal,
				parent = parent,
			})
		end
		-- Elbow sphere at each interior joint so corners do not show a gap.
		if i > 1 then
			BuildKit.detail({
				name = "Elbow",
				size = Vector3.new(diameter * 1.15, diameter * 1.15, diameter * 1.15),
				cf = originCF * CFrame.new(a),
				colour = colour,
				material = Enum.Material.Metal,
				shape = Enum.PartType.Ball,
				parent = parent,
			})
		end
	end
end

--- A louvred vent panel.
function BuildKit.vent(cf: CFrame, width: number, height: number, colour: Color3, parent: Instance)
	local frame = BuildKit.detail({
		name = "VentFrame",
		size = Vector3.new(0.16, height, width),
		cf = cf,
		colour = colour,
		material = Enum.Material.Metal,
		parent = parent,
	})
	frame.Name = "VentFrame"
	local slats = math.max(3, math.floor(height / 0.45))
	local step = (height - 0.3) / (slats - 1)
	local darker = Color3.new(colour.R * 0.45, colour.G * 0.45, colour.B * 0.45)
	for i = 0, slats - 1 do
		BuildKit.detail({
			name = "Slat",
			size = Vector3.new(0.22, 0.14, width - 0.3),
			cf = cf * CFrame.new(0.05, -height * 0.5 + 0.15 + i * step, 0) * CFrame.Angles(0, 0, math.rad(22)),
			colour = darker,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
end

--- A mesh grille made from crossing bars. Used on radiator faces and windows
--- that should read as barred rather than glazed.
function BuildKit.grille(cf: CFrame, width: number, height: number, spacing: number, colour: Color3, parent: Instance)
	local bars = math.max(2, math.floor(width / spacing))
	for i = 0, bars do
		BuildKit.detail({
			name = "GrilleBar",
			size = Vector3.new(0.1, height, 0.1),
			cf = cf * CFrame.new(0, 0, -width * 0.5 + (width / bars) * i),
			colour = colour,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	local rows = math.max(2, math.floor(height / spacing))
	for i = 0, rows do
		BuildKit.detail({
			name = "GrilleBar",
			size = Vector3.new(0.09, 0.09, width),
			cf = cf * CFrame.new(0, -height * 0.5 + (height / rows) * i, 0),
			colour = colour,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
end

--- A climbable ladder. Rungs are collidable and tagged so the movement system
--- can offer a climb prompt; stiles are decoration.
function BuildKit.ladder(baseCF: CFrame, height: number, width: number, colour: Color3, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = "Ladder"
	for _, sign in { 1, -1 } do
		BuildKit.detail({
			name = "Stile",
			size = Vector3.new(0.16, height, 0.16),
			cf = baseCF * CFrame.new(sign * width * 0.5, height * 0.5, 0),
			colour = colour,
			material = Enum.Material.Metal,
			parent = model,
		})
	end
	local rungs = math.max(2, math.floor(height / 1.4))
	for i = 0, rungs do
		local rung = BuildKit.part({
			name = "Rung",
			size = Vector3.new(width, 0.14, 0.14),
			cf = baseCF * CFrame.new(0, 0.6 + (height - 1.0) / rungs * i, 0),
			colour = colour,
			material = Enum.Material.Metal,
			canCollide = false,
			castShadow = false,
			parent = model,
		})
		rung:AddTag("LadderRung")
	end
	model.Parent = parent
	return model
end

--- Corrugated sheeting, for shed walls and roofs. Built as one flat panel plus
--- ribs so a large wall is two dozen parts rather than two hundred.
function BuildKit.corrugated(cf: CFrame, width: number, height: number, colour: Color3, parent: Instance)
	BuildKit.part({
		name = "Sheet",
		size = Vector3.new(0.3, height, width),
		cf = cf,
		colour = colour,
		material = Enum.Material.CorrodedMetal,
		parent = parent,
	})
	local ribs = math.max(3, math.floor(width / 1.6))
	local darker = Color3.new(colour.R * 0.8, colour.G * 0.8, colour.B * 0.8)
	for i = 0, ribs do
		BuildKit.detail({
			name = "Rib",
			size = Vector3.new(0.14, height, 0.22),
			cf = cf * CFrame.new(0.2, 0, -width * 0.5 + (width / ribs) * i),
			colour = darker,
			material = Enum.Material.CorrodedMetal,
			parent = parent,
		})
	end
end

--------------------------------------------------------------------------
-- Openings
--------------------------------------------------------------------------

--- A window: frame, glass and a sill. Glass is non-collidable and
--- non-queryable so it never blocks a raycast or a bullet.
function BuildKit.window(cf: CFrame, width: number, height: number, frameColour: Color3, parent: Instance, broken: boolean?)
	local t = 0.14
	local function frameMember(size: Vector3, offset: CFrame)
		BuildKit.detail({
			name = "Frame",
			size = size,
			cf = cf * offset,
			colour = frameColour,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	frameMember(Vector3.new(t, height, 0.3), CFrame.new(0, 0, -width * 0.5))
	frameMember(Vector3.new(t, height, 0.3), CFrame.new(0, 0, width * 0.5))
	frameMember(Vector3.new(t, 0.3, width), CFrame.new(0, height * 0.5, 0))
	frameMember(Vector3.new(t, 0.3, width), CFrame.new(0, -height * 0.5, 0))
	if not broken then
		local glass = BuildKit.detail({
			name = "Glass",
			size = Vector3.new(0.06, height - 0.3, width - 0.3),
			cf = cf,
			colour = C(150, 170, 185),
			material = Enum.Material.Glass,
			transparency = 0.72,
			reflectance = 0.12,
			parent = parent,
		})
		glass.Name = "Glass"
	else
		-- Broken windows keep a few shards so the opening still reads as glazed.
		for i = 1, 4 do
			BuildKit.detail({
				name = "Shard",
				size = Vector3.new(0.06, math.random(20, 60) / 100, math.random(20, 70) / 100),
				cf = cf
					* CFrame.new(0, height * 0.5 - 0.3 - i * 0.15, (i - 2.5) * width * 0.22)
					* CFrame.Angles(math.rad(math.random(-12, 12)), 0, math.rad(math.random(-20, 20))),
				colour = C(150, 170, 185),
				material = Enum.Material.Glass,
				transparency = 0.6,
				parent = parent,
			})
		end
	end
end

--- A hinged door as its own Model with a PrimaryPart at the hinge, so
--- DoorService can swing it by rotating the model rather than tweening parts.
function BuildKit.door(
	hingeCF: CFrame,
	width: number,
	height: number,
	thickness: number,
	colour: Color3,
	material: Enum.Material,
	parent: Instance
): Model
	local model = Instance.new("Model")
	model.Name = "Door"

	local hinge = BuildKit.part({
		name = "Hinge",
		size = Vector3.new(0.2, 0.2, 0.2),
		cf = hingeCF,
		transparency = 1,
		canCollide = false,
		canQuery = false,
		castShadow = false,
		parent = model,
	})

	local leaf = BuildKit.part({
		name = "Leaf",
		size = Vector3.new(thickness, height, width),
		cf = hingeCF * CFrame.new(0, height * 0.5, -width * 0.5),
		colour = colour,
		material = material,
		parent = model,
	})

	-- Handle, so the door reads as openable before you get the prompt.
	BuildKit.detail({
		name = "Handle",
		size = Vector3.new(thickness + 0.2, 0.12, 0.5),
		cf = hingeCF * CFrame.new(0, height * 0.48, -width * 0.85),
		colour = C(168, 150, 110),
		material = Enum.Material.Metal,
		parent = model,
	})

	model.PrimaryPart = hinge
	leaf:AddTag("DoorLeaf")
	model.Parent = parent
	return model
end

--------------------------------------------------------------------------
-- Lighting
--------------------------------------------------------------------------

--- A practical light: a visible fitting plus the light source. Every light in
--- this game has a visible source, because an unexplained pool of light in a
--- horror game reads as a bug.
function BuildKit.lamp(
	cf: CFrame,
	kind: string,
	colour: Color3,
	brightness: number,
	range: number,
	parent: Instance
): (Part, Light)
	local housingColour = C(48, 50, 54)
	local housing: Part
	local light: Light

	if kind == "pendant" then
		BuildKit.detail({
			name = "Flex",
			size = Vector3.new(0.08, 1.2, 0.08),
			cf = cf * CFrame.new(0, 0.6, 0),
			colour = housingColour,
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.detail({
			name = "Shade",
			size = Vector3.new(1.4, 0.5, 1.4),
			cf = cf * CFrame.new(0, 0.2, 0),
			colour = C(184, 178, 162),
			material = Enum.Material.Metal,
			parent = parent,
		})
		housing = BuildKit.detail({
			name = "Bulb",
			size = Vector3.new(0.42, 0.42, 0.42),
			cf = cf,
			colour = colour,
			material = Enum.Material.Neon,
			shape = Enum.PartType.Ball,
			parent = parent,
		})
		local point = Instance.new("PointLight")
		point.Color = colour
		point.Brightness = brightness
		point.Range = range
		point.Shadows = true
		point.Parent = housing
		light = point
	elseif kind == "flood" then
		BuildKit.detail({
			name = "Bracket",
			size = Vector3.new(0.24, 0.8, 0.24),
			cf = cf * CFrame.new(0, 0.5, 0),
			colour = housingColour,
			material = Enum.Material.Metal,
			parent = parent,
		})
		housing = BuildKit.detail({
			name = "FloodBody",
			size = Vector3.new(1.1, 0.9, 1.6),
			cf = cf,
			colour = housingColour,
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.detail({
			name = "Lens",
			size = Vector3.new(0.2, 0.7, 1.4),
			cf = cf * CFrame.new(-0.6, 0, 0),
			colour = colour,
			material = Enum.Material.Neon,
			parent = parent,
		})
		local spot = Instance.new("SpotLight")
		spot.Color = colour
		spot.Brightness = brightness
		spot.Range = range
		spot.Angle = 78
		spot.Face = Enum.NormalId.Left
		spot.Shadows = true
		spot.Parent = housing
		light = spot
	elseif kind == "strip" then
		housing = BuildKit.detail({
			name = "StripBody",
			size = Vector3.new(0.3, 0.3, 6),
			cf = cf,
			colour = C(190, 190, 186),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		BuildKit.detail({
			name = "Diffuser",
			size = Vector3.new(0.22, 0.16, 5.6),
			cf = cf * CFrame.new(0, -0.16, 0),
			colour = colour,
			material = Enum.Material.Neon,
			parent = parent,
		})
		local surface = Instance.new("SurfaceLight")
		surface.Color = colour
		surface.Brightness = brightness
		surface.Range = range
		surface.Angle = 120
		surface.Face = Enum.NormalId.Bottom
		surface.Parent = housing
		light = surface
	else -- "bulkhead", the default
		housing = BuildKit.detail({
			name = "BulkheadBody",
			size = Vector3.new(0.5, 0.9, 0.9),
			cf = cf,
			colour = housingColour,
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.detail({
			name = "Lens",
			size = Vector3.new(0.24, 0.62, 0.62),
			cf = cf * CFrame.new(-0.3, 0, 0),
			colour = colour,
			material = Enum.Material.Neon,
			parent = parent,
		})
		BuildKit.grille(cf * CFrame.new(-0.36, 0, 0), 0.7, 0.7, 0.22, housingColour, parent)
		local point = Instance.new("PointLight")
		point.Color = colour
		point.Brightness = brightness
		point.Range = range
		point.Shadows = true
		point.Parent = housing
		light = point
	end

	housing:AddTag("PracticalLight")
	return housing, light
end

--------------------------------------------------------------------------
-- Materials and wear
--------------------------------------------------------------------------

BuildKit.Palette = {
	rustedSteel = C(112, 74, 52),
	paintedSteel = C(88, 94, 98),
	darkSteel = C(46, 48, 52),
	galvanised = C(150, 154, 158),
	brass = C(172, 138, 70),
	concrete = C(132, 130, 124),
	weatheredConcrete = C(108, 106, 100),
	sleeper = C(64, 52, 42),
	ballast = C(96, 92, 86),
	bark = C(72, 58, 46),
	darkBark = C(52, 42, 34),
	foliage = C(38, 56, 40),
	deepFoliage = C(28, 44, 32),
	soil = C(52, 44, 36),
	planking = C(104, 84, 60),
	weatheredPlank = C(88, 78, 64),
	glass = C(150, 170, 185),
	canvas = C(122, 112, 90),
}

--- Applies a subtle per-instance colour jitter. Identical parts across a
--- forest or a row of buildings are the main thing that makes a procedural
--- world look procedural, and this is the cheapest fix.
function BuildKit.weather(colour: Color3, amount: number, rng: Random): Color3
	local jitter = function()
		return (rng:NextNumber() - 0.5) * 2 * amount
	end
	return Color3.new(
		math.clamp(colour.R + jitter(), 0, 1),
		math.clamp(colour.G + jitter(), 0, 1),
		math.clamp(colour.B + jitter(), 0, 1)
	)
end

--- Streaks of rust down a painted surface. Applied to large metal faces on
--- the train and on station buildings.
function BuildKit.rustStreaks(cf: CFrame, width: number, height: number, count: number, rng: Random, parent: Instance)
	for _ = 1, count do
		local w = rng:NextNumber(0.12, 0.4)
		local h = rng:NextNumber(height * 0.2, height * 0.75)
		BuildKit.detail({
			name = "Streak",
			size = Vector3.new(0.05, h, w),
			cf = cf
				* CFrame.new(0, height * 0.5 - h * 0.5 - rng:NextNumber(0, height * 0.2), rng:NextNumber(-width * 0.5, width * 0.5)),
			colour = BuildKit.weather(BuildKit.Palette.rustedSteel, 0.06, rng),
			material = Enum.Material.CorrodedMetal,
			transparency = 0.25,
			parent = parent,
		})
	end
end

--------------------------------------------------------------------------
-- Model helpers
--------------------------------------------------------------------------

function BuildKit.model(name: string, parent: Instance?): Model
	local model = Instance.new("Model")
	model.Name = name
	if parent then
		model.Parent = parent
	end
	return model
end

--- Welds every BasePart in a model to the given root, then unanchors them.
--- Used for objects that must move as one rigid body, such as dropped items.
function BuildKit.weldAssembly(model: Model, root: BasePart)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = root
			descendant.Anchored = false
		end
	end
	root.Anchored = false
end

--- Sets the whole model anchored, which is the default for scenery.
function BuildKit.anchorAll(model: Model)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
end

--- Counts parts, so builders can report their cost and the performance budget
--- in docs/PERFORMANCE.md can be checked rather than guessed.
function BuildKit.countParts(instance: Instance): number
	local n = 0
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

--- Adds a ProximityPrompt configured to this project's conventions: short
--- hold, generous distance, and no floating billboard.
function BuildKit.prompt(
	parent: BasePart,
	actionText: string,
	objectText: string,
	holdDuration: number?,
	maxDistance: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration or 0
	prompt.MaxActivationDistance = maxDistance or 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = parent
	return prompt
end

--------------------------------------------------------------------------
-- Track
--------------------------------------------------------------------------

--- Builds a straight run of railway: ballast shoulder, sleepers and two rails.
--- Sleepers are cloned from a single template, which keeps a 14,000 stud line
--- affordable.
function BuildKit.trackSection(originCF: CFrame, length: number, parent: Instance, rng: Random): Model
	local model = BuildKit.model("Track", parent)
	local gauge = 9.4

	-- Ballast shoulder as two long parts rather than many small ones.
	BuildKit.part({
		name = "Ballast",
		size = Vector3.new(26, 1.6, length),
		cf = originCF * CFrame.new(0, -0.8, -length * 0.5),
		colour = BuildKit.Palette.ballast,
		material = Enum.Material.Slate,
		parent = model,
	})

	local sleeperTemplate = BuildKit.part({
		name = "Sleeper",
		size = Vector3.new(14, 0.7, 1.8),
		cf = CFrame.new(),
		colour = BuildKit.Palette.sleeper,
		material = Enum.Material.WoodPlanks,
		canQuery = false,
		castShadow = false,
	})

	local spacing = 3.2
	local count = math.floor(length / spacing)
	for i = 0, count - 1 do
		local sleeper = sleeperTemplate:Clone()
		sleeper.CFrame = originCF
			* CFrame.new(0, 0.15, -i * spacing - spacing * 0.5)
			* CFrame.Angles(0, math.rad(rng:NextNumber(-1.2, 1.2)), 0)
		sleeper.Color = BuildKit.weather(BuildKit.Palette.sleeper, 0.05, rng)
		sleeper.Parent = model
	end
	sleeperTemplate:Destroy()

	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "Rail",
			size = Vector3.new(0.9, 0.9, length),
			cf = originCF * CFrame.new(side * gauge * 0.5, 0.85, -length * 0.5),
			colour = C(102, 96, 88),
			material = Enum.Material.Metal,
			reflectance = 0.08,
			castShadow = false,
			parent = model,
		})
		-- Rail head, the shiny worn strip on top.
		BuildKit.detail({
			name = "RailHead",
			size = Vector3.new(0.5, 0.12, length),
			cf = originCF * CFrame.new(side * gauge * 0.5, 1.32, -length * 0.5),
			colour = C(168, 166, 160),
			material = Enum.Material.Metal,
			reflectance = 0.3,
			parent = model,
		})
	end

	return model
end

return BuildKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ForestBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ForestBuilder
	-------------
	The dense night forest either side of the railway.

	THE PROBLEM THIS SOLVES
	-----------------------
	A procedural forest fails in three recognisable ways: obvious grid spacing,
	identical trees, and a thin band of scenery around a small stage. All three
	are addressed here deliberately.

	  Grid       Positions come from jittered Poisson-ish sampling with a
	             per-cell random offset and rejection against a minimum spacing,
	             so no two trees line up and no row is visible.
	  Sameness   Six tree archetypes, each built with randomised height, lean,
	             trunk taper, branch count and per-instance colour jitter. A
	             template is built once per archetype and cloned, then mutated,
	             which keeps the cost affordable.
	  Thinness   The forest is generated in streaming chunks along the whole
	             14,000 stud corridor rather than as set dressing around
	             stations, and undergrowth, deadfall, rocks and stumps fill the
	             floor so the ground is never bare.

	Everything here is anchored, non-collidable except trunks, and does not cast
	shadows except for trunks, which is what keeps a forest this size affordable
	with Future lighting on.
]]

local BuildKit = require(script.Parent.BuildKit)

local C = Color3.fromRGB
local P = BuildKit.Palette

local ForestBuilder = {}

--------------------------------------------------------------------------
-- Tree archetypes
--------------------------------------------------------------------------

export type TreeArchetype = {
	id: string,
	minHeight: number,
	maxHeight: number,
	trunkRadius: number,
	canopyStyle: string,
	barkColour: Color3,
	foliageColour: Color3,
	weight: number,
}

local ARCHETYPES: { TreeArchetype } = {
	{
		id = "spruce_tall",
		minHeight = 58,
		maxHeight = 92,
		trunkRadius = 1.5,
		canopyStyle = "conifer",
		barkColour = C(58, 46, 38),
		foliageColour = C(30, 48, 34),
		weight = 30,
	},
	{
		id = "spruce_young",
		minHeight = 26,
		maxHeight = 44,
		trunkRadius = 0.9,
		canopyStyle = "conifer",
		barkColour = C(66, 54, 42),
		foliageColour = C(36, 58, 40),
		weight = 22,
	},
	{
		id = "pine",
		minHeight = 62,
		maxHeight = 104,
		trunkRadius = 1.7,
		canopyStyle = "pine",
		barkColour = C(84, 60, 44),
		foliageColour = C(34, 52, 36),
		weight = 18,
	},
	{
		id = "birch",
		minHeight = 40,
		maxHeight = 64,
		trunkRadius = 0.8,
		canopyStyle = "broadleaf",
		barkColour = C(196, 192, 180),
		foliageColour = C(52, 62, 40),
		weight = 12,
	},
	{
		id = "oak_old",
		minHeight = 44,
		maxHeight = 70,
		trunkRadius = 2.4,
		canopyStyle = "broadleaf",
		barkColour = C(68, 56, 44),
		foliageColour = C(44, 56, 36),
		weight = 10,
	},
	{
		id = "dead_standing",
		minHeight = 34,
		maxHeight = 66,
		trunkRadius = 1.2,
		canopyStyle = "dead",
		barkColour = C(84, 76, 66),
		foliageColour = C(60, 54, 46),
		weight = 8,
	},
}

--------------------------------------------------------------------------
-- Tree construction
--------------------------------------------------------------------------

local function buildTrunk(model: Model, height: number, radius: number, bark: Color3, lean: CFrame, rng: Random)
	-- Trunk in tapering segments, so it is not a uniform pole.
	local segments = math.clamp(math.floor(height / 16), 2, 5)
	local segmentHeight = height / segments
	local cf = lean
	for i = 0, segments - 1 do
		local taper = 1 - (i / segments) * 0.55
		local segCF = cf * CFrame.new(0, segmentHeight * 0.5, 0)
		local part = BuildKit.part({
			name = "Trunk",
			size = Vector3.new(radius * 2 * taper, segmentHeight * 1.02, radius * 2 * taper),
			cf = segCF,
			colour = BuildKit.weather(bark, 0.035, rng),
			material = Enum.Material.Wood,
			canCollide = i == 0, -- only the base blocks movement
			canQuery = true,
			castShadow = i < 2,
			parent = model,
		})
		part.Shape = Enum.PartType.Cylinder
		part.CFrame = segCF * CFrame.Angles(0, 0, math.rad(90))
		part.Size = Vector3.new(segmentHeight * 1.02, radius * 2 * taper, radius * 2 * taper)
		-- Each segment leans slightly further, giving a natural crookedness.
		cf = cf
			* CFrame.new(0, segmentHeight, 0)
			* CFrame.Angles(math.rad(rng:NextNumber(-3, 3)), 0, math.rad(rng:NextNumber(-3, 3)))
	end

	-- Root flare at the base.
	for i = 0, 3 do
		BuildKit.detail({
			name = "Root",
			size = Vector3.new(radius * 0.7, radius * 1.6, radius * 2.6),
			cf = lean
				* CFrame.Angles(0, math.rad(i * 90 + rng:NextNumber(-20, 20)), 0)
				* CFrame.new(0, radius * 0.5, radius * 1.2)
				* CFrame.Angles(math.rad(28), 0, 0),
			colour = BuildKit.weather(bark, 0.03, rng),
			material = Enum.Material.Wood,
			parent = model,
		})
	end
	return cf
end

local function buildConiferCanopy(model: Model, topCF: CFrame, height: number, foliage: Color3, rng: Random)
	local tiers = math.clamp(math.floor(height / 9), 4, 9)
	local canopyHeight = height * 0.62
	for i = 0, tiers - 1 do
		local t = i / (tiers - 1)
		local radius = (1 - t * 0.86) * height * 0.16 + 1.5
		local y = -canopyHeight + t * canopyHeight
		BuildKit.detail({
			name = "Foliage",
			size = Vector3.new(radius * 2, canopyHeight / tiers * 1.9, radius * 2),
			cf = topCF
				* CFrame.new(rng:NextNumber(-0.8, 0.8), y, rng:NextNumber(-0.8, 0.8))
				* CFrame.Angles(0, math.rad(rng:NextNumber(0, 360)), 0),
			colour = BuildKit.weather(foliage, 0.045, rng),
			material = Enum.Material.Grass,
			castShadow = i < 2,
			parent = model,
		})
	end
	-- Leader spike at the very top.
	BuildKit.detail({
		name = "Leader",
		size = Vector3.new(2.2, height * 0.1, 2.2),
		cf = topCF * CFrame.new(0, height * 0.04, 0),
		colour = BuildKit.weather(foliage, 0.04, rng),
		material = Enum.Material.Grass,
		parent = model,
	})
end

local function buildPineCanopy(model: Model, topCF: CFrame, height: number, foliage: Color3, rng: Random)
	-- Pines carry their mass at the top with a bare lower trunk, which makes
	-- the forest floor readable and keeps sightlines interesting.
	local clumps = rng:NextInteger(4, 6)
	for i = 1, clumps do
		local angle = math.rad((360 / clumps) * i + rng:NextNumber(-25, 25))
		local reach = height * rng:NextNumber(0.1, 0.18)
		BuildKit.detail({
			name = "Foliage",
			size = Vector3.new(reach * 1.7, height * 0.14, reach * 1.7),
			cf = topCF
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, rng:NextNumber(-height * 0.12, 0), reach * 0.6),
			colour = BuildKit.weather(foliage, 0.05, rng),
			material = Enum.Material.Grass,
			castShadow = i <= 2,
			parent = model,
		})
		-- The branch that holds the clump.
		BuildKit.detail({
			name = "Branch",
			size = Vector3.new(0.5, 0.5, reach),
			cf = topCF * CFrame.Angles(0, angle, 0) * CFrame.new(0, rng:NextNumber(-height * 0.12, 0), reach * 0.5),
			colour = C(58, 46, 38),
			material = Enum.Material.Wood,
			parent = model,
		})
	end
end

local function buildBroadleafCanopy(model: Model, topCF: CFrame, height: number, foliage: Color3, rng: Random)
	local clumps = rng:NextInteger(5, 8)
	local spread = height * 0.3
	for _ = 1, clumps do
		local offset = Vector3.new(
			rng:NextNumber(-spread, spread),
			rng:NextNumber(-height * 0.12, height * 0.08),
			rng:NextNumber(-spread, spread)
		)
		local size = rng:NextNumber(spread * 0.7, spread * 1.3)
		BuildKit.detail({
			name = "Foliage",
			size = Vector3.new(size, size * 0.75, size),
			cf = topCF * CFrame.new(offset),
			colour = BuildKit.weather(foliage, 0.05, rng),
			material = Enum.Material.Grass,
			shape = Enum.PartType.Ball,
			castShadow = false,
			parent = model,
		})
	end
end

local function buildDeadCanopy(model: Model, topCF: CFrame, height: number, rng: Random)
	local branches = rng:NextInteger(4, 7)
	for i = 1, branches do
		local angle = math.rad((360 / branches) * i + rng:NextNumber(-30, 30))
		local len = height * rng:NextNumber(0.12, 0.24)
		BuildKit.detail({
			name = "DeadBranch",
			size = Vector3.new(0.6, 0.6, len),
			cf = topCF
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, rng:NextNumber(-height * 0.2, 0), len * 0.5)
				* CFrame.Angles(math.rad(rng:NextNumber(-35, -10)), 0, 0),
			colour = C(84, 76, 66),
			material = Enum.Material.Wood,
			parent = model,
		})
	end
end

--- Builds one tree template. Templates are cloned rather than rebuilt.
local function buildTreeTemplate(archetype: TreeArchetype, rng: Random): Model
	local model = BuildKit.model("Tree_" .. archetype.id, nil)
	local height = rng:NextNumber(archetype.minHeight, archetype.maxHeight)
	local lean = CFrame.Angles(math.rad(rng:NextNumber(-4, 4)), 0, math.rad(rng:NextNumber(-4, 4)))
	local topCF = buildTrunk(model, height, archetype.trunkRadius, archetype.barkColour, lean, rng)

	if archetype.canopyStyle == "conifer" then
		buildConiferCanopy(model, topCF, height, archetype.foliageColour, rng)
	elseif archetype.canopyStyle == "pine" then
		buildPineCanopy(model, topCF, height, archetype.foliageColour, rng)
	elseif archetype.canopyStyle == "broadleaf" then
		buildBroadleafCanopy(model, topCF, height, archetype.foliageColour, rng)
	else
		buildDeadCanopy(model, topCF, height, rng)
	end

	return model
end

--------------------------------------------------------------------------
-- Ground cover
--------------------------------------------------------------------------

local function buildUndergrowth(cf: CFrame, parent: Instance, rng: Random)
	local kind = rng:NextInteger(1, 4)
	if kind == 1 then
		-- Fern clump.
		for _ = 1, rng:NextInteger(3, 6) do
			BuildKit.detail({
				name = "Fern",
				size = Vector3.new(rng:NextNumber(1.4, 3.2), 0.25, rng:NextNumber(1.4, 3.2)),
				cf = cf
					* CFrame.new(rng:NextNumber(-2, 2), rng:NextNumber(0.2, 1.2), rng:NextNumber(-2, 2))
					* CFrame.Angles(math.rad(rng:NextNumber(-30, 30)), math.rad(rng:NextNumber(0, 360)), 0),
				colour = BuildKit.weather(C(38, 54, 36), 0.05, rng),
				material = Enum.Material.Grass,
				parent = parent,
			})
		end
	elseif kind == 2 then
		-- Bramble mound.
		BuildKit.detail({
			name = "Bramble",
			size = Vector3.new(rng:NextNumber(4, 8), rng:NextNumber(1.6, 3.2), rng:NextNumber(4, 8)),
			cf = cf * CFrame.new(0, 0.8, 0),
			colour = BuildKit.weather(C(34, 44, 32), 0.04, rng),
			material = Enum.Material.Grass,
			shape = Enum.PartType.Ball,
			parent = parent,
		})
	elseif kind == 3 then
		-- Rock.
		local size = rng:NextNumber(2, 7)
		BuildKit.part({
			name = "Rock",
			size = Vector3.new(size, size * rng:NextNumber(0.5, 0.9), size * rng:NextNumber(0.7, 1.3)),
			cf = cf * CFrame.new(0, size * 0.25, 0) * CFrame.Angles(math.rad(rng:NextNumber(-15, 15)), math.rad(rng:NextNumber(0, 360)), math.rad(rng:NextNumber(-15, 15))),
			colour = BuildKit.weather(C(88, 86, 82), 0.05, rng),
			material = Enum.Material.Rock,
			canQuery = false,
			parent = parent,
		})
	else
		-- Stump.
		local radius = rng:NextNumber(1.2, 2.6)
		local stump = BuildKit.part({
			name = "Stump",
			size = Vector3.new(radius * 2, rng:NextNumber(1.5, 3.5), radius * 2),
			cf = cf * CFrame.new(0, 1.2, 0),
			colour = BuildKit.weather(P.darkBark, 0.04, rng),
			material = Enum.Material.Wood,
			parent = parent,
		})
		stump.Shape = Enum.PartType.Cylinder
		stump.CFrame = cf * CFrame.new(0, 1.2, 0) * CFrame.Angles(0, 0, math.rad(90))
		stump.Size = Vector3.new(stump.Size.Y, radius * 2, radius * 2)
	end
end

local function buildDeadfall(cf: CFrame, parent: Instance, rng: Random)
	local length = rng:NextNumber(14, 34)
	local radius = rng:NextNumber(1.0, 2.2)
	local log = BuildKit.part({
		name = "FallenLog",
		size = Vector3.new(length, radius * 2, radius * 2),
		cf = cf * CFrame.new(0, radius, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 360)), math.rad(rng:NextNumber(-6, 6))),
		colour = BuildKit.weather(P.darkBark, 0.05, rng),
		material = Enum.Material.Wood,
		parent = parent,
	})
	log.Shape = Enum.PartType.Cylinder
	-- Moss on the upper face.
	BuildKit.detail({
		name = "Moss",
		size = Vector3.new(length * 0.8, 0.3, radius * 1.5),
		cf = log.CFrame * CFrame.new(0, 0, 0) * CFrame.new(0, radius * 0.9, 0),
		colour = C(48, 62, 42),
		material = Enum.Material.Grass,
		parent = parent,
	})
end

--------------------------------------------------------------------------
-- Placement
--------------------------------------------------------------------------

export type ForestOptions = {
	-- World-space centre of the region to populate.
	centre: Vector3,
	-- Half-extents. X is across the track, Z is along it.
	halfExtents: Vector2,
	-- Corridor kept clear along the X = centre.X line, for the railway.
	trackClearance: number,
	-- Circular clearings carved out for stations, in world space.
	clearings: { { position: Vector3, radius: number } },
	density: number, -- trees per 10,000 square studs
	seed: number,
	parent: Instance,
}

--- Rejection-sampled placement. Cells are visited in a shuffled order and each
--- candidate is jittered inside its cell, which removes the grid entirely
--- while keeping the cost linear in area.
function ForestBuilder.populate(options: ForestOptions): Model
	local rng = Random.new(options.seed)
	local forest = BuildKit.model("Forest", nil)

	-- Build one template per archetype, then clone.
	local templates: { { archetype: TreeArchetype, variants: { Model } } } = {}
	for _, archetype in ARCHETYPES do
		local variants: { Model } = {}
		-- Four variants per archetype is enough that repetition is not visible
		-- once per-instance rotation and colour jitter are applied.
		for _ = 1, 4 do
			table.insert(variants, buildTreeTemplate(archetype, rng))
		end
		table.insert(templates, { archetype = archetype, variants = variants })
	end

	local totalWeight = 0
	for _, entry in templates do
		totalWeight += entry.archetype.weight
	end

	local function pickTemplate(): Model
		local roll = rng:NextNumber() * totalWeight
		for _, entry in templates do
			roll -= entry.archetype.weight
			if roll <= 0 then
				return entry.variants[rng:NextInteger(1, #entry.variants)]
			end
		end
		local last = templates[#templates]
		return last.variants[1]
	end

	local cellSize = math.sqrt(10000 / math.max(0.01, options.density))
	local cellsX = math.floor((options.halfExtents.X * 2) / cellSize)
	local cellsZ = math.floor((options.halfExtents.Y * 2) / cellSize)

	local placed = 0
	local groundCover = 0

	for ix = 0, cellsX - 1 do
		for iz = 0, cellsZ - 1 do
			local baseX = options.centre.X - options.halfExtents.X + ix * cellSize
			local baseZ = options.centre.Z - options.halfExtents.Y + iz * cellSize
			local x = baseX + rng:NextNumber(0, cellSize)
			local z = baseZ + rng:NextNumber(0, cellSize)
			local position = Vector3.new(x, options.centre.Y, z)

			-- Reject inside the railway corridor.
			if math.abs(x - options.centre.X) < options.trackClearance then
				continue
			end

			-- Reject inside station clearings, with a soft edge so the forest
			-- thins towards a clearing rather than stopping at a hard circle.
			local rejected = false
			for _, clearing in options.clearings do
				local distance = (Vector3.new(position.X, 0, position.Z) - Vector3.new(clearing.position.X, 0, clearing.position.Z)).Magnitude
				if distance < clearing.radius then
					rejected = true
					break
				elseif distance < clearing.radius * 1.4 then
					-- Thinning band.
					local edgeT = (distance - clearing.radius) / (clearing.radius * 0.4)
					if rng:NextNumber() > edgeT then
						rejected = true
						break
					end
				end
			end
			if rejected then
				-- Clearing edges still get ground cover, so they are not bald.
				if rng:NextNumber() < 0.25 then
					buildUndergrowth(CFrame.new(position), forest, rng)
					groundCover += 1
				end
				continue
			end

			local tree = pickTemplate():Clone()
			tree:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 360)), 0))
			-- Per-instance colour jitter on top of the template's own.
			for _, descendant in tree:GetDescendants() do
				if descendant:IsA("BasePart") then
					descendant.Color = BuildKit.weather(descendant.Color, 0.02, rng)
				end
			end
			tree.Parent = forest
			placed += 1

			-- Ground cover clustered near trunks, as it is in real woodland.
			if rng:NextNumber() < 0.55 then
				buildUndergrowth(
					CFrame.new(position + Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8))),
					forest,
					rng
				)
				groundCover += 1
			end
			if rng:NextNumber() < 0.09 then
				buildDeadfall(
					CFrame.new(position + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))),
					forest,
					rng
				)
				groundCover += 1
			end
		end
	end

	for _, entry in templates do
		for _, variant in entry.variants do
			variant:Destroy()
		end
	end

	forest:SetAttribute("TreeCount", placed)
	forest:SetAttribute("GroundCoverCount", groundCover)
	forest.Parent = options.parent
	return forest
end

--- A dense screen of trees used to close off the far ends of the corridor, so
--- a player who walks off the map hits forest rather than a void.
function ForestBuilder.buildBoundary(centre: Vector3, length: number, facing: Vector3, parent: Instance, seed: number): Model
	local rng = Random.new(seed)
	local model = BuildKit.model("ForestBoundary", parent)
	local template = buildTreeTemplate(ARCHETYPES[1], rng)
	local rows = 4
	for row = 0, rows - 1 do
		local rowCount = math.floor(length / 16)
		for i = 0, rowCount do
			local along = -length * 0.5 + i * 16 + rng:NextNumber(-5, 5)
			local perpendicular = facing * (row * 14 + rng:NextNumber(-4, 4))
			local pos = centre + Vector3.new(along, 0, 0) + perpendicular
			local tree = template:Clone()
			tree:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 360)), 0))
			tree.Parent = model
		end
	end
	template:Destroy()
	return model
end

ForestBuilder.Archetypes = ARCHETYPES

return ForestBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LobbyBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LobbyBuilder
	------------
	The railway maintenance yard the expedition leaves from.

	Deliberately a small, ordinary, working yard: a brick workshop, a covered
	waiting area with benches, a stores hut, a water column, a couple of sidings
	and the departure road. No concourse, no shopping arcade, no giant terminal.
	The whole thing is walkable in about twenty seconds, which is the point: a
	lobby is a place to gather, not a place to explore.

	Everything a player needs is reachable from the shelter without a map:
	  - the departure road and the train, directly ahead
	  - the crew board, under the shelter
	  - the workshop (loadout and cosmetics), on the left
	  - the stores hut (shop), on the right
	  - the notice board (quests, rewards, events), by the shelter

	Interactive fixtures are tagged here and given behaviour by LobbyService.
]]

local BuildKit = require(script.Parent.BuildKit)

local C = Color3.fromRGB
local P = BuildKit.Palette

local LobbyBuilder = {}

export type BuiltLobby = {
	model: Model,
	spawnCFrames: { CFrame },
	crewBoard: BasePart,
	workshopBench: BasePart,
	storesCounter: BasePart,
	noticeBoard: BasePart,
	trainPreviewCF: CFrame,
	departureCF: CFrame,
	lights: { Light },
	partCount: number,
}

--------------------------------------------------------------------------

local function buildWorkshop(cf: CFrame, parent: Instance, lights: { Light }, rng: Random): BasePart
	local size = Vector3.new(44, 26, 60)
	local half = size * 0.5

	-- Brick shell with a large roller-shutter opening facing the yard.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "WorkshopWall",
			size = Vector3.new(1.0, size.Y, size.Z),
			cf = cf * CFrame.new(side * half.X, size.Y * 0.5, 0),
			colour = C(122, 84, 68),
			material = Enum.Material.Brick,
			parent = parent,
		})
		for i = 0, 2 do
			BuildKit.window(
				cf * CFrame.new(side * (half.X + 0.05), 17, -18 + i * 18),
				7,
				6,
				C(64, 60, 52),
				parent,
				rng:NextNumber() < 0.2
			)
		end
	end
	BuildKit.part({
		name = "WorkshopBack",
		size = Vector3.new(size.X, size.Y, 1.0),
		cf = cf * CFrame.new(0, size.Y * 0.5, half.Z),
		colour = C(122, 84, 68),
		material = Enum.Material.Brick,
		parent = parent,
	})
	-- Front wall either side of the shutter.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "WorkshopFront",
			size = Vector3.new(size.X * 0.28, size.Y, 1.0),
			cf = cf * CFrame.new(side * (size.X * 0.36), size.Y * 0.5, -half.Z),
			colour = C(122, 84, 68),
			material = Enum.Material.Brick,
			parent = parent,
		})
	end
	BuildKit.part({
		name = "ShutterHeader",
		size = Vector3.new(size.X * 0.44, size.Y - 18, 1.0),
		cf = cf * CFrame.new(0, 18 + (size.Y - 18) * 0.5, -half.Z),
		colour = C(122, 84, 68),
		material = Enum.Material.Brick,
		parent = parent,
	})
	-- The shutter itself, rolled up.
	BuildKit.detail({
		name = "RollerShutter",
		size = Vector3.new(size.X * 0.44, 3.0, 1.4),
		cf = cf * CFrame.new(0, 19, -half.Z),
		colour = C(112, 108, 100),
		material = Enum.Material.CorrodedMetal,
		parent = parent,
	})

	BuildKit.part({
		name = "WorkshopFloor",
		size = Vector3.new(size.X - 1, 0.6, size.Z - 1),
		cf = cf * CFrame.new(0, 0.3, 0),
		colour = C(88, 86, 82),
		material = Enum.Material.Concrete,
		parent = parent,
	})
	-- Sawtooth roof, which is what a workshop of this era actually has.
	for i = 0, 2 do
		local z = -half.Z + 10 + i * 20
		BuildKit.wedge({
			name = "SawtoothRoof",
			size = Vector3.new(size.X + 1, 7, 20),
			cf = cf * CFrame.new(0, size.Y + 3.5, z) * CFrame.Angles(0, math.rad(180), 0),
			colour = C(70, 68, 64),
			material = Enum.Material.Metal,
			parent = parent,
		})
		-- North light glazing on the vertical face of each sawtooth.
		BuildKit.detail({
			name = "NorthLight",
			size = Vector3.new(size.X, 6.5, 0.4),
			cf = cf * CFrame.new(0, size.Y + 3.4, z + 10),
			colour = C(150, 170, 185),
			material = Enum.Material.Glass,
			transparency = 0.6,
			parent = parent,
		})
	end

	-- Interior: benches, a pit, tool boards, an overhead gantry crane.
	local bench = BuildKit.part({
		name = "WorkshopBench",
		size = Vector3.new(5.0, 4.0, 26.0),
		cf = cf * CFrame.new(half.X - 5, 2.6, 4),
		colour = C(96, 78, 56),
		material = Enum.Material.Wood,
		parent = parent,
	})
	bench:AddTag("WorkshopBench")
	BuildKit.detail({
		name = "BenchTop",
		size = Vector3.new(5.6, 0.5, 26.4),
		cf = bench.CFrame * CFrame.new(0, 2.2, 0),
		colour = C(112, 92, 66),
		material = Enum.Material.Wood,
		parent = parent,
	})
	for i = 0, 3 do
		BuildKit.detail({
			name = "Vice",
			size = Vector3.new(1.6, 1.6, 2.0),
			cf = bench.CFrame * CFrame.new(0, 3.2, -10 + i * 7),
			colour = C(110, 60, 50),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	BuildKit.detail({
		name = "ToolBoard",
		size = Vector3.new(0.4, 8.0, 24.0),
		cf = cf * CFrame.new(half.X - 1.2, 10, 4),
		colour = C(92, 74, 54),
		material = Enum.Material.Wood,
		parent = parent,
	})

	-- Inspection pit with a handrail, the detail that says "railway workshop".
	BuildKit.part({
		name = "PitFloor",
		size = Vector3.new(10, 0.5, 34),
		cf = cf * CFrame.new(-6, -3.5, 0),
		colour = C(72, 70, 66),
		material = Enum.Material.Concrete,
		parent = parent,
	})
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "PitWall",
			size = Vector3.new(0.8, 4.4, 34),
			cf = cf * CFrame.new(-6 + side * 5, -1.5, 0),
			colour = C(80, 78, 74),
			material = Enum.Material.Concrete,
			parent = parent,
		})
		BuildKit.handrail(cf * CFrame.new(-6 + side * 5.6, 0.6, 0), 34, 3.2, C(178, 148, 52), parent, true)
	end

	-- Overhead travelling crane.
	for _, side in { -1, 1 } do
		BuildKit.detail({
			name = "CraneRail",
			size = Vector3.new(1.2, 1.2, size.Z - 4),
			cf = cf * CFrame.new(side * (half.X - 3), 20, 0),
			colour = C(76, 80, 84),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	BuildKit.detail({
		name = "CraneBridge",
		size = Vector3.new(size.X - 6, 2.4, 3.0),
		cf = cf * CFrame.new(0, 20, -8),
		colour = C(150, 124, 44),
		material = Enum.Material.Metal,
		parent = parent,
	})
	BuildKit.detail({
		name = "CraneHook",
		size = Vector3.new(1.0, 6.0, 1.0),
		cf = cf * CFrame.new(0, 15, -8),
		colour = C(60, 58, 56),
		material = Enum.Material.Metal,
		parent = parent,
	})

	for i = 0, 2 do
		local _, light = BuildKit.lamp(
			cf * CFrame.new(0, size.Y - 4, -18 + i * 18),
			"strip",
			C(238, 244, 255),
			1.6,
			42,
			parent
		)
		table.insert(lights, light)
	end

	return bench
end

local function buildShelter(cf: CFrame, parent: Instance, lights: { Light }): (BasePart, BasePart)
	local width, length = 26, 40

	BuildKit.part({
		name = "ShelterFloor",
		size = Vector3.new(width, 0.8, length),
		cf = cf * CFrame.new(0, 0.4, 0),
		colour = P.weatheredConcrete,
		material = Enum.Material.Concrete,
		parent = parent,
	})
	-- Back and side walls; the yard side is open, which is what a waiting
	-- shelter is.
	BuildKit.part({
		name = "ShelterBack",
		size = Vector3.new(0.8, 14, length),
		cf = cf * CFrame.new(width * 0.5, 7, 0),
		colour = C(126, 88, 72),
		material = Enum.Material.Brick,
		parent = parent,
	})
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "ShelterSide",
			size = Vector3.new(width, 14, 0.8),
			cf = cf * CFrame.new(0, 7, side * length * 0.5),
			colour = C(126, 88, 72),
			material = Enum.Material.Brick,
			parent = parent,
		})
	end
	-- Posts and a lean-to canopy.
	for i = 0, 3 do
		BuildKit.detail({
			name = "ShelterPost",
			size = Vector3.new(1.0, 14, 1.0),
			cf = cf * CFrame.new(-width * 0.5 + 1, 7, -length * 0.5 + 4 + i * 10.6),
			colour = C(62, 66, 64),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	BuildKit.wedge({
		name = "Canopy",
		size = Vector3.new(width + 3, 3.5, length + 2),
		cf = cf * CFrame.new(0, 15.8, 0) * CFrame.Angles(0, math.rad(180), 0),
		colour = C(66, 64, 60),
		material = Enum.Material.Metal,
		parent = parent,
	})

	-- Benches, the ordinary slatted kind.
	local benchSeat: BasePart? = nil
	for i = 0, 2 do
		local benchCF = cf * CFrame.new(width * 0.5 - 4, 2.2, -length * 0.5 + 8 + i * 12)
		for slat = 0, 3 do
			local part = BuildKit.part({
				name = "BenchSlat",
				size = Vector3.new(0.8, 0.35, 9.0),
				cf = benchCF * CFrame.new(-1.2 + slat * 0.95, 0, 0),
				colour = C(102, 76, 50),
				material = Enum.Material.WoodPlanks,
				parent = parent,
			})
			if not benchSeat then
				benchSeat = part
			end
		end
		for slat = 0, 3 do
			BuildKit.detail({
				name = "BenchBack",
				size = Vector3.new(0.35, 0.8, 9.0),
				cf = benchCF * CFrame.new(1.8, 1.4 + slat * 0.95, 0),
				colour = C(102, 76, 50),
				material = Enum.Material.WoodPlanks,
				parent = parent,
			})
		end
		for _, end_ in { -1, 1 } do
			BuildKit.detail({
				name = "BenchFrame",
				size = Vector3.new(4.4, 2.4, 0.5),
				cf = benchCF * CFrame.new(0, -1.0, end_ * 4.2),
				colour = C(56, 58, 56),
				material = Enum.Material.Metal,
				parent = parent,
			})
		end
	end

	-- Crew board: the physical object the crew interface hangs off.
	local crewBoard = BuildKit.part({
		name = "CrewBoard",
		size = Vector3.new(0.6, 9.0, 14.0),
		cf = cf * CFrame.new(width * 0.5 - 0.9, 8.5, -length * 0.5 + 10),
		colour = C(48, 54, 50),
		material = Enum.Material.SmoothPlastic,
		parent = parent,
	})
	crewBoard:AddTag("CrewBoard")
	BuildKit.detail({
		name = "CrewBoardFrame",
		size = Vector3.new(0.8, 9.6, 14.6),
		cf = crewBoard.CFrame * CFrame.new(0.15, 0, 0),
		colour = C(142, 118, 62),
		material = Enum.Material.Metal,
		parent = parent,
	})
	BuildKit.detail({
		name = "CrewBoardGlass",
		size = Vector3.new(0.15, 8.4, 13.4),
		cf = crewBoard.CFrame * CFrame.new(-0.35, 0, 0),
		colour = C(150, 170, 185),
		material = Enum.Material.Glass,
		transparency = 0.7,
		parent = parent,
	})

	-- Notice board for quests, rewards and events.
	local noticeBoard = BuildKit.part({
		name = "NoticeBoard",
		size = Vector3.new(0.6, 8.0, 12.0),
		cf = cf * CFrame.new(width * 0.5 - 0.9, 8.0, length * 0.5 - 10),
		colour = C(96, 76, 54),
		material = Enum.Material.Wood,
		parent = parent,
	})
	noticeBoard:AddTag("NoticeBoard")
	-- Pinned papers, so it reads as a notice board before you interact.
	local rng = Random.new(7)
	for _noticeIndex = 1, 7 do
		BuildKit.detail({
			name = "Notice",
			size = Vector3.new(0.1, rng:NextNumber(1.2, 2.2), rng:NextNumber(0.9, 1.6)),
			cf = noticeBoard.CFrame
				* CFrame.new(-0.36, rng:NextNumber(-2.8, 2.8), rng:NextNumber(-4.5, 4.5))
				* CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, 0),
			colour = C(208, 200, 178),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
	end

	for i = 0, 2 do
		local _, light = BuildKit.lamp(
			cf * CFrame.new(0, 14.2, -length * 0.5 + 8 + i * 12),
			"bulkhead",
			C(255, 228, 178),
			1.1,
			30,
			parent
		)
		table.insert(lights, light)
	end

	return crewBoard, noticeBoard
end

local function buildStoresHut(cf: CFrame, parent: Instance, lights: { Light }): BasePart
	local size = Vector3.new(22, 16, 26)
	BuildKit.corrugated(cf * CFrame.new(size.X * 0.5, size.Y * 0.5, 0), size.Z, size.Y, C(98, 102, 94), parent)
	BuildKit.corrugated(cf * CFrame.new(-size.X * 0.5, size.Y * 0.5, 0), size.Z, size.Y, C(98, 102, 94), parent)
	BuildKit.corrugated(
		cf * CFrame.new(0, size.Y * 0.5, size.Z * 0.5) * CFrame.Angles(0, math.rad(90), 0),
		size.X,
		size.Y,
		C(98, 102, 94),
		parent
	)
	-- Front wall with a serving hatch, which is the shop counter.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "StoresFront",
			size = Vector3.new(size.X * 0.3, size.Y, 0.6),
			cf = cf * CFrame.new(side * size.X * 0.35, size.Y * 0.5, -size.Z * 0.5),
			colour = C(98, 102, 94),
			material = Enum.Material.CorrodedMetal,
			parent = parent,
		})
	end
	BuildKit.part({
		name = "StoresHeader",
		size = Vector3.new(size.X * 0.4, size.Y - 9, 0.6),
		cf = cf * CFrame.new(0, 9 + (size.Y - 9) * 0.5, -size.Z * 0.5),
		colour = C(98, 102, 94),
		material = Enum.Material.CorrodedMetal,
		parent = parent,
	})

	local counter = BuildKit.part({
		name = "StoresCounter",
		size = Vector3.new(size.X * 0.4, 1.0, 2.4),
		cf = cf * CFrame.new(0, 4.5, -size.Z * 0.5),
		colour = C(104, 84, 58),
		material = Enum.Material.Wood,
		parent = parent,
	})
	counter:AddTag("StoresCounter")
	BuildKit.part({
		name = "CounterFront",
		size = Vector3.new(size.X * 0.4, 4.0, 0.5),
		cf = cf * CFrame.new(0, 2.0, -size.Z * 0.5 - 0.9),
		colour = C(92, 74, 52),
		material = Enum.Material.Wood,
		parent = parent,
	})

	BuildKit.part({
		name = "StoresFloor",
		size = Vector3.new(size.X - 1, 0.5, size.Z - 1),
		cf = cf * CFrame.new(0, 0.25, 0),
		colour = C(82, 80, 76),
		material = Enum.Material.Concrete,
		parent = parent,
	})
	BuildKit.corrugated(cf * CFrame.new(0, size.Y + 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)), size.Z, size.X, C(88, 92, 86), parent)

	-- Stock on shelves behind the counter, visible through the hatch.
	for shelf = 0, 2 do
		BuildKit.detail({
			name = "StockShelf",
			size = Vector3.new(size.X - 4, 0.3, 3.0),
			cf = cf * CFrame.new(0, 4 + shelf * 3.5, size.Z * 0.4),
			colour = C(88, 84, 76),
			material = Enum.Material.Metal,
			parent = parent,
		})
		for i = 0, 5 do
			BuildKit.detail({
				name = "StockBox",
				size = Vector3.new(2.0, 2.2, 2.2),
				cf = cf * CFrame.new(-size.X * 0.4 + 2 + i * 3.2, 5.4 + shelf * 3.5, size.Z * 0.4),
				colour = C(118, 96, 66),
				material = Enum.Material.Cardboard,
				parent = parent,
			})
		end
	end

	local _, light = BuildKit.lamp(cf * CFrame.new(0, size.Y - 2, 0), "pendant", C(255, 232, 186), 1.1, 28, parent)
	table.insert(lights, light)
	local _, hatchLight = BuildKit.lamp(cf * CFrame.new(0, 9.5, -size.Z * 0.5 - 1.2), "bulkhead", C(255, 220, 170), 1.0, 20, parent)
	table.insert(lights, hatchLight)

	return counter
end

--------------------------------------------------------------------------

function LobbyBuilder.build(origin: Vector3, parent: Instance, seed: number?): BuiltLobby
	local rng = Random.new(seed or 217)
	local model = BuildKit.model("Lobby", nil)
	local lights: { Light } = {}
	local originCF = CFrame.new(origin)

	--------------------------------------------------------------
	-- Ground and yard surface
	--------------------------------------------------------------
	BuildKit.part({
		name = "YardGround",
		size = Vector3.new(420, 2, 520),
		cf = originCF * CFrame.new(0, -1, 0),
		colour = P.soil,
		material = Enum.Material.Ground,
		parent = model,
	})
	BuildKit.part({
		name = "YardHardstanding",
		size = Vector3.new(220, 0.6, 300),
		cf = originCF * CFrame.new(0, 0.3, 0),
		colour = C(96, 92, 86),
		material = Enum.Material.Asphalt,
		parent = model,
	})
	-- Puddles. The yard is wet, and wet ground under lamps is most of what
	-- sells a night scene.
	for _ = 1, 24 do
		local size = rng:NextNumber(6, 22)
		BuildKit.detail({
			name = "Puddle",
			size = Vector3.new(size, 0.08, size * rng:NextNumber(0.5, 1.2)),
			cf = originCF * CFrame.new(rng:NextNumber(-105, 105), 0.64, rng:NextNumber(-140, 140)),
			colour = C(38, 42, 46),
			material = Enum.Material.Glass,
			transparency = 0.25,
			reflectance = 0.45,
			parent = model,
		})
	end

	--------------------------------------------------------------
	-- Tracks: departure road plus two sidings
	--------------------------------------------------------------
	local departureX = 0
	BuildKit.trackSection(originCF * CFrame.new(departureX, 0, 240), 480, model, rng)
	BuildKit.trackSection(originCF * CFrame.new(departureX - 34, 0, 180), 300, model, rng)
	BuildKit.trackSection(originCF * CFrame.new(departureX + 34, 0, 180), 300, model, rng)

	-- Buffer stops at the ends of the sidings.
	for _, x in { departureX - 34, departureX + 34 } do
		local stopCF = originCF * CFrame.new(x, 0, -110)
		BuildKit.part({
			name = "BufferStop",
			size = Vector3.new(14, 5, 3),
			cf = stopCF * CFrame.new(0, 2.5, 0),
			colour = C(84, 58, 46),
			material = Enum.Material.Wood,
			parent = model,
		})
		for _, side in { -1, 1 } do
			BuildKit.detail({
				name = "BufferFace",
				size = Vector3.new(2.2, 2.2, 1.0),
				cf = stopCF * CFrame.new(side * 4.7, 3.2, -1.8),
				colour = C(48, 48, 50),
				material = Enum.Material.Metal,
				parent = model,
			})
		end
		BuildKit.detail({
			name = "BufferStripe",
			size = Vector3.new(14.2, 1.4, 0.3),
			cf = stopCF * CFrame.new(0, 4.2, -1.6),
			colour = C(196, 160, 56),
			material = Enum.Material.SmoothPlastic,
			parent = model,
		})
	end

	--------------------------------------------------------------
	-- Buildings
	--------------------------------------------------------------
	local workshopBench = buildWorkshop(originCF * CFrame.new(-86, 0, -20) * CFrame.Angles(0, math.rad(90), 0), model, lights, rng)
	local crewBoard, noticeBoard = buildShelter(originCF * CFrame.new(52, 0, -30), model, lights)
	local storesCounter = buildStoresHut(originCF * CFrame.new(74, 0, 60) * CFrame.Angles(0, math.rad(-90), 0), model, lights)

	-- Water column by the departure road, the classic yard silhouette.
	do
		local columnCF = originCF * CFrame.new(departureX + 16, 0, 40)
		BuildKit.part({
			name = "WaterColumn",
			size = Vector3.new(2.0, 18, 2.0),
			cf = columnCF * CFrame.new(0, 9, 0),
			colour = C(58, 62, 60),
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.detail({
			name = "ColumnArm",
			size = Vector3.new(1.4, 1.4, 12),
			cf = columnCF * CFrame.new(0, 17, -6),
			colour = C(58, 62, 60),
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.detail({
			name = "ColumnBag",
			size = Vector3.new(2.2, 4.0, 2.2),
			cf = columnCF * CFrame.new(0, 14.5, -11),
			colour = C(52, 46, 40),
			material = Enum.Material.Fabric,
			parent = model,
		})
		BuildKit.detail({
			name = "ColumnBrazier",
			size = Vector3.new(2.6, 2.6, 2.6),
			cf = columnCF * CFrame.new(2.6, 1.3, 0),
			colour = C(88, 62, 48),
			material = Enum.Material.CorrodedMetal,
			parent = model,
		})
	end

	-- Yard lighting: tall masts with warm sodium heads.
	for _, spec in
		{
			Vector3.new(-40, 0, 90),
			Vector3.new(40, 0, 90),
			Vector3.new(-40, 0, -60),
			Vector3.new(40, 0, -60),
			Vector3.new(0, 0, 150),
		}
	do
		local mastCF = originCF * CFrame.new(spec)
		BuildKit.part({
			name = "YardLightMast",
			size = Vector3.new(1.6, 42, 1.6),
			cf = mastCF * CFrame.new(0, 21, 0),
			colour = C(56, 60, 58),
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.detail({
			name = "MastBase",
			size = Vector3.new(4, 1.5, 4),
			cf = mastCF * CFrame.new(0, 0.75, 0),
			colour = C(80, 78, 74),
			material = Enum.Material.Concrete,
			parent = model,
		})
		for _, head in { -1, 1 } do
			local _, light = BuildKit.lamp(
				mastCF * CFrame.new(head * 3, 41, 0) * CFrame.Angles(0, 0, math.rad(if head > 0 then 20 else -20)),
				"flood",
				C(255, 206, 140),
				3.2,
				88,
				model
			)
			table.insert(lights, light)
		end
	end

	-- Scattered yard clutter: pallets, drums, a permanent way trolley, sleepers.
	for _ = 1, 16 do
		local pos = originCF * CFrame.new(rng:NextNumber(-95, 95), 0, rng:NextNumber(-130, 130))
		local pick = rng:NextInteger(1, 4)
		if pick == 1 then
			BuildKit.part({
				name = "Pallet",
				size = Vector3.new(6, 0.8, 6),
				cf = pos * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 360)), 0),
				colour = BuildKit.weather(P.planking, 0.05, rng),
				material = Enum.Material.WoodPlanks,
				parent = model,
			})
		elseif pick == 2 then
			local drum = BuildKit.part({
				name = "Drum",
				size = Vector3.new(4.4, 3.2, 3.2),
				cf = pos * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
				colour = BuildKit.weather(C(96, 72, 54), 0.07, rng),
				material = Enum.Material.CorrodedMetal,
				parent = model,
			})
			drum.Shape = Enum.PartType.Cylinder
		elseif pick == 3 then
			for i = 0, 4 do
				BuildKit.part({
					name = "StackedSleeper",
					size = Vector3.new(12, 0.9, 2.2),
					cf = pos * CFrame.new(0, 0.9 + i * 0.95, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(-3, 3)), 0),
					colour = BuildKit.weather(P.sleeper, 0.04, rng),
					material = Enum.Material.WoodPlanks,
					parent = model,
				})
			end
		else
			BuildKit.part({
				name = "RailStack",
				size = Vector3.new(1.0, 1.0, 26),
				cf = pos * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 20)), 0),
				colour = C(96, 88, 80),
				material = Enum.Material.Metal,
				parent = model,
			})
		end
	end

	-- Perimeter fence, so the yard has an edge without a wall of nothing.
	for _, side in { -1, 1 } do
		for i = 0, 24 do
			BuildKit.detail({
				name = "FencePost",
				size = Vector3.new(0.5, 9, 0.5),
				cf = originCF * CFrame.new(side * 130, 4.5, -160 + i * 13),
				colour = C(64, 58, 50),
				material = Enum.Material.Wood,
				parent = model,
			})
		end
		for wire = 0, 3 do
			BuildKit.detail({
				name = "FenceWire",
				size = Vector3.new(0.12, 0.12, 312),
				cf = originCF * CFrame.new(side * 130, 2.5 + wire * 2.0, -4),
				colour = C(70, 70, 68),
				material = Enum.Material.Metal,
				parent = model,
			})
		end
	end

	--------------------------------------------------------------
	-- Spawns
	--------------------------------------------------------------
	local spawnCFrames: { CFrame } = {}
	for i = 0, 11 do
		local angle = math.rad(i * 30)
		spawnCFrames[i + 1] = originCF
			* CFrame.new(38 + math.cos(angle) * 9, 3, -14 + math.sin(angle) * 9)
			* CFrame.Angles(0, math.rad(-90), 0)
	end

	model:AddTag("Lobby")
	model.Parent = parent

	return {
		model = model,
		spawnCFrames = spawnCFrames,
		crewBoard = crewBoard,
		workshopBench = workshopBench,
		storesCounter = storesCounter,
		noticeBoard = noticeBoard,
		-- The preview road, where the selected train is displayed.
		trainPreviewCF = originCF * CFrame.new(departureX - 34, 0, 40) * CFrame.Angles(0, math.rad(180), 0),
		-- Where the expedition train sits before departure.
		departureCF = originCF * CFrame.new(departureX, 0, 60) * CFrame.Angles(0, math.rad(180), 0),
		lights = lights,
		partCount = BuildKit.countParts(model),
	}
end

return LobbyBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">StationBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StationBuilder
	--------------
	Builds a station from its StationRegistry layout block.

	Every building marked `interior = true` gets a genuine walkable inside:
	floor, lined walls, ceiling, its own practical lighting, props, and the
	number of entrances the spec asks for. Walls are built as segments around
	door and window openings, so an opening is a real gap you can walk through
	rather than a decal on a solid box.

	Fixtures and loot nodes are built as tagged, promptable objects. This module
	only builds geometry and tags it; InteractionService and ObjectiveService
	give it behaviour. Nothing built here contains a script.
]]

local BuildKit = require(script.Parent.BuildKit)
local StationRegistry = require(game:GetService("ReplicatedStorage").LastSignal.Registry.StationRegistry)

local C = Color3.fromRGB
local P = BuildKit.Palette

local StationBuilder = {}

export type BuiltStation = {
	model: Model,
	stationId: string,
	origin: CFrame,
	fixtures: { [string]: BasePart },
	lootNodes: { { part: BasePart, kind: string, tier: number, rolls: number, guaranteed: { string } } },
	landmarks: { [string]: Vector3 },
	lights: { Light },
	doors: { Model },
	-- Set true once power is restored; used by the lighting logic.
	poweredLights: { Light },
	discoveries: { { id: string, part: BasePart } },
	partCount: number,
}

--------------------------------------------------------------------------
-- Shared building pieces
--------------------------------------------------------------------------

--- Builds a wall with rectangular openings cut out of it, as segments.
--- `openings` are in wall-local coordinates: { alongOffset, bottom, width, height }.
local function segmentedWall(
	cf: CFrame,
	length: number,
	height: number,
	thickness: number,
	colour: Color3,
	material: Enum.Material,
	openings: { { along: number, bottom: number, width: number, height: number } },
	parent: Instance
)
	-- Sort openings along the wall and build the solid runs between them.
	local sorted = table.clone(openings)
	table.sort(sorted, function(a, b)
		return a.along < b.along
	end)

	local cursor = -length * 0.5
	for _, opening in sorted do
		local openingStart = opening.along - opening.width * 0.5
		local openingEnd = opening.along + opening.width * 0.5
		if openingStart > cursor then
			local runLength = openingStart - cursor
			BuildKit.part({
				name = "Wall",
				size = Vector3.new(thickness, height, runLength),
				cf = cf * CFrame.new(0, height * 0.5, cursor + runLength * 0.5),
				colour = colour,
				material = material,
				parent = parent,
			})
		end
		-- Lintel above the opening.
		local lintelHeight = height - (opening.bottom + opening.height)
		if lintelHeight > 0.1 then
			BuildKit.part({
				name = "Lintel",
				size = Vector3.new(thickness, lintelHeight, opening.width),
				cf = cf * CFrame.new(0, opening.bottom + opening.height + lintelHeight * 0.5, opening.along),
				colour = colour,
				material = material,
				parent = parent,
			})
		end
		-- Sill below, for windows that do not reach the floor.
		if opening.bottom > 0.1 then
			BuildKit.part({
				name = "Sill",
				size = Vector3.new(thickness, opening.bottom, opening.width),
				cf = cf * CFrame.new(0, opening.bottom * 0.5, opening.along),
				colour = colour,
				material = material,
				parent = parent,
			})
		end
		cursor = openingEnd
	end
	if cursor < length * 0.5 then
		local runLength = length * 0.5 - cursor
		BuildKit.part({
			name = "Wall",
			size = Vector3.new(thickness, height, runLength),
			cf = cf * CFrame.new(0, height * 0.5, cursor + runLength * 0.5),
			colour = colour,
			material = material,
			parent = parent,
		})
	end
end

local function pitchedRoof(cf: CFrame, width: number, length: number, rise: number, colour: Color3, parent: Instance)
	for _, side in { -1, 1 } do
		BuildKit.wedge({
			name = "RoofPitch",
			size = Vector3.new(width * 0.5 + 0.6, rise, length + 1.2),
			cf = cf * CFrame.new(side * width * 0.25, rise * 0.5, 0) * CFrame.Angles(0, math.rad(if side > 0 then 0 else 180), 0),
			colour = colour,
			material = Enum.Material.Slate,
			parent = parent,
		})
	end
	-- Ridge and barge boards.
	BuildKit.detail({
		name = "Ridge",
		size = Vector3.new(1.0, 0.5, length + 1.6),
		cf = cf * CFrame.new(0, rise, 0),
		colour = C(58, 54, 50),
		material = Enum.Material.Slate,
		parent = parent,
	})
end

--- Standard interior treatment: lined walls, floor, ceiling and a practical light.
local function fitInterior(
	cf: CFrame,
	size: Vector3,
	wallColour: Color3,
	floorColour: Color3,
	lampColour: Color3,
	parent: Instance,
	lights: { Light },
	rng: Random
)
	BuildKit.part({
		name = "InteriorFloor",
		size = Vector3.new(size.X - 1.2, 0.4, size.Z - 1.2),
		cf = cf * CFrame.new(0, 0.2, 0),
		colour = floorColour,
		material = Enum.Material.WoodPlanks,
		parent = parent,
	})
	BuildKit.part({
		name = "Ceiling",
		size = Vector3.new(size.X - 1.0, 0.4, size.Z - 1.0),
		cf = cf * CFrame.new(0, size.Y - 0.2, 0),
		colour = wallColour,
		material = Enum.Material.Plaster,
		parent = parent,
	})
	-- Skirting, which is a cheap detail that reads strongly indoors.
	for _, side in { -1, 1 } do
		BuildKit.detail({
			name = "Skirting",
			size = Vector3.new(0.2, 0.8, size.Z - 1.2),
			cf = cf * CFrame.new(side * (size.X * 0.5 - 0.7), 0.8, 0),
			colour = C(70, 58, 46),
			material = Enum.Material.Wood,
			parent = parent,
		})
	end

	local count = math.max(1, math.floor(size.Z / 18))
	for i = 0, count - 1 do
		local z = -size.Z * 0.3 + i * (size.Z * 0.6 / math.max(1, count - 1))
		local _, light = BuildKit.lamp(
			cf * CFrame.new(0, size.Y - 1.6, if count == 1 then 0 else z),
			if rng:NextNumber() < 0.5 then "pendant" else "bulkhead",
			lampColour,
			0.9,
			34,
			parent
		)
		light.Enabled = false -- stations start dark until powered
		table.insert(lights, light)
	end
end

--------------------------------------------------------------------------
-- Building kinds
--------------------------------------------------------------------------

type BuildContext = {
	parent: Instance,
	lights: { Light },
	doors: { Model },
	rng: Random,
}

local function buildPlatform(cf: CFrame, size: Vector3, ctx: BuildContext)
	BuildKit.part({
		name = "PlatformDeck",
		size = Vector3.new(size.X, size.Y, size.Z),
		cf = cf * CFrame.new(0, size.Y * 0.5, 0),
		colour = P.weatheredConcrete,
		material = Enum.Material.Concrete,
		parent = ctx.parent,
	})
	-- Platform edge with the white safety line.
	for _, side in { -1, 1 } do
		BuildKit.detail({
			name = "PlatformEdge",
			size = Vector3.new(1.0, size.Y + 0.1, size.Z),
			cf = cf * CFrame.new(side * (size.X * 0.5 - 0.5), size.Y * 0.5, 0),
			colour = C(58, 56, 52),
			material = Enum.Material.Concrete,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "SafetyLine",
			size = Vector3.new(0.8, 0.08, size.Z),
			cf = cf * CFrame.new(side * (size.X * 0.5 - 1.8), size.Y + 0.02, 0),
			colour = C(198, 194, 182),
			material = Enum.Material.Concrete,
			parent = ctx.parent,
		})
	end
	-- Lamp posts down the platform, unlit until the station has power.
	local posts = math.max(2, math.floor(size.Z / 40))
	for i = 0, posts - 1 do
		local z = -size.Z * 0.5 + 20 + i * ((size.Z - 40) / math.max(1, posts - 1))
		local postCF = cf * CFrame.new(0, size.Y, z)
		BuildKit.detail({
			name = "LampPost",
			size = Vector3.new(0.6, 14, 0.6),
			cf = postCF * CFrame.new(0, 7, 0),
			colour = C(52, 56, 54),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		local _, light = BuildKit.lamp(postCF * CFrame.new(0, 13.4, 0), "flood", C(214, 226, 255), 2.2, 46, ctx.parent)
		light.Enabled = false
		table.insert(ctx.lights, light)
	end
end

local function buildEnclosure(
	cf: CFrame,
	size: Vector3,
	spec: StationRegistry.BuildingSpec,
	wallColour: Color3,
	wallMaterial: Enum.Material,
	roofKind: string,
	ctx: BuildContext
)
	local halfX, halfZ = size.X * 0.5, size.Z * 0.5
	local storeys = spec.storey or 1
	local storeyHeight = size.Y / storeys

	-- Long walls with window openings; short walls with doors.
	for _, side in { -1, 1 } do
		local openings = {}
		local windowCount = math.max(2, math.floor(size.Z / 12))
		for i = 0, windowCount - 1 do
			local along = -halfZ + (size.Z / (windowCount + 1)) * (i + 1)
			table.insert(openings, { along = along, bottom = 4.0, width = 5.0, height = 4.5 })
		end
		segmentedWall(
			cf * CFrame.new(side * halfX, 0, 0),
			size.Z,
			size.Y,
			0.8,
			wallColour,
			wallMaterial,
			openings,
			ctx.parent
		)
		for _, opening in openings do
			BuildKit.window(
				cf * CFrame.new(side * halfX, opening.bottom + opening.height * 0.5, opening.along),
				opening.width - 0.4,
				opening.height - 0.4,
				C(68, 62, 54),
				ctx.parent,
				ctx.rng:NextNumber() < 0.35
			)
		end
	end

	local entrancesLeft = spec.entrances
	for _, endSign in { -1, 1 } do
		local openings = {}
		if entrancesLeft > 0 then
			table.insert(openings, { along = 0, bottom = 0, width = 7.0, height = 9.0 })
			entrancesLeft -= 1
		end
		segmentedWall(
			cf * CFrame.new(0, 0, endSign * halfZ) * CFrame.Angles(0, math.rad(90), 0),
			size.X,
			size.Y,
			0.8,
			wallColour,
			wallMaterial,
			openings,
			ctx.parent
		)
		if #openings > 0 then
			local door = BuildKit.door(
				cf * CFrame.new(-3.2, 0, endSign * halfZ) * CFrame.Angles(0, math.rad(if endSign > 0 then 0 else 180), 0),
				6.4,
				8.8,
				0.35,
				C(78, 62, 46),
				Enum.Material.Wood,
				ctx.parent
			)
			table.insert(ctx.doors, door)
		end
	end

	-- Side entrances beyond the two ends.
	while entrancesLeft > 0 do
		local side = if entrancesLeft % 2 == 0 then 1 else -1
		local door = BuildKit.door(
			cf * CFrame.new(side * halfX, 0, halfZ * 0.4) * CFrame.Angles(0, math.rad(if side > 0 then 90 else -90), 0),
			6.0,
			8.6,
			0.35,
			C(78, 62, 46),
			Enum.Material.Wood,
			ctx.parent
		)
		table.insert(ctx.doors, door)
		entrancesLeft -= 1
	end

	-- Upper floors get a real deck and a stair.
	for floor = 1, storeys - 1 do
		BuildKit.part({
			name = "UpperFloor",
			size = Vector3.new(size.X - 1.6, 0.5, size.Z - 1.6),
			cf = cf * CFrame.new(0, storeyHeight * floor, 0),
			colour = C(84, 70, 54),
			material = Enum.Material.WoodPlanks,
			parent = ctx.parent,
		})
		-- Stair well opening, built by simply leaving the last bay clear.
		BuildKit.part({
			name = "StairFlight",
			size = Vector3.new(4.5, 0.5, storeyHeight * 1.8),
			cf = cf
				* CFrame.new(halfX - 4, storeyHeight * (floor - 0.5), halfZ - storeyHeight)
				* CFrame.Angles(math.rad(-34), 0, 0),
			colour = C(84, 70, 54),
			material = Enum.Material.WoodPlanks,
			parent = ctx.parent,
		})
		for step = 0, 9 do
			BuildKit.detail({
				name = "Tread",
				size = Vector3.new(4.4, 0.25, 1.1),
				cf = cf
					* CFrame.new(
						halfX - 4,
						storeyHeight * (floor - 1) + 1 + step * (storeyHeight / 10),
						halfZ - 2 - step * (storeyHeight * 1.5 / 10)
					),
				colour = C(96, 80, 62),
				material = Enum.Material.WoodPlanks,
				parent = ctx.parent,
			})
		end
	end

	-- Roof.
	if roofKind == "pitched" then
		pitchedRoof(cf * CFrame.new(0, size.Y, 0), size.X, size.Z, size.X * 0.28, C(64, 60, 56), ctx.parent)
	elseif roofKind == "corrugated" then
		BuildKit.corrugated(
			cf * CFrame.new(0, size.Y + 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)),
			size.Z,
			size.X,
			C(96, 92, 84),
			ctx.parent
		)
	else
		BuildKit.part({
			name = "FlatRoof",
			size = Vector3.new(size.X + 1.2, 0.7, size.Z + 1.2),
			cf = cf * CFrame.new(0, size.Y + 0.35, 0),
			colour = C(62, 60, 58),
			material = Enum.Material.Concrete,
			parent = ctx.parent,
		})
		-- Parapet.
		for _, side in { -1, 1 } do
			BuildKit.detail({
				name = "Parapet",
				size = Vector3.new(0.6, 1.6, size.Z + 1.2),
				cf = cf * CFrame.new(side * (size.X * 0.5 + 0.3), size.Y + 1.2, 0),
				colour = C(70, 68, 64),
				material = Enum.Material.Concrete,
				parent = ctx.parent,
			})
		end
	end

	if spec.interior then
		fitInterior(cf, size, C(150, 142, 124), C(74, 62, 48), C(255, 232, 186), ctx.parent, ctx.lights, ctx.rng)
	end
end

local function buildWaterTower(cf: CFrame, size: Vector3, ctx: BuildContext)
	local legHeight = size.Y * 0.62
	for i = 0, 3 do
		local angle = math.rad(i * 90 + 45)
		BuildKit.part({
			name = "TowerLeg",
			size = Vector3.new(1.2, legHeight, 1.2),
			cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, legHeight * 0.5, size.X * 0.36),
			colour = C(74, 62, 52),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end
	-- Cross bracing.
	for i = 0, 3 do
		local angle = math.rad(i * 90)
		BuildKit.detail({
			name = "Brace",
			size = Vector3.new(0.5, 0.5, size.X * 0.85),
			cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, legHeight * 0.55, 0) * CFrame.Angles(math.rad(24), 0, 0),
			colour = C(74, 62, 52),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end
	local tank = BuildKit.cylinder({
		name = "Tank",
		size = Vector3.new(size.Y - legHeight, size.X, size.X),
		cf = cf * CFrame.new(0, legHeight + (size.Y - legHeight) * 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		colour = C(82, 70, 58),
		material = Enum.Material.CorrodedMetal,
		parent = ctx.parent,
	})
	BuildKit.rivetStrip(tank.CFrame * CFrame.new(0, size.X * 0.5, -size.X * 0.4), size.X * 0.8, 1.6, 0.16, C(58, 50, 44), ctx.parent)
	-- Filler spout.
	BuildKit.detail({
		name = "Spout",
		size = Vector3.new(1.4, 6.0, 1.4),
		cf = cf * CFrame.new(size.X * 0.5, legHeight + 2, 0) * CFrame.Angles(0, 0, math.rad(28)),
		colour = C(68, 58, 50),
		material = Enum.Material.Metal,
		parent = ctx.parent,
	})
	BuildKit.ladder(cf * CFrame.new(size.X * 0.4, 0, size.X * 0.4), legHeight + 4, 2.2, C(70, 66, 60), ctx.parent)
end

local function buildSignalTower(cf: CFrame, size: Vector3, spec: StationRegistry.BuildingSpec, ctx: BuildContext)
	local baseHeight = size.Y * 0.62
	-- Brick base with a door.
	segmentedWall(
		cf * CFrame.new(0, 0, size.Z * 0.5) * CFrame.Angles(0, math.rad(90), 0),
		size.X,
		baseHeight,
		0.9,
		C(112, 74, 62),
		Enum.Material.Brick,
		{ { along = 0, bottom = 0, width = 6.0, height = 8.5 } },
		ctx.parent
	)
	for _, side in { -1, 1 } do
		segmentedWall(
			cf * CFrame.new(side * size.X * 0.5, 0, 0),
			size.Z,
			baseHeight,
			0.9,
			C(112, 74, 62),
			Enum.Material.Brick,
			{},
			ctx.parent
		)
	end
	segmentedWall(
		cf * CFrame.new(0, 0, -size.Z * 0.5) * CFrame.Angles(0, math.rad(90), 0),
		size.X,
		baseHeight,
		0.9,
		C(112, 74, 62),
		Enum.Material.Brick,
		{},
		ctx.parent
	)
	local door = BuildKit.door(
		cf * CFrame.new(-3.0, 0, size.Z * 0.5),
		6.0,
		8.4,
		0.35,
		C(72, 58, 44),
		Enum.Material.Wood,
		ctx.parent
	)
	table.insert(ctx.doors, door)

	-- Operating floor: a glazed box on top, which is the whole point of a
	-- signal box. It has to be legible from the ground and lit from inside.
	BuildKit.part({
		name = "OperatingFloor",
		size = Vector3.new(size.X + 2, 0.6, size.Z + 2),
		cf = cf * CFrame.new(0, baseHeight, 0),
		colour = C(88, 72, 56),
		material = Enum.Material.WoodPlanks,
		parent = ctx.parent,
	})
	local upper = size.Y - baseHeight
	for _, side in { -1, 1 } do
		-- Fully glazed long sides: a low panel and a tall window band.
		BuildKit.part({
			name = "GlazingPanel",
			size = Vector3.new(0.5, 3.0, size.Z + 2),
			cf = cf * CFrame.new(side * (size.X * 0.5 + 1), baseHeight + 1.5, 0),
			colour = C(78, 62, 46),
			material = Enum.Material.Wood,
			parent = ctx.parent,
		})
		local panes = 4
		for i = 0, panes - 1 do
			BuildKit.window(
				cf * CFrame.new(side * (size.X * 0.5 + 1), baseHeight + 3 + (upper - 4) * 0.5, -size.Z * 0.5 + (size.Z + 2) / panes * (i + 0.5) - 1),
				(size.Z + 2) / panes - 0.6,
				upper - 4.5,
				C(78, 62, 46),
				ctx.parent
			)
		end
		BuildKit.part({
			name = "GlazingHeader",
			size = Vector3.new(0.5, 1.2, size.Z + 2),
			cf = cf * CFrame.new(side * (size.X * 0.5 + 1), size.Y - 0.6, 0),
			colour = C(78, 62, 46),
			material = Enum.Material.Wood,
			parent = ctx.parent,
		})
	end
	for _, endSign in { -1, 1 } do
		segmentedWall(
			cf * CFrame.new(0, baseHeight, endSign * (size.Z * 0.5 + 1)) * CFrame.Angles(0, math.rad(90), 0),
			size.X + 2,
			upper,
			0.5,
			C(78, 62, 46),
			Enum.Material.Wood,
			{},
			ctx.parent
		)
	end
	pitchedRoof(cf * CFrame.new(0, size.Y, 0), size.X + 3, size.Z + 3, 4, C(58, 54, 50), ctx.parent)

	-- External stair up to the operating floor, which is how signal boxes work.
	for step = 0, 13 do
		BuildKit.part({
			name = "Tread",
			size = Vector3.new(4.0, 0.3, 1.4),
			cf = cf * CFrame.new(size.X * 0.5 + 4, 1 + step * (baseHeight / 14), size.Z * 0.5 - step * 1.5),
			colour = C(88, 76, 62),
			material = Enum.Material.WoodPlanks,
			parent = ctx.parent,
		})
	end
	BuildKit.handrail(
		cf * CFrame.new(size.X * 0.5 + 6, baseHeight * 0.5, size.Z * 0.5 - 9) * CFrame.Angles(math.rad(-40), 0, 0),
		22,
		3.2,
		C(70, 66, 60),
		ctx.parent
	)

	if spec.interior then
		-- Operating floor interior: the interlocking frame is a fixture, but
		-- the room around it is built here.
		BuildKit.part({
			name = "DiagramBoard",
			size = Vector3.new(0.4, 5.0, 14.0),
			cf = cf * CFrame.new(-size.X * 0.5 - 0.4, baseHeight + upper * 0.62, 0),
			colour = C(46, 52, 48),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "DiagramLine",
			size = Vector3.new(0.1, 0.3, 12.0),
			cf = cf * CFrame.new(-size.X * 0.5 - 0.62, baseHeight + upper * 0.62, 0),
			colour = C(214, 208, 190),
			material = Enum.Material.Neon,
			parent = ctx.parent,
		})
		local _, light = BuildKit.lamp(
			cf * CFrame.new(0, size.Y - 1.6, 0),
			"pendant",
			C(255, 226, 172),
			1.0,
			30,
			ctx.parent
		)
		light.Enabled = false
		table.insert(ctx.lights, light)
	end
end

local function buildLiftBridge(cf: CFrame, size: Vector3, ctx: BuildContext)
	-- Two piers, an approach span, and a raised lifting span.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "Pier",
			size = Vector3.new(size.X * 0.5, size.Y * 0.5, 18),
			cf = cf * CFrame.new(0, size.Y * 0.25 - 20, side * size.Z * 0.3),
			colour = P.weatheredConcrete,
			material = Enum.Material.Concrete,
			parent = ctx.parent,
		})
		-- Lifting tower.
		for _, x in { -1, 1 } do
			BuildKit.part({
				name = "TowerLeg",
				size = Vector3.new(3.0, size.Y, 3.0),
				cf = cf * CFrame.new(x * size.X * 0.45, size.Y * 0.5 - 12, side * size.Z * 0.3),
				colour = C(72, 76, 80),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
		end
		BuildKit.part({
			name = "TowerHead",
			size = Vector3.new(size.X, 4.0, 5.0),
			cf = cf * CFrame.new(0, size.Y - 12, side * size.Z * 0.3),
			colour = C(66, 70, 74),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		-- Counterweight, hanging where it should be for a raised span.
		BuildKit.part({
			name = "Counterweight",
			size = Vector3.new(size.X * 0.7, 8, 8),
			cf = cf * CFrame.new(0, size.Y - 26, side * size.Z * 0.3),
			colour = C(58, 58, 60),
			material = Enum.Material.Concrete,
			parent = ctx.parent,
		})
		for _, x in { -1, 1 } do
			BuildKit.detail({
				name = "Cable",
				size = Vector3.new(0.4, 16, 0.4),
				cf = cf * CFrame.new(x * size.X * 0.35, size.Y - 20, side * size.Z * 0.3),
				colour = C(48, 48, 50),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
		end
	end

	-- Fixed approach spans at deck level.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "ApproachSpan",
			size = Vector3.new(size.X * 0.8, 2.5, size.Z * 0.26),
			cf = cf * CFrame.new(0, -18, side * (size.Z * 0.42)),
			colour = C(80, 84, 88),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		-- Truss sides.
		for _, x in { -1, 1 } do
			for i = 0, 7 do
				BuildKit.detail({
					name = "TrussMember",
					size = Vector3.new(0.7, 9, 0.7),
					cf = cf
						* CFrame.new(x * size.X * 0.4, -13.5, side * (size.Z * 0.42) - size.Z * 0.12 + i * (size.Z * 0.033))
						* CFrame.Angles(math.rad(if i % 2 == 0 then 34 else -34), 0, 0),
					colour = C(74, 78, 82),
					material = Enum.Material.Metal,
					parent = ctx.parent,
				})
			end
		end
	end

	-- The raised lifting span itself, sitting up between the towers.
	local span = BuildKit.part({
		name = "LiftSpan",
		size = Vector3.new(size.X * 0.8, 2.5, size.Z * 0.3),
		cf = cf * CFrame.new(0, size.Y - 34, 0),
		colour = C(86, 90, 94),
		material = Enum.Material.Metal,
		parent = ctx.parent,
	})
	span:AddTag("LiftSpan")
	span.Name = "LiftSpan"
	for _, x in { -1, 1 } do
		BuildKit.detail({
			name = "SpanTruss",
			size = Vector3.new(0.8, 7, size.Z * 0.3),
			cf = cf * CFrame.new(x * size.X * 0.4, size.Y - 30.5, 0),
			colour = C(80, 84, 88),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end
	-- Warning lights on the raised span, which is the visual that reads from
	-- the approach and tells the crew what the problem is before the radio does.
	for _, x in { -1, 1 } do
		local lamp = BuildKit.detail({
			name = "SpanWarning",
			size = Vector3.new(1.0, 1.0, 1.0),
			cf = cf * CFrame.new(x * size.X * 0.42, size.Y - 27, 0),
			colour = C(220, 70, 50),
			material = Enum.Material.Neon,
			parent = ctx.parent,
		})
		local light = Instance.new("PointLight")
		light.Color = C(220, 70, 50)
		light.Brightness = 2.5
		light.Range = 60
		light.Parent = lamp
		table.insert(ctx.lights, light)
	end
end

local function buildMast(cf: CFrame, size: Vector3, ctx: BuildContext)
	local height = size.Y
	-- Lattice mast: four legs plus bracing, tapering with height.
	local segments = 10
	for seg = 0, segments - 1 do
		local t = seg / segments
		local radius = size.X * 0.5 * (1 - t * 0.62)
		local y = height * t
		local segHeight = height / segments
		for i = 0, 3 do
			local angle = math.rad(i * 90 + 45)
			BuildKit.detail({
				name = "MastLeg",
				size = Vector3.new(1.0, segHeight * 1.05, 1.0),
				cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, y + segHeight * 0.5, radius),
				colour = C(96, 84, 70),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
			BuildKit.detail({
				name = "MastBrace",
				size = Vector3.new(0.5, 0.5, radius * 1.5),
				cf = cf * CFrame.Angles(0, angle + math.rad(45), 0) * CFrame.new(0, y + segHeight * 0.5, 0) * CFrame.Angles(math.rad(30), 0, 0),
				colour = C(92, 80, 66),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
		end
		-- Aviation warning lamp every few segments.
		if seg % 3 == 2 then
			local lamp = BuildKit.detail({
				name = "MastLamp",
				size = Vector3.new(1.2, 1.2, 1.2),
				cf = cf * CFrame.new(0, y, 0),
				colour = C(220, 70, 50),
				material = Enum.Material.Neon,
				parent = ctx.parent,
			})
			local light = Instance.new("PointLight")
			light.Color = C(220, 70, 50)
			light.Brightness = 2
			light.Range = 50
			light.Parent = lamp
			table.insert(ctx.lights, light)
		end
	end
	-- Dishes and yagis near the top.
	for i = 0, 2 do
		BuildKit.cylinder({
			name = "Dish",
			size = Vector3.new(1.2, 9 - i * 2, 9 - i * 2),
			cf = cf * CFrame.new(0, height * (0.62 + i * 0.1), 0) * CFrame.Angles(0, math.rad(i * 60), math.rad(90)),
			colour = C(180, 176, 168),
			material = Enum.Material.Metal,
			canCollide = false,
			parent = ctx.parent,
		})
	end
	BuildKit.ladder(cf * CFrame.new(size.X * 0.32, 0, 0), height * 0.7, 2.4, C(88, 82, 74), ctx.parent)
	-- Guy wires anchoring the mast, which is what sells its scale.
	for i = 0, 2 do
		local angle = math.rad(i * 120)
		BuildKit.detail({
			name = "GuyWire",
			size = Vector3.new(0.3, height * 0.9, 0.3),
			cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, height * 0.42, height * 0.3) * CFrame.Angles(math.rad(36), 0, 0),
			colour = C(60, 60, 62),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end
end

--------------------------------------------------------------------------
-- Fixtures
--------------------------------------------------------------------------

local function buildFixture(spec: StationRegistry.FixtureSpec, cf: CFrame, ctx: BuildContext): BasePart
	local kind = spec.kind
	local anchor: BasePart

	if kind == "generator" then
		anchor = BuildKit.part({
			name = "Generator",
			size = Vector3.new(5.5, 4.5, 9.0),
			cf = cf * CFrame.new(0, 2.25, 0),
			colour = C(96, 100, 88),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "GenRadiator",
			size = Vector3.new(5.2, 3.6, 0.8),
			cf = anchor.CFrame * CFrame.new(0, 0.2, -4.4),
			colour = C(72, 76, 68),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.grille(anchor.CFrame * CFrame.new(0, 0.2, -4.8) * CFrame.Angles(0, math.rad(90), 0), 4.6, 3.2, 0.5, C(50, 52, 48), ctx.parent)
		BuildKit.cylinder({
			name = "GenExhaust",
			size = Vector3.new(4.0, 1.1, 1.1),
			cf = anchor.CFrame * CFrame.new(1.8, 3.0, 2.0) * CFrame.Angles(0, 0, math.rad(90)),
			colour = C(46, 42, 40),
			material = Enum.Material.CorrodedMetal,
			canCollide = false,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "GenControlPanel",
			size = Vector3.new(0.5, 2.0, 2.4),
			cf = anchor.CFrame * CFrame.new(2.9, 0.8, 1.0),
			colour = C(56, 58, 60),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "GenPullCord",
			size = Vector3.new(0.16, 1.6, 0.16),
			cf = anchor.CFrame * CFrame.new(2.9, 0.2, 2.6),
			colour = C(150, 130, 90),
			material = Enum.Material.Fabric,
			parent = ctx.parent,
		})
	elseif kind == "fusebox" then
		anchor = BuildKit.part({
			name = "Fusebox",
			size = Vector3.new(0.9, 4.0, 3.0),
			cf = cf * CFrame.new(0, 6.0, 0),
			colour = C(62, 66, 60),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		for i = 0, 5 do
			BuildKit.detail({
				name = "FuseWay",
				size = Vector3.new(0.4, 0.55, 0.55),
				cf = anchor.CFrame * CFrame.new(-0.6, 1.3 - math.floor(i / 3) * 1.0, -0.8 + (i % 3) * 0.8),
				colour = if i == 4 then C(90, 60, 50) else C(196, 186, 158),
				material = Enum.Material.Concrete,
				parent = ctx.parent,
			})
		end
	elseif kind == "breaker" then
		anchor = BuildKit.part({
			name = "Breaker",
			size = Vector3.new(1.1, 5.5, 3.6),
			cf = cf * CFrame.new(0, 5.5, 0),
			colour = C(54, 58, 56),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "BreakerHandle",
			size = Vector3.new(1.4, 1.8, 0.5),
			cf = anchor.CFrame * CFrame.new(-0.9, -1.2, 0),
			colour = C(178, 48, 42),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "BreakerLamp",
			size = Vector3.new(0.3, 0.5, 0.5),
			cf = anchor.CFrame * CFrame.new(-0.62, 1.8, 0),
			colour = C(120, 40, 36),
			material = Enum.Material.Neon,
			parent = ctx.parent,
		})
	elseif kind == "lever" then
		anchor = BuildKit.part({
			name = "GroundLever",
			size = Vector3.new(2.6, 1.4, 3.6),
			cf = cf * CFrame.new(0, 0.7, 0),
			colour = C(64, 62, 58),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "LeverArm",
			size = Vector3.new(0.4, 5.0, 0.4),
			cf = anchor.CFrame * CFrame.new(0, 2.6, 0.6) * CFrame.Angles(math.rad(22), 0, 0),
			colour = C(150, 60, 52),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "LeverGrip",
			size = Vector3.new(0.7, 1.2, 0.7),
			cf = anchor.CFrame * CFrame.new(0, 5.0, 1.4),
			colour = C(40, 40, 42),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
		-- Position plate, so a player can see which way it is set.
		BuildKit.detail({
			name = "LeverPlate",
			size = Vector3.new(0.2, 1.4, 3.0),
			cf = anchor.CFrame * CFrame.new(1.4, 1.2, 0),
			colour = C(196, 186, 158),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
	elseif kind == "controls" then
		anchor = BuildKit.part({
			name = "ControlPanel",
			size = Vector3.new(1.2, 4.4, 4.0),
			cf = cf * CFrame.new(0, 3.6, 0),
			colour = C(58, 62, 60),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "PanelFace",
			size = Vector3.new(0.3, 3.0, 3.4),
			cf = anchor.CFrame * CFrame.new(-0.7, 0.2, 0) * CFrame.Angles(0, 0, math.rad(12)),
			colour = C(76, 80, 78),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		for i = 0, 2 do
			BuildKit.detail({
				name = "PanelLamp",
				size = Vector3.new(0.3, 0.45, 0.45),
				cf = anchor.CFrame * CFrame.new(-0.9, 1.0, -1.0 + i * 1.0),
				colour = C(90, 80, 50),
				material = Enum.Material.Neon,
				parent = ctx.parent,
			})
		end
		BuildKit.detail({
			name = "PanelLegs",
			size = Vector3.new(1.0, 3.2, 0.6),
			cf = anchor.CFrame * CFrame.new(0, -3.6, 0),
			colour = C(50, 52, 50),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	elseif kind == "fuel_point" then
		anchor = BuildKit.part({
			name = "FuelPoint",
			size = Vector3.new(3.0, 7.0, 3.0),
			cf = cf * CFrame.new(0, 3.5, 0),
			colour = C(118, 92, 56),
			material = Enum.Material.CorrodedMetal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "PumpHead",
			size = Vector3.new(3.2, 2.0, 3.2),
			cf = anchor.CFrame * CFrame.new(0, 4.0, 0),
			colour = C(96, 76, 48),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.pipeRun(
			anchor.CFrame,
			{ Vector3.new(0, 3.5, 1.4), Vector3.new(0, 2.0, 3.5), Vector3.new(0, -2.0, 4.5) },
			0.5,
			C(60, 58, 56),
			ctx.parent
		)
		BuildKit.detail({
			name = "Nozzle",
			size = Vector3.new(0.7, 1.6, 0.7),
			cf = anchor.CFrame * CFrame.new(0, -2.4, 4.6),
			colour = C(140, 60, 50),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	elseif kind == "interlocking_frame" then
		anchor = BuildKit.part({
			name = "InterlockingFrame",
			size = Vector3.new(3.0, 2.0, 16.0),
			cf = cf * CFrame.new(0, 1.0, 0),
			colour = C(72, 70, 66),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		-- A bank of tall painted levers, which is what a frame actually is.
		for i = 0, 11 do
			local colour = if i % 3 == 0 then C(160, 52, 46) elseif i % 3 == 1 then C(52, 100, 60) else C(60, 70, 120)
			BuildKit.detail({
				name = "FrameLever",
				size = Vector3.new(0.4, 6.5, 0.4),
				cf = anchor.CFrame * CFrame.new(0, 3.4, -7.0 + i * 1.3) * CFrame.Angles(math.rad(if i % 2 == 0 then 16 else -8), 0, 0),
				colour = colour,
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
			BuildKit.detail({
				name = "FrameLeverNumber",
				size = Vector3.new(0.5, 0.6, 0.6),
				cf = anchor.CFrame * CFrame.new(0, 1.4, -7.0 + i * 1.3),
				colour = C(206, 200, 182),
				material = Enum.Material.SmoothPlastic,
				parent = ctx.parent,
			})
		end
	elseif kind == "relay_bay" then
		anchor = BuildKit.part({
			name = "RelayBay",
			size = Vector3.new(2.0, 7.0, 6.0),
			cf = cf * CFrame.new(0, 3.5, 0),
			colour = C(66, 70, 74),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		for row = 0, 3 do
			for col = 0, 2 do
				BuildKit.detail({
					name = "RelayUnit",
					size = Vector3.new(0.6, 1.2, 1.5),
					cf = anchor.CFrame * CFrame.new(-1.0, 2.4 - row * 1.5, -1.8 + col * 1.8),
					colour = if row == 2 and col == 1 then C(120, 50, 44) else C(84, 88, 92),
					material = Enum.Material.Metal,
					parent = ctx.parent,
				})
			end
		end
	elseif kind == "stores_cage" then
		anchor = BuildKit.part({
			name = "StoresCage",
			size = Vector3.new(6.0, 8.0, 8.0),
			cf = cf * CFrame.new(0, 4.0, 0),
			colour = C(74, 78, 76),
			material = Enum.Material.Metal,
			transparency = 0.75,
			parent = ctx.parent,
		})
		BuildKit.grille(cf * CFrame.new(-3.0, 4.0, 0) * CFrame.Angles(0, math.rad(90), 0), 7.6, 7.6, 0.9, C(74, 78, 76), ctx.parent)
		BuildKit.grille(cf * CFrame.new(3.0, 4.0, 0) * CFrame.Angles(0, math.rad(90), 0), 7.6, 7.6, 0.9, C(74, 78, 76), ctx.parent)
	elseif kind == "hydraulics" then
		anchor = BuildKit.part({
			name = "HydraulicHead",
			size = Vector3.new(5.0, 6.0, 5.0),
			cf = cf * CFrame.new(0, 3.0, 0),
			colour = C(84, 72, 52),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.pipeRun(
			anchor.CFrame,
			{ Vector3.new(-2.5, 1.5, 0), Vector3.new(-5, 1.5, 0), Vector3.new(-5, -2.5, 0) },
			0.8,
			C(120, 90, 60),
			ctx.parent
		)
		BuildKit.detail({
			name = "ValveSeat",
			size = Vector3.new(1.6, 1.6, 1.6),
			cf = anchor.CFrame * CFrame.new(0, 2.2, -2.6),
			colour = C(60, 56, 50),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "PressureGauge",
			size = Vector3.new(1.4, 1.4, 0.4),
			cf = anchor.CFrame * CFrame.new(1.6, 2.0, -2.5),
			colour = C(206, 200, 182),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
	elseif kind == "transmitter" then
		anchor = BuildKit.part({
			name = "Transmitter",
			size = Vector3.new(4.0, 9.0, 7.0),
			cf = cf * CFrame.new(0, 4.5, 0),
			colour = C(60, 64, 62),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		for i = 0, 3 do
			BuildKit.detail({
				name = "ValveHolder",
				size = Vector3.new(0.8, 1.8, 0.8),
				cf = anchor.CFrame * CFrame.new(-1.8, 2.5 - i * 1.6, -2.0),
				colour = if i == 1 then C(90, 60, 52) else C(196, 186, 160),
				material = if i == 1 then Enum.Material.Metal else Enum.Material.Glass,
				transparency = if i == 1 then 0 else 0.35,
				parent = ctx.parent,
			})
		end
		BuildKit.detail({
			name = "MeterBank",
			size = Vector3.new(0.4, 3.0, 5.0),
			cf = anchor.CFrame * CFrame.new(-2.1, -2.0, 0),
			colour = C(48, 50, 48),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	else
		anchor = BuildKit.part({
			name = spec.kind,
			size = Vector3.new(3, 3, 3),
			cf = cf * CFrame.new(0, 1.5, 0),
			colour = C(90, 90, 92),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end

	anchor.Name = spec.id
	anchor:AddTag("StationFixture")
	anchor:SetAttribute("FixtureKind", spec.kind)
	if spec.objective then
		anchor:SetAttribute("Objective", spec.objective)
	end
	if spec.step then
		anchor:SetAttribute("Step", spec.step)
	end
	return anchor
end

--------------------------------------------------------------------------
-- Loot containers
--------------------------------------------------------------------------

local function buildLootNode(node: StationRegistry.LootNode, cf: CFrame, ctx: BuildContext): BasePart
	local anchor: BasePart
	local kind = node.kind

	if kind == "locker" then
		anchor = BuildKit.part({
			name = "Locker",
			size = Vector3.new(3.0, 8.0, 4.5),
			cf = cf * CFrame.new(0, 4.0, 0),
			colour = C(76, 90, 84),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
		for i = 0, 1 do
			BuildKit.detail({
				name = "LockerDoor",
				size = Vector3.new(0.3, 7.6, 2.1),
				cf = anchor.CFrame * CFrame.new(-1.6, 0, -1.1 + i * 2.2),
				colour = C(82, 96, 90),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
			BuildKit.detail({
				name = "LockerHandle",
				size = Vector3.new(0.3, 1.0, 0.2),
				cf = anchor.CFrame * CFrame.new(-1.85, 0, -0.2 + i * 2.2),
				colour = C(150, 150, 152),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
			BuildKit.grille(anchor.CFrame * CFrame.new(-1.8, 3.0, -1.1 + i * 2.2) * CFrame.Angles(0, math.rad(90), 0), 1.6, 0.9, 0.22, C(60, 70, 66), ctx.parent)
		end
	elseif kind == "crate" then
		anchor = BuildKit.part({
			name = "Crate",
			size = Vector3.new(4.4, 3.6, 4.4),
			cf = cf * CFrame.new(0, 1.8, 0),
			colour = C(112, 92, 64),
			material = Enum.Material.WoodPlanks,
			parent = ctx.parent,
		})
		for _, side in { -1, 1 } do
			BuildKit.detail({
				name = "CrateBatten",
				size = Vector3.new(4.6, 0.3, 0.35),
				cf = anchor.CFrame * CFrame.new(0, side * 1.3, 2.25),
				colour = C(88, 70, 48),
				material = Enum.Material.Wood,
				parent = ctx.parent,
			})
		end
		BuildKit.detail({
			name = "CrateLid",
			size = Vector3.new(4.6, 0.35, 4.6),
			cf = anchor.CFrame * CFrame.new(0, 1.9, 0),
			colour = C(100, 82, 56),
			material = Enum.Material.WoodPlanks,
			parent = ctx.parent,
		})
	elseif kind == "shelf" then
		anchor = BuildKit.part({
			name = "Shelving",
			size = Vector3.new(2.4, 8.0, 9.0),
			cf = cf * CFrame.new(0, 4.0, 0),
			colour = C(84, 80, 72),
			material = Enum.Material.Metal,
			transparency = 1,
			canCollide = false,
			parent = ctx.parent,
		})
		for i = 0, 3 do
			BuildKit.part({
				name = "Shelf",
				size = Vector3.new(2.4, 0.25, 9.0),
				cf = anchor.CFrame * CFrame.new(0, -3.2 + i * 2.1, 0),
				colour = C(88, 84, 76),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
		end
		for _, side in { -1, 1 } do
			for _, zSide in { -1, 1 } do
				BuildKit.detail({
					name = "ShelfUpright",
					size = Vector3.new(0.3, 8.0, 0.3),
					cf = anchor.CFrame * CFrame.new(side * 1.0, 0, zSide * 4.3),
					colour = C(74, 70, 64),
					material = Enum.Material.Metal,
					parent = ctx.parent,
				})
			end
		end
	elseif kind == "cabinet" then
		anchor = BuildKit.part({
			name = "Cabinet",
			size = Vector3.new(2.6, 5.0, 5.0),
			cf = cf * CFrame.new(0, 2.5, 0),
			colour = C(96, 76, 54),
			material = Enum.Material.Wood,
			parent = ctx.parent,
		})
		for i = 0, 2 do
			BuildKit.detail({
				name = "Drawer",
				size = Vector3.new(0.3, 1.3, 4.5),
				cf = anchor.CFrame * CFrame.new(-1.4, 1.5 - i * 1.6, 0),
				colour = C(108, 86, 60),
				material = Enum.Material.Wood,
				parent = ctx.parent,
			})
			BuildKit.detail({
				name = "DrawerPull",
				size = Vector3.new(0.25, 0.25, 1.2),
				cf = anchor.CFrame * CFrame.new(-1.6, 1.5 - i * 1.6, 0),
				colour = C(160, 140, 96),
				material = Enum.Material.Metal,
				parent = ctx.parent,
			})
		end
	elseif kind == "toolboard" then
		anchor = BuildKit.part({
			name = "ToolBoard",
			size = Vector3.new(0.5, 6.0, 9.0),
			cf = cf * CFrame.new(0, 6.0, 0),
			colour = C(92, 74, 54),
			material = Enum.Material.Wood,
			parent = ctx.parent,
		})
		-- Painted tool silhouettes, the detail that makes a tool board readable.
		for i = 0, 4 do
			BuildKit.detail({
				name = "ToolShadow",
				size = Vector3.new(0.1, 2.6, 0.7),
				cf = anchor.CFrame * CFrame.new(-0.3, 0.4, -3.4 + i * 1.7) * CFrame.Angles(math.rad(ctx.rng:NextNumber(-8, 8)), 0, 0),
				colour = C(52, 42, 32),
				material = Enum.Material.SmoothPlastic,
				parent = ctx.parent,
			})
		end
	elseif kind == "body" then
		-- A body is a story object first and a container second. It is built as
		-- a slumped shape with a coat and a scattered kit, not as a gore prop.
		anchor = BuildKit.part({
			name = "Remains",
			size = Vector3.new(3.2, 1.6, 5.0),
			cf = cf * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(8)),
			colour = C(58, 56, 50),
			material = Enum.Material.Fabric,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "Coat",
			size = Vector3.new(3.6, 0.6, 4.0),
			cf = anchor.CFrame * CFrame.new(0, 0.9, 0.4),
			colour = C(48, 52, 46),
			material = Enum.Material.Fabric,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "Satchel",
			size = Vector3.new(1.8, 1.2, 2.2),
			cf = anchor.CFrame * CFrame.new(1.4, 0.6, -1.6),
			colour = C(84, 68, 46),
			material = Enum.Material.Fabric,
			parent = ctx.parent,
		})
		BuildKit.detail({
			name = "FallenLamp",
			size = Vector3.new(0.8, 0.8, 1.4),
			cf = anchor.CFrame * CFrame.new(-1.8, 0.4, 1.8) * CFrame.Angles(0, math.rad(40), 0),
			colour = C(64, 66, 70),
			material = Enum.Material.SmoothPlastic,
			parent = ctx.parent,
		})
	else
		anchor = BuildKit.part({
			name = "Container",
			size = Vector3.new(3, 3, 3),
			cf = cf * CFrame.new(0, 1.5, 0),
			colour = C(100, 100, 100),
			material = Enum.Material.Metal,
			parent = ctx.parent,
		})
	end

	anchor:AddTag("LootNode")
	anchor:SetAttribute("LootKind", kind)
	anchor:SetAttribute("Tier", node.tier)
	anchor:SetAttribute("Rolls", node.rolls)
	anchor:SetAttribute("Searched", false)
	return anchor
end

--------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------

function StationBuilder.build(def: StationRegistry.StationDef, originCF: CFrame, parent: Instance, seed: number): BuiltStation
	local rng = Random.new(seed)
	local model = BuildKit.model("Station_" .. def.id, nil)
	local ctx: BuildContext = { parent = model, lights = {}, doors = {}, rng = rng }

	-- Ground pad so the clearing reads as compacted earth rather than grass.
	BuildKit.part({
		name = "Ground",
		size = Vector3.new(def.layout.radius * 2, 1.2, def.layout.radius * 2),
		cf = originCF * CFrame.new(0, -0.6, 0),
		colour = P.soil,
		material = Enum.Material.Ground,
		parent = model,
	})

	for _, spec in def.layout.buildings do
		local cf = originCF * CFrame.new(spec.position) * CFrame.Angles(0, math.rad(spec.rotation), 0)
		local kind = spec.kind

		if kind == "platform" then
			buildPlatform(cf, spec.size, ctx)
		elseif kind == "water_tower" then
			buildWaterTower(cf, spec.size, ctx)
		elseif kind == "signal_tower" then
			buildSignalTower(cf, spec.size, spec, ctx)
		elseif kind == "lift_bridge" then
			buildLiftBridge(cf, spec.size, ctx)
		elseif kind == "mast" then
			buildMast(cf, spec.size, ctx)
		elseif kind == "log_stack" then
			-- Stacked timber, which doubles as cover and as a climbable route.
			local logsPerRow = math.floor(spec.size.X / 3.2)
			local rows = math.floor(spec.size.Y / 3.0)
			for row = 0, rows - 1 do
				for i = 0, logsPerRow - 1 - row do
					local log = BuildKit.part({
						name = "Log",
						size = Vector3.new(spec.size.Z, 2.8, 2.8),
						cf = cf * CFrame.new(-spec.size.X * 0.5 + 1.6 + (i + row * 0.5) * 3.1, 1.5 + row * 2.7, 0),
						colour = BuildKit.weather(P.darkBark, 0.05, rng),
						material = Enum.Material.Wood,
						parent = model,
					})
					log.Shape = Enum.PartType.Cylinder
				end
			end
		elseif kind == "loader" then
			-- Tracked timber loader with a raised grab.
			BuildKit.part({
				name = "LoaderBody",
				size = spec.size * Vector3.new(1, 0.5, 0.6),
				cf = cf * CFrame.new(0, spec.size.Y * 0.35, 0),
				colour = C(150, 124, 44),
				material = Enum.Material.Metal,
				parent = model,
			})
			for _, side in { -1, 1 } do
				BuildKit.part({
					name = "Track",
					size = Vector3.new(3.4, 4.0, spec.size.Z),
					cf = cf * CFrame.new(side * (spec.size.X * 0.5 - 1.4), 2.0, 0),
					colour = C(46, 46, 48),
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			BuildKit.part({
				name = "LoaderCab",
				size = Vector3.new(7, 7, 7),
				cf = cf * CFrame.new(0, spec.size.Y * 0.62, spec.size.Z * 0.28),
				colour = C(150, 124, 44),
				material = Enum.Material.Metal,
				parent = model,
			})
			BuildKit.window(cf * CFrame.new(-3.5, spec.size.Y * 0.62, spec.size.Z * 0.28) * CFrame.Angles(0, math.rad(90), 0), 5, 5, C(64, 58, 48), model)
			-- The boom and the grab, still holding a lift.
			BuildKit.detail({
				name = "Boom",
				size = Vector3.new(2.4, 2.4, 22),
				cf = cf * CFrame.new(0, spec.size.Y * 0.75, -6) * CFrame.Angles(math.rad(-22), 0, 0),
				colour = C(140, 114, 40),
				material = Enum.Material.Metal,
				parent = model,
			})
			BuildKit.detail({
				name = "Grab",
				size = Vector3.new(5, 4, 5),
				cf = cf * CFrame.new(0, spec.size.Y * 0.3, -16),
				colour = C(58, 58, 60),
				material = Enum.Material.Metal,
				parent = model,
			})
			for i = 0, 3 do
				local log = BuildKit.part({
					name = "HeldLog",
					size = Vector3.new(16, 2.4, 2.4),
					cf = cf * CFrame.new(-2 + i * 1.4, spec.size.Y * 0.18, -16) * CFrame.Angles(0, math.rad(90), 0),
					colour = BuildKit.weather(P.darkBark, 0.04, rng),
					material = Enum.Material.Wood,
					parent = model,
				})
				log.Shape = Enum.PartType.Cylinder
			end
		elseif kind == "signal_gantry" then
			for _, side in { -1, 1 } do
				BuildKit.part({
					name = "GantryLeg",
					size = Vector3.new(2.4, spec.size.Y, 2.4),
					cf = cf * CFrame.new(side * spec.size.X * 0.45, spec.size.Y * 0.5, 0),
					colour = C(78, 82, 86),
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			BuildKit.part({
				name = "GantryBeam",
				size = Vector3.new(spec.size.X, 2.6, 3.0),
				cf = cf * CFrame.new(0, spec.size.Y, 0),
				colour = C(78, 82, 86),
				material = Enum.Material.Metal,
				parent = model,
			})
			BuildKit.part({
				name = "GantryWalkway",
				size = Vector3.new(spec.size.X, 0.3, 4.0),
				cf = cf * CFrame.new(0, spec.size.Y + 1.6, 1.6),
				colour = C(66, 66, 68),
				material = Enum.Material.DiamondPlate,
				parent = model,
			})
			BuildKit.handrail(cf * CFrame.new(0, spec.size.Y + 1.7, 3.4) * CFrame.Angles(0, math.rad(90), 0), spec.size.X, 3.4, C(70, 74, 78), model, true)
			-- Signal heads: three aspects, dark.
			for _, x in { -0.25, 0.25 } do
				for aspect = 0, 2 do
					local lampColour = if aspect == 0 then C(70, 30, 26) elseif aspect == 1 then C(70, 60, 26) else C(26, 60, 34)
					BuildKit.detail({
						name = "Aspect",
						size = Vector3.new(1.6, 1.6, 0.6),
						cf = cf * CFrame.new(x * spec.size.X, spec.size.Y - 2 - aspect * 2.0, -1.8),
						colour = lampColour,
						material = Enum.Material.SmoothPlastic,
						parent = model,
					})
				end
				BuildKit.detail({
					name = "SignalBack",
					size = Vector3.new(2.6, 7.5, 1.0),
					cf = cf * CFrame.new(x * spec.size.X, spec.size.Y - 4, -1.2),
					colour = C(40, 42, 44),
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			BuildKit.ladder(cf * CFrame.new(-spec.size.X * 0.45 + 2, 0, 1.6), spec.size.Y, 2.2, C(74, 78, 82), model)
		elseif kind == "aerials" then
			for i = 0, 7 do
				local angle = math.rad(i * 45)
				BuildKit.detail({
					name = "AerialPole",
					size = Vector3.new(0.8, spec.size.Y, 0.8),
					cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, spec.size.Y * 0.5, spec.size.X * 0.35),
					colour = C(92, 88, 80),
					material = Enum.Material.Metal,
					parent = model,
				})
				for element = 0, 4 do
					BuildKit.detail({
						name = "AerialElement",
						size = Vector3.new(6 - element, 0.2, 0.2),
						cf = cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, spec.size.Y * 0.6 + element * 1.6, spec.size.X * 0.35),
						colour = C(150, 146, 138),
						material = Enum.Material.Metal,
						parent = model,
					})
				end
			end
		elseif kind == "walkway" then
			BuildKit.part({
				name = "WalkwayDeck",
				size = spec.size,
				cf = cf * CFrame.new(0, spec.size.Y * 0.5, 0),
				colour = C(64, 66, 68),
				material = Enum.Material.DiamondPlate,
				parent = model,
			})
			for _, side in { -1, 1 } do
				BuildKit.handrail(cf * CFrame.new(side * spec.size.X * 0.5, spec.size.Y, 0), spec.size.Z, 3.2, C(74, 72, 68), model, true)
			end
		else
			-- Everything else is an enclosure, differing by material and roof.
			local wallColour, wallMaterial, roofKind
			if kind == "cabin" or kind == "hut" or kind == "shelter" then
				wallColour = BuildKit.weather(P.weatheredPlank, 0.04, rng)
				wallMaterial = Enum.Material.WoodPlanks
				roofKind = "pitched"
			elseif kind == "shed" or kind == "pump_house" then
				wallColour = C(102, 98, 90)
				wallMaterial = Enum.Material.CorrodedMetal
				roofKind = "corrugated"
			elseif kind == "depot" or kind == "facility" then
				wallColour = P.weatheredConcrete
				wallMaterial = Enum.Material.Concrete
				roofKind = "flat"
			else -- station_building
				wallColour = C(126, 86, 70)
				wallMaterial = Enum.Material.Brick
				roofKind = "pitched"
			end
			buildEnclosure(cf, spec.size, spec, wallColour, wallMaterial, roofKind, ctx)
		end
	end

	-- Fixtures.
	local fixtures: { [string]: BasePart } = {}
	for _, spec in def.layout.fixtures do
		local cf = originCF * CFrame.new(spec.position) * CFrame.Angles(0, math.rad(spec.rotation), 0)
		fixtures[spec.id] = buildFixture(spec, cf, ctx)
	end

	-- Loot nodes.
	local lootNodes: { { part: BasePart, kind: string, tier: number, rolls: number, guaranteed: { string } } } = {}
	for _, node in def.layout.lootNodes do
		local cf = originCF * CFrame.new(node.position) * CFrame.Angles(0, math.rad(node.rotation), 0)
		local part = buildLootNode(node, cf, ctx)
		table.insert(lootNodes, {
			part = part,
			kind = node.kind,
			tier = node.tier,
			rolls = node.rolls,
			guaranteed = node.guaranteed or {},
		})
	end

	-- Discoveries: small, tagged markers at named positions.
	local discoveries: { { id: string, part: BasePart } } = {}
	for _, discovery in def.discoveries do
		local marker = BuildKit.part({
			name = "Discovery_" .. discovery.id,
			size = Vector3.new(4, 6, 4),
			cf = originCF * CFrame.new(discovery.position) * CFrame.new(0, 3, 0),
			transparency = 1,
			canCollide = false,
			canQuery = false,
			castShadow = false,
			parent = model,
		})
		marker:AddTag("Discovery")
		marker:SetAttribute("DiscoveryId", discovery.id)
		marker:SetAttribute("StationId", def.id)
		table.insert(discoveries, { id = discovery.id, part = marker :: BasePart })
	end

	local landmarks: { [string]: Vector3 } = {}
	for _, landmark in def.layout.landmarks do
		landmarks[landmark.id] = (originCF * CFrame.new(landmark.position)).Position
	end

	model:AddTag("Station")
	model:SetAttribute("StationId", def.id)
	model.Parent = parent

	return {
		model = model,
		stationId = def.id,
		origin = originCF,
		fixtures = fixtures,
		lootNodes = lootNodes,
		landmarks = landmarks,
		lights = ctx.lights,
		doors = ctx.doors,
		poweredLights = ctx.lights,
		discoveries = discoveries,
		partCount = BuildKit.countParts(model),
	}
end

return StationBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">TrainBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainBuilder
	------------
	Builds a complete locomotive and consist from a TrainRegistry definition.

	STRUCTURE
	---------
	The whole train is one welded rigid assembly hanging off a single anchored
	root part. That choice is load-bearing:

	  - Moving a thousand anchored parts by CFrame every frame is expensive.
	    Moving one anchored root that a thousand parts are welded to is cheap,
	    because Roblox treats the welded set as a single assembly.
	  - It guarantees the train can never deform, stretch or come apart, which
	    is the usual failure mode of constraint-driven rolling stock.

	Passengers do not ride by friction. An anchored assembly imparts no velocity
	to what stands on it, so a player on a moving train would be left behind.
	Instead the client applies the train's per-frame delta CFrame to its own
	character while that character is inside the train volume. The client owns
	its character's physics, so this is smooth at any framerate and produces no
	jitter, no sliding and no falling through floors. See TrainRideController.

	GEOMETRY
	--------
	Exterior and interior are built against the same dimensions, from the same
	numbers, so a window on the outside is a window on the inside and a door
	always opens into a real space. Every carriage is walkable end to end and
	the gangways between them are real openings, not teleports.
]]

local BuildKit = require(script.Parent.BuildKit)
local TrainRegistry = require(game:GetService("ReplicatedStorage").LastSignal.Registry.TrainRegistry)

local C = Color3.fromRGB
local P = BuildKit.Palette

local TrainBuilder = {}

export type CabControls = {
	throttleLever: BasePart,
	brakeLever: BasePart,
	emergencyHandle: BasePart,
	reverser: BasePart,
	hornButton: BasePart,
	headlightSwitch: BasePart,
	cabinLightSwitch: BasePart,
	wiperSwitch: BasePart,
	doorSwitch: BasePart,
	radioDial: BasePart,
	speedNeedle: BasePart,
	fuelNeedle: BasePart,
	conditionNeedle: BasePart,
	driverSeat: Seat,
	wiperArms: { BasePart },
}

export type BuiltTrain = {
	model: Model,
	root: BasePart,
	trainId: string,
	-- Ordered, front to back.
	carriages: { Model },
	-- Everything a service needs to drive, light or interact with the train.
	cab: CabControls,
	headlights: { SpotLight },
	tailLights: { PointLight },
	cabinLights: { Light },
	interiorLights: { Light },
	wheels: { BasePart },
	doors: { { model: Model, hinge: BasePart, side: string, carriage: number } },
	fuelPoint: BasePart,
	repairPoint: BasePart,
	supplyRack: BasePart,
	radioSet: BasePart,
	-- Local-space box that defines "inside the train", used by the client ride
	-- controller and by the server for shelter checks.
	volumeSize: Vector3,
	volumeOffset: CFrame,
	partCount: number,
}

--------------------------------------------------------------------------
-- Bogies and running gear
--------------------------------------------------------------------------

local function buildWheel(cf: CFrame, radius: number, width: number, parent: Instance): BasePart
	-- Cylinder parts are oriented along X, so the wheel is rotated to stand up.
	local tyre = BuildKit.cylinder({
		name = "Wheel",
		size = Vector3.new(width, radius * 2, radius * 2),
		cf = cf * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, math.rad(90), 0),
		colour = C(58, 56, 54),
		material = Enum.Material.Metal,
		canCollide = false,
		castShadow = true,
		parent = parent,
	})
	-- Worn steel tread.
	BuildKit.cylinder({
		name = "Tread",
		size = Vector3.new(width * 0.55, radius * 2.02, radius * 2.02),
		cf = tyre.CFrame,
		colour = C(150, 148, 142),
		material = Enum.Material.Metal,
		reflectance = 0.18,
		canCollide = false,
		canQuery = false,
		castShadow = false,
		parent = parent,
	})
	-- Hub and spokes give the wheel a readable rotation.
	BuildKit.cylinder({
		name = "Hub",
		size = Vector3.new(width * 1.15, radius * 0.55, radius * 0.55),
		cf = tyre.CFrame,
		colour = C(72, 70, 66),
		material = Enum.Material.Metal,
		canCollide = false,
		canQuery = false,
		castShadow = false,
		parent = parent,
	})
	for i = 0, 5 do
		BuildKit.detail({
			name = "Spoke",
			size = Vector3.new(width * 0.4, radius * 1.5, 0.24),
			cf = tyre.CFrame * CFrame.Angles(math.rad(i * 30), 0, 0),
			colour = C(66, 64, 60),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	tyre:AddTag("TrainWheel")
	return tyre
end

local function buildBogie(cf: CFrame, axles: number, wheelRadius: number, width: number, parent: Instance): { BasePart }
	local wheels: { BasePart } = {}
	local spacing = 6.2
	local frameLength = spacing * (axles - 1) + 7

	-- Bogie frame: two side frames and a transom.
	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "BogieFrame",
			size = Vector3.new(0.8, 2.2, frameLength),
			cf = cf * CFrame.new(side * (width * 0.5 - 0.6), wheelRadius + 0.4, 0),
			colour = C(44, 44, 46),
			material = Enum.Material.Metal,
			canCollide = false,
			parent = parent,
		})
		-- Leaf spring stacks over each axle.
		for a = 0, axles - 1 do
			local z = -spacing * (axles - 1) * 0.5 + a * spacing
			for leaf = 0, 2 do
				BuildKit.detail({
					name = "Leaf",
					size = Vector3.new(0.5, 0.16, 2.6 - leaf * 0.5),
					cf = cf * CFrame.new(side * (width * 0.5 - 0.6), wheelRadius + 1.5 + leaf * 0.2, z),
					colour = C(52, 52, 54),
					material = Enum.Material.Metal,
					parent = parent,
				})
			end
			-- Axlebox.
			BuildKit.detail({
				name = "Axlebox",
				size = Vector3.new(1.1, 1.2, 1.4),
				cf = cf * CFrame.new(side * (width * 0.5 - 0.55), wheelRadius, z),
				colour = C(64, 60, 56),
				material = Enum.Material.Metal,
				parent = parent,
			})
			-- Brake shoe, sitting against the wheel face.
			BuildKit.detail({
				name = "BrakeShoe",
				size = Vector3.new(0.35, 1.6, 0.5),
				cf = cf * CFrame.new(side * (width * 0.5 - 1.5), wheelRadius, z + wheelRadius * 0.85),
				colour = C(88, 62, 48),
				material = Enum.Material.CorrodedMetal,
				parent = parent,
			})
		end
	end

	BuildKit.detail({
		name = "Transom",
		size = Vector3.new(width - 1.4, 1.0, 2.4),
		cf = cf * CFrame.new(0, wheelRadius + 0.8, 0),
		colour = C(46, 46, 48),
		material = Enum.Material.Metal,
		parent = parent,
	})

	-- Axles and wheels.
	for a = 0, axles - 1 do
		local z = -spacing * (axles - 1) * 0.5 + a * spacing
		BuildKit.detail({
			name = "Axle",
			size = Vector3.new(width - 1.2, 0.5, 0.5),
			cf = cf * CFrame.new(0, wheelRadius, z),
			colour = C(70, 68, 64),
			material = Enum.Material.Metal,
			parent = parent,
		})
		for _, side in { -1, 1 } do
			table.insert(wheels, buildWheel(cf * CFrame.new(side * (width * 0.5 + 0.15), wheelRadius, z), wheelRadius, 0.9, parent))
		end
	end

	return wheels
end

--------------------------------------------------------------------------
-- Couplers and buffer beams
--------------------------------------------------------------------------

local function buildCouplerEnd(cf: CFrame, width: number, colour: Color3, parent: Instance)
	-- Buffer beam.
	BuildKit.part({
		name = "BufferBeam",
		size = Vector3.new(width + 0.6, 2.0, 1.0),
		cf = cf,
		colour = C(112, 44, 40),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = parent,
	})
	-- Buffers.
	for _, side in { -1, 1 } do
		BuildKit.cylinder({
			name = "BufferShank",
			size = Vector3.new(1.4, 1.0, 1.0),
			cf = cf * CFrame.new(side * width * 0.32, 0, -0.9) * CFrame.Angles(0, math.rad(90), 0),
			colour = C(60, 58, 56),
			material = Enum.Material.Metal,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
		BuildKit.cylinder({
			name = "BufferHead",
			size = Vector3.new(0.4, 1.9, 1.9),
			cf = cf * CFrame.new(side * width * 0.32, 0, -1.7) * CFrame.Angles(0, math.rad(90), 0),
			colour = C(46, 46, 48),
			material = Enum.Material.Metal,
			reflectance = 0.1,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
	end
	-- Drawhook and three-link chain.
	BuildKit.detail({
		name = "Drawhook",
		size = Vector3.new(0.5, 0.9, 1.2),
		cf = cf * CFrame.new(0, -0.2, -0.8),
		colour = C(54, 52, 50),
		material = Enum.Material.Metal,
		parent = parent,
	})
	for link = 1, 3 do
		BuildKit.detail({
			name = "Link",
			size = Vector3.new(0.12, 0.7, 0.45),
			cf = cf * CFrame.new(0, -0.7 - link * 0.35, -0.9) * CFrame.Angles(0, 0, math.rad(if link % 2 == 0 then 90 else 0)),
			colour = C(48, 46, 44),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	-- Air and vacuum pipes with their cocks.
	for _, side in { -1, 1 } do
		BuildKit.pipeRun(
			cf,
			{ Vector3.new(side * width * 0.18, 0.6, 0.4), Vector3.new(side * width * 0.18, -0.4, -0.3), Vector3.new(side * width * 0.18, -0.9, -0.9) },
			0.28,
			C(58, 60, 58),
			parent
		)
		BuildKit.detail({
			name = "Cock",
			size = Vector3.new(0.45, 0.45, 0.3),
			cf = cf * CFrame.new(side * width * 0.18, 0.1, 0.0),
			colour = C(160, 62, 52),
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
	-- Steps up to the footplate.
	for _, side in { -1, 1 } do
		for stepIndex = 0, 2 do
			BuildKit.part({
				name = "Step",
				size = Vector3.new(2.2, 0.22, 0.9),
				cf = cf * CFrame.new(side * (width * 0.5 - 1.0), -1.4 - stepIndex * 1.0, 0.6 + stepIndex * 0.35),
				colour = C(70, 70, 72),
				material = Enum.Material.DiamondPlate,
				parent = parent,
			})
		end
	end
end

--------------------------------------------------------------------------
-- Locomotive
--------------------------------------------------------------------------

local function buildNose(
	cf: CFrame,
	style: string,
	width: number,
	height: number,
	livery: TrainRegistry.LiveryDef,
	parent: Instance
)
	if style == "raked" then
		BuildKit.wedge({
			name = "Nose",
			size = Vector3.new(width, height * 0.55, 7),
			cf = cf * CFrame.new(0, height * 0.22, -3.5) * CFrame.Angles(0, math.rad(180), 0),
			colour = livery.body,
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.part({
			name = "NoseLower",
			size = Vector3.new(width, height * 0.45, 7),
			cf = cf * CFrame.new(0, -height * 0.27, -3.5),
			colour = livery.body,
			material = Enum.Material.Metal,
			parent = parent,
		})
	elseif style == "bonnet" then
		-- A long low bonnet in front of a centre cab.
		BuildKit.part({
			name = "Bonnet",
			size = Vector3.new(width * 0.72, height * 0.62, 14),
			cf = cf * CFrame.new(0, -height * 0.16, -7),
			colour = livery.body,
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.detail({
			name = "BonnetTop",
			size = Vector3.new(width * 0.74, 0.35, 14),
			cf = cf * CFrame.new(0, height * 0.16, -7),
			colour = livery.roof,
			material = Enum.Material.Metal,
			parent = parent,
		})
		for i = 0, 5 do
			BuildKit.vent(
				cf * CFrame.new(width * 0.36, -height * 0.16, -2.5 - i * 2.0) * CFrame.Angles(0, math.rad(90), 0),
				1.6,
				height * 0.4,
				livery.trim,
				parent
			)
		end
	elseif style == "armoured" then
		BuildKit.part({
			name = "NoseArmour",
			size = Vector3.new(width + 0.4, height * 0.9, 6),
			cf = cf * CFrame.new(0, 0, -3),
			colour = livery.body,
			material = Enum.Material.DiamondPlate,
			parent = parent,
		})
		-- Plough / obstacle deflector.
		BuildKit.wedge({
			name = "Plough",
			size = Vector3.new(width + 1.2, 3.2, 3.4),
			cf = cf * CFrame.new(0, -height * 0.5 + 0.4, -6.4) * CFrame.Angles(0, math.rad(180), 0),
			colour = C(58, 58, 60),
			material = Enum.Material.DiamondPlate,
			parent = parent,
		})
		for _, side in { -1, 1 } do
			BuildKit.detail({
				name = "ArmourRib",
				size = Vector3.new(0.4, height * 0.85, 5.6),
				cf = cf * CFrame.new(side * (width * 0.5 + 0.2), 0, -3),
				colour = livery.trim,
				material = Enum.Material.Metal,
				parent = parent,
			})
		end
	else -- "blunt"
		BuildKit.part({
			name = "Nose",
			size = Vector3.new(width, height * 0.92, 5),
			cf = cf * CFrame.new(0, 0, -2.5),
			colour = livery.body,
			material = Enum.Material.Metal,
			parent = parent,
		})
		-- A shallow curve across the top of the nose so it is not a slab.
		BuildKit.wedge({
			name = "NoseCrown",
			size = Vector3.new(width, 1.4, 5),
			cf = cf * CFrame.new(0, height * 0.46 + 0.7, -2.5) * CFrame.Angles(0, math.rad(180), 0),
			colour = livery.roof,
			material = Enum.Material.Metal,
			parent = parent,
		})
	end
end

local function buildCabInterior(
	cf: CFrame,
	width: number,
	height: number,
	livery: TrainRegistry.LiveryDef,
	interior: TrainRegistry.InteriorDef,
	parent: Instance
): CabControls
	local desk = C(58, 60, 62)

	-- Floor, ceiling and rear bulkhead.
	BuildKit.part({
		name = "CabFloor",
		size = Vector3.new(width - 0.8, 0.4, 11),
		cf = cf * CFrame.new(0, -height * 0.5 + 0.2, 0),
		colour = C(48, 48, 50),
		material = Enum.Material.DiamondPlate,
		parent = parent,
	})
	BuildKit.part({
		name = "CabCeiling",
		size = Vector3.new(width - 0.8, 0.35, 11),
		cf = cf * CFrame.new(0, height * 0.5 - 0.2, 0),
		colour = interior.wall,
		material = Enum.Material.Metal,
		parent = parent,
	})
	BuildKit.part({
		name = "CabBulkhead",
		size = Vector3.new(width - 0.8, height - 0.8, 0.4),
		cf = cf * CFrame.new(0, 0, 5.3),
		colour = interior.wall,
		material = Enum.Material.Metal,
		parent = parent,
	})

	-- Driver's desk: a sloped console across the front of the cab.
	local deskTop = BuildKit.part({
		name = "DeskTop",
		size = Vector3.new(width - 2.2, 0.4, 2.6),
		cf = cf * CFrame.new(0, -height * 0.5 + 3.4, -3.6) * CFrame.Angles(math.rad(-18), 0, 0),
		colour = desk,
		material = Enum.Material.Metal,
		parent = parent,
	})
	BuildKit.part({
		name = "DeskFront",
		size = Vector3.new(width - 2.2, 3.0, 0.4),
		cf = cf * CFrame.new(0, -height * 0.5 + 1.9, -4.6),
		colour = desk,
		material = Enum.Material.Metal,
		parent = parent,
	})

	local function control(name: string, offset: CFrame, size: Vector3, colour: Color3, material: Enum.Material?): BasePart
		local p = BuildKit.part({
			name = name,
			size = size,
			cf = deskTop.CFrame * offset,
			colour = colour,
			material = material or Enum.Material.Metal,
			canCollide = false,
			parent = parent,
		})
		p:AddTag("CabControl")
		return p
	end

	-- Levers. Each has a visible pivot ball so its travel reads clearly.
	local throttle = control("ThrottleLever", CFrame.new(-2.6, 0.9, 0), Vector3.new(0.28, 1.8, 0.28), C(160, 130, 60))
	BuildKit.detail({
		name = "ThrottleKnob",
		size = Vector3.new(0.55, 0.55, 0.55),
		cf = throttle.CFrame * CFrame.new(0, 0.95, 0),
		colour = C(40, 40, 42),
		material = Enum.Material.SmoothPlastic,
		shape = Enum.PartType.Ball,
		parent = parent,
	})
	BuildKit.detail({
		name = "ThrottleQuadrant",
		size = Vector3.new(0.18, 1.4, 1.6),
		cf = throttle.CFrame * CFrame.new(-0.3, -0.4, 0),
		colour = C(72, 70, 68),
		material = Enum.Material.Metal,
		parent = parent,
	})

	local brake = control("BrakeLever", CFrame.new(-1.5, 0.8, 0), Vector3.new(0.26, 1.6, 0.26), C(140, 140, 145))
	BuildKit.detail({
		name = "BrakeKnob",
		size = Vector3.new(0.5, 0.5, 0.5),
		cf = brake.CFrame * CFrame.new(0, 0.85, 0),
		colour = C(40, 40, 42),
		material = Enum.Material.SmoothPlastic,
		shape = Enum.PartType.Ball,
		parent = parent,
	})

	local emergency = control("EmergencyHandle", CFrame.new(2.9, 0.7, 0), Vector3.new(0.3, 1.3, 0.3), C(178, 48, 42))
	BuildKit.detail({
		name = "EmergencyGuard",
		size = Vector3.new(1.1, 1.0, 1.1),
		cf = emergency.CFrame * CFrame.new(0, -0.5, 0),
		colour = C(196, 152, 58),
		material = Enum.Material.Metal,
		transparency = 0.45,
		parent = parent,
	})

	local reverser = control("Reverser", CFrame.new(-3.5, 0.55, 0.5), Vector3.new(0.9, 0.9, 0.35), C(90, 92, 96))
	local horn = control("HornButton", CFrame.new(0.4, 0.35, -0.6), Vector3.new(0.7, 0.35, 0.7), C(40, 40, 44), Enum.Material.SmoothPlastic)
	local headlightSwitch = control("HeadlightSwitch", CFrame.new(1.3, 0.3, -0.4), Vector3.new(0.35, 0.55, 0.35), C(196, 152, 58))
	local cabinLightSwitch = control("CabinLightSwitch", CFrame.new(1.8, 0.3, -0.4), Vector3.new(0.35, 0.55, 0.35), C(150, 152, 156))
	local wiperSwitch = control("WiperSwitch", CFrame.new(2.3, 0.3, -0.4), Vector3.new(0.35, 0.55, 0.35), C(110, 150, 170))
	local doorSwitch = control("DoorSwitch", CFrame.new(-0.6, 0.3, -0.6), Vector3.new(0.55, 0.35, 0.55), C(120, 170, 130), Enum.Material.SmoothPlastic)

	-- Gauges. Each is a dial face with a needle part the service rotates.
	local function gauge(offset: CFrame, label: string, faceColour: Color3): BasePart
		local face = BuildKit.detail({
			name = label .. "Face",
			size = Vector3.new(1.7, 0.2, 1.7),
			cf = deskTop.CFrame * offset,
			colour = faceColour,
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		BuildKit.detail({
			name = label .. "Bezel",
			size = Vector3.new(1.95, 0.28, 1.95),
			cf = face.CFrame * CFrame.new(0, -0.05, 0),
			colour = C(64, 62, 60),
			material = Enum.Material.Metal,
			parent = parent,
		})
		-- Tick marks around the dial.
		for i = 0, 10 do
			local angle = math.rad(-120 + i * 24)
			BuildKit.detail({
				name = "Tick",
				size = Vector3.new(0.08, 0.06, 0.3),
				cf = face.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.12, -0.65),
				colour = C(30, 30, 32),
				material = Enum.Material.SmoothPlastic,
				parent = parent,
			})
		end
		local needle = BuildKit.detail({
			name = label .. "Needle",
			size = Vector3.new(0.09, 0.09, 0.72),
			cf = face.CFrame * CFrame.new(0, 0.16, -0.3),
			colour = C(190, 60, 50),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		needle:AddTag("Gauge")
		return needle
	end

	local speedNeedle = gauge(CFrame.new(-0.9, 0.22, -0.2), "Speed", C(214, 208, 190))
	local fuelNeedle = gauge(CFrame.new(1.0, 0.22, 0.6), "Fuel", C(206, 200, 182))
	local conditionNeedle = gauge(CFrame.new(2.4, 0.22, 0.6), "Condition", C(206, 200, 182))

	-- Radio set, mounted on the bulkhead behind the driver.
	local radio = BuildKit.part({
		name = "RadioSet",
		size = Vector3.new(2.4, 1.5, 1.0),
		cf = cf * CFrame.new(width * 0.28, -height * 0.5 + 4.2, 4.6),
		colour = C(58, 60, 56),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = parent,
	})
	radio:AddTag("RadioSet")
	BuildKit.detail({
		name = "RadioDialFace",
		size = Vector3.new(1.2, 0.6, 0.2),
		cf = radio.CFrame * CFrame.new(0, 0.25, -0.55),
		colour = C(196, 186, 150),
		material = Enum.Material.Neon,
		parent = parent,
	})
	local radioDial = BuildKit.detail({
		name = "RadioDial",
		size = Vector3.new(0.45, 0.45, 0.3),
		cf = radio.CFrame * CFrame.new(-0.7, -0.35, -0.55),
		colour = C(40, 40, 42),
		material = Enum.Material.SmoothPlastic,
		parent = parent,
	})
	radioDial:AddTag("CabControl")
	BuildKit.grille(radio.CFrame * CFrame.new(0.5, -0.3, -0.52), 0.8, 0.7, 0.16, C(40, 40, 42), parent)

	-- Driver's seat. A real Seat so sitting is native and reliable.
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2.2, 0.5, 2.2)
	seat.CFrame = cf * CFrame.new(-width * 0.22, -height * 0.5 + 2.4, -0.4)
	seat.Color = interior.seat
	seat.Material = interior.seatMaterial
	seat.Anchored = true
	seat.CanTouch = true
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Parent = parent
	seat:AddTag("DriverSeat")
	BuildKit.detail({
		name = "SeatBack",
		size = Vector3.new(2.2, 2.6, 0.4),
		cf = seat.CFrame * CFrame.new(0, 1.3, 1.1),
		colour = interior.seat,
		material = interior.seatMaterial,
		parent = parent,
	})
	BuildKit.detail({
		name = "SeatPedestal",
		size = Vector3.new(0.7, 2.2, 0.7),
		cf = seat.CFrame * CFrame.new(0, -1.2, 0),
		colour = C(52, 52, 54),
		material = Enum.Material.Metal,
		parent = parent,
	})

	-- Secondary seat for a second crew member.
	local mate = Instance.new("Seat")
	mate.Name = "SecondSeat"
	mate.Size = Vector3.new(2.0, 0.5, 2.0)
	mate.CFrame = cf * CFrame.new(width * 0.24, -height * 0.5 + 2.3, -0.4)
	mate.Color = interior.seat
	mate.Material = interior.seatMaterial
	mate.Anchored = true
	mate.Parent = parent

	-- Wiper arms on the inside of the windscreen.
	local wipers: { BasePart } = {}
	for _, side in { -1, 1 } do
		local pivot = cf * CFrame.new(side * width * 0.22, -height * 0.5 + 6.3, -5.2)
		BuildKit.detail({
			name = "WiperPivot",
			size = Vector3.new(0.35, 0.35, 0.3),
			cf = pivot,
			colour = C(40, 40, 42),
			material = Enum.Material.Metal,
			parent = parent,
		})
		local arm = BuildKit.detail({
			name = "WiperArm",
			size = Vector3.new(0.16, 3.4, 0.16),
			cf = pivot * CFrame.new(0, 1.7, -0.15),
			colour = C(36, 36, 38),
			material = Enum.Material.Metal,
			parent = parent,
		})
		BuildKit.detail({
			name = "WiperBlade",
			size = Vector3.new(0.12, 3.0, 0.1),
			cf = arm.CFrame * CFrame.new(0, 0.1, -0.14),
			colour = C(28, 28, 30),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		arm:AddTag("WiperArm")
		table.insert(wipers, arm)
	end

	return {
		throttleLever = throttle,
		brakeLever = brake,
		emergencyHandle = emergency,
		reverser = reverser,
		hornButton = horn,
		headlightSwitch = headlightSwitch,
		cabinLightSwitch = cabinLightSwitch,
		wiperSwitch = wiperSwitch,
		doorSwitch = doorSwitch,
		radioDial = radioDial,
		speedNeedle = speedNeedle,
		fuelNeedle = fuelNeedle,
		conditionNeedle = conditionNeedle,
		driverSeat = seat,
		wiperArms = wipers,
	}
end

local function buildLocomotive(
	originCF: CFrame,
	def: TrainRegistry.TrainDef,
	livery: TrainRegistry.LiveryDef,
	interior: TrainRegistry.InteriorDef,
	parent: Instance,
	rng: Random
): {
	wheels: { BasePart },
	cab: CabControls,
	headlights: { SpotLight },
	cabinLights: { Light },
	fuelPoint: BasePart,
	repairPoint: BasePart,
	radioSet: BasePart,
	doors: { { model: Model, hinge: BasePart, side: string, carriage: number } },
}
	local build = def.build
	local width = build.locoWidth
	local height = build.locoHeight
	local length = build.locoLength
	local model = BuildKit.model("Locomotive", parent)

	local wheels: { BasePart } = {}
	local doors: { { model: Model, hinge: BasePart, side: string, carriage: number } } = {}

	--------------------------------------------------------------
	-- Underframe and running gear
	--------------------------------------------------------------
	BuildKit.part({
		name = "Underframe",
		size = Vector3.new(width - 0.6, 1.6, length - 3),
		cf = originCF * CFrame.new(0, 2.2, 0),
		colour = livery.underframe,
		material = Enum.Material.Metal,
		canCollide = false,
		parent = model,
	})
	-- Solebar with rivets down each side.
	for _, side in { -1, 1 } do
		BuildKit.detail({
			name = "Solebar",
			size = Vector3.new(0.5, 1.9, length - 3),
			cf = originCF * CFrame.new(side * (width * 0.5 - 0.2), 2.2, 0),
			colour = livery.underframe,
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.rivetStrip(
			originCF * CFrame.new(side * (width * 0.5 + 0.05), 2.2, (length - 6) * 0.5),
			length - 6,
			2.2,
			0.1,
			C(58, 58, 58),
			model
		)
	end

	local bogieSpacing = length * 0.29
	for _, offset in { -bogieSpacing, bogieSpacing } do
		for _, w in buildBogie(originCF * CFrame.new(0, 0, offset), build.axlesPerBogie, build.wheelRadius, width - 2.2, model) do
			table.insert(wheels, w)
		end
	end

	-- Fuel and air tanks slung under the frame.
	BuildKit.cylinder({
		name = "FuelTank",
		size = Vector3.new(width - 4, 3.4, 3.4),
		cf = originCF * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, math.rad(90), 0),
		colour = C(52, 54, 56),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = model,
	})
	for _, side in { -1, 1 } do
		BuildKit.cylinder({
			name = "AirTank",
			size = Vector3.new(5, 1.5, 1.5),
			cf = originCF * CFrame.new(side * (width * 0.5 - 2.2), 1.4, length * 0.18) * CFrame.Angles(0, math.rad(90), 0),
			colour = C(62, 64, 66),
			material = Enum.Material.Metal,
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	end

	--------------------------------------------------------------
	-- Body sides
	--------------------------------------------------------------
	local bodyBottom = 3.0
	local bodyTop = bodyBottom + height
	local bodyCentreY = (bodyBottom + bodyTop) * 0.5

	-- The cab occupies one end (or the centre); the engine bay the rest.
	local cabLength = 11
	local cabZ = if build.cabPosition == "front" then -(length * 0.5 - cabLength * 0.5 - 1) else 0

	for _, side in { -1, 1 } do
		BuildKit.part({
			name = "BodySide",
			size = Vector3.new(0.6, height, length - 4),
			cf = originCF * CFrame.new(side * (width * 0.5 - 0.3), bodyCentreY, 0),
			colour = livery.body,
			material = Enum.Material.Metal,
			parent = model,
		})
		-- Waist stripe, if the livery has one.
		if livery.stripe then
			BuildKit.detail({
				name = "Stripe",
				size = Vector3.new(0.12, 0.9, length - 4),
				cf = originCF * CFrame.new(side * (width * 0.5 + 0.05), bodyCentreY + height * 0.12, 0),
				colour = livery.stripe,
				material = Enum.Material.Metal,
				parent = model,
			})
		end
		-- Hazard chevrons for liveries that use them.
		if livery.pattern == "chevron" then
			for i = 0, 5 do
				BuildKit.detail({
					name = "Chevron",
					size = Vector3.new(0.1, height * 0.3, 1.6),
					cf = originCF
						* CFrame.new(side * (width * 0.5 + 0.06), bodyBottom + height * 0.22, -length * 0.4 + i * 2.6)
						* CFrame.Angles(math.rad(28), 0, 0),
					colour = livery.trim,
					material = Enum.Material.Metal,
					parent = model,
				})
			end
		end

		-- Engine bay louvres and radiator grille.
		local bayStart = if build.cabPosition == "front" then -length * 0.5 + cabLength + 3 else -length * 0.5 + 4
		for i = 0, math.max(2, build.detailLevel) do
			local z = bayStart + i * 4.2
			if math.abs(z - cabZ) > cabLength * 0.6 and math.abs(z) < length * 0.5 - 4 then
				BuildKit.vent(
					originCF * CFrame.new(side * (width * 0.5 + 0.1), bodyCentreY + 1.0, z) * CFrame.Angles(0, math.rad(90), 0),
					3.0,
					height * 0.34,
					livery.trim,
					model
				)
			end
		end
		BuildKit.grille(
			originCF * CFrame.new(side * (width * 0.5 + 0.12), bodyCentreY - height * 0.2, length * 0.3) * CFrame.Angles(0, math.rad(90), 0),
			4.0,
			height * 0.3,
			0.5,
			C(46, 46, 48),
			model
		)

		-- Rust streaking, so painted steel does not read as plastic.
		BuildKit.rustStreaks(
			originCF * CFrame.new(side * (width * 0.5 + 0.07), bodyCentreY, 0),
			length - 6,
			height,
			build.detailLevel * 3,
			rng,
			model
		)

		-- Full-length handrail and grab irons.
		BuildKit.handrail(
			originCF * CFrame.new(side * (width * 0.5 + 0.45), bodyBottom - 0.2, 0),
			length - 8,
			1.1,
			livery.trim,
			model
		)

		-- Cab side door with a real opening.
		local doorCF = originCF * CFrame.new(side * (width * 0.5 - 0.35), bodyBottom + 0.2, cabZ + 3.4)
		local door = BuildKit.door(doorCF * CFrame.Angles(0, math.rad(if side > 0 then 0 else 180), 0), 3.2, 7.0, 0.35, livery.body, Enum.Material.Metal, model)
		door.Name = "CabDoor"
		table.insert(doors, { model = door, hinge = door.PrimaryPart :: BasePart, side = if side > 0 then "right" else "left", carriage = 0 })
		-- Cab side window above the door.
		BuildKit.window(
			originCF * CFrame.new(side * (width * 0.5 + 0.02), bodyBottom + 8.4, cabZ + 0.5) * CFrame.Angles(0, math.rad(90), 0),
			4.0,
			3.2,
			livery.trim,
			model
		)
	end

	--------------------------------------------------------------
	-- Roof
	--------------------------------------------------------------
	BuildKit.part({
		name = "Roof",
		size = Vector3.new(width, 0.7, length - 4),
		cf = originCF * CFrame.new(0, bodyTop, 0),
		colour = livery.roof,
		material = Enum.Material.Metal,
		parent = model,
	})
	-- Slight roof camber, built from two shallow wedges.
	for _, side in { -1, 1 } do
		BuildKit.wedge({
			name = "RoofCamber",
			size = Vector3.new(width * 0.5, 0.6, length - 4),
			cf = originCF * CFrame.new(side * width * 0.25, bodyTop + 0.6, 0) * CFrame.Angles(0, math.rad(if side > 0 then 0 else 180), 0),
			colour = livery.roof,
			material = Enum.Material.Metal,
			canCollide = false,
			parent = model,
		})
	end

	-- Exhaust stacks with soot staining.
	for i = 1, build.exhaustStacks do
		local z = length * 0.1 + (i - 1) * 5
		BuildKit.cylinder({
			name = "ExhaustStack",
			size = Vector3.new(2.2, 2.6, 2.6),
			cf = originCF * CFrame.new(0, bodyTop + 1.6, z) * CFrame.Angles(0, 0, math.rad(90)),
			colour = C(44, 42, 40),
			material = Enum.Material.CorrodedMetal,
			canCollide = false,
			parent = model,
		})
		BuildKit.detail({
			name = "StackSoot",
			size = Vector3.new(3.0, 0.15, 3.0),
			cf = originCF * CFrame.new(0, bodyTop + 0.45, z),
			colour = C(28, 26, 24),
			material = Enum.Material.Slate,
			transparency = 0.3,
			parent = model,
		})
	end

	-- Radiator fan grilles on the roof.
	for i = 0, math.max(1, build.detailLevel - 2) do
		local z = -length * 0.06 - i * 5.5
		if math.abs(z - cabZ) > cabLength * 0.7 then
			BuildKit.cylinder({
				name = "FanRing",
				size = Vector3.new(0.5, 4.4, 4.4),
				cf = originCF * CFrame.new(0, bodyTop + 0.6, z),
				colour = C(52, 52, 54),
				material = Enum.Material.Metal,
				canCollide = false,
				canQuery = false,
				parent = model,
			})
			for blade = 0, 5 do
				BuildKit.detail({
					name = "FanBlade",
					size = Vector3.new(3.6, 0.14, 0.9),
					cf = originCF * CFrame.new(0, bodyTop + 0.62, z) * CFrame.Angles(0, math.rad(blade * 30), math.rad(18)),
					colour = C(64, 64, 66),
					material = Enum.Material.Metal,
					parent = model,
				})
			end
		end
	end

	-- Horn cluster on the cab roof.
	for i = 0, 1 do
		BuildKit.cylinder({
			name = "Horn",
			size = Vector3.new(2.2, 0.9, 0.9),
			cf = originCF * CFrame.new(-0.8 + i * 1.6, bodyTop + 1.0, cabZ - 3.0) * CFrame.Angles(0, math.rad(90), 0),
			colour = C(150, 120, 62),
			material = Enum.Material.Metal,
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	end

	-- Roof walkway, so a player on the roof has somewhere to stand.
	BuildKit.part({
		name = "RoofWalkway",
		size = Vector3.new(3.2, 0.2, length - 10),
		cf = originCF * CFrame.new(0, bodyTop + 1.2, 0),
		colour = C(56, 56, 58),
		material = Enum.Material.DiamondPlate,
		parent = model,
	})

	--------------------------------------------------------------
	-- Nose, cab glazing and lights
	--------------------------------------------------------------
	local noseCF = originCF * CFrame.new(0, bodyCentreY, -length * 0.5 + 1)
	buildNose(noseCF, build.nose, width, height, livery, model)

	-- Windscreen: two panes with a centre pillar.
	for _, side in { -1, 1 } do
		BuildKit.window(
			originCF * CFrame.new(side * width * 0.24, bodyBottom + 8.2, cabZ - 5.3),
			4.6,
			4.2,
			livery.trim,
			model
		)
	end
	BuildKit.detail({
		name = "CentrePillar",
		size = Vector3.new(0.6, 4.6, 0.5),
		cf = originCF * CFrame.new(0, bodyBottom + 8.2, cabZ - 5.3),
		colour = livery.trim,
		material = Enum.Material.Metal,
		parent = model,
	})

	local headlights: { SpotLight } = {}
	for _, side in { -1, 1 } do
		local housing = BuildKit.detail({
			name = "HeadlampHousing",
			size = Vector3.new(2.0, 2.0, 1.2),
			cf = noseCF * CFrame.new(side * width * 0.3, -height * 0.18, -2.8),
			colour = C(50, 50, 52),
			material = Enum.Material.Metal,
			parent = model,
		})
		local lens = BuildKit.detail({
			name = "HeadlampLens",
			size = Vector3.new(1.6, 1.6, 0.3),
			cf = housing.CFrame * CFrame.new(0, 0, -0.7),
			colour = livery.lampColour,
			material = Enum.Material.Neon,
			parent = model,
		})
		lens.Name = "HeadlampLens"
		lens:AddTag("HeadlampLens")
		local spot = Instance.new("SpotLight")
		spot.Color = livery.lampColour
		spot.Brightness = 4.5
		spot.Range = 200 * def.handling.headlightRangeMultiplier
		spot.Angle = 56
		spot.Face = Enum.NormalId.Front
		spot.Shadows = true
		spot.Enabled = false
		spot.Parent = lens
		table.insert(headlights, spot)
	end
	-- Marker lights, always on, so the train is locatable from the forest.
	for _, side in { -1, 1 } do
		local marker = BuildKit.detail({
			name = "MarkerLamp",
			size = Vector3.new(0.8, 0.8, 0.5),
			cf = noseCF * CFrame.new(side * width * 0.42, height * 0.22, -2.6),
			colour = C(255, 214, 150),
			material = Enum.Material.Neon,
			parent = model,
		})
		local point = Instance.new("PointLight")
		point.Color = C(255, 214, 150)
		point.Brightness = 1.4
		point.Range = 26
		point.Parent = marker
	end

	--------------------------------------------------------------
	-- Cab interior
	--------------------------------------------------------------
	local cab = buildCabInterior(
		originCF * CFrame.new(0, bodyBottom + height * 0.5, cabZ),
		width,
		height,
		livery,
		interior,
		model
	)

	local cabinLights: { Light } = {}
	do
		local _, light = BuildKit.lamp(
			originCF * CFrame.new(0, bodyTop - 1.2, cabZ + 1.0),
			"bulkhead",
			interior.lampColour,
			interior.lampBrightness,
			26,
			model
		)
		table.insert(cabinLights, light)
	end

	--------------------------------------------------------------
	-- Engine bay: fuel and repair points
	--------------------------------------------------------------
	local bayZ = if build.cabPosition == "front" then length * 0.2 else length * 0.32

	local fuelPoint = BuildKit.part({
		name = "FuelPoint",
		size = Vector3.new(2.2, 2.6, 2.2),
		cf = originCF * CFrame.new(width * 0.5 - 1.4, bodyBottom - 0.6, bayZ),
		colour = C(64, 66, 60),
		material = Enum.Material.Metal,
		canCollide = false,
		parent = model,
	})
	BuildKit.detail({
		name = "FillerCap",
		size = Vector3.new(1.2, 0.4, 1.2),
		cf = fuelPoint.CFrame * CFrame.new(0, 1.4, 0),
		colour = C(160, 130, 60),
		material = Enum.Material.Metal,
		parent = model,
	})
	fuelPoint:AddTag("TrainFuelPoint")

	local repairPoint = BuildKit.part({
		name = "RepairPoint",
		size = Vector3.new(2.4, 3.0, 2.4),
		cf = originCF * CFrame.new(-(width * 0.5 - 1.4), bodyBottom - 0.4, bayZ),
		colour = C(60, 62, 64),
		material = Enum.Material.DiamondPlate,
		canCollide = false,
		parent = model,
	})
	BuildKit.pipeRun(
		repairPoint.CFrame,
		{ Vector3.new(0, 1.6, -1), Vector3.new(0, 2.4, 0), Vector3.new(0, 2.4, 1.4) },
		0.4,
		C(120, 90, 60),
		model
	)
	repairPoint:AddTag("TrainRepairPoint")

	local radioSet = model:FindFirstChild("RadioSet", true) :: BasePart

	--------------------------------------------------------------
	-- Coupler ends
	--------------------------------------------------------------
	buildCouplerEnd(originCF * CFrame.new(0, 2.4, -length * 0.5), width, livery.body, model)
	buildCouplerEnd(originCF * CFrame.new(0, 2.4, length * 0.5) * CFrame.Angles(0, math.rad(180), 0), width, livery.body, model)

	return {
		wheels = wheels,
		cab = cab,
		headlights = headlights,
		cabinLights = cabinLights,
		fuelPoint = fuelPoint,
		repairPoint = repairPoint,
		radioSet = radioSet,
		doors = doors,
	}
end

--------------------------------------------------------------------------
-- Carriages
--------------------------------------------------------------------------

local function buildCarriage(
	originCF: CFrame,
	spec: TrainRegistry.CarriageSpec,
	index: number,
	def: TrainRegistry.TrainDef,
	livery: TrainRegistry.LiveryDef,
	interior: TrainRegistry.InteriorDef,
	parent: Instance,
	rng: Random
): {
	model: Model,
	wheels: { BasePart },
	lights: { Light },
	doors: { { model: Model, hinge: BasePart, side: string, carriage: number } },
	supplyRack: BasePart?,
}
	local model = BuildKit.model("Carriage" .. index, parent)
	local width = def.build.locoWidth - 0.5
	local height = def.build.locoHeight - 1.5
	local length = spec.length
	local wheels: { BasePart } = {}
	local lights: { Light } = {}
	local doors: { { model: Model, hinge: BasePart, side: string, carriage: number } } = {}
	local supplyRack: BasePart? = nil

	local bodyBottom = 3.0
	local bodyTop = bodyBottom + height
	local bodyCentreY = (bodyBottom + bodyTop) * 0.5
	local isFlat = spec.kind == "flat"

	--------------------------------------------------------------
	-- Underframe and bogies
	--------------------------------------------------------------
	BuildKit.part({
		name = "Underframe",
		size = Vector3.new(width - 0.4, 1.4, length - 2),
		cf = originCF * CFrame.new(0, 2.3, 0),
		colour = livery.underframe,
		material = Enum.Material.Metal,
		canCollide = false,
		parent = model,
	})
	for _, side in { -1, 1 } do
		BuildKit.detail({
			name = "Solebar",
			size = Vector3.new(0.45, 1.7, length - 2),
			cf = originCF * CFrame.new(side * (width * 0.5 - 0.15), 2.3, 0),
			colour = livery.underframe,
			material = Enum.Material.Metal,
			parent = model,
		})
		BuildKit.rivetStrip(
			originCF * CFrame.new(side * (width * 0.5 + 0.05), 2.3, (length - 5) * 0.5),
			length - 5,
			2.4,
			0.09,
			C(56, 56, 56),
			model
		)
	end
	for _, offset in { -length * 0.31, length * 0.31 } do
		for _, w in buildBogie(originCF * CFrame.new(0, 0, offset), 2, def.build.wheelRadius * 0.92, width - 2.4, model) do
			table.insert(wheels, w)
		end
	end

	--------------------------------------------------------------
	-- Floor. Collidable, because players walk on it.
	--------------------------------------------------------------
	BuildKit.part({
		name = "Floor",
		size = Vector3.new(width - 1.2, 0.5, length - 2.5),
		cf = originCF * CFrame.new(0, bodyBottom + 0.25, 0),
		colour = interior.floor,
		material = if isFlat then Enum.Material.WoodPlanks else Enum.Material.Fabric,
		parent = model,
	})

	if isFlat then
		--------------------------------------------------------------
		-- Flat wagon: deck, stanchions and a lashed load.
		--------------------------------------------------------------
		for _, side in { -1, 1 } do
			for i = 0, 5 do
				BuildKit.part({
					name = "Stanchion",
					size = Vector3.new(0.5, 5.0, 0.5),
					cf = originCF * CFrame.new(side * (width * 0.5 - 0.4), bodyBottom + 2.5, -length * 0.4 + i * (length * 0.16)),
					colour = livery.underframe,
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			BuildKit.handrail(
				originCF * CFrame.new(side * (width * 0.5 - 0.4), bodyBottom + 0.3, 0),
				length - 6,
				1.0,
				livery.trim,
				model
			)
		end
		for i = 0, spec.crates - 1 do
			local cx = (i % 2 == 0) and -2.4 or 2.4
			local cz = -length * 0.33 + math.floor(i / 2) * 5.5
			BuildKit.part({
				name = "Cargo",
				size = Vector3.new(4.2, 3.4, 4.6),
				cf = originCF * CFrame.new(cx, bodyBottom + 2.2, cz) * CFrame.Angles(0, math.rad(rng:NextNumber(-4, 4)), 0),
				colour = BuildKit.weather(P.planking, 0.05, rng),
				material = Enum.Material.WoodPlanks,
				parent = model,
			})
		end
		-- Lashing straps over the load.
		for i = 0, 3 do
			BuildKit.detail({
				name = "Strap",
				size = Vector3.new(width - 1.5, 0.14, 0.4),
				cf = originCF * CFrame.new(0, bodyBottom + 4.0, -length * 0.3 + i * (length * 0.2)),
				colour = C(96, 84, 60),
				material = Enum.Material.Fabric,
				parent = model,
			})
		end
	else
		--------------------------------------------------------------
		-- Enclosed body
		--------------------------------------------------------------
		local isGuard = spec.kind == "guard"
		local windowCount = math.max(3, math.floor(length / 9))
		local windowSpacing = (length - 10) / (windowCount - 1)

		for _, side in { -1, 1 } do
			-- Side wall built as segments so window openings are real gaps.
			local segmentZ = -length * 0.5 + 1.25
			BuildKit.part({
				name = "SideWall",
				size = Vector3.new(0.55, height, length - 2.5),
				cf = originCF * CFrame.new(side * (width * 0.5 - 0.28), bodyCentreY, 0),
				colour = livery.body,
				material = Enum.Material.Metal,
				parent = model,
			})
			-- Interior lining, so the inside is not bare exterior colour.
			BuildKit.detail({
				name = "Lining",
				size = Vector3.new(0.2, height - 1.2, length - 3),
				cf = originCF * CFrame.new(side * (width * 0.5 - 0.7), bodyCentreY, 0),
				colour = interior.wall,
				material = Enum.Material.Wood,
				parent = model,
			})
			BuildKit.detail({
				name = "Dado",
				size = Vector3.new(0.26, 1.0, length - 3),
				cf = originCF * CFrame.new(side * (width * 0.5 - 0.72), bodyBottom + 1.6, 0),
				colour = interior.trim,
				material = Enum.Material.Wood,
				parent = model,
			})
			_ = segmentZ

			for i = 0, windowCount - 1 do
				local z = -length * 0.5 + 5 + i * windowSpacing
				local broken = not isGuard and rng:NextNumber() < 0.12
				if isGuard then
					-- Guard van windows are shuttered with a narrow slit.
					BuildKit.detail({
						name = "Shutter",
						size = Vector3.new(0.2, 3.6, 4.0),
						cf = originCF * CFrame.new(side * (width * 0.5 + 0.05), bodyBottom + height * 0.62, z),
						colour = livery.trim,
						material = Enum.Material.DiamondPlate,
						parent = model,
					})
					BuildKit.detail({
						name = "Slit",
						size = Vector3.new(0.1, 0.5, 3.0),
						cf = originCF * CFrame.new(side * (width * 0.5 + 0.12), bodyBottom + height * 0.68, z),
						colour = C(20, 20, 22),
						material = Enum.Material.SmoothPlastic,
						parent = model,
					})
				else
					BuildKit.window(
						originCF * CFrame.new(side * (width * 0.5 + 0.02), bodyBottom + height * 0.62, z),
						4.2,
						3.8,
						livery.trim,
						model,
						broken
					)
				end
			end

			-- Passenger door, one per side, roughly a third along.
			local doorZ = -length * 0.5 + length * 0.3
			local doorCF = originCF * CFrame.new(side * (width * 0.5 - 0.3), bodyBottom + 0.1, doorZ)
			local door = BuildKit.door(
				doorCF * CFrame.Angles(0, math.rad(if side > 0 then 0 else 180), 0),
				3.4,
				7.2,
				0.32,
				livery.body,
				Enum.Material.Metal,
				model
			)
			door.Name = "CarriageDoor"
			table.insert(doors, { model = door, hinge = door.PrimaryPart :: BasePart, side = if side > 0 then "right" else "left", carriage = index })
			-- Boarding steps below each door.
			for stepIndex = 0, 1 do
				BuildKit.part({
					name = "Step",
					size = Vector3.new(2.0, 0.22, 3.2),
					cf = originCF * CFrame.new(side * (width * 0.5 + 0.6), bodyBottom - 1.1 - stepIndex * 1.1, doorZ),
					colour = C(68, 68, 70),
					material = Enum.Material.DiamondPlate,
					parent = model,
				})
			end
			BuildKit.handrail(
				originCF * CFrame.new(side * (width * 0.5 + 0.4), bodyBottom - 0.4, doorZ + 2.6),
				4.0,
				2.4,
				livery.trim,
				model
			)

			BuildKit.rustStreaks(
				originCF * CFrame.new(side * (width * 0.5 + 0.06), bodyCentreY, 0),
				length - 6,
				height,
				def.build.detailLevel * 2,
				rng,
				model
			)
		end

		-- Roof with vents.
		BuildKit.part({
			name = "Roof",
			size = Vector3.new(width, 0.65, length - 2.5),
			cf = originCF * CFrame.new(0, bodyTop, 0),
			colour = livery.roof,
			material = Enum.Material.Metal,
			parent = model,
		})
		for _, side in { -1, 1 } do
			BuildKit.wedge({
				name = "RoofCamber",
				size = Vector3.new(width * 0.5, 0.55, length - 2.5),
				cf = originCF * CFrame.new(side * width * 0.25, bodyTop + 0.55, 0) * CFrame.Angles(0, math.rad(if side > 0 then 0 else 180), 0),
				colour = livery.roof,
				material = Enum.Material.Metal,
				canCollide = false,
				parent = model,
			})
		end
		for i = 0, math.floor(length / 14) do
			BuildKit.detail({
				name = "RoofVent",
				size = Vector3.new(1.8, 0.9, 1.8),
				cf = originCF * CFrame.new(0, bodyTop + 0.9, -length * 0.35 + i * 13),
				colour = C(92, 94, 96),
				material = Enum.Material.Metal,
				parent = model,
			})
		end

		-- End walls with gangway openings, so carriages genuinely connect.
		for _, endSign in { -1, 1 } do
			local endZ = endSign * (length * 0.5 - 0.6)
			-- Wall either side of the gangway.
			for _, side in { -1, 1 } do
				BuildKit.part({
					name = "EndWall",
					size = Vector3.new(width * 0.32, height, 0.5),
					cf = originCF * CFrame.new(side * (width * 0.34), bodyCentreY, endZ),
					colour = livery.body,
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			-- Header above the gangway.
			BuildKit.part({
				name = "EndHeader",
				size = Vector3.new(width * 0.4, height - 7.4, 0.5),
				cf = originCF * CFrame.new(0, bodyBottom + 7.4 + (height - 7.4) * 0.5, endZ),
				colour = livery.body,
				material = Enum.Material.Metal,
				parent = model,
			})
			-- Concertina gangway shroud.
			for ring = 0, 2 do
				BuildKit.detail({
					name = "GangwayRing",
					size = Vector3.new(width * 0.42 + ring * 0.12, 7.6 + ring * 0.12, 0.3),
					cf = originCF * CFrame.new(0, bodyBottom + 3.8, endZ + endSign * (0.6 + ring * 0.6)),
					colour = C(42, 40, 40),
					material = Enum.Material.Fabric,
					parent = model,
				})
			end
			-- Gangway plate to walk across.
			BuildKit.part({
				name = "GangwayPlate",
				size = Vector3.new(width * 0.36, 0.3, 3.2),
				cf = originCF * CFrame.new(0, bodyBottom + 0.3, endZ + endSign * 1.6),
				colour = C(62, 62, 64),
				material = Enum.Material.DiamondPlate,
				parent = model,
			})
		end

		--------------------------------------------------------------
		-- Interior fittings
		--------------------------------------------------------------
		-- Seating: facing bays either side of a central aisle.
		local bays = math.floor(spec.seats / 4)
		for bay = 0, bays - 1 do
			local bz = -length * 0.5 + 9 + bay * 11
			for _, side in { -1, 1 } do
				for _, facing in { -1, 1 } do
					local seat = Instance.new("Seat")
					seat.Name = "PassengerSeat"
					seat.Size = Vector3.new(3.4, 0.45, 2.6)
					seat.CFrame = originCF * CFrame.new(side * (width * 0.26), bodyBottom + 2.0, bz + facing * 1.8)
					seat.Color = interior.seat
					seat.Material = interior.seatMaterial
					seat.Anchored = true
					seat.TopSurface = Enum.SurfaceType.Smooth
					seat.Parent = model
					BuildKit.detail({
						name = "SeatBack",
						size = Vector3.new(3.4, 3.2, 0.45),
						cf = seat.CFrame * CFrame.new(0, 1.6, facing * 1.3),
						colour = interior.seat,
						material = interior.seatMaterial,
						parent = model,
					})
					BuildKit.detail({
						name = "SeatFrame",
						size = Vector3.new(3.2, 1.5, 2.4),
						cf = seat.CFrame * CFrame.new(0, -0.9, 0),
						colour = interior.trim,
						material = Enum.Material.Wood,
						parent = model,
					})
				end
				-- Table between the facing pairs.
				BuildKit.detail({
					name = "Table",
					size = Vector3.new(3.0, 0.25, 2.2),
					cf = originCF * CFrame.new(side * (width * 0.26), bodyBottom + 2.9, bz),
					colour = interior.trim,
					material = Enum.Material.Wood,
					parent = model,
				})
			end
		end

		-- Luggage racks above the windows, on both sides.
		for _, side in { -1, 1 } do
			for rack = 0, spec.racks - 1 do
				local rz = -length * 0.5 + 8 + rack * ((length - 16) / math.max(1, spec.racks - 1))
				BuildKit.detail({
					name = "LuggageRack",
					size = Vector3.new(2.6, 0.18, 7.0),
					cf = originCF * CFrame.new(side * (width * 0.32), bodyBottom + height * 0.78, rz),
					colour = interior.trim,
					material = Enum.Material.Wood,
					parent = model,
				})
				for bracket = -1, 1, 2 do
					BuildKit.detail({
						name = "RackBracket",
						size = Vector3.new(2.4, 1.1, 0.16),
						cf = originCF * CFrame.new(side * (width * 0.32), bodyBottom + height * 0.83, rz + bracket * 3.2),
						colour = C(120, 110, 90),
						material = Enum.Material.Metal,
						parent = model,
					})
				end
			end
		end

		-- Storage crates and, in supply and workshop stock, the supply rack.
		if spec.kind == "supply" or spec.kind == "workshop" or spec.kind == "guard" then
			local rack = BuildKit.part({
				name = "SupplyRack",
				size = Vector3.new(3.0, 6.0, 8.0),
				cf = originCF * CFrame.new(-(width * 0.5 - 2.2), bodyBottom + 3.2, length * 0.28),
				colour = C(78, 74, 66),
				material = Enum.Material.Metal,
				parent = model,
			})
			rack:AddTag("SupplyRack")
			supplyRack = rack
			for shelf = 0, 3 do
				BuildKit.detail({
					name = "RackShelf",
					size = Vector3.new(3.2, 0.2, 8.2),
					cf = rack.CFrame * CFrame.new(0.1, -2.4 + shelf * 1.6, 0),
					colour = C(96, 92, 84),
					material = Enum.Material.Metal,
					parent = model,
				})
			end
			if spec.kind == "workshop" then
				BuildKit.part({
					name = "Workbench",
					size = Vector3.new(3.4, 0.4, 10.0),
					cf = originCF * CFrame.new(width * 0.5 - 2.4, bodyBottom + 3.0, -length * 0.15),
					colour = interior.trim,
					material = Enum.Material.Wood,
					parent = model,
				})
				BuildKit.detail({
					name = "Vice",
					size = Vector3.new(1.0, 1.0, 1.4),
					cf = originCF * CFrame.new(width * 0.5 - 2.4, bodyBottom + 3.7, -length * 0.15 - 4.0),
					colour = C(110, 60, 50),
					material = Enum.Material.Metal,
					parent = model,
				})
				BuildKit.detail({
					name = "ToolBoard",
					size = Vector3.new(0.25, 4.0, 8.0),
					cf = originCF * CFrame.new(width * 0.5 - 0.9, bodyBottom + 6.2, -length * 0.15),
					colour = C(92, 74, 54),
					material = Enum.Material.Wood,
					parent = model,
				})
			end
		end

		for crate = 0, math.min(spec.crates, 8) - 1 do
			BuildKit.part({
				name = "Crate",
				size = Vector3.new(2.6, 2.4, 2.6),
				cf = originCF
					* CFrame.new(
						(if crate % 2 == 0 then 1 else -1) * (width * 0.28),
						bodyBottom + 1.5,
						length * 0.5 - 6 - math.floor(crate / 2) * 3.2
					)
					* CFrame.Angles(0, math.rad(rng:NextNumber(-8, 8)), 0),
				colour = BuildKit.weather(P.planking, 0.06, rng),
				material = Enum.Material.WoodPlanks,
				parent = model,
			})
		end

		-- Interior lighting, spaced down the ceiling.
		local lampCount = math.max(2, math.floor(length / 16))
		for i = 0, lampCount - 1 do
			local lz = -length * 0.5 + 8 + i * ((length - 16) / math.max(1, lampCount - 1))
			local _, light = BuildKit.lamp(
				originCF * CFrame.new(0, bodyTop - 1.0, lz),
				"pendant",
				interior.lampColour,
				interior.lampBrightness,
				24,
				model
			)
			table.insert(lights, light)
		end
	end

	-- Coupler ends on every carriage.
	buildCouplerEnd(originCF * CFrame.new(0, 2.4, -length * 0.5), width, livery.body, model)
	buildCouplerEnd(originCF * CFrame.new(0, 2.4, length * 0.5) * CFrame.Angles(0, math.rad(180), 0), width, livery.body, model)

	return { model = model, wheels = wheels, lights = lights, doors = doors, supplyRack = supplyRack }
end

--------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------

--- Builds a complete train at the given CFrame, facing -Z.
function TrainBuilder.build(
	trainId: string,
	liveryId: string?,
	interiorId: string?,
	originCF: CFrame,
	parent: Instance,
	seed: number?
): BuiltTrain
	local def = TrainRegistry.getOrStarter(trainId)
	local livery = TrainRegistry.getLivery(liveryId or def.defaultLivery)
	local interior = TrainRegistry.getInterior(interiorId)
	local rng = Random.new(seed or 20217)

	local model = BuildKit.model("Train_" .. def.id, nil)

	-- The root sits at the front coupler face. Everything is built relative to
	-- it, and it is the only part the movement code ever touches.
	local root = BuildKit.part({
		name = "TrainRoot",
		size = Vector3.new(2, 2, 2),
		cf = originCF,
		transparency = 1,
		canCollide = false,
		canQuery = false,
		castShadow = false,
		parent = model,
	})
	model.PrimaryPart = root

	local locoLength = def.build.locoLength
	local locoCF = originCF * CFrame.new(0, 0, locoLength * 0.5)
	local loco = buildLocomotive(locoCF, def, livery, interior, model, rng)

	local carriages: { Model } = {}
	local allWheels = loco.wheels
	local interiorLights: { Light } = {}
	local allDoors = loco.doors
	local supplyRack: BasePart? = nil

	local cursor = locoLength + 4
	for index, spec in def.build.carriages do
		local carriageCF = originCF * CFrame.new(0, 0, cursor + spec.length * 0.5)
		local built = buildCarriage(carriageCF, spec, index, def, livery, interior, model, rng)
		table.insert(carriages, built.model)
		for _, w in built.wheels do
			table.insert(allWheels, w)
		end
		for _, l in built.lights do
			table.insert(interiorLights, l)
		end
		for _, d in built.doors do
			table.insert(allDoors, d)
		end
		if built.supplyRack and not supplyRack then
			supplyRack = built.supplyRack
		end
		cursor += spec.length + 4
	end

	-- Tail lights on the rear of the last vehicle.
	local tailLights: { PointLight } = {}
	for _, side in { -1, 1 } do
		local lamp = BuildKit.detail({
			name = "TailLamp",
			size = Vector3.new(0.9, 0.9, 0.5),
			cf = originCF * CFrame.new(side * (def.build.locoWidth * 0.35), 5.4, cursor - 1),
			colour = C(200, 60, 50),
			material = Enum.Material.Neon,
			parent = model,
		})
		local point = Instance.new("PointLight")
		point.Color = C(200, 60, 50)
		point.Brightness = 1.6
		point.Range = 22
		point.Parent = lamp
		table.insert(tailLights, point)
	end

	-- Fallback supply rack: the locomotive always has somewhere to put things,
	-- even on a consist with no supply carriage.
	if not supplyRack then
		local rack = BuildKit.part({
			name = "SupplyRack",
			size = Vector3.new(2.6, 4.0, 5.0),
			cf = locoCF * CFrame.new(0, 4.6, locoLength * 0.28),
			colour = C(78, 74, 66),
			material = Enum.Material.Metal,
			canCollide = false,
			parent = model,
		})
		rack:AddTag("SupplyRack")
		supplyRack = rack
	end

	-- Weld the whole assembly to the root, then anchor only the root. This is
	-- what makes the train a single cheap rigid body.
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = root
			descendant.Anchored = false
		end
	end
	root.Anchored = true

	model:AddTag("Train")
	model.Parent = parent

	local totalLength = cursor
	return {
		model = model,
		root = root,
		trainId = def.id,
		carriages = carriages,
		cab = loco.cab,
		headlights = loco.headlights,
		tailLights = tailLights,
		cabinLights = loco.cabinLights,
		interiorLights = interiorLights,
		wheels = allWheels,
		doors = allDoors,
		fuelPoint = loco.fuelPoint,
		repairPoint = loco.repairPoint,
		supplyRack = supplyRack :: BasePart,
		radioSet = loco.radioSet,
		volumeSize = Vector3.new(def.build.locoWidth + 2, def.build.locoHeight + 6, totalLength),
		volumeOffset = CFrame.new(0, def.build.locoHeight * 0.5 + 2, totalLength * 0.5),
		partCount = BuildKit.countParts(model),
	}
end

return TrainBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
