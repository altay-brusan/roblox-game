}

--------------------------------------------------------------------------
-- Recordings found in the world
--------------------------------------------------------------------------

export type RecordingDef = {
	id: string,
	station: string,
	title: string,
	text: string,
	duration: number,
	credits: number,
}

local RECORDINGS: { RecordingDef } = {
	{
		id = "rec_marrow",
		station = "marrow_halt",
		title = "Marrow Halt, day two",
		text = "We put everything we had against the waiting room door. Then Ellis said the sensible thing, which is that it was already inside with us, and we went out the window instead.",
		duration = 11,
		credits = 30,
	},
	{
		id = "rec_tolbridge",
		station = "tolbridge_camp",
		title = "Camp office tape",
		text = "It copies the saw. Not the sound of the saw, the pattern of it. Three cuts and a pause, three cuts and a pause. We stopped cutting on the second day and it kept going for a week.",
		duration = 13,
		credits = 30,
	},
	{
		id = "rec_93",
		station = "tower_93",
		title = "Tower cabin tape",
		text = "It has learned the callsign. It has not learned that Control signs off at the end, not the start. That is the only thing keeping me sat in this chair.",
		duration = 12,
		credits = 35,
	},
	{
		id = "rec_bridge",
		station = "hallow_bridge",
		title = "Pump house tape",
		text = "The span has been up for two years. The gearing is fine. The valve is fine. Somebody took the valve out and put it in the stores, deliberately, and I would like to know who and I would like to know why.",
		duration = 14,
		credits = 35,
	},
	{
		id = "rec_ward_1",
		station = "ward_hill",
		title = "Operator, day one",
		text = "Regional says evacuate. I am not leaving a transmitter this size unattended. Someone has to hold the frequency open or none of them can find each other.",
		duration = 12,
		credits = 40,
	},
	{
		id = "rec_ward_2",
		station = "ward_hill",
		title = "Operator, day six",
		text = "It sits outside the hall and it says my own callsign back at me in my own voice. I have stopped answering. The carrier stays up. That is the job.",
		duration = 13,
		credits = 40,
	},
	{
		id = "rec_ward_3",
		station = "ward_hill",
		title = "Operator, day eleven",
		text = "Valve has gone in the transmitter. There is a spare in the cabinet. I am going to fit it, and if I do not come back from that room, the spare is in the cabinet. Whoever you are. The spare is in the cabinet.",
		duration = 15,
		credits = 50,
	},
	{
		id = "rec_ward_4",
		station = "ward_hill",
		title = "Unmarked tape",
		text = "Control, to zero two seventeen. Control, to zero two seventeen. Control, to zero two seventeen.",
		duration = 10,
		credits = 60,
	},
}

--------------------------------------------------------------------------

local RadioScript = {}

RadioScript.Beats = TableUtil.deepFreeze(BEATS) :: { Beat }
RadioScript.Recordings = TableUtil.deepFreeze(RECORDINGS) :: { RecordingDef }

--- The dispatcher's callsign, used by the client to render the attribution and
--- by the mimicry system to know what it is imitating.
RadioScript.DispatchCallsign = "Control, to zero two seventeen"

function RadioScript.beatsFor(trigger: string): { Beat }
	local out: { Beat } = {}
	for _, beat in BEATS do
		if beat.trigger == trigger then
			table.insert(out, beat)
		end
	end
	table.sort(out, function(a, b)
		return a.priority > b.priority
	end)
	return out
end

function RadioScript.beatById(id: string): Beat?
	for _, beat in BEATS do
		if beat.id == id then
			return beat
		end
	end
	return nil
end

function RadioScript.recordingsFor(station: string): { RecordingDef }
	local out: { RecordingDef } = {}
	for _, rec in RECORDINGS do
		if rec.station == station then
			table.insert(out, rec)
		end
	end
	return out
end

--- Total spoken duration of a beat, used to reserve the radio so two beats
--- never talk over each other.
function RadioScript.beatDuration(beat: Beat): number
	local total = 0
	for _, l in beat.lines do
		total += l.duration + 0.4
	end
	return total
end

return RadioScript
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">StationRegistry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StationRegistry
	---------------
	Chapter One: The Long Grade. Five stops, in order, each with its own layout,
	objective shape, environmental story and threat profile.

	The rule that shaped this file: no two stops ask for the same verb. Fetching
	is the tutorial, and after that every stop asks for something structurally
	different, because "collect four things" repeated five times is the failure
	mode the brief calls out.

	  1  Marrow Halt          restore power     (sequence: find, fuel, start, throw)
	  2  Tolbridge Camp       cooperate         (two separated levers, held together)
	  3  Ninety-Three Tower   communicate       (one reads, others act, on radio)
	  4  Hallow Bridge        repair under time (fetch a part, fit it, hold the area)
	  5  Ward Hill Relay      converge          (three sub-tasks, then the ending)

	`layout` blocks are consumed by the station builders in server/World. Sizes
	are in studs and every interior listed here is actually built and enterable.
]]

local TableUtil = require(script.Parent.Parent.Core.TableUtil)

--- One step of a "sequence" objective. Fields are optional because each step
--- kind uses a different subset; ExpeditionService validates per kind.
export type StepDef = {
	id: string,
	text: string,
	kind: string,
	item: string?,
	quantity: number?,
	fixture: string?,
	seconds: number?,
	needsFuel: boolean?,
	allowAbandon: boolean?,
}

export type ObjectiveKind =
	"collect" -- gather N of an item
	| "deliver" -- bring an item to a specific station fixture
	| "operate" -- use a fixture, possibly with a prerequisite
	| "sequence" -- ordered sub-steps
	| "simultaneous" -- two or more fixtures held at once by different players
	| "relay" -- one player reads a value, another enters it
	| "defend" -- survive at a location for a duration
	| "escort" -- move an object along a path

export type ObjectiveDef = {
	id: string,
	kind: ObjectiveKind,
	title: string, -- shown in the corner objective panel, kept under 48 chars
	detail: string, -- one line of extra context on the objective panel
	optional: boolean,
	-- Interpreted per kind. Quantities scale by crew size via Balance.
	params: { [string]: any },
	-- Credits and XP on completion, before multipliers.
	credits: number,
	xp: number,
	-- Objectives that must be done first.
	requires: { string }?,
}

export type LootNode = {
	kind: string, -- "locker" | "crate" | "shelf" | "body" | "cabinet" | "toolboard"
	position: Vector3, -- relative to the station origin
	rotation: number, -- degrees about Y
	tier: number,
	rolls: number,
	-- Guaranteed contents, always spawned in addition to the random rolls.
	guaranteed: { string }?,
}

export type BuildingSpec = {
	id: string,
	kind: string, -- interpreted by the station builder
	position: Vector3,
	rotation: number,
	size: Vector3,
	-- Buildings flagged interior get a real enterable inside with its own
	-- lighting, props and at least two ways in.
	interior: boolean,
	entrances: number,
	storey: number?,
}

export type FixtureSpec = {
	id: string,
	kind: string, -- "generator" | "breaker" | "fusebox" | "lever" | "frame" | ...
	position: Vector3,
	rotation: number,
	-- Links this fixture to an objective step.
	objective: string?,
	step: string?,
}

export type StationDef = {
	id: string,
	index: number,
	name: string,
	subtitle: string,
	-- Distance along the track from the expedition origin, in studs.
	distance: number,
	-- Platform side the train doors open onto.
	platformSide: "left" | "right",
	-- Environmental story: what happened here, told through the build and the
	-- optional records rather than through a cutscene.
	story: string,
	-- One line the dispatcher says on approach.
	approachLine: string,
	-- Threat profile at this stop.
	threat: {
		baseline: number,
		escalation: number, -- added to the director's band pressure
		creatureActive: boolean,
		mimicryEnabled: boolean,
		-- A scripted beat that fires once, at a specific objective step.
		scriptedBeat: string?,
	},
	layout: {
		radius: number, -- clearing radius carved from the forest
		buildings: { BuildingSpec },
		fixtures: { FixtureSpec },
		lootNodes: { LootNode },
		-- Named landmarks the radio and the objective panel can refer to, so
		-- directions are always speakable: "the water tower", not "grid 4".
		landmarks: { { id: string, name: string, position: Vector3 } },
	},
	objectives: { ObjectiveDef },
	-- Optional discoveries. None are required; all give credits and story.
	discoveries: { { id: string, name: string, position: Vector3, hint: string } },
	-- Expected time on station for a crew of three, used by the pacing director.
	expectedSeconds: number,
}

local V = Vector3.new

local function station(def: StationDef): StationDef
	return def
end

--------------------------------------------------------------------------

local STATIONS: { StationDef } = {

	----------------------------------------------------------------------
