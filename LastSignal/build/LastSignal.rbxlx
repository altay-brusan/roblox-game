        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Admin</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Admin
	-----
	Role configuration for LAST SIGNAL.

	Roles are resolved on the server from Player.UserId only. Display names are
	never used for anything but display: Roblox usernames can be changed, and a
	display name can be set to anything at all, so trusting either would let any
	player impersonate an administrator.

	FILLING IN THE USER IDS
	-----------------------
	The two accounts named in the brief are listed below with their IDs set to
	0, which grants nothing. To activate them, look up each account's numeric
	user ID and paste it in. The fastest way: open the profile in a browser and
	read the number in the URL, roblox.com/users/<NUMBER>/profile.

	The IDs are not filled in here because this project cannot verify which
	account a given username currently belongs to, and guessing would be worse
	than leaving the role switched off. A role with ID 0 is inert.
]]

local Admin = {}

export type Role = "owner" | "admin" | "moderator" | "tester" | "player"

export type RoleEntry = {
	userId: number,
	username: string, -- reference only, never used for authorisation
	role: Role,
	note: string?,
}

--------------------------------------------------------------------------
-- Role assignments
--------------------------------------------------------------------------

Admin.Roles = {
	{
		userId = 0, -- TODO(operator): RIPjafar1 numeric user ID
		username = "RIPjafar1",
		role = "owner" :: Role,
		note = "Owner and main developer. Full access including destructive resets.",
	},
	{
		userId = 0, -- TODO(operator): shayanbrusan1234 numeric user ID
		username = "shayanbrusan1234",
		role = "admin" :: Role,
		note = "Administrator. Everything except destructive resets and role changes.",
	},
} :: { RoleEntry }

--------------------------------------------------------------------------
-- Capability matrix
--------------------------------------------------------------------------

-- Each capability maps to the minimum role that holds it. Every admin command
-- declares one capability; AdminService checks it before running anything.
local RANK: { [string]: number } = {
	player = 0,
	tester = 10,
	moderator = 20,
	admin = 30,
	owner = 40,
}

Admin.Capabilities = {
	inspect_player = "moderator",
	announce = "moderator",
	kick = "moderator",
	teleport_self = "tester",
	teleport_player = "admin",
	grant_currency = "admin",
	grant_xp = "admin",
	grant_item = "admin",
	unlock_content = "admin",
	control_event = "admin",
	control_expedition = "admin",
	spawn_creature = "admin",
	set_difficulty = "admin",
	toggle_godmode = "admin",
	view_analytics = "admin",
	reset_player_data = "owner",
	reset_all_data = "owner",
	grant_role = "owner",
} :: { [string]: Role }

--------------------------------------------------------------------------
-- Resolution
--------------------------------------------------------------------------

local byUserId: { [number]: Role } = {}
for _, entry in Admin.Roles do
	if entry.userId and entry.userId > 0 then
		byUserId[entry.userId] = entry.role
	end
end

--- Server-side role lookup. The only correct way to ask "is this an admin".
function Admin.roleOf(userId: number): Role
	return byUserId[userId] or "player"
end

function Admin.rankOf(role: string): number
	return RANK[role] or 0
end

--- True when the given user ID may use the named capability.
function Admin.can(userId: number, capability: string): boolean
	local required = Admin.Capabilities[capability] :: Role?
	if not required then
		-- Unknown capability is denied. Failing closed matters here: a typo in a
		-- command definition must not silently grant access to everyone.
		return false
	end
	return Admin.rankOf(Admin.roleOf(userId)) >= Admin.rankOf(required)
end

--- Reports which configured roles are inert, so the operator sees it at boot.
function Admin.audit(): { active: number, inactive: { string } }
	local active = 0
	local inactive: { string } = {}
	for _, entry in Admin.Roles do
		if entry.userId > 0 then
			active += 1
		else
			table.insert(inactive, string.format("%s (%s)", entry.username, entry.role))
		end
	end
	return { active = active, inactive = inactive }
end

--------------------------------------------------------------------------
-- Command safety
--------------------------------------------------------------------------

-- Destructive commands require the operator to repeat the command with a
-- confirmation token within this window.
Admin.ConfirmWindowSeconds = 30

-- Commands that always require confirmation regardless of role.
Admin.ConfirmRequired = {
	reset_player_data = true,
	reset_all_data = true,
}

-- Maximum values an admin grant may issue in one command. Prevents a slip of
-- the keyboard from writing an absurd number into a live profile.
Admin.GrantLimits = {
	credits = 1000000,
	xp = 500000,
	itemQuantity = 999,
}

-- Public announcements are filtered through TextService before broadcast.
Admin.FilterAnnouncements = true

-- Admin actions are appended to a rolling in-memory log and mirrored to the
-- server output. Size is bounded so a long-running server cannot grow forever.
Admin.AuditLogSize = 250

return Admin
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Audio
	-----
	The sound design of LAST SIGNAL expressed as named cues, mixer buses and
	playback behaviour. Every system asks for a cue by name; none of them ever
	touch an asset ID.

	WHY THE IDS ARE EMPTY
	--------------------
	Roblox sounds are asset IDs on Roblox's servers. This project cannot create,
	upload or verify audio assets, and shipping guessed numeric IDs is worse than
	shipping none: a wrong ID is either silence, an error, or somebody else's
	audio playing in your game without permission.

	So every cue below has `id = 0`, and AudioService treats zero as "cue not
	configured": it plays nothing, logs once, and the game continues normally.
	Nothing crashes, nothing waits, and no cue is faked.

	FILLING THEM IN
	---------------
	docs/AUDIO.md lists every cue with the search terms to use in the Studio
	Toolbox audio browser and the licence rules that apply. Roblox-created audio
	is free to use in your own experiences; third-party audio is not, unless its
	licence says so. Paste the ID into the `id` field for the cue.

	The mixer, ducking, occlusion, distance behaviour, speed-reactive layering
	and subtitles below are all implemented and working. They are what makes the
	soundscape coherent once the cues are populated.
]]

local Audio = {}

--------------------------------------------------------------------------
-- Mixer buses
--------------------------------------------------------------------------

-- Player-facing volume sliders map onto these buses. A cue names its bus and
-- AudioService applies the bus gain, the master gain and any active ducking.
export type BusId = "master" | "music" | "ambience" | "sfx" | "train" | "voice" | "ui" | "creature"

export type BusDef = { name: string, default: number }

Audio.Buses = ({
	master = { name = "Master", default = 0.85 },
	music = { name = "Music", default = 0.6 },
	ambience = { name = "Ambience", default = 0.8 },
	sfx = { name = "Effects", default = 0.9 },
	train = { name = "Train", default = 0.85 },
	voice = { name = "Radio & Voice", default = 1.0 },
	ui = { name = "Interface", default = 0.7 },
	creature = { name = "Threat", default = 1.0 },
} :: { [string]: BusDef })

-- When a bus in `trigger` is playing, buses in `duck` drop by `amount` over
-- `attack` seconds and recover over `release`. Radio lines must always be
-- intelligible; that is the entire reason this exists.
export type DuckRule = { trigger: string, duck: { string }, amount: number, attack: number, release: number }

Audio.Ducking = ({
	{ trigger = "voice", duck = { "music", "ambience", "train" }, amount = 0.45, attack = 0.12, release = 0.8 },
	{ trigger = "creature", duck = { "music" }, amount = 0.7, attack = 0.05, release = 1.6 },
} :: { DuckRule })

--------------------------------------------------------------------------
-- Cue definitions
--------------------------------------------------------------------------

export type CueDef = {
	id: number,
	bus: BusId,
	volume: number,
	pitch: number?,
	looped: boolean?,
	rollOffMin: number?,
	rollOffMax: number?,
	-- Random pitch spread applied per play, so repeated cues do not machine-gun.
	pitchVariance: number?,
	-- Subtitle text shown when accessibility subtitles are enabled. Cues that
	-- carry gameplay information must have one; that is the accessibility
	-- requirement for "alternatives for essential audio cues".
	subtitle: string?,
	-- Marks a cue as gameplay-critical. AudioService additionally surfaces these
	-- as a directional on-screen indicator when the player enables it.
	directionalHint: boolean?,
	description: string,
}

local function cue(def: CueDef): CueDef
	return def
end

Audio.Cues = {
	--------------------------------------------------------------------
	-- Train: locomotive and rolling stock
	--------------------------------------------------------------------
	train_engine_idle = cue({
		id = 0,
		bus = "train",
		volume = 0.55,
		looped = true,
		rollOffMin = 12,
		rollOffMax = 320,
		description = "Diesel idle loop at the engine bay. Pitch and volume track throttle notch.",
	}),
	train_engine_load = cue({
		id = 0,
		bus = "train",
		volume = 0.7,
		looped = true,
		rollOffMin = 12,
		rollOffMax = 420,
		description = "Engine under load. Crossfaded over idle proportionally to notch.",
	}),
	train_wheels_roll = cue({
		id = 0,
		bus = "train",
		volume = 0.6,
		looped = true,
		rollOffMin = 8,
		rollOffMax = 260,
		description = "Rail roll loop under each bogie. Playback speed tracks train speed.",
	}),
	train_rail_joint = cue({
		id = 0,
		bus = "train",
		volume = 0.5,
		pitchVariance = 0.08,
		rollOffMin = 8,
		rollOffMax = 200,
		description = "Single rail joint clack. Scheduled by distance travelled, not by timer.",
	}),
	train_brake_apply = cue({
		id = 0,
		bus = "train",
		volume = 0.75,
		looped = true,
		rollOffMin = 10,
		rollOffMax = 300,
		description = "Brake squeal loop while the service brake is applied above walking speed.",
	}),
	train_brake_emergency = cue({
		id = 0,
		bus = "train",
		volume = 1.0,
		rollOffMin = 15,
		rollOffMax = 700,
		subtitle = "[Emergency brakes screaming]",
		description = "Emergency brake. Loud, ugly, and heard from a long way off.",
	}),
	train_horn = cue({
		id = 0,
		bus = "train",
		volume = 1.0,
		rollOffMin = 30,
		rollOffMax = 1400,
		subtitle = "[Train horn]",
		description = "Air horn. Also the creature repel tool, so it must read at distance.",
	}),
	train_door = cue({
		id = 0,
		bus = "train",
		volume = 0.6,
		pitchVariance = 0.05,
		rollOffMin = 5,
		rollOffMax = 60,
		description = "Pneumatic carriage door cycle.",
	}),
	train_coupler = cue({
		id = 0,
		bus = "train",
		volume = 0.8,
		rollOffMin = 10,
		rollOffMax = 220,
		description = "Coupler slack taking up. Plays once when the train starts moving.",
	}),
	train_wiper = cue({
		id = 0,
		bus = "train",
		volume = 0.35,
		rollOffMin = 3,
		rollOffMax = 25,
		description = "Windscreen wiper sweep, cab interior only.",
	}),
	train_stall = cue({
		id = 0,
		bus = "train",
		volume = 0.9,
		subtitle = "[The engine dies]",
		description = "Engine stall when fuel runs dry or condition fails.",
	}),
	train_start = cue({
		id = 0,
		bus = "train",
		volume = 0.85,
		description = "Engine crank and catch.",
	}),

	--------------------------------------------------------------------
	-- Weather and forest ambience
	--------------------------------------------------------------------
	rain_light = cue({ id = 0, bus = "ambience", volume = 0.5, looped = true, description = "Light rain bed, exterior." }),
	rain_heavy = cue({ id = 0, bus = "ambience", volume = 0.75, looped = true, description = "Heavy rain bed, exterior." }),
	rain_on_roof = cue({ id = 0, bus = "ambience", volume = 0.6, looped = true, description = "Rain on the carriage roof, interior only." }),
	wind_forest = cue({ id = 0, bus = "ambience", volume = 0.45, looped = true, description = "Wind through conifers." }),
	forest_night = cue({ id = 0, bus = "ambience", volume = 0.4, looped = true, description = "Distant night forest bed. Goes quiet when threat is high." }),
	thunder_distant = cue({ id = 0, bus = "ambience", volume = 0.7, subtitle = "[Distant thunder]", description = "Occasional distant thunder." }),
	station_hum = cue({ id = 0, bus = "ambience", volume = 0.35, looped = true, description = "Failing fluorescent hum at powered stations." }),
	tunnel_tone = cue({ id = 0, bus = "ambience", volume = 0.5, looped = true, description = "Low enclosed tone inside the service tunnel." }),

	--------------------------------------------------------------------
	-- Player
	--------------------------------------------------------------------
	footstep_metal = cue({ id = 0, bus = "sfx", volume = 0.4, pitchVariance = 0.1, description = "Footstep on carriage decking." }),
	footstep_gravel = cue({ id = 0, bus = "sfx", volume = 0.4, pitchVariance = 0.1, description = "Footstep on ballast." }),
	footstep_wood = cue({ id = 0, bus = "sfx", volume = 0.35, pitchVariance = 0.1, description = "Footstep on sleepers and boardwalk." }),
	footstep_soil = cue({ id = 0, bus = "sfx", volume = 0.3, pitchVariance = 0.1, description = "Footstep on forest floor." }),
	footstep_concrete = cue({ id = 0, bus = "sfx", volume = 0.4, pitchVariance = 0.1, description = "Footstep on platform concrete." }),
	breath_tired = cue({ id = 0, bus = "sfx", volume = 0.5, looped = true, description = "Exhausted breathing when stamina bottoms out." }),
	heartbeat = cue({ id = 0, bus = "sfx", volume = 0.6, looped = true, description = "Heartbeat under low health and during a chase." }),
	hurt = cue({ id = 0, bus = "sfx", volume = 0.7, pitchVariance = 0.08, description = "Player takes damage." }),
	downed = cue({ id = 0, bus = "sfx", volume = 0.8, subtitle = "[A crew member goes down]", directionalHint = true, description = "A crew member is downed." }),
	revive = cue({ id = 0, bus = "sfx", volume = 0.7, description = "Revive completes." }),
	flashlight_click = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Flashlight toggle." }),
	flashlight_die = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Flashlight battery gives out." }),

	--------------------------------------------------------------------
	-- Items, tools and machinery
	--------------------------------------------------------------------
	item_pickup = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Generic pickup." }),
	item_drop = cue({ id = 0, bus = "sfx", volume = 0.45, description = "Generic drop." }),
	item_fuel_pour = cue({ id = 0, bus = "sfx", volume = 0.6, description = "Refuelling the locomotive." }),
	item_bandage = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Applying a bandage." }),
	item_battery = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Loading a battery." }),
	repair_wrench = cue({ id = 0, bus = "sfx", volume = 0.55, pitchVariance = 0.1, description = "Repair progress tick." }),
	generator_start = cue({ id = 0, bus = "sfx", volume = 0.8, subtitle = "[Generator coughs into life]", description = "Generator start." }),
	generator_run = cue({ id = 0, bus = "sfx", volume = 0.55, looped = true, description = "Generator running loop." }),
	breaker_throw = cue({ id = 0, bus = "sfx", volume = 0.7, description = "Heavy electrical breaker." }),
	lever_switch = cue({ id = 0, bus = "sfx", volume = 0.6, description = "Track switch lever." }),
	door_wood_open = cue({ id = 0, bus = "sfx", volume = 0.5, pitchVariance = 0.06, description = "Building door opening." }),
	door_metal_open = cue({ id = 0, bus = "sfx", volume = 0.55, pitchVariance = 0.06, description = "Metal door opening." }),
	locker_open = cue({ id = 0, bus = "sfx", volume = 0.45, description = "Searching a locker or crate." }),

	--------------------------------------------------------------------
	-- Weapons
	--------------------------------------------------------------------
	melee_swing = cue({ id = 0, bus = "sfx", volume = 0.55, pitchVariance = 0.12, description = "Melee swing through air." }),
	melee_hit_flesh = cue({ id = 0, bus = "sfx", volume = 0.7, pitchVariance = 0.1, description = "Melee connecting with a creature." }),
	melee_hit_hard = cue({ id = 0, bus = "sfx", volume = 0.65, pitchVariance = 0.1, description = "Melee connecting with metal or wood." }),
	gun_revolver = cue({ id = 0, bus = "sfx", volume = 1.0, rollOffMax = 900, subtitle = "[Gunshot]", description = "Revolver discharge." }),
	gun_shotgun = cue({ id = 0, bus = "sfx", volume = 1.0, rollOffMax = 1100, subtitle = "[Shotgun blast]", description = "Shotgun discharge." }),
	gun_rifle = cue({ id = 0, bus = "sfx", volume = 1.0, rollOffMax = 1200, subtitle = "[Rifle shot]", description = "Bolt rifle discharge." }),
	gun_flare = cue({ id = 0, bus = "sfx", volume = 0.8, description = "Flare gun launch." }),
	gun_dry = cue({ id = 0, bus = "sfx", volume = 0.5, description = "Dry fire on an empty chamber." }),
	reload_revolver = cue({ id = 0, bus = "sfx", volume = 0.6, description = "Swing-out cylinder, eject, load, close." }),
	reload_shotgun_shell = cue({ id = 0, bus = "sfx", volume = 0.6, pitchVariance = 0.05, description = "Single shell into the tube, one per shell." }),
	reload_bolt = cue({ id = 0, bus = "sfx", volume = 0.6, description = "Bolt cycle." }),
	bullet_impact = cue({ id = 0, bus = "sfx", volume = 0.6, pitchVariance = 0.15, description = "Bullet impact at the hit point." }),

	--------------------------------------------------------------------
	-- Radio and voice
	--------------------------------------------------------------------
	radio_static = cue({ id = 0, bus = "voice", volume = 0.4, looped = true, description = "Carrier static under every radio line." }),
	radio_open = cue({ id = 0, bus = "voice", volume = 0.6, description = "Squelch opening before a transmission." }),
	radio_close = cue({ id = 0, bus = "voice", volume = 0.5, description = "Squelch closing after a transmission." }),
	radio_distort = cue({ id = 0, bus = "voice", volume = 0.7, subtitle = "[The signal warps]", description = "Distortion sting used when a transmission is not the dispatcher." }),
	radio_tune = cue({ id = 0, bus = "voice", volume = 0.5, description = "Tuning the set between frequencies." }),

	--------------------------------------------------------------------
	-- The Signal-Eater
	--------------------------------------------------------------------
	creature_distant = cue({
		id = 0,
		bus = "creature",
		volume = 0.7,
		rollOffMax = 1200,
		subtitle = "[Something calls, far off]",
		directionalHint = true,
		description = "Distant call. The first warning a crew gets, deliberately vague in direction.",
	}),
	creature_near = cue({
		id = 0,
		bus = "creature",
		volume = 0.85,
		rollOffMax = 380,
		subtitle = "[Something is close]",
		directionalHint = true,
		description = "Close proximity vocalisation.",
	}),
	creature_chase = cue({
		id = 0,
		bus = "creature",
		volume = 1.0,
		looped = true,
		rollOffMax = 500,
		subtitle = "[It is hunting]",
		directionalHint = true,
		description = "Chase loop. Unmistakable, because a chase must never be ambiguous.",
	}),
	creature_attack = cue({ id = 0, bus = "creature", volume = 1.0, subtitle = "[It strikes]", description = "Attack." }),
	creature_repelled = cue({ id = 0, bus = "creature", volume = 0.9, subtitle = "[It recoils and retreats]", description = "Driven off by the horn, a flare or sustained damage." }),
	creature_mimic = cue({
		id = 0,
		bus = "creature",
		volume = 0.6,
		rollOffMax = 300,
		subtitle = "[A familiar sound, not quite right]",
		description = "Mimicry cue. Deliberately routed on the creature bus so a careful player can learn to tell.",
	}),
	footsteps_outside = cue({
		id = 0,
		bus = "creature",
		volume = 0.5,
		rollOffMax = 90,
		subtitle = "[Footsteps on the ballast outside]",
		directionalHint = true,
		description = "Footsteps along the outside of the carriage. Nothing is there when you look.",
	}),

	--------------------------------------------------------------------
	-- Music
	--------------------------------------------------------------------
	music_lobby = cue({ id = 0, bus = "music", volume = 0.45, looped = true, description = "Lobby bed. Warm, tired, safe." }),
	music_departure = cue({ id = 0, bus = "music", volume = 0.6, description = "Departure cue under the cinematic." }),
	music_travel = cue({ id = 0, bus = "music", volume = 0.35, looped = true, description = "Sparse travel bed between stations." }),
	music_tension = cue({ id = 0, bus = "music", volume = 0.5, looped = true, description = "Rising bed while threat sits in the upper bands." }),
	music_climax = cue({ id = 0, bus = "music", volume = 0.7, looped = true, description = "Final sequence." }),
	music_resolution = cue({ id = 0, bus = "music", volume = 0.6, description = "Ending cue." }),

	--------------------------------------------------------------------
	-- Interface
	--------------------------------------------------------------------
	ui_hover = cue({ id = 0, bus = "ui", volume = 0.25, description = "Button hover." }),
	ui_click = cue({ id = 0, bus = "ui", volume = 0.4, description = "Button press." }),
	ui_open = cue({ id = 0, bus = "ui", volume = 0.4, description = "Panel opening." }),
	ui_close = cue({ id = 0, bus = "ui", volume = 0.35, description = "Panel closing." }),
	ui_error = cue({ id = 0, bus = "ui", volume = 0.5, description = "Rejected action." }),
	ui_reward = cue({ id = 0, bus = "ui", volume = 0.6, description = "Reward granted." }),
	ui_objective = cue({ id = 0, bus = "ui", volume = 0.5, subtitle = "[Objective updated]", description = "Objective updated." }),
	ui_countdown = cue({ id = 0, bus = "ui", volume = 0.5, description = "Departure countdown tick." }),
} :: { [string]: CueDef }

--------------------------------------------------------------------------
-- Reporting
--------------------------------------------------------------------------

function Audio.audit(): { configured: number, total: number }
	local configured, total = 0, 0
	for _, def in Audio.Cues do
		total += 1
		if def.id > 0 then
			configured += 1
		end
	end
	return { configured = configured, total = total }
end

--- Cues that carry information a player needs. These are the ones that must
--- have subtitles, and the ones AudioService can render as a directional arrow.
function Audio.informationalCues(): { string }
	local out = {}
	for name, def in Audio.Cues do
		if def.subtitle then
			table.insert(out, name)
		end
	end
	table.sort(out)
	return out
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Balance</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Balance
	-------
	Tuning numbers for survival, the train, combat, threat and economy.
	Isolated from logic so the game can be re-tuned without touching systems.

	Units used throughout:
	  distance  studs (1 stud is treated as 0.28 m for display only)
	  speed     studs per second
	  time      seconds
	  weight    kilograms, an abstract carry budget
]]

local Balance = {}

--------------------------------------------------------------------------
-- Player vitals
--------------------------------------------------------------------------

Balance.Player = {
	maxHealth = 100,
	-- Passive regeneration is deliberately tiny. It removes the tedium of
	-- chip damage without making bandages pointless.
	healthRegenPerSecond = 0.35,
	healthRegenDelay = 22,

	maxStamina = 100,
	sprintDrainPerSecond = 13,
	staminaRegenPerSecond = 9,
	staminaRegenDelay = 1.4,
	-- Below this, sprint is locked out until stamina passes the recovery gate.
	staminaExhaustedAt = 0,
	staminaRecoverGate = 22,

	walkSpeed = 14,
	sprintSpeed = 23,
	crouchSpeed = 7,
	aimSpeed = 9,
	carryHeavySpeedMultiplier = 0.78,

	jumpPower = 42,
	fallDamageThreshold = 42, -- studs of fall before damage begins
	fallDamagePerStud = 2.1,

	-- Carry budget. Cargo Rigging adds to both, and that is the only paid
	-- product that touches any number in this file.
	baseInventorySlots = 18,
	baseCarryWeight = 42,
	quickSlots = 5,
}

Balance.Flashlight = {
	maxCharge = 100,
	drainPerSecond = 0.55,
	-- Flicker starts here, giving a clear warning before darkness.
	lowChargeWarning = 22,
	criticalCharge = 8,
	batteryRestore = 55,
	range = 78,
	angle = 42,
	brightness = 2.6,
	-- A dying light is a horror beat, not a stealth mechanic: the creature does
	-- not track light level, so a low battery never makes players safer.
	colour = Color3.fromRGB(255, 243, 214),
}

--------------------------------------------------------------------------
-- Train
--------------------------------------------------------------------------

Balance.Train = {
	-- Acceleration is deliberately slow. A train that starts instantly does not
	-- feel like a train, and the wind-up is where the tension lives.
	maxSpeed = 92,
	accelerationPerNotch = 3.4,
	notches = 8,
	coastDeceleration = 1.6,
	serviceBrakeDeceleration = 7.5,
	emergencyBrakeDeceleration = 19,
	-- Emergency braking is punishing on purpose: it costs condition and wakes
	-- things up, so it is a real decision rather than a free stop.
	emergencyBrakeConditionCost = 4,
	emergencyBrakeNoiseRadius = 900,

	reverseMaxSpeed = 18,

	maxFuel = 100,
	fuelPerStudAtFullSpeed = 0.00042,
	fuelIdleDrainPerSecond = 0.012,
	fuelCanRestore = 26,

	maxCondition = 100,
	conditionDriftPerMinute = 0.9,
	repairKitRestore = 22,
	-- Below this the train cannot depart a station until repaired.
	conditionDepartureMinimum = 15,
	-- Below this, failures begin: lights cut, doors stick, the engine stalls.
	conditionFailureThreshold = 40,

	headlightRange = 260,
	hornNoiseRadius = 1400,
	doorOpenSeconds = 1.6,
	wiperCycleSeconds = 1.35,

	-- Passengers are welded to a carriage platform rather than relying on
	-- friction. Rolling stock plus Roblox physics plus six players equals
	-- players sliding off the back, every time, without this.
	passengerAnchorRadius = 3.2,
	boardingSpeedLimit = 6,
}

--------------------------------------------------------------------------
-- Combat
--------------------------------------------------------------------------

Balance.Combat = {
	-- Server tolerance for client-reported hits. Generous enough for a 250 ms
	-- connection, tight enough that a teleporting client is rejected.
	hitPositionTolerance = 14,
	maxHitDistanceGrace = 1.25, -- multiplier on a weapon's stated range
	fireIntervalGrace = 0.06,

	headshotMultiplier = 2.1,
	limbMultiplier = 0.82,

	-- Noise made by weapons, feeding the threat director.
	noiseRadiusMelee = 55,
	noiseRadiusSuppressed = 180,
	noiseRadiusFirearm = 620,

	meleeStaminaCost = 8,
	-- Firearms are scarce by design: ammunition is a resource decision, and
	-- most encounters are meant to be avoided rather than won.
	startingAmmoFraction = 0.4,
}

--------------------------------------------------------------------------
-- Downed state and revival
--------------------------------------------------------------------------

Balance.Downed = {
	-- A downed player bleeds out over this window and can be revived the whole
	-- time. The number is long enough to cross a station, which is the point.
	bleedoutSeconds = 95,
	reviveSeconds = 12, -- overridden per difficulty
	reviveHealthFraction = 0.45,
	selfReviveHealthFraction = 0.40,
	-- Crawling keeps a downed player an actor rather than a spectator.
	crawlSpeed = 3.2,
	-- Each subsequent down in one expedition shortens the next bleedout.
	bleedoutDecayPerDown = 0.85,
	minBleedoutSeconds = 40,
	-- Dropped on death, recoverable from the body by teammates.
	dropFractionOnDeath = 0.5,
	spectatorSwitchCooldown = 0.6,
}

--------------------------------------------------------------------------
-- Threat and horror direction
--------------------------------------------------------------------------

Balance.Threat = {
	-- Threat is a 0-100 meter driven by noise, light, time spent away from the
	-- train, and objective progress. The director reads it to decide what to
	-- schedule. It is never shown to players as a number.
	baseline = 8,
	decayPerSecond = 0.55,
	noisePerGunshot = 14,
	noisePerEmergencyBrake = 18,
	noisePerHorn = 9,
	noisePerGenerator = 6,
	perSecondAwayFromTrain = 0.32,
	perSecondAlone = 0.18,
	objectiveCompleteRelief = -12,

	-- Escalation bands. The director will not schedule a band-3 event while
	-- threat sits in band 1, which is what stops the random jumpscare feeling.
	bands = { 0, 25, 55, 80 },

	-- Minimum quiet between any two scheduled events, and a longer floor on
	-- repeating the same event type.
	globalCooldown = 42,
	perEventCooldown = 150,
	-- After a major encounter the director enforces genuine relief. Horror
	-- without quiet stops working after about ten minutes.
	postEncounterCalm = 75,

	-- Hard safety rails. The director will never fire anything while any of
	-- these hold, which is how "no unavoidable deaths during loading" is
	-- actually guaranteed rather than hoped for.
	blockedDuringCinematic = true,
	blockedDuringLoading = true,
	respawnImmunitySeconds = 6,
	boardingImmunitySeconds = 3,
}

Balance.Creature = {
	-- The Signal-Eater. Hunts by sound, investigates light, and loses interest
	-- when a target breaks line of sight and stays quiet.
	hearingRadius = 420,
	sightRadius = 165,
	sightAngle = 118,
	investigateSeconds = 18,
	chaseSeconds = 26,
	loseInterestSeconds = 9,

	patrolSpeed = 9,
	investigateSpeed = 15,
	chaseSpeed = 22,

	attackRange = 7.5,
	attackDamage = 34,
	attackCooldown = 2.2,

	-- Counterplay: it will not enter lit carriages, it recoils from the horn at
	-- close range, and flares deny an area for a while.
	repelledByHorn = true,
	hornRepelRadius = 60,
	flareDenialSeconds = 24,
	flareDenialRadius = 45,
	avoidsLitTrain = true,

	-- It cannot be killed, only driven off. Damage extends the driven-off timer
	-- so weapons still matter without turning the game into a shooter.
	drivenOffSeconds = 45,
	damageToDriveOff = 120,
}

--------------------------------------------------------------------------
-- Economy and progression
--------------------------------------------------------------------------

Balance.Economy = {
	-- Credits are the free currency. Everything cosmetic can eventually be
	-- earned with them; Robux buys time and a few exclusive finishes.
	creditsPerStationCleared = 120,
	creditsPerOptionalObjective = 65,
	creditsPerExpeditionComplete = 400,
	creditsPerRescue = 45,
	creditsPerCollectible = 30,
	creditsFailurePenaltyFraction = 0.4, -- kept on a failed run, not zero

	xpPerStationCleared = 90,
	xpPerOptionalObjective = 45,
	xpPerExpeditionComplete = 320,
	xpPerRescue = 60,

	-- Cooperation pays more than solo grinding, without making solo unviable.
	crewBonusPerMember = 0.06,
	maxCrewBonus = 0.30,

	dailyLoginCredits = { 100, 150, 200, 275, 350, 450, 700 },
	-- Streaks are forgiving: missing a day steps the streak back by one rather
	-- than resetting it, and nothing is ever taken away.
	streakGraceDays = 1,
	playtimeRewardIntervalSeconds = 900,
	playtimeRewardCredits = 85,
	maxPlaytimeRewardsPerDay = 6,
}

Balance.Progression = {
	maxLevel = 60,
	-- Curve: gentle early so the first few levels arrive quickly, then linear.
	baseXp = 420,
	xpGrowth = 1.085,
	xpLinearAfterLevel = 25,
	xpLinearStep = 2600,
}

--- XP needed to go from `level` to `level + 1`.
function Balance.xpForLevel(level: number): number
	local p = Balance.Progression
	if level >= p.maxLevel then
		return math.huge
	end
	if level < p.xpLinearAfterLevel then
		return math.floor(p.baseXp * (p.xpGrowth ^ (level - 1)))
	end
	local atTransition = math.floor(p.baseXp * (p.xpGrowth ^ (p.xpLinearAfterLevel - 1)))
	return atTransition + (level - p.xpLinearAfterLevel) * p.xpLinearStep
end

--------------------------------------------------------------------------
-- Crew scaling
--------------------------------------------------------------------------

-- Objective requirements and threat pressure scale with crew size so a solo
-- run is genuinely completable and a six-player run is not trivial.
Balance.CrewScaling = {
	[1] = { objectiveQuantity = 1.0, threat = 0.78, loot = 1.0, creatureCount = 1 },
	[2] = { objectiveQuantity = 1.25, threat = 0.9, loot = 1.15, creatureCount = 1 },
	[3] = { objectiveQuantity = 1.5, threat = 1.0, loot = 1.3, creatureCount = 1 },
	[4] = { objectiveQuantity = 1.75, threat = 1.12, loot = 1.45, creatureCount = 2 },
	[5] = { objectiveQuantity = 2.0, threat = 1.22, loot = 1.6, creatureCount = 2 },
	[6] = { objectiveQuantity = 2.25, threat = 1.32, loot = 1.75, creatureCount = 2 },
}

function Balance.crewScaling(size: number)
	return Balance.CrewScaling[math.clamp(math.floor(size), 1, 6)]
end

--------------------------------------------------------------------------
-- Anti-grief
--------------------------------------------------------------------------

Balance.AntiGrief = {
	-- Doors a player closed cannot be re-locked by the same player immediately,
	-- which defeats the standard door-spam grief without annoying real play.
	doorToggleCooldown = 1.1,
	doorToggleBurstLimit = 5,
	doorToggleBurstWindow = 8,

	-- Essential items cannot be destroyed, and dropping one inside the train
	-- places it in the supply rack rather than the floor.
	essentialItemsIndestructible = true,

	-- Emergency brake spam is rate limited per player, not globally, so one
	-- player cannot hold a crew hostage.
	emergencyBrakeCooldown = 12,

	-- Repeated friendly interference is tracked and reported to the crew leader
	-- rather than auto-punished, because false positives are worse than grief.
	interferenceReportThreshold = 4,
}

return Balance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GameConfig
	----------
	Top-level switches for LAST SIGNAL. Anything an operator might reasonably
	want to change without reading code lives here.

	PLACE TOPOLOGY
	--------------
	The brief asks for a lobby that is separate from the expedition. There are
	two ways to do that on Roblox and they have very different prerequisites:

	  "single"  Lobby and expedition occupy one place, far apart in world space.
	            Crews are moved between them by the server. Works immediately in
	            Studio and on an unpublished place, needs no API access, and has
	            no teleport failure modes at all.

	  "two"     Lobby is one published place, the expedition is a second place in
	            the same universe, joined by TeleportService with reserved
	            servers. This is the shape most large Roblox games use because it
	            isolates expedition load from lobby load.

	The project ships in "single" mode so it is playable the moment you open it.
	Every teleport path for "two" mode is implemented and tested for its failure
	branches, but it cannot be exercised until both places are published; see
	docs/PUBLISHING.md. Switching modes is this one value plus two place IDs.
]]

export type PlaceMode = "single" | "two"

local GameConfig = {}

GameConfig.GameName = "LAST SIGNAL"
GameConfig.StudioName = "RIPGAMES"
GameConfig.ChapterName = "Chapter One: The Long Grade"

-- Bumped whenever the save schema changes. DataService migrates on load.
GameConfig.DataVersion = 3

-- Build stamp, surfaced in the settings panel and in analytics events so a
-- bug report can be tied to a specific build.
GameConfig.BuildId = "1.0.0"

--------------------------------------------------------------------------
-- Place topology
--------------------------------------------------------------------------

GameConfig.PlaceMode = "single" :: PlaceMode

-- Only used when PlaceMode is "two". Zero means "not configured", which makes
-- the lobby fall back to single-place behaviour rather than failing a teleport.
GameConfig.LobbyPlaceId = 0
GameConfig.ExpeditionPlaceId = 0

-- How long the client waits on a teleport before showing recovery options.
GameConfig.TeleportTimeoutSeconds = 20
GameConfig.TeleportRetryAttempts = 3

--------------------------------------------------------------------------
-- World layout (single-place mode)
--------------------------------------------------------------------------

-- The lobby sits at the origin. The expedition corridor runs north from a
-- distant offset so streaming never has both loaded for the same player.
GameConfig.LobbyOrigin = Vector3.new(0, 0, 0)
GameConfig.ExpeditionOrigin = Vector3.new(0, 0, -20000)

-- The railway is a straight line along -Z from the expedition origin. Stations
-- are placed along it by StationRegistry. Keeping the line straight is a
-- deliberate simplification: it makes carriage physics, streaming and creature
-- navigation dramatically more reliable than a curved spline would, and the
-- forest density hides the geometry.
GameConfig.TrackDirection = Vector3.new(0, 0, -1)
GameConfig.TrackLength = 14000

--------------------------------------------------------------------------
-- Crew and session
--------------------------------------------------------------------------

GameConfig.MinCrewSize = 1
GameConfig.MaxCrewSize = 6
-- Single-place mode holds the lobby and every active expedition in one server,
-- so the player cap is set by how many expedition lanes the server can hold
-- rather than by anything social. Two-place mode removes this constraint; see
-- docs/PUBLISHING.md.
GameConfig.MaxServerPlayers = 12

-- How many expeditions can run at once in single-place mode. Each lane is a
-- full 14,000 stud corridor of track, forest and stations, built once and
-- reused between runs. Measured part counts per lane are in docs/PERFORMANCE.md.
GameConfig.MaxConcurrentExpeditions = 2

-- Lanes are separated along X so streaming never loads two at once.
GameConfig.ExpeditionLaneSpacing = 9000

GameConfig.DepartureCountdownSeconds = 10
GameConfig.ReadyRequiredFraction = 1.0 -- every member must be ready to depart

-- A crew whose leader leaves is handed to the longest-present member rather
-- than being disbanded, so a disconnect does not end everyone else's evening.
GameConfig.LeaderTransferGraceSeconds = 5

-- How long a disconnected player's expedition slot is held for reconnection.
GameConfig.ReconnectGraceSeconds = 180

--------------------------------------------------------------------------
-- Expedition pacing
--------------------------------------------------------------------------

-- Target wall-clock for a successful normal run. Used by the pacing director
-- to decide whether to stretch or compress optional content.
GameConfig.TargetRunSeconds = 32 * 60
GameConfig.MinRunSeconds = 22 * 60
GameConfig.MaxRunSeconds = 48 * 60

GameConfig.CinematicSeconds = 38
GameConfig.CinematicSkippableAfter = 2

--------------------------------------------------------------------------
-- Difficulty
--------------------------------------------------------------------------

export type DifficultyId = "signal" | "blackout" | "derelict"

GameConfig.Difficulties = {
	{
		id = "signal",
		name = "Signal",
		blurb = "The intended experience. Threats are dangerous but readable.",
		threatRate = 1.0,
		damageTaken = 1.0,
		lootRate = 1.0,
		creditMultiplier = 1.0,
		xpMultiplier = 1.0,
		reviveSeconds = 12,
		unlockLevel = 0,
	},
	{
		id = "blackout",
		name = "Blackout",
		blurb = "Less light, less loot, and the forest pays closer attention.",
		threatRate = 1.35,
		damageTaken = 1.3,
		lootRate = 0.82,
		creditMultiplier = 1.45,
		xpMultiplier = 1.4,
		reviveSeconds = 16,
		unlockLevel = 6,
	},
	{
		id = "derelict",
		name = "Derelict",
		blurb = "The train fails more often and the radio lies more convincingly.",
		threatRate = 1.7,
		damageTaken = 1.6,
		lootRate = 0.7,
		creditMultiplier = 2.0,
		xpMultiplier = 1.9,
		reviveSeconds = 22,
		unlockLevel = 14,
	},
}

GameConfig.DefaultDifficulty = "signal" :: DifficultyId

function GameConfig.getDifficulty(id: string?)
	for _, entry in GameConfig.Difficulties do
		if entry.id == id then
			return entry
		end
	end
	return GameConfig.Difficulties[1]
end

--------------------------------------------------------------------------
-- Persistence
--------------------------------------------------------------------------

-- Changing this key starts everyone from zero. It is versioned so a broken
-- migration can be rolled forward into a fresh namespace rather than
-- corrupting live saves.
GameConfig.DataStoreName = "LastSignal_Profiles_v3"
GameConfig.LeaderboardStoreName = "LastSignal_Boards_v3"

GameConfig.AutosaveIntervalSeconds = 180
GameConfig.SessionLockStaleSeconds = 1200
GameConfig.DataRetryAttempts = 5

-- In Studio, DataStore access is often unavailable or slow. When true, the
-- server uses an in-memory store so the full progression loop is testable
-- without touching live player data. Never enabled on a real server.
GameConfig.UseMockDataInStudio = true

--------------------------------------------------------------------------
-- Performance
--------------------------------------------------------------------------

GameConfig.MaxActiveLights = 26
GameConfig.ForestStreamRadius = 620
-- Half-width of the forest corridor either side of the track. Kept just beyond
-- the fog distance: trees further out are never visible and only cost memory.
GameConfig.ForestCorridorHalfWidth = 280
GameConfig.ForestDensity = 3.5
GameConfig.CorpseCleanupSeconds = 45
GameConfig.DroppedItemLifetimeSeconds = 600

-- Server tick rates. Anything gameplay-authoritative runs at these rates
-- rather than every frame, which keeps CPU predictable with six players plus
-- creatures plus a moving train.
GameConfig.VitalsTickRate = 4
GameConfig.TrainTickRate = 20
GameConfig.CreatureTickRate = 10
GameConfig.DirectorTickRate = 1

return table.freeze(GameConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Monetization
	------------
	Every Robux-earning product in LAST SIGNAL is declared here, and only here.

	HOW TO TURN THIS ON
	-------------------
	Each entry has an `id` field set to 0. Zero means "not configured": the shop
	renders the product as Unavailable, the buy button is disabled, and no
	purchase can be attempted or simulated. Nothing anywhere in this project
	fakes a purchase.

	To go live, RIPjafar1 creates each Game Pass and Developer Product on the
	published experience, then pastes the numeric ID into the matching `id`
	field here. Full walkthrough with screenshots of where each number comes
	from is in docs/MONETIZATION.md.

	IMPORTANT OWNERSHIP NOTE
	------------------------
	Robux from Game Passes and Developer Products is paid to the owner of the
	experience the products belong to. Creating them under the RIPGAMES group or
	under the RIPjafar1 account is what directs revenue; the strings in this file
	do not. If the place is published under a different account, that account is
	paid. See docs/OWNERSHIP.md.

	PRICE FIELDS
	------------
	`suggestedPrice` is a design note for whoever configures the product. It is
	never shown to players. The shop always displays the live price fetched from
	MarketplaceService:GetProductInfo, so what a player sees is always what
	Roblox will actually charge.
]]

local Monetization = {}

export type ProductKind = "gamepass" | "developerproduct"

export type ProductDef = {
	key: string,
	kind: ProductKind,
	id: number,
	name: string,
	blurb: string,
	suggestedPrice: number,
	category: string,
	-- What owning or consuming this grants. Interpreted by PurchaseService.
	grants: { [string]: any },
	-- Permanent entitlements can only be bought once; the shop hides the button
	-- and shows Owned instead.
	permanent: boolean,
	-- Sort weight inside its shop category.
	order: number,
}

--------------------------------------------------------------------------
-- Game Passes (permanent entitlements)
--------------------------------------------------------------------------

local GAMEPASSES: { ProductDef } = {
	{
		key = "vip_crew",
		kind = "gamepass",
		id = 0,
		name = "Signalman's Pass",
		blurb = "Permanent: +25% credits and XP, a reserved cab seat cosmetic, the Signalman lantern skin, and a second daily quest slot.",
		suggestedPrice = 399,
		category = "passes",
		grants = {
			creditMultiplier = 1.25,
			xpMultiplier = 1.25,
			extraDailyQuest = 1,
			cosmetics = { "lantern_signalman", "patch_signalman" },
			chatTag = "SIGNALMAN",
		},
		permanent = true,
		order = 1,
	},
	{
		key = "cargo_rig",
		kind = "gamepass",
		id = 0,
		name = "Cargo Rigging",
		blurb = "Permanent: +6 inventory slots and +18 kg carry weight for every crew member you bring, including your friends.",
		suggestedPrice = 249,
		category = "passes",
		grants = {
			inventorySlots = 6,
			carryWeight = 18,
			sharedWithCrew = true,
		},
		permanent = true,
		order = 2,
	},
	{
		key = "workshop_access",
		kind = "gamepass",
		id = 0,
		name = "Workshop Access",
		blurb = "Permanent: unlocks the lobby workshop bench for livery mixing, plus three exclusive interior kits.",
		suggestedPrice = 199,
		category = "passes",
		grants = {
			workshopBench = true,
			cosmetics = { "interior_brass", "interior_surveyor", "interior_ashwood" },
		},
		permanent = true,
		order = 3,
	},
}

--------------------------------------------------------------------------
-- Developer Products (consumables and one-off unlocks)
--------------------------------------------------------------------------

local DEVELOPER_PRODUCTS: { ProductDef } = {
	{
		key = "field_revive",
		kind = "developerproduct",
		id = 0,
		name = "Emergency Stimulant",
		blurb = "Revive yourself once, where you fell, with 40% health. Only offered while you are down and only when a teammate is not already reviving you.",
		suggestedPrice = 20,
		category = "field",
		grants = { selfRevive = 1 },
		permanent = false,
		order = 1,
	},
	{
		key = "credits_small",
		kind = "developerproduct",
		id = 0,
		name = "Supply Voucher",
		blurb = "1,000 credits, spendable on liveries, interiors and cosmetics.",
		suggestedPrice = 99,
		category = "credits",
		grants = { credits = 1000 },
		permanent = false,
		order = 1,
	},
	{
		key = "credits_medium",
		kind = "developerproduct",
		id = 0,
		name = "Depot Requisition",
		blurb = "5,500 credits. Better value than the Supply Voucher.",
		suggestedPrice = 449,
		category = "credits",
		grants = { credits = 5500 },
		permanent = false,
		order = 2,
	},
	{
		key = "credits_large",
		kind = "developerproduct",
		id = 0,
		name = "Regional Stockpile",
		blurb = "14,000 credits. Best value.",
		suggestedPrice = 999,
		category = "credits",
		grants = { credits = 14000 },
		permanent = false,
		order = 3,
	},
	{
		key = "livery_ember",
		kind = "developerproduct",
		id = 0,
		name = "Livery: Ember Line",
		blurb = "Permanent livery. Oxblood panels, brass trim, warm running lights that read clearly at distance in fog.",
		suggestedPrice = 149,
		category = "liveries",
		grants = { cosmetics = { "livery_ember" } },
		permanent = true,
		order = 1,
	},
	{
		key = "livery_permafrost",
		kind = "developerproduct",
		id = 0,
		name = "Livery: Permafrost",
		blurb = "Permanent livery. Frost-bitten white over grey steel with ice-blue signal lamps.",
		suggestedPrice = 149,
		category = "liveries",
		grants = { cosmetics = { "livery_permafrost" } },
		permanent = true,
		order = 2,
	},
	{
		key = "livery_nightpost",
		kind = "developerproduct",
		id = 0,
		name = "Livery: Night Post",
		blurb = "Permanent livery. Matte black with reflective hazard chevrons that catch your own headlights.",
		suggestedPrice = 199,
		category = "liveries",
		grants = { cosmetics = { "livery_nightpost" } },
		permanent = true,
		order = 3,
	},
	{
		key = "lantern_kit",
		kind = "developerproduct",
		id = 0,
		name = "Lamp Collection",
		blurb = "Permanent: four cosmetic flashlight bodies, including the brass Dispatcher lamp with a warmer beam tint.",
		suggestedPrice = 129,
		category = "cosmetics",
		grants = { cosmetics = { "lantern_brass", "lantern_dispatcher", "lantern_field", "lantern_hooded" } },
		permanent = true,
		order = 1,
	},
	{
		key = "crew_outfits",
		kind = "developerproduct",
		id = 0,
		name = "Crew Wardrobe",
		blurb = "Permanent: six crew outfits including the conductor's coat and the long-haul engineer's kit.",
		suggestedPrice = 179,
		category = "cosmetics",
		grants = {
			cosmetics = {
				"outfit_conductor",
				"outfit_engineer",
				"outfit_surveyor",
				"outfit_medic",
				"outfit_lineman",
				"outfit_forester",
			},
		},
		permanent = true,
		order = 2,
	},
	{
		key = "tool_finishes",
		kind = "developerproduct",
		id = 0,
		name = "Equipment Finishes",
		blurb = "Permanent: worn brass, gunmetal and enamel finishes for your tools and weapons. Appearance only, no stat change.",
		suggestedPrice = 99,
		category = "cosmetics",
		grants = { cosmetics = { "finish_brass", "finish_gunmetal", "finish_enamel" } },
		permanent = true,
		order = 3,
	},
}

--------------------------------------------------------------------------
-- Lookup tables
--------------------------------------------------------------------------

Monetization.GamePasses = GAMEPASSES
Monetization.DeveloperProducts = DEVELOPER_PRODUCTS

local byKey: { [string]: ProductDef } = {}
local allProducts: { ProductDef } = {}

for _, def in GAMEPASSES do
	byKey[def.key] = def
	table.insert(allProducts, def)
end
for _, def in DEVELOPER_PRODUCTS do
	if byKey[def.key] then
		error("Monetization: duplicate product key " .. def.key)
	end
	byKey[def.key] = def
	table.insert(allProducts, def)
end

Monetization.All = allProducts

function Monetization.get(key: string): ProductDef?
	return byKey[key]
end

--- Reverse lookup used by ProcessReceipt and gamepass checks, where Roblox
--- gives us only a numeric ID.
function Monetization.byId(kind: ProductKind, id: number): ProductDef?
	if id <= 0 then
		return nil
	end
	for _, def in allProducts do
		if def.kind == kind and def.id == id then
			return def
		end
	end
	return nil
end

--- A product is purchasable only when it has a real ID. Everything that can
--- show a buy button must call this first.
function Monetization.isConfigured(key: string): boolean
	local def = byKey[key]
	return def ~= nil and def.id > 0
end

--- Reports configuration state at boot so the operator sees exactly what is
--- live and what is still switched off.
function Monetization.audit(): { configured: number, total: number, missing: { string } }
	local configured = 0
	local missing: { string } = {}
	for _, def in allProducts do
		if def.id > 0 then
			configured += 1
		else
			table.insert(missing, def.key)
		end
	end
	table.sort(missing)
	return { configured = configured, total = #allProducts, missing = missing }
end

--------------------------------------------------------------------------
-- Shop categories
--------------------------------------------------------------------------

Monetization.Categories = {
	{ id = "featured", name = "Featured", robux = true },
	{ id = "passes", name = "Passes", robux = true },
	{ id = "liveries", name = "Liveries", robux = true },
	{ id = "cosmetics", name = "Cosmetics", robux = true },
	{ id = "credits", name = "Credits", robux = true },
	{ id = "field", name = "Field Supplies", robux = true },
	{ id = "exchange", name = "Credit Exchange", robux = false },
}

--------------------------------------------------------------------------
-- Design guardrails, enforced by tests in docs/TESTING.md
--------------------------------------------------------------------------

-- No product in this file grants combat power, damage, health, ammunition
-- capacity or threat suppression. Cargo Rigging grants carry capacity, which
-- affects how much loot a crew can haul, not how hard they hit. This is a
-- deliberate constraint: it keeps the free experience whole and keeps the
-- paid content about identity and convenience.
Monetization.NoCombatAdvantage = true

-- Purchase prompts are suppressed while any of these are true. Checked by
-- ShopService before it will open a prompt.
Monetization.PromptBlockedStates = {
	"cinematic",
	"encounter",
	"downed_teammate_critical",
	"expedition_climax",
	"loading",
}

return Monetization
]]></string>
          </Properties>
        </Item>
      </Item>
