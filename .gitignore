# Build toolchain. These are third-party binaries (Rojo, Luau, luau-lsp) that
# are downloaded rather than committed. docs/SETUP.md has the exact commands
# to reinstall them.
/tools/bin/
/tools/dl/

# Rojo sourcemap, regenerated by scripts/check.sh
LastSignal/sourcemap.json

# Roblox lock files
*.rbxlx.lock
*.rbxl.lock

# Local place backups taken before large edits (kept on disk, not in git)
LastSignal/backups/

# Dev-sync scratch: server log and code fragments used while editing
tools/devsync/devsync.log
tools/devsync/frag_*.luau
tools/devsync/patch_*.js
tools/devsync/frag_*
tools/devsync/append_*.js
tools/devsync/fix.js
tools/devsync/silent.js
